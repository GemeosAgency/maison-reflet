---
/**
 * Section « Designed to be worn, remembered and shared. » : trois piliers
 * (Qualité / Tenue / Caractère) en bande pleine largeur, texte en bas de
 * chaque visuel sur un dégradé sombre.
 *
 * Extrait de la fiche produit pour être partagé avec la page coffret — le
 * rendu est identique, seuls les textes viennent de l'appelant (i18n).
 */
interface Pillar {
  title: string;
  text: string;
  image: string;
}

interface Props {
  title1: string;
  title2: string;
  subtitle: string;
  pillars: Pillar[];
}

const { title1, title2, subtitle, pillars } = Astro.props;

const responsiveSources = (image: string) => {
  const stem = image.replace(/\.[^.]+$/, "");
  return [640, 960, 1400].map((width) => `${stem}-${width}.webp ${width}w`).join(", ");
};
---

<section class="pillars">
  <div class="pillars-head">
    <h2>
      {title1}<br />
      {title2}
    </h2>
    <p>{subtitle}</p>
  </div>
  <div class="pillars-grid full-bleed">
    {
      pillars.map((p) => (
        <div class="pillar">
          <img
            class="pillar-media"
            src={p.image}
            srcset={responsiveSources(p.image)}
            sizes="(max-width: 900px) 100vw, 34vw"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pillars { display: flex; flex-direction: column; align-items: center; }
  .pillars-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    padding: 112px var(--gutter-x) 40px;
  }
  .pillars-head h2 { margin: 0; font-size: 32px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .pillars-head p { margin: 0; font-size: 18px; }
  /* Pas de `width` ici : c'est .full-bleed (globale) qui l'étire bord à bord.
     La colonne porte le ratio de la maquette plutôt qu'une hauteur figée —
     sinon au-delà de 1440px elle s'élargissait sans grandir et le visuel
     était rogné. */
  .pillars-grid { display: flex; gap: 2px; }
  .pillar {
    flex: 1 0 0;
    min-width: 0;
    aspect-ratio: var(--band-col);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 32px;
    color: var(--paper);
  }
  .pillar-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pillar::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 47%, rgba(23, 23, 23, 0.96) 86%);
  }
  .pillar h3,
  .pillar p { position: relative; z-index: 1; margin: 0; }
  .pillar h3 { font-size: 20px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .pillar p { max-width: 360px; font-size: 18px; line-height: 1.28; letter-spacing: 1.08px; }

  @media (max-width: 900px) {
    .pillars-head { padding: 56px var(--gutter-x) 24px; }
    .pillars-head h2 { font-size: 22px; }
    .pillars-head p { max-width: 340px; font-size: 16px; line-height: 1.35; }
    /* Les sources sont des portraits (~4/5) : le précédent recadrage paysage
       coupait les sujets et empilait trois grands blocs. Une bande à snap
       conserve leur format et laisse voir la carte suivante. */
    .pillars-grid {
      box-sizing: border-box;
      padding-inline: 0;
      gap: 2px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .pillars-grid::-webkit-scrollbar { display: none; }
    .pillar {
      flex: 0 0 calc(100vw - 32px);
      aspect-ratio: 4 / 5;
      padding: 24px;
      scroll-snap-align: start;
    }
  }
</style>
