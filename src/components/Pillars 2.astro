---
/**
 * Section « Designed to be worn, remembered and shared. » : trois piliers
 * (Qualité / Tenue / Caractère) en bande pleine largeur, texte en bas de
 * chaque visuel sur un dégradé sombre.
 *
 * Extrait de la fiche produit pour être partagé avec la page coffret — le
 * rendu est identique, seuls les textes viennent de l'appelant (i18n).
 */
interface Pillar {
  title: string;
  text: string;
  image: string;
}

interface Props {
  title1: string;
  title2: string;
  subtitle: string;
  pillars: Pillar[];
}

const { title1, title2, subtitle, pillars } = Astro.props;
---

<section class="pillars">
  <div class="pillars-head">
    <h2>
      {title1}<br />
      {title2}
    </h2>
    <p>{subtitle}</p>
  </div>
  <div class="pillars-grid media-band">
    {
      pillars.map((p) => (
        <div class="pillar" style={`background-image: url(${p.image})`}>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .pillars { display: flex; flex-direction: column; align-items: center; }
  .pillars-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    padding: 112px var(--gutter-x) 40px;
  }
  .pillars-head h2 { margin: 0; font-size: 32px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .pillars-head p { margin: 0; font-size: 18px; }
  /* Pas de `width` ici : c'est .media-band (globale) qui la fixe. La colonne
     porte le ratio de la maquette plutôt qu'une hauteur figée — sinon au-delà
     de 1440px elle s'élargissait sans grandir et le visuel était rogné. */
  .pillars-grid { display: flex; gap: 2px; }
  .pillar {
    flex: 1 0 0;
    min-width: 0;
    aspect-ratio: var(--band-col);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 32px;
    background-size: cover;
    background-position: center;
    color: var(--paper);
  }
  .pillar::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 47%, rgba(23, 23, 23, 0.96) 86%);
  }
  .pillar h3,
  .pillar p { position: relative; z-index: 1; margin: 0; }
  .pillar h3 { font-size: 20px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .pillar p { max-width: 360px; font-size: 18px; line-height: 1.28; letter-spacing: 1.08px; }

  @media (max-width: 900px) {
    .pillars-head { padding: 56px var(--gutter-x) 24px; }
    .pillars-head h2 { font-size: 26px; }
    .pillars-grid { flex-direction: column; }
    /* `flex: none` est indispensable : en flex-direction column, le
       `flex: 1 0 0` du desktop s'applique à la HAUTEUR et écrase
       l'aspect-ratio — les piliers s'effondraient à 48px de haut.
       Et empilés en pleine largeur, le ratio de maquette donnerait des blocs
       de 117vw de haut, d'où le 4/3 paysage. */
    .pillar { flex: none; aspect-ratio: 4 / 3; padding: 24px; }
  }
</style>
