---
/**
 * Le diaporama du menu, en composant : les photos d'un Reflet empilées, la
 * visible en fondu croisé avec un zoom très lent, et un segment par photo
 * façon stories — le courant se remplit au rythme du défilement, chacun se
 * clique. Le survol de l'image fige tout. Même rythme que le menu (2,3 s).
 *
 * Seule la première photo est chargée avec la page ; les autres à la mise en
 * route. Sur ordinateur, le composant reste un diaporama automatique. Sur
 * mobile, il devient une bande tactile à snap, sans avance automatique : le
 * visiteur garde la main et voit le bord de la photo suivante.
 */
import type { ResponsiveImage } from "../lib/sanity";

interface Props {
  slides: ResponsiveImage[];
  name: string;
  href?: string;
  /** Attribut sizes des images (largeur affichée). */
  sizes?: string;
  /** Format de l'image, ex. "3 / 4" (défaut) ou "4 / 5". */
  ratio?: string;
  /** Le lien s'ouvre dans un nouvel onglet (la fiche courante reste ouverte). */
  newTab?: boolean;
  class?: string;
}

const { slides, name, href, sizes = "260px", ratio = "3 / 4", newTab = false, class: className } = Astro.props;
const Media = href ? "a" : "div";
---

{
  slides.length > 0 && (
    <div class:list={["slides", className]} data-slides>
      <Media
        class="slides-media"
        href={href}
        target={href && newTab ? "_blank" : undefined}
        rel={href && newTab ? "noopener" : undefined}
        tabindex={href ? "-1" : undefined}
        aria-label={href ? name : undefined}
        style={`--slides-ratio: ${ratio}; aspect-ratio: ${ratio}`}
      >
        {slides.map((slide, i) =>
          i === 0 ? (
            <img class="slides-img is-shown" src={slide.src} srcset={slide.srcset} sizes={sizes} alt="" loading="lazy" decoding="async" />
          ) : (
            <img class="slides-img" data-src={slide.src} data-srcset={slide.srcset} sizes={sizes} alt="" decoding="async" />
          )
        )}
      </Media>
      {slides.length > 1 && (
        <div class="slides-dots">
          {slides.map((_, i) => (
            <button type="button" class="slides-dot" data-slides-dot={i} tabindex="-1" aria-label={`${name} ${i + 1}/${slides.length}`}></button>
          ))}
        </div>
      )}
    </div>
  )
}

<script>
  const SLIDE_MS = 2300;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  for (const fig of document.querySelectorAll<HTMLElement>("[data-slides]")) {
    const imgs = Array.from(fig.querySelectorAll<HTMLImageElement>(".slides-img"));
    const dots = Array.from(fig.querySelectorAll<HTMLElement>(".slides-dot"));
    const media = fig.querySelector<HTMLElement>(".slides-media");
    const count = imgs.length;
    let timer: number | undefined;
    let index = 0;
    let startedAt = 0;
    let remaining = SLIDE_MS;
    let running = false;
    let paused = false;
    let scrollFrame = 0;
    let pointerX: number | null = null;
    let draggedAt = 0;

    const isTouchStrip = () => window.matchMedia("(max-width: 560px)").matches;
    const alignImage = (image: HTMLElement | undefined, behavior: ScrollBehavior) => {
      if (!media || !image) return;
      const mediaRect = media.getBoundingClientRect();
      const imageRect = image.getBoundingClientRect();
      const rtl = getComputedStyle(media).direction === "rtl";
      const left = media.scrollLeft + (rtl ? imageRect.right - mediaRect.right : imageRect.left - mediaRect.left);
      media.scrollTo({ left, behavior });
    };

    const hydrate = () => {
      for (const img of imgs) {
        if (!img.dataset.src) continue;
        img.src = img.dataset.src;
        if (img.dataset.srcset) img.srcset = img.dataset.srcset;
        img.removeAttribute("data-src");
        img.removeAttribute("data-srcset");
      }
    };
    const show = (i: number, animate: boolean) => {
      imgs.forEach((im, k) => im.classList.toggle("is-shown", k === i));
      dots.forEach((dot, k) => {
        dot.classList.remove("is-current", "is-done", "is-active");
        if (k < i) dot.classList.add("is-done");
        if (k === i) dot.classList.add("is-active");
        if (k === i && animate) {
          void dot.offsetWidth; // relance le remplissage depuis zéro
          dot.style.animationDuration = `${SLIDE_MS}ms`;
          dot.classList.add("is-current");
        }
      });
    };
    const schedule = (delay: number) => {
      window.clearTimeout(timer);
      startedAt = performance.now();
      remaining = delay;
      timer = window.setTimeout(() => {
        index = (index + 1) % count;
        show(index, true);
        schedule(SLIDE_MS);
      }, delay);
    };
    const stop = () => {
      window.clearTimeout(timer);
      running = false;
      paused = false;
      fig.classList.remove("is-paused");
      index = 0;
      show(0, false);
    };
    const start = () => {
      stop();
      hydrate();
      if (isTouchStrip()) {
        show(0, false);
        alignImage(imgs[0], "auto");
        return;
      }
      if (count < 2 || reducedMotion.matches) return;
      running = true;
      show(0, true);
      schedule(SLIDE_MS);
    };
    fig.addEventListener("slides:start", start);
    fig.addEventListener("slides:stop", stop);

    for (const dot of dots) {
      dot.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        hydrate();
        paused = false;
        fig.classList.remove("is-paused");
        index = Number((dot as HTMLElement).dataset.slidesDot ?? 0);
        show(index, !reducedMotion.matches && !isTouchStrip());
        if (isTouchStrip()) {
          alignImage(imgs[index], reducedMotion.matches ? "auto" : "smooth");
          return;
        }
        if (!reducedMotion.matches) {
          running = true;
          schedule(SLIDE_MS);
        }
      });
    }
    media?.addEventListener("mouseenter", () => {
      if (!running || paused) return;
      paused = true;
      window.clearTimeout(timer);
      remaining = Math.max(200, remaining - (performance.now() - startedAt));
      fig.classList.add("is-paused");
    });
    media?.addEventListener("mouseleave", () => {
      if (!running || !paused) return;
      paused = false;
      fig.classList.remove("is-paused");
      schedule(remaining);
    });
    media?.addEventListener("scroll", () => {
      if (!isTouchStrip() || scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = 0;
        const mediaCenter = media.getBoundingClientRect().left + media.clientWidth / 2;
        index = imgs.reduce(
          (closest, image, imageIndex) => {
            const rect = image.getBoundingClientRect();
            const distance = Math.abs(rect.left + rect.width / 2 - mediaCenter);
            return distance < closest.distance ? { index: imageIndex, distance } : closest;
          },
          { index: 0, distance: Number.POSITIVE_INFINITY }
        ).index;
        show(index, false);
      });
    }, { passive: true });
    // Un swipe dans l'ancre ne doit pas ouvrir la fiche partenaire au relâché ;
    // un tap immobile continue, lui, de suivre le lien.
    media?.addEventListener("pointerdown", (event) => {
      if (isTouchStrip()) pointerX = event.clientX;
    }, { passive: true });
    media?.addEventListener("pointerup", (event) => {
      if (pointerX !== null && Math.abs(event.clientX - pointerX) > 8) draggedAt = performance.now();
      pointerX = null;
    }, { passive: true });
    media?.addEventListener("pointercancel", () => { pointerX = null; }, { passive: true });
    media?.addEventListener("click", (event) => {
      if (performance.now() - draggedAt < 350) event.preventDefault();
    });
  }
</script>

<style>
  .slides { display: flex; flex-direction: column; }
  .slides-media { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: var(--sand); }
  .slides-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1);
    transition: opacity 0.6s ease;
  }
  .slides-img.is-shown { opacity: 1; animation: slides-kenburns 3.1s ease-out forwards; }
  @keyframes slides-kenburns {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }
  .slides-dots { display: flex; gap: 4px; height: 14px; margin-top: 10px; }
  .slides-dot {
    position: relative;
    flex: 1 1 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .slides-dot::before,
  .slides-dot::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 6px;
    height: 2px;
  }
  .slides-dot::before { background: rgba(21, 14, 10, 0.14); transition: background-color 0.2s ease; }
  .slides-dot:hover::before { background: rgba(21, 14, 10, 0.3); }
  .slides-dot::after { background: var(--ink); transform: scaleX(0); transform-origin: 0 50%; }
  :global([dir="rtl"]) .slides-dot::after { transform-origin: 100% 50%; }
  .slides-dot.is-done::after { transform: scaleX(1); }
  .slides-dot.is-current::after { animation: slides-dot 2300ms linear forwards; }
  @keyframes slides-dot {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .slides.is-paused .slides-img,
  .slides.is-paused .slides-dot::after { animation-play-state: paused; }
  @media (max-width: 560px) {
    .slides-media {
      display: flex;
      gap: 2px;
      aspect-ratio: auto !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .slides-media::-webkit-scrollbar { display: none; }
    .slides-img,
    .slides-img.is-shown {
      position: relative;
      inset: auto;
      flex: 0 0 calc(100% - 32px);
      width: auto;
      min-width: 0;
      height: auto;
      aspect-ratio: var(--slides-ratio, 4 / 5);
      opacity: 1;
      transform: none;
      transition: none;
      animation: none;
      scroll-snap-align: start;
    }
    .slides-dot.is-done::after { transform: scaleX(0); }
    .slides-dot.is-active::after { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .slides-img { transition: none; }
    .slides-img.is-shown, .slides-dot.is-current::after { animation: none; }
    .slides-dot.is-current::after { transform: scaleX(1); }
  }
</style>
