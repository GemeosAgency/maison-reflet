---
/**
 * Menu de navigation — deux formes, un seul composant, monté dans Layout juste
 * après l'en-tête (dans `.site-header-sticky`, qui est positionné : c'est lui
 * qui sert de référence au panneau).
 *
 * ORDINATEUR — un panneau pleine largeur sous la barre, ouvert au survol de
 * « Parfums » (avec un délai d'intention, pour ne pas surgir au passage de la
 * souris) ou au clavier. Trois colonnes : les six Reflets en liste
 * typographique, les coffrets, et un grand visuel qui change au survol d'un
 * nom. Le « Parfums » de la barre reste un lien vers le catalogue : sur un
 * écran tactile, sans survol, le premier toucher ouvre le panneau.
 *
 * MOBILE — une feuille plein écran ouverte par le bouton menu, avec les mêmes
 * entrées en liste (vignette, nom, univers), puis Luma, le pays et la langue.
 *
 * Le premium est dans la retenue : papier et encre, beaucoup d'air, une
 * apparition lente, aucune boîte ni ombre. Les prix portent `data-money`
 * pour être recalculés dans la devise du visiteur (voir lib/country.ts).
 */
import {
  formatPrice,
  getAllProducts,
  getDisplayPrice,
  getPrimaryVariant,
  isCoffret,
  secondaryImage,
  shopifyImage,
} from "../lib/shopify";
import { getCoffrets, getMenuParfums, getRecoImages, responsiveImage, type ResponsiveImage } from "../lib/sanity";
import { type Locale, locales, localeNames, localePath, useTranslations } from "../i18n";
import { portraitAudioPath } from "../lib/luma/portraits";
import { universeLabel } from "../lib/universes";

interface Props {
  lang: Locale;
  /** Chemin courant sans préfixe de langue, pour le sélecteur de langue. */
  rest: string;
}

const { lang, rest } = Astro.props;
const t = useTranslations(lang);

const [products, menuParfums, recoImages, coffretContent] = await Promise.all([
  getAllProducts(),
  getMenuParfums(),
  getRecoImages(),
  getCoffrets(lang),
]);
const docByHandle = Object.fromEntries(menuParfums.map((p) => [p.shopifyHandle, p]));

// La colonne visuelle fait au plus 360 px : deux paliers, écran 2x compris.
const VISUAL_WIDTHS = [360, 720];
const THUMB_WIDTHS = [72, 144];
const BOX_WIDTHS = [320, 640];

type Picture = ResponsiveImage | null;

const reflets = products
  .filter((p) => !isCoffret(p))
  .map((p) => {
    const doc = docByHandle[p.handle];
    const source = recoImages[p.handle]?.main ?? null;
    // Seconde photo au survol du visuel — la même que les tuiles du
    // catalogue : la version curée dans Sanity, sinon la deuxième photo Shopify.
    const hoverSource = recoImages[p.handle]?.hover ?? null;
    const secondary = secondaryImage(p);
    const hoverVisual: Picture = hoverSource
      ? responsiveImage(hoverSource as any, { widths: VISUAL_WIDTHS, aspect: 3 / 4 })
      : secondary
        ? shopifyImage(secondary, VISUAL_WIDTHS)
        : null;
    const variant = getPrimaryVariant(p);
    const price = getDisplayPrice(p);
    // Même visuel que la tuile du catalogue : la photo curée dans Sanity
    // (imageRecommandation) sinon la photo principale Shopify.
    const picture = (widths: number[], aspect: number): Picture =>
      source
        ? responsiveImage(source as any, { widths, aspect })
        : p.featuredImage
          ? shopifyImage(p.featuredImage, widths)
          : null;
    return {
      handle: p.handle,
      name: p.title,
      href: localePath(lang, `/parfums/${p.handle}`),
      universe: universeLabel(p.handle, lang),
      bestSeller: !!doc?.bestSeller,
      nouveau: !!doc?.nouveau,
      // Le portrait audio déjà enregistré (portraits.ts) : zéro crédit à l'écoute.
      audio: portraitAudioPath(lang, p.handle),
      listenLabel: t("luma.discover").replace("{name}", p.title),
      price: formatPrice(price.amount, price.currencyCode),
      variantId: variant.id,
      visual: picture(VISUAL_WIDTHS, 3 / 4),
      hoverVisual,
      thumb: picture(THUMB_WIDTHS, 4 / 5),
    };
  });

// Visuel affiché à l'ouverture : le best-seller, sinon le premier.
const initialHandle = (reflets.find((r) => r.bestSeller) ?? reflets[0])?.handle ?? null;

const coffrets = products
  .filter(isCoffret)
  .map((sp) => {
    const content = coffretContent.find((c) => c.shopifyHandle === sp.handle);
    const variant = getPrimaryVariant(sp);
    const price = getDisplayPrice(sp);
    // La photo Shopify d'abord (règle de la Maison : les photos produit vivent
    // dans Shopify), l'image Sanity du coffret en repli.
    const img: Picture = sp.featuredImage
      ? shopifyImage(sp.featuredImage, BOX_WIDTHS)
      : content?.image
        ? responsiveImage(content.image as any, { widths: BOX_WIDTHS, aspect: 4 / 3 })
        : null;
    return {
      handle: sp.handle,
      title: content?.titre ?? sp.title,
      href: localePath(lang, `/coffrets/${sp.handle}`),
      price: formatPrice(price.amount, price.currencyCode),
      variantId: variant.id,
      img,
    };
  });

const catalogueHref = localePath(lang, "/parfums");
const materialsHref = `${catalogueHref}#luma-doors-title`;
const maisonHref = localePath(lang, "/maison");
---

{/* ---------------- Ordinateur : le panneau ---------------- */}
<div class="mega-veil" data-menu-veil aria-hidden="true"></div>
<div class="mega" id="site-mega" data-menu-panel aria-label={t("nav.perfumes")}>
  <div class="mega-inner">
    <div class="mega-col mega-col-reflets">
      <p class="mega-eyebrow">{t("menu.reflets")}</p>
      <ul class="mega-list">
        {
          reflets.map((r) => (
            <li class:list={["mega-entry", { "is-active": r.handle === initialHandle }]} data-menu-entry={r.handle}>
              <a class="mega-item" href={r.href} data-menu-item={r.handle}>
                <span class="mega-kicker">
                  {r.universe && <span class="mega-universe">{r.universe}</span>}
                  {r.bestSeller && <span class="mega-pill mega-pill-best">{t("product.bestSeller")}</span>}
                  {r.nouveau && <span class="mega-pill mega-pill-new">{t("menu.new")}</span>}
                </span>
                <span class="mega-item-name">{r.name}</span>
              </a>
              {/* Le trait de progression relie la ligne au portrait en cours d'écoute (bouton sous le visuel). */}
              <span class="mega-listen-track" aria-hidden="true"><span class="mega-listen-progress" data-menu-progress={r.handle}></span></span>
            </li>
          ))
        }
      </ul>
      <a class="mega-all" href={catalogueHref}>{t("menu.all")}</a>
    </div>

    <div class="mega-visual" aria-hidden="true">
      {/* Même hauteur d'intitulé que les colonnes voisines : les trois visuels partent de la même ligne. */}
      <p class="mega-eyebrow mega-eyebrow-ghost">{t("menu.reflets")}</p>
      <div class="mega-visual-stack">
      {
        reflets.map((r) => (
          <div class:list={["mega-fig", { "is-active": r.handle === initialHandle }]} data-menu-figure={r.handle}>
            <a class="mega-fig-media" href={r.href} tabindex="-1" aria-label={r.name}>
              {r.visual && (
                <img
                  class="mega-fig-img"
                  src={r.visual.src}
                  srcset={r.visual.srcset}
                  sizes="360px"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              {r.hoverVisual && (
                <img
                  class="mega-fig-img mega-fig-img-hover"
                  src={r.hoverVisual.src}
                  srcset={r.hoverVisual.srcset}
                  sizes="360px"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </a>
            <div class="mega-fig-caption">
              <a class="mega-fig-title" href={r.href} tabindex="-1">
                <span class="mega-fig-name">{r.name}</span>
                <span class="mega-fig-price" data-money={r.variantId}>{r.price}</span>
                <span class="mega-fig-cta">{t("menu.discover")}</span>
              </a>
              {r.audio && (
                <button
                  type="button"
                  class="mega-listen mega-listen-big"
                  data-menu-listen={r.handle}
                  data-src={r.audio}
                  aria-label={r.listenLabel}
                  aria-pressed="false"
                  tabindex="-1"
                >
                  <span class="mega-listen-icon" aria-hidden="true">
                    <svg class="mega-listen-play" width="12" height="12" viewBox="0 0 12 12"><path d="M2 1.5v9l8-4.5z" fill="currentColor" /></svg>
                    <svg class="mega-listen-pause" width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 1.5h2.5v9h-2.5zM7 1.5h2.5v9H7z" fill="currentColor" /></svg>
                  </span>
                  <span class="mega-listen-label">{t("menu.listenPortrait")}</span>
                  <span class="mega-listen-time" data-menu-time={r.handle}></span>
                  <span class="mega-listen-track mega-listen-track-big" aria-hidden="true"><span class="mega-listen-progress" data-menu-progress={r.handle}></span></span>
                </button>
              )}
            </div>
          </div>
        ))
      }
      </div>
    </div>
    <div class="mega-col mega-col-coffrets">
      <p class="mega-eyebrow">{t("menu.coffrets")}</p>
      <div class="mega-boxes">
        {
          coffrets.map((c) => (
            <a class="mega-box" href={c.href}>
              {c.img && (
                <img
                  class="mega-box-img"
                  src={c.img.src}
                  srcset={c.img.srcset}
                  sizes="240px"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="mega-box-title">{c.title}</span>
              <span class="mega-box-price" data-money={c.variantId}>{c.price}</span>
            </a>
          ))
        }
      </div>
    </div>

  </div>
  <div class="mega-foot">
    <button type="button" class="mega-luma" data-luma-open data-luma-source="menu">
      <span class="mega-luma-name">{t("luma.name")}</span>
      <span>{t("menu.luma")}</span>
    </button>
    <a class="mega-foot-link" href={materialsHref}>{t("menu.materials")}</a>
    <a class="mega-foot-link" href={maisonHref}>{t("nav.maison")}</a>
  </div>
</div>

{/* ---------------- Mobile : la feuille ---------------- */}
<div class="msheet" id="site-menu-sheet" data-menu-sheet aria-hidden="true" role="dialog" aria-label={t("menu.open")}>
  <div class="msheet-head">
    <img src="/brand/logo.svg" alt="Maison Reflet" height="22" />
    <button type="button" class="msheet-close" data-menu-close aria-label={t("menu.close")}>
      <img src="/brand/close.svg" alt="" width="16" height="16" />
    </button>
  </div>
  <nav class="msheet-body">
    <p class="mega-eyebrow">{t("menu.reflets")}</p>
    <ul class="msheet-list">
      {
        reflets.map((r) => (
          <li>
            <a class="msheet-row" href={r.href}>
              {r.thumb && (
                <img
                  class="msheet-thumb"
                  src={r.thumb.src}
                  srcset={r.thumb.srcset}
                  sizes="56px"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="msheet-row-text">
                <span class="mega-kicker">
                  {r.universe && <span class="mega-universe">{r.universe}</span>}
                  {r.bestSeller && <span class="mega-pill mega-pill-best">{t("product.bestSeller")}</span>}
                  {r.nouveau && <span class="mega-pill mega-pill-new">{t("menu.new")}</span>}
                </span>
                <span class="msheet-row-name">{r.name}</span>
              </span>
              <span class="msheet-row-price" data-money={r.variantId}>{r.price}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="msheet-all" href={catalogueHref}>{t("menu.all")}</a>

    <p class="mega-eyebrow">{t("menu.coffrets")}</p>
    <ul class="msheet-list">
      {
        coffrets.map((c) => (
          <li>
            <a class="msheet-row" href={c.href}>
              {c.img && (
                <img
                  class="msheet-thumb msheet-thumb-box"
                  src={c.img.src}
                  srcset={c.img.srcset}
                  sizes="56px"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="msheet-row-text">
                <span class="msheet-row-name">{c.title}</span>
              </span>
              <span class="msheet-row-price" data-money={c.variantId}>{c.price}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a class="msheet-link" href={maisonHref}>{t("nav.maison")}</a>
  </nav>
  <div class="msheet-foot">
    <button type="button" class="msheet-luma" data-luma-open data-luma-source="menu">
      <span class="mega-luma-name">{t("luma.name")}</span>
      <span>{t("menu.luma")}</span>
    </button>
    <div class="msheet-settings">
      <button type="button" class="msheet-region" data-region-open>{t("menu.region")}</button>
      <ul class="msheet-langs">
        {
          locales.map((loc) => (
            <li>
              <a href={localePath(loc, rest)} aria-current={loc === lang ? "true" : undefined} lang={loc}>
                {localeNames[loc]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  /* ---------------- Ordinateur ---------------- */
  const trigger = document.querySelector<HTMLAnchorElement>("[data-menu-trigger]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const veil = document.querySelector<HTMLElement>("[data-menu-veil]");
  const hoverable = window.matchMedia("(hover: hover)");

  let openTimer: number | undefined;
  let closeTimer: number | undefined;
  let isOpen = false;

  function openPanel() {
    window.clearTimeout(closeTimer);
    if (!panel || isOpen) return;
    isOpen = true;
    primeDurations();
    document.body.classList.add("menu-open");
    panel.classList.add("is-open");
    veil?.classList.add("is-open");
    trigger?.setAttribute("aria-expanded", "true");
  }
  function closePanel() {
    window.clearTimeout(openTimer);
    if (!panel || !isOpen) return;
    stopListening();
    isOpen = false;
    document.body.classList.remove("menu-open");
    panel.classList.remove("is-open");
    veil?.classList.remove("is-open");
    trigger?.setAttribute("aria-expanded", "false");
  }
  // Délais d'intention : ouvrir au passage de la souris serait agressif,
  // fermer à la sortie immédiate ferait perdre le panneau en diagonale.
  const scheduleOpen = () => {
    window.clearTimeout(closeTimer);
    openTimer = window.setTimeout(openPanel, 120);
  };
  const scheduleClose = () => {
    window.clearTimeout(openTimer);
    // Un portrait en cours d'écoute : la souris qui s'éloigne ne coupe pas
    // la voix ; Échap, un clic ailleurs ou le bouton, si.
    if (listening()) return;
    closeTimer = window.setTimeout(closePanel, 220);
  };

  if (trigger && panel) {
    trigger.addEventListener("mouseenter", () => hoverable.matches && scheduleOpen());
    trigger.addEventListener("mouseleave", () => hoverable.matches && scheduleClose());
    panel.addEventListener("mouseenter", () => window.clearTimeout(closeTimer));
    panel.addEventListener("mouseleave", () => hoverable.matches && scheduleClose());
    // Sans survol (tactile) : le premier toucher ouvre, le second suit le lien.
    trigger.addEventListener("click", (e) => {
      if (!isOpen) {
        e.preventDefault();
        openPanel();
      }
    });
    // Le focus clavier ouvre — sauf quand c'est nous qui le rendons au
    // trigger après Échap, sinon le panneau se rouvrait aussitôt.
    let returningFocus = false;
    trigger.addEventListener("focus", () => !returningFocus && openPanel());
    veil?.addEventListener("click", closePanel);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) {
        closePanel();
        returningFocus = true;
        trigger.focus();
        returningFocus = false;
      }
    });
    // Le focus clavier quitte le trigger et le panneau : on referme.
    document.addEventListener("focusin", (e) => {
      const target = e.target as Node | null;
      if (isOpen && target && !panel.contains(target) && target !== trigger) closePanel();
    });
    document.addEventListener("click", (e) => {
      const target = e.target as Node | null;
      if (isOpen && target && !panel.contains(target) && !trigger.contains(target)) closePanel();
    });

    // Survoler un nom change le visuel : chaque Reflet a sa figure empilée,
    // on n'active que la sienne (fondu en CSS).
    const figures = panel.querySelectorAll<HTMLElement>("[data-menu-figure]");
    const items = panel.querySelectorAll<HTMLElement>("[data-menu-item]");
    const entries = panel.querySelectorAll<HTMLElement>("[data-menu-entry]");
    function activate(handle: string) {
      for (const f of figures) f.classList.toggle("is-active", f.dataset.menuFigure === handle);
      for (const e of entries) e.classList.toggle("is-active", e.dataset.menuEntry === handle);
    }
    for (const entry of entries) {
      const show = () => activate(entry.dataset.menuEntry ?? "");
      entry.addEventListener("mouseenter", show);
      entry.addEventListener("focusin", show);
    }
    void items;
  }

  /* ---------------- Portraits audio ----------------
   * Un lecteur par Reflet, créé à la première ouverture du menu (panneau ou
   * feuille) en `preload="metadata"` : la durée s'affiche à côté de chaque
   * bouton avant même d'écouter, pour quelques kilo-octets. Les fichiers sont
   * ceux de la fiche produit (portraits.ts). Les lecteurs portent
   * data-listen-audio et vivent dans le DOM : LumaListen (fiche produit) met
   * les autres en pause, et réciproquement.
   */
  const listenButtons = document.querySelectorAll<HTMLButtonElement>("[data-menu-listen]");
  const players = new Map<string, HTMLAudioElement>();
  const fmt = (s: number) =>
    Number.isFinite(s) ? `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}` : "";
  let current = "";
  const currentPlayer = () => (current ? players.get(current) : undefined);
  const listening = () => {
    const a = currentPlayer();
    return Boolean(a) && !a!.paused && !a!.ended;
  };

  function player(handle: string, src: string): HTMLAudioElement {
    let a = players.get(handle);
    if (a) return a;
    a = document.createElement("audio");
    a.preload = "metadata";
    a.src = src;
    a.dataset.listenAudio = "";
    a.dataset.menuPlayer = handle;
    (panel ?? document.body).appendChild(a);
    players.set(handle, a);
    for (const ev of ["play", "pause", "ended", "timeupdate", "loadedmetadata"]) a.addEventListener(ev, renderListening);
    a.addEventListener("ended", () => {
      a!.currentTime = 0;
      renderListening();
    });
    return a;
  }
  let primed = false;
  function primeDurations() {
    if (primed) return;
    primed = true;
    for (const b of listenButtons) if (b.dataset.menuListen && b.dataset.src) player(b.dataset.menuListen, b.dataset.src);
  }

  function renderListening() {
    const playing = listening();
    for (const b of listenButtons) {
      const handle = b.dataset.menuListen ?? "";
      const mine = handle === current;
      b.classList.toggle("is-playing", mine && playing);
      b.setAttribute("aria-pressed", String(mine && playing));
    }
    for (const entry of document.querySelectorAll<HTMLElement>("[data-menu-entry]")) {
      const a = players.get(entry.dataset.menuEntry ?? "");
      entry.classList.toggle("is-listening", entry.dataset.menuEntry === current && Boolean(a) && (playing || a!.currentTime > 0));
    }
    for (const bar of document.querySelectorAll<HTMLElement>("[data-menu-progress]")) {
      const a = players.get(bar.dataset.menuProgress ?? "");
      const pct = a && a.duration ? (a.currentTime / a.duration) * 100 : 0;
      bar.style.width = bar.dataset.menuProgress === current ? `${pct}%` : "0%";
    }
    for (const time of document.querySelectorAll<HTMLElement>("[data-menu-time]")) {
      const handle = time.dataset.menuTime ?? "";
      const a = players.get(handle);
      if (!a || !a.duration) {
        time.textContent = "";
        continue;
      }
      const active = handle === current && (playing || a.currentTime > 0);
      time.textContent = active ? `${fmt(a.currentTime)} / ${fmt(a.duration)}` : fmt(a.duration);
    }
  }
  function stopListening() {
    const a = currentPlayer();
    if (!a) return;
    a.pause();
    a.currentTime = 0;
    current = "";
    renderListening();
  }
  for (const b of listenButtons) {
    b.addEventListener("click", (e) => {
      e.stopPropagation();
      e.preventDefault();
      const handle = b.dataset.menuListen ?? "";
      const src = b.dataset.src ?? "";
      if (!handle || !src) return;
      const a = player(handle, src);
      if (current === handle && !a.paused) {
        a.pause();
        return;
      }
      if (current !== handle) {
        const previous = currentPlayer();
        if (previous) {
          previous.pause();
          previous.currentTime = 0;
        }
        current = handle;
        // Le visuel suit la voix.
        for (const f of panel?.querySelectorAll<HTMLElement>("[data-menu-figure]") ?? []) f.classList.toggle("is-active", f.dataset.menuFigure === handle);
        for (const i of panel?.querySelectorAll<HTMLElement>("[data-menu-entry]") ?? []) i.classList.toggle("is-active", i.dataset.menuEntry === handle);
      }
      for (const other of document.querySelectorAll<HTMLAudioElement>("[data-listen-audio]")) if (other !== a) other.pause();
      a.play().catch(() => {});
      renderListening();
    });
  }

  /* ---------------- Mobile ---------------- */
  const sheet = document.querySelector<HTMLElement>("[data-menu-sheet]");
  const burger = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  let sheetOpen = false;

  function openSheet() {
    if (!sheet) return;
    sheetOpen = true;
    primeDurations();
    document.body.classList.add("menu-open");
    sheet.classList.add("is-open");
    sheet.setAttribute("aria-hidden", "false");
    burger?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    sheet.querySelector<HTMLElement>("[data-menu-close]")?.focus();
  }
  function closeSheet() {
    if (!sheet || !sheetOpen) return;
    stopListening();
    sheetOpen = false;
    document.body.classList.remove("menu-open");
    sheet.classList.remove("is-open");
    sheet.setAttribute("aria-hidden", "true");
    burger?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }
  burger?.addEventListener("click", () => (sheetOpen ? closeSheet() : openSheet()));
  sheet?.querySelector("[data-menu-close]")?.addEventListener("click", closeSheet);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && sheetOpen) {
      closeSheet();
      burger?.focus();
    }
  });
  // Luma et le sélecteur de pays ouvrent leur propre panneau : la feuille se
  // retire d'abord, sinon ils s'ouvriraient derrière elle.
  for (const b of sheet?.querySelectorAll("[data-luma-open], [data-region-open]") ?? []) {
    b.addEventListener("click", closeSheet);
  }
</script>

<style>
  /*
   * Le menu vit dans l'en-tête collant, dont le z-index (20) plafonne tout
   * ce qu'il contient : la pilule Luma (55, à la racine) passerait devant la
   * feuille et le pied du panneau. Plutôt que de sortir le menu de l'en-tête,
   * la pilule s'efface tant que le menu est ouvert (classe posée sur body).
   */
  :global(body.menu-open .luma-pill) { opacity: 0 !important; pointer-events: none !important; }

  /* ===== Panneau ordinateur ===== */
