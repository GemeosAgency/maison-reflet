---
/**
 * Le portrait audio d'un Reflet, sur sa fiche : « Découvrir Melting Mango »
 * (le verbe de Luma, sans mention de qui parle — la voix arabe est celle de
 * la Maison). Un fichier statique pré-généré (portraits.ts), donc zéro
 * crédit à l'écoute. Le dessin est celui de la pilule d'écoute du menu
 * (Sandro, 12 septembre 2026 : « le même design partout si ça passe ») : une
 * pilule cerclée, toute cliquable, la pastille ronde avec le glyphe, le
 * libellé, la durée à droite ; au survol et en lecture le contour s'affirme
 * et seule la pastille se remplit (l'onde y bat pendant la lecture). La
 * pilule est elle-même la timeline (Sandro, 13 septembre 2026, après une
 * première version en filet + point jugée « pas design ») : une teinte
 * légère la remplit au fil de la lecture, un clic ou un glissé n'importe où
 * dessus s'y déplace (et lance la lecture si elle était en pause), une ombre
 * suit le pointeur au survol, les flèches au clavier avancent et reculent de
 * cinq secondes. La pastille reste le bouton lecture-pause. Largeur bornée à
 * celle du menu (320 px). Plus de « Lire le portrait » : la description est
 * toujours juste au-dessus.
 */
import { useTranslations, type Locale } from "../i18n";
import { portraitAudioPath } from "../lib/luma/portraits";

interface Props {
  lang: Locale;
  /** Le Reflet dont on lit le portrait (source et texte déduits de portraits.ts)… */
  handle?: string;
  name?: string;
  /** …ou n'importe quel audio statique : la recommandation du parfumeur sur un accord, par exemple. */
  src?: string | null;
  label?: string;
}

const { lang, handle, name } = Astro.props;
const t = useTranslations(lang);
const src = Astro.props.src ?? (handle ? portraitAudioPath(lang, handle) : null);
const label = Astro.props.label ?? t("luma.discover").replace("{name}", name ?? "");
// Pour la tour de contrôle : un portrait (handle) ou la recommandation d'un accord (id du duo dans le chemin).
const trackKind = handle ? "portrait" : src?.includes("/accords/") ? "accord" : "audio";
const trackId = handle ?? src?.match(/\/accords\/([a-z0-9-]+)\.mp3/)?.[1] ?? null;
---

{
  src && (
    <div class="listen-wrap" data-luma-listen data-track-kind={trackKind} data-track-id={trackId}>
      <div class="listen" data-listen-pill>
        {/* Le remplissage de la lecture, et l'ombre qui suit le pointeur au survol. */}
        <span class="listen-fill" data-listen-fill aria-hidden="true"></span>
        <span class="listen-ghost" aria-hidden="true"></span>
        <button type="button" class="listen-icon" data-listen-toggle aria-pressed="false" aria-label={label}>
          <svg class="listen-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" fill="currentColor" /></svg>
          <svg class="listen-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1.5h2.5v9h-2.5zM7 1.5h2.5v9H7z" fill="currentColor" /></svg>
          <span class="listen-eq" aria-hidden="true"><i></i><i></i><i></i></span>
        </button>
        {/* Le corps de la pilule est le curseur : clic, glissé, flèches. */}
        <div class="listen-body" data-listen-seek role="slider" tabindex="0" aria-label={t("luma.seek")} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <span class="listen-label">{label}</span>
          <span class="listen-time" data-listen-time aria-hidden="true">–:––</span>
        </div>
      </div>
      <audio preload="metadata" src={src} data-listen-audio></audio>
    </div>
  )
}

<script>
  import { trackSite } from "../lib/site-events";
  const fmt = (s: number) => (Number.isFinite(s) ? `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}` : "–:––");
  const clamp = (n: number) => Math.min(1, Math.max(0, n));
  for (const root of document.querySelectorAll<HTMLElement>("[data-luma-listen]")) {
    const audio = root.querySelector<HTMLAudioElement>("[data-listen-audio]");
    const pill = root.querySelector<HTMLElement>("[data-listen-pill]");
    const btn = root.querySelector<HTMLButtonElement>("[data-listen-toggle]");
    const fill = root.querySelector<HTMLElement>("[data-listen-fill]");
    const time = root.querySelector<HTMLElement>("[data-listen-time]");
    const seek = root.querySelector<HTMLElement>("[data-listen-seek]");
    if (!audio || !pill || !btn || !fill || !time || !seek) continue;
    const render = () => {
      const playing = !audio.paused && !audio.ended;
      const started = audio.currentTime > 0;
      root.classList.toggle("is-playing", playing);
      root.classList.toggle("has-time", started);
      btn.setAttribute("aria-pressed", String(playing));
      const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      fill.style.width = `${pct}%`;
      seek.setAttribute("aria-valuenow", String(Math.round(pct)));
      seek.setAttribute("aria-valuetext", `${fmt(audio.currentTime)} / ${fmt(audio.duration)}`);
      time.textContent = playing || started ? fmt(audio.currentTime) : fmt(audio.duration);
    };
    const play = () => {
      // Un seul portrait à la fois sur la page.
      for (const other of document.querySelectorAll<HTMLAudioElement>("[data-listen-audio]")) if (other !== audio) other.pause();
      audio.dataset.userPlay = "1"; // jeton lu par la garde globale (Layout) : lecture voulue
      audio.play().catch(() => {});
    };
    const toggle = () => (audio.paused ? play() : audio.pause());
    btn.addEventListener("click", toggle);
    for (const ev of ["play", "pause", "ended", "timeupdate", "loadedmetadata", "seeked"]) audio.addEventListener(ev, render);
    // Tour de contrôle : une écoute par lecteur et par page, et « jusqu'au bout » à 90 %.
    let played = false;
    let completed = false;
    audio.addEventListener("play", () => {
      if (played) return;
      played = true;
      trackSite("audio_play", { kind: root.dataset.trackKind, id: root.dataset.trackId, source: "page" });
    });
    audio.addEventListener("timeupdate", () => {
      if (completed || !audio.duration || audio.currentTime / audio.duration < 0.9) return;
      completed = true;
      trackSite("audio_complete", { kind: root.dataset.trackKind, id: root.dataset.trackId });
    });

    /*
     * La pilule est la timeline : la position suit le pointeur sur toute sa
     * largeur (sens de l'écriture en arabe). Un clic ou un glissé se déplace ;
     * relâché sur une lecture en pause, il la lance d'ici. Les flèches au
     * clavier avancent et reculent, Entrée ou Espace font lecture-pause.
     */
    const ratioAt = (clientX: number) => {
      const r = pill.getBoundingClientRect();
      let ratio = clamp((clientX - r.left) / r.width);
      if (getComputedStyle(pill).direction === "rtl") ratio = 1 - ratio;
      return ratio;
    };
    const seekTo = (clientX: number) => {
      if (!audio.duration) return;
      audio.currentTime = ratioAt(clientX) * audio.duration;
      render();
    };
    let wasPaused = false;
    seek.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      wasPaused = audio.paused;
      root.classList.add("is-seeking");
      try {
        seek.setPointerCapture(e.pointerId);
      } catch {
        /* pointeur inconnu (événement synthétique) : le geste marche sans capture */
      }
      seekTo(e.clientX);
    });
    seek.addEventListener("pointermove", (e) => {
      if (root.classList.contains("is-seeking")) seekTo(e.clientX);
      else pill.style.setProperty("--ghost", `${ratioAt(e.clientX) * 100}%`);
    });
    pill.addEventListener("pointerleave", () => pill.style.setProperty("--ghost", "0%"));
    const endSeek = (e: PointerEvent) => {
      if (!root.classList.contains("is-seeking")) return;
      root.classList.remove("is-seeking");
      if (seek.hasPointerCapture(e.pointerId)) seek.releasePointerCapture(e.pointerId);
      pill.style.setProperty("--ghost", "0%");
      if (wasPaused && audio.paused) play();
    };
    seek.addEventListener("pointerup", endSeek);
    seek.addEventListener("pointercancel", endSeek);
    seek.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        toggle();
        return;
      }
      if (!audio.duration) return;
      const step = e.shiftKey ? 15 : 5;
      if (e.key === "ArrowRight" || e.key === "ArrowUp") audio.currentTime = Math.min(audio.duration, audio.currentTime + step);
      else if (e.key === "ArrowLeft" || e.key === "ArrowDown") audio.currentTime = Math.max(0, audio.currentTime - step);
      else if (e.key === "Home") audio.currentTime = 0;
      else if (e.key === "End") audio.currentTime = audio.duration;
      else return;
      e.preventDefault();
      render();
    });
  }
</script>

<style>
  .listen-wrap { margin-top: 14px; width: 100%; max-width: 320px; }
  /* La pilule du menu, qui est aussi la barre : le remplissage et l'ombre du survol vivent derrière le contenu. */
  .listen {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 14px;
    border: 1px solid rgba(21, 14, 10, 0.3);
    border-radius: 100px;
    color: var(--ink);
    font-size: 14px;
    line-height: 1;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.25s ease;
  }
  .listen:hover, .is-playing .listen { border-color: var(--ink); }
  .listen-fill, .listen-ghost { position: absolute; inset-block: 0; inset-inline-start: 0; z-index: -1; pointer-events: none; }
  .listen-fill { width: 0; background: rgba(21, 14, 10, 0.08); transition: width 0.25s linear; }
  .is-seeking .listen-fill { transition: none; }
  .listen-ghost { width: var(--ghost, 0%); background: rgba(21, 14, 10, 0.045); }
  .listen-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 1px solid rgba(21, 14, 10, 0.4);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }
  .listen-icon:focus { outline: none; }
  .listen-icon:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 2px; }
  /* Survol et lecture : seule la pastille se remplit — le plein noir sur toute la pilule faisait « cheap ». */
  .listen:hover .listen-icon, .is-playing .listen-icon { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .listen-body { flex: 1 1 auto; min-width: 0; display: flex; align-items: center; gap: 12px; align-self: stretch; touch-action: none; }
  .listen-body:focus { outline: none; }
  .listen-body:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 4px; border-radius: 100px; }
  .listen-label { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .listen-time { margin-inline-start: auto; flex-shrink: 0; font-size: 13px; opacity: 0.55; font-variant-numeric: tabular-nums; }
  .listen-pause, .listen-eq { display: none; }
  .is-playing .listen-play { display: none; }
  .is-playing .listen-icon .listen-eq { display: inline-flex; }
  .is-playing .listen:hover .listen-icon .listen-eq { display: none; }
  .is-playing .listen:hover .listen-pause { display: block; }
  .listen-eq { align-items: flex-end; gap: 2px; height: 10px; }
  .listen-eq i { display: block; width: 2px; height: 35%; border-radius: 1px; background: currentColor; animation: listen-eq 0.9s ease-in-out infinite; }
  .listen-eq i:nth-child(2) { animation-delay: -0.45s; }
  .listen-eq i:nth-child(3) { animation-delay: -0.2s; }
  @keyframes listen-eq {
    0%, 100% { height: 35%; }
    50% { height: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .listen, .listen-icon, .listen-fill { transition: none; }
    .listen-eq i { animation: none; height: 60%; }
  }
</style>
