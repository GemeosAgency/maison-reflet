---
/**
 * Luma, la conseillère de la Maison — le panneau de conversation.
 *
 * Géométrie (décision de Sandro, 11 septembre 2026, après le tiroir latéral
 * jugé trop étroit) : sur ordinateur, une modale de 720 px centrée et ancrée
 * en bas, qui monte depuis le bord inférieur et laisse la page visible
 * au-dessus ; sur mobile, une feuille qui glisse depuis le bas avec sa
 * poignée, presque plein écran. Même mécanique que les tiroirs du site :
 * voile, fermeture au voile / à la croix / par Échap, piège de focus. Monté
 * UNE FOIS par le layout ; les déclencheurs vivent dans le header, les fiches,
 * la page collection — et la pilule collée en bas de l'écran, d'où la modale
 * sort : « Luma · Trouver votre Reflet », en encre, sans icône ni « IA »
 * (Sandro, 11 septembre 2026, d'après la pilule de Kayali mais sans son nudge
 * commercial). Elle apparaît après un peu de défilement, se ferme pour la
 * session, s'efface quand Luma ou le panier sont ouverts, et jamais sur la
 * page panier. La ligne au-dessus est réservée aux initiatives (persona §9).
 *
 * Ce que le brief (§5) interdit, et qu'on ne fait donc pas : la bulle ronde en
 * bas à droite, les bulles de chat colorées. Ici : du texte, sans bulles — Luma
 * en italique du côté de la lecture, le visiteur de l'autre côté. Luma ne
 * s'ouvre jamais seule.
 *
 * Décisions de Sandro après le premier test en staging (11 septembre 2026),
 * qui priment sur le brief là où elles le contredisent :
 *  - chaque Reflet recommandé se montre par une fiche complète — visuel
 *    cliquable, nom, phrase, prix affiché, « Ajouter au panier » (sans ouvrir
 *    le tiroir : on reste avec Luma) et « Voir le produit » — et l'alternative
 *    a sa fiche aussi, pas un simple lien ;
 *  - Luma propose des réponses toutes faites à chaque message, un clic envoie ;
 *  - la conversation suit la session d'un bout à l'autre du site : le fil
 *    complet (fiches comprises) vit dans sessionStorage le temps de l'onglet,
 *    et un nouvel onglet sur la même session récupère le texte du serveur.
 *
 * Le serveur vérifie la réponse avant de l'envoyer ; c'est ici que se fait
 * l'effet de frappe (mot à mot, curseur discret, instantané si le visiteur
 * préfère moins d'animation, et instantané pour un fil rejoué).
 */
import { useTranslations, type Locale } from "../i18n";
import { CONTACT_EMAIL } from "../lib/luma/collection";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<script
  type="application/json"
  id="luma-i18n"
  is:inline
  set:html={JSON.stringify({
    thinking: t("luma.thinking"),
    unavailable: t("luma.unavailable").replace("{email}", CONTACT_EMAIL),
    writeTo: t("luma.writeTo"),
    emailLabel: t("luma.emailLabel"),
    emailConsent: t("luma.emailConsent"),
    emailSend: t("luma.send"),
    emailDone: t("luma.emailDone"),
    addToCart: t("luma.addToCart"),
    viewProduct: t("luma.viewProduct"),
    added: t("luma.added"),
    soldOut: t("luma.soldOut"),
    resume: t("luma.resume"),
    alternative: t("luma.alternative"),
    voiceOn: t("luma.voiceOn"),
    voiceOff: t("luma.voiceOff"),
    replay: t("luma.replay"),
    listen: t("luma.listen"),
    voicePaused: t("luma.voicePaused"),
    you: t("luma.you"),
    name: t("luma.name"),
    contact: CONTACT_EMAIL,
  })}
/>

<div class="luma-pill" data-luma-pill hidden>
  <button type="button" class="luma-pill-open" data-luma-open data-luma-source="pill">
    <span class="luma-pill-name">{t("luma.name")}</span>
    <span class="luma-pill-line" data-luma-pill-line>{t("luma.tagline")}</span>
  </button>
  <button type="button" class="luma-pill-close" data-luma-pill-close aria-label={t("luma.pillClose")}>
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
  </button>
</div>

<div class="luma" data-luma aria-hidden="true">
  <div class="luma-backdrop" data-luma-close></div>
  <aside class="luma-panel" role="dialog" aria-modal="true" aria-label={t("luma.open")}>
    <span class="luma-handle" aria-hidden="true"></span>
    <button type="button" class="luma-close" data-luma-close aria-label={t("luma.close")}>
      <img src="/brand/close.svg" alt="" width="16" height="16" />
    </button>
    <button type="button" class="luma-voice" data-luma-voice aria-pressed="false" title={t("luma.voice")}>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M2 6h3l4-3v10l-4-3H2z" fill="currentColor" />
        <path d="M11 5.5a3.5 3.5 0 0 1 0 5M12.6 3.4a6 6 0 0 1 0 9.2" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linecap="round" />
      </svg>
      <span data-luma-voice-label>{t("luma.voiceOn")}</span>
    </button>

    <header class="luma-head">
      <h2 class="luma-title">{t("luma.name")}</h2>
      <p class="luma-subtitle">{t("luma.subtitle")}</p>
    </header>

    <div class="luma-log" data-luma-log role="log" aria-live="polite" aria-relevant="additions">
      <div class="luma-msg luma-msg-luma" data-luma-opening>
        <p>{t("luma.opening")}</p>
        <div class="luma-chips">
          <button type="button" class="luma-chip" data-luma-say={t("luma.forMe")}>{t("luma.forMe")}</button>
          <button type="button" class="luma-chip" data-luma-say={t("luma.forGift")}>{t("luma.forGift")}</button>
        </div>
      </div>
    </div>

    <p class="luma-status" data-luma-status role="status" aria-live="polite"></p>

    <form class="luma-form" data-luma-form>
      <input
        type="text"
        class="luma-input"
        data-luma-input
        placeholder={t("luma.placeholder")}
        aria-label={t("luma.placeholder")}
        autocomplete="off"
        maxlength="1000"
        enterkeyhint="send"
      />
      <button type="submit" class="luma-send">{t("luma.send")}</button>
    </form>

    <p class="luma-privacy">{t("luma.privacy")}</p>
  </aside>
</div>

<script>
  import { addToCart, loadCart, type CartUpdatedEvent } from "../lib/cart";
  import type { ShopifyCart } from "../lib/shopify";

  type Card = {
    handle: string;
    name: string;
    kind: "parfum" | "coffret";
    url: string;
    image: string | null;
    price: string | null;
    available: boolean;
    variantId: string | null;
    /** Portrait audio statique du produit, s'il existe. */
    audio?: string | null;
  };
  type Action =
    | { type: "recommend_reflet"; reflet: Card; alternative: Card | null; reason: string }
    | { type: "show_product"; product: Card }
    | { type: "propose_email_capture"; pretext: string }
    | { type: "handoff_to_human"; email: string; reason: string }
    | { type: "suggest_replies"; replies: string[] };
  /** Le script parlé, encodé et signé par le serveur : la route de synthèse ne lit rien d'autre. */
  type Speech = { s: string; t: string; l: string };
  type Frame =
    | { type: "status"; state: string }
    | { type: "text"; text: string }
    | { type: "action"; action: Action }
    | { type: "speak"; s: string; t: string; l: string }
    | { type: "voice_paused" }
    | { type: "done"; sessionId: string | null; fallback: boolean; reason?: string };
  /** Une ligne du fil, telle qu'on la garde le temps de l'onglet. */
  type Entry =
    | { role: "visitor"; text: string }
    | { role: "luma"; text: string; actions: Action[]; emailDone?: boolean; speech?: Speech };
  type Transcript = { locale: string; entries: Entry[] };

  const TRANSCRIPT_KEY = "maison-reflet:luma";
  const TRANSCRIPT_MAX = 60;
  const TYPING_MS = 34;
  const PILL_KEY = "maison-reflet:luma-pill"; // « off » quand le visiteur l'a fermée pour la session
  const VOICE_KEY = "maison-reflet:luma-voice"; // « on » quand le visiteur écoute Luma
  // La voix du chat (une synthèse par réponse) est éteinte depuis le 11 septembre 2026 : les
  // portraits pré-générés couvrent l'écoute sans crédit. Remettre à true pour la rallumer —
  // le serveur (outil speak, route /api/luma/speak, budgets) est resté en place.
  const CHAT_VOICE_ENABLED = false;
  // Les phrases fixes de Luma sont pré-générées (scripts/luma-voice-static.mjs) : zéro crédit à l'usage.
  type StaticPhrase = "opening" | "unavailable" | "fallback" | "emailDone";
  const PILL_SCROLL_PX = 320;
  const PILL_DELAY_MS = 6000;

  const i18n: Record<string, string> = JSON.parse(document.getElementById("luma-i18n")?.textContent || "{}");

  const root = document.querySelector<HTMLElement>("[data-luma]");
  const panel = root?.querySelector<HTMLElement>(".luma-panel");
  const log = root?.querySelector<HTMLElement>("[data-luma-log]");
  const status = root?.querySelector<HTMLElement>("[data-luma-status]");
  const form = root?.querySelector<HTMLFormElement>("[data-luma-form]");
  const input = root?.querySelector<HTMLInputElement>("[data-luma-input]");
  const locale = document.documentElement.lang || "fr";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && panel && log && status && form && input) {
    /* ---------------- Mémoire du fil (le temps de l'onglet) ---------------- */

    function loadTranscript(): Entry[] {
      try {
        const parsed = JSON.parse(sessionStorage.getItem(TRANSCRIPT_KEY) ?? "null") as Transcript | null;
        return parsed && parsed.locale === locale && Array.isArray(parsed.entries) ? parsed.entries : [];
      } catch {
        return [];
      }
    }
    const transcript: Entry[] = loadTranscript();
    function saveTranscript() {
      try {
        const data: Transcript = { locale, entries: transcript.slice(-TRANSCRIPT_MAX) };
        sessionStorage.setItem(TRANSCRIPT_KEY, JSON.stringify(data));
      } catch {
        /* sans stockage, le fil ne survit pas au changement de page — la session serveur, si */
      }
    }
    /** Le déclencheur du header dit « Reprendre la conversation » dès qu'il y a un fil. */
    function markResumable() {
      for (const line of document.querySelectorAll<HTMLElement>(".luma-trigger-line, [data-luma-pill-line]")) line.textContent = i18n.resume;
    }
    function removeOpeningChips() {
      root!.querySelector("[data-luma-opening] .luma-chips")?.remove();
    }

    /* ---------------- Panier (pour le contexte de Luma) ---------------- */

    let cart: ShopifyCart | null = null;
    let cartRequested = false;
    document.addEventListener("cart:updated", (e) => {
      cart = (e as CartUpdatedEvent).detail.cart;
    });
    function cartContext() {
      const lines = cart?.lines.nodes ?? [];
      if (!lines.length) return undefined;
      return {
        lines: lines.map((l) => ({
          handle: l.merchandise.product.handle,
          title: l.merchandise.product.title,
          quantity: l.quantity,
        })),
      };
    }

    /* ---------------- Ouverture / fermeture ---------------- */

    let lastFocused: HTMLElement | null = null;

    function open() {
      lastFocused = document.activeElement as HTMLElement | null;
      root!.classList.add("is-open");
      root!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      input!.focus();
      void hydrate();
      scrollToEnd(true);
      pill.hide();
      if (!cartRequested) {
        cartRequested = true;
        loadCart()
          .then((c) => (cart = c))
          .catch(() => {});
      }
    }
    function close() {
      root!.classList.remove("is-open");
      root!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      lastFocused?.focus();
      pill.show();
    }
    /** Par où le visiteur est entré (header, fiche produit…) : voyage avec chaque tour, pour le suivi. */
    let entry = "header";
    for (const trigger of document.querySelectorAll<HTMLElement>("[data-luma-open]")) {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        entry = trigger.dataset.lumaSource ?? "header";
        open();
      });
    }
    // Une question posée depuis une fiche (LumaAsk) : on ouvre et on l'envoie.
    for (const ask of document.querySelectorAll<HTMLElement>("[data-luma-ask]")) {
      ask.addEventListener("click", () => {
        entry = ask.dataset.lumaSource ?? "product";
        open();
        void say(ask.dataset.lumaAsk ?? "");
      });
    }
    for (const el of root.querySelectorAll<HTMLElement>("[data-luma-close]")) el.addEventListener("click", close);

    /* ---------------- La pilule collée en bas ---------------- */

    const pill = (() => {
      const node = document.querySelector<HTMLElement>("[data-luma-pill]");
      let dismissed = false;
      try {
        dismissed = sessionStorage.getItem(PILL_KEY) === "off";
      } catch {
        /* sans stockage, la pilule revient à chaque page */
      }
      // Jamais sur la page panier : le visiteur est en train de conclure.
      const onCartPage = /^\/(fr|en|ar)?\/?panier/.test(location.pathname);
      let eligible = false; // vrai après un peu de défilement, ou un délai
      let cartOpen = false;
      const wanted = () => Boolean(node) && eligible && !dismissed && !cartOpen && !onCartPage && !root!.classList.contains("is-open");
      const render = () => {
        if (!node) return;
        if (wanted()) {
          node.hidden = false;
          // L'état peut changer avant l'image suivante (croix, ouverture) : on revérifie.
          requestAnimationFrame(() => wanted() && node.classList.add("is-visible"));
        } else {
          node.classList.remove("is-visible");
        }
      };
      const becomeEligible = () => {
        if (eligible) return;
        eligible = true;
        render();
      };
      if (node && !dismissed && !onCartPage) {
        window.addEventListener("scroll", () => scrollY > PILL_SCROLL_PX && becomeEligible(), { passive: true });
        setTimeout(becomeEligible, PILL_DELAY_MS);
        // Le tiroir panier n'émet rien à la fermeture : on regarde sa classe.
        const drawer = document.querySelector(".cart-drawer");
        if (drawer) {
          new MutationObserver(() => {
            cartOpen = drawer.classList.contains("is-open");
            render();
          }).observe(drawer, { attributes: true, attributeFilter: ["class"] });
        }
        node.querySelector("[data-luma-pill-close]")?.addEventListener("click", () => {
          dismissed = true;
          try {
            sessionStorage.setItem(PILL_KEY, "off");
          } catch {
            /* la fermeture ne vaut alors que pour cette page */
          }
          render();
        });
      }
      return { show: render, hide: () => node?.classList.remove("is-visible") };
    })();

    /* ---------------- La voix de Luma ---------------- */

    const voiceButton = root.querySelector<HTMLButtonElement>("[data-luma-voice]");
    const voiceLabel = root.querySelector<HTMLElement>("[data-luma-voice-label]");
    let voiceOn = false;
    try {
      voiceOn = CHAT_VOICE_ENABLED && sessionStorage.getItem(VOICE_KEY) === "on";
    } catch {
      /* la voix repart éteinte à chaque page */
    }
    if (voiceButton && !CHAT_VOICE_ENABLED) voiceButton.hidden = true;
    const audio = new Audio();
    audio.preload = "auto";
    const speechUrl = (sp: Speech) => `/api/luma/speak?s=${sp.s}&t=${sp.t}&l=${encodeURIComponent(sp.l)}`;
    function playSpeech(sp: Speech) {
      audio.src = speechUrl(sp);
      audio.play().catch(() => {
        /* lecture refusée (pas de geste, onglet caché) : le texte est là, et « Réécouter » aussi */
      });
    }
    /** Une phrase fixe, servie en fichier statique (absente pour une langue sans voix : silence). */
    function playStatic(key: StaticPhrase) {
      if (!voiceOn) return;
      audio.src = `/luma/voice/${locale}/${key}.mp3`;
      audio.play().catch(() => {});
    }
    let voicePausedShown = false;
    function renderVoice() {
      if (!voiceButton) return;
      voiceButton.setAttribute("aria-pressed", String(voiceOn));
      if (voiceLabel) voiceLabel.textContent = voiceOn ? i18n.voiceOff : i18n.voiceOn;
    }
    voiceButton?.addEventListener("click", () => {
      voiceOn = !voiceOn;
      try {
        sessionStorage.setItem(VOICE_KEY, voiceOn ? "on" : "off");
      } catch {
        /* sans stockage, le choix vaut pour cette page */
      }
      if (voiceOn) {
        // Le clic est un geste : la phrase d'ouverture déverrouille l'audio et fait entendre la voix tout de suite.
        playStatic("opening");
      } else {
        audio.pause();
      }
      renderVoice();
    });
    renderVoice();
    /** Sous un message de Luma qui a été dit : le réécouter, voix activée ou non (le clic est un geste). */
    function replayButton(sp: Speech): HTMLElement {
      const b = el("button", "luma-replay", i18n.replay) as HTMLButtonElement;
      b.type = "button";
      b.addEventListener("click", () => playSpeech(sp));
      return b;
    }

    // Échap ferme ; Tab reste dans le panneau tant qu'il est ouvert.
    document.addEventListener("keydown", (e) => {
      if (!root!.classList.contains("is-open")) return;
      if (e.key === "Escape") return close();
      if (e.key !== "Tab") return;
      const focusable = Array.from(
        panel!.querySelectorAll<HTMLElement>('button, a[href], input, [tabindex]:not([tabindex="-1"])')
      ).filter((el) => !el.hasAttribute("disabled") && el.offsetParent !== null);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    /* ---------------- Contexte de la page ---------------- */

    function pageContext() {
      const path = location.pathname.replace(/^\/(fr|en|ar)(?=\/|$)/, "");
      const product = path.match(/^\/(parfums|coffrets)\/([^/]+)/);
      let page: { type: string; handle?: string };
      if (product) page = { type: product[1] === "coffrets" ? "coffret" : "product", handle: product[2] };
      else if (path.startsWith("/parfums")) page = { type: "collection" };
      else if (path.startsWith("/panier")) page = { type: "cart" };
      else if (path.startsWith("/maison")) page = { type: "maison" };
      else page = { type: "home" };
      return { page, cart: cartContext(), entry };
    }

    /* ---------------- Rendu ---------------- */

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    };
    /**
     * Défilement façon messagerie : le fil suit ce qui arrive (mots, fiches,
     * réponses toutes faites) — sauf si le visiteur remonte lui-même pendant
     * que Luma écrit ; on le laisse lire, et on reprend dès qu'il revient en
     * bas. Un seuil de distance ne suffisait pas : une fiche entière arrivant
     * d'un coup dépassait le seuil et le fil restait bloqué au-dessus.
     * `force` pour les gestes du visiteur (son message, l'ouverture).
     */
    let follow = true;
    let placedAt = 0; // la position posée par le code, pour reconnaître un geste du visiteur
    const scrollToEnd = (force = false) => {
      if (force) follow = true;
      if (!follow) return;
      log!.scrollTop = log!.scrollHeight;
      placedAt = log!.scrollTop;
    };
    log.addEventListener("scroll", () => {
      if (log!.scrollTop < placedAt - 4) follow = false; // il a remonté
      if (log!.scrollHeight - log!.scrollTop - log!.clientHeight < 8) follow = true; // il est revenu en bas
    });

    function addVisitor(text: string) {
      const msg = el("div", "luma-msg luma-msg-visitor");
      const label = el("span", "luma-sr", i18n.you);
      msg.append(label, el("p", undefined, text));
      log!.append(msg);
      scrollToEnd(true);
    }

    /** « Luma est en train d'écrire » et trois points, dans le fil, comme une messagerie. */
    function showTyping(): HTMLElement {
      const node = el("div", "luma-msg luma-msg-luma luma-typing");
      node.setAttribute("aria-hidden", "true");
      const dots = el("span", "luma-dots");
      dots.append(el("i"), el("i"), el("i"));
      node.append(el("span", undefined, i18n.thinking), dots);
      log!.append(node);
      scrollToEnd();
      return node;
    }

    /**
     * Luma parle : mot à mot, avec un curseur, puis le curseur s'efface.
     * Instantané pour un fil rejoué, et pour un onglet caché. La cadence suit le
     * temps écoulé, pas le nombre de réveils : Chrome ralentit les timers d'un
     * onglet passé en arrière-plan (jusqu'à un par minute), et le texte doit
     * être là, complet, quand le visiteur revient — pas continuer à s'écrire.
     */
    /**
     * Le seul enrichissement que Luma peut employer : le nom d'un Reflet en gras
     * (« **Ultra Cuir** ») quand elle présente la collection. Rien d'autre n'est
     * interprété — des nœuds texte et des <strong>, jamais de HTML.
     */
    type Segment = { text: string; strong: boolean };
    function segments(paragraph: string): Segment[] {
      return paragraph
        .split(/(\*\*[^*]+\*\*)/)
        .filter(Boolean)
        .map((part) =>
          part.startsWith("**") && part.endsWith("**") ? { text: part.slice(2, -2), strong: true } : { text: part, strong: false }
        );
    }
    function appendSegments(p: HTMLElement, parts: Segment[]) {
      for (const part of parts) p.append(part.strong ? el("strong", undefined, part.text) : document.createTextNode(part.text));
    }

    async function addLuma(text: string, instant = reduceMotion): Promise<HTMLElement> {
      const msg = el("div", "luma-msg luma-msg-luma");
      log!.append(msg);
      const paragraphs = text.split(/\n+/).filter(Boolean);
      for (const paragraph of paragraphs) {
        const p = el("p");
        msg.append(p);
        const parts = segments(paragraph);
        if (instant || document.hidden) {
          appendSegments(p, parts);
          continue;
        }
        const cursor = el("span", "luma-cursor");
        p.append(cursor);
        // Un mot à la fois, gras compris : chaque segment est découpé en mots.
        const words: Segment[] = parts.flatMap((part) =>
          part.text.split(" ").map((w, i) => ({ text: (i ? " " : "") + w, strong: part.strong }))
        );
        const started = performance.now();
        let shown = 0;
        while (shown < words.length) {
          const due = document.hidden
            ? words.length
            : Math.min(words.length, Math.floor((performance.now() - started) / TYPING_MS) + 1);
          while (shown < due) {
            const w = words[shown];
            const previous = cursor.previousSibling;
            // Les mots d'un même nom en gras rejoignent le même <strong>.
            if (w.strong && previous instanceof HTMLElement && previous.tagName === "STRONG") previous.append(w.text);
            else cursor.before(w.strong ? el("strong", undefined, w.text) : document.createTextNode(w.text));
            shown++;
          }
          scrollToEnd();
          if (shown < words.length) await new Promise((r) => setTimeout(r, TYPING_MS));
        }
        cursor.remove();
      }
      scrollToEnd();
      return msg;
    }

    /** La fiche d'un Reflet : visuel, nom et prix, les deux gestes du site — pas de texte (Sandro). */
    function cardNode(card: Card): HTMLElement {
      const node = el("article", "luma-card");
      node.dataset.handle = card.handle;
      if (card.image) {
        // Le visuel mène au produit, comme partout sur le site.
        const media = el("a", "luma-card-media") as HTMLAnchorElement;
        media.href = card.url;
        media.setAttribute("aria-label", i18n.viewProduct);
        const img = el("img", "luma-card-img") as HTMLImageElement;
        img.src = card.image;
        img.alt = "";
        img.decoding = "async";
        media.append(img);
        node.append(media);
      }
      const body = el("div", "luma-card-body");
      const head = el("div", "luma-card-head");
      head.append(el("p", "luma-card-name", card.name));
      if (card.price) head.append(el("p", "luma-card-price", card.price));
      body.append(head);

      const actions = el("div", "luma-card-actions");
      if (card.available && card.variantId) {
        const add = el("button", "luma-card-add", i18n.addToCart) as HTMLButtonElement;
        add.type = "button";
        add.addEventListener("click", async () => {
          add.disabled = true;
          try {
            // Le tiroir panier ne surgit pas : le visiteur reste avec Luma, le
            // compteur du header suit (cart:updated), et Luma voit le panier au tour suivant.
            await addToCart(card.variantId!, 1, { openDrawer: false });
            add.textContent = i18n.added;
            add.classList.add("is-added");
          } catch {
            add.disabled = false;
          }
        });
        actions.append(add);
      } else if (!card.available) {
        actions.append(el("span", "luma-card-soldout", i18n.soldOut));
      }
      const link = el("a", "luma-card-link", i18n.viewProduct) as HTMLAnchorElement;
      link.href = card.url;
      link.setAttribute("aria-label", `${i18n.viewProduct} ${card.name}`);
      actions.append(link);
      if (card.audio) {
        // Le portrait du Reflet, pré-généré : gratuit, et le clic est un geste (lecture autorisée).
        const listen = el("button", "luma-card-listen", i18n.listen) as HTMLButtonElement;
        listen.type = "button";
        listen.setAttribute("aria-label", `${i18n.listen} — ${card.name}`);
        listen.addEventListener("click", () => {
          audio.src = card.audio!;
          audio.play().catch(() => {});
        });
        actions.append(listen);
      }
      // Les gestes restent à côté du visuel (choix de Sandro) ; la fiche prend
      // toute la largeur du panneau pour que le rang tienne sur une ligne.
      body.append(actions);
      node.append(body);
      return node;
    }

    function chipsNode(replies: string[]): HTMLElement {
      const chips = el("div", "luma-chips");
      for (const reply of replies) {
        const chip = el("button", "luma-chip", reply) as HTMLButtonElement;
        chip.type = "button";
        chip.addEventListener("click", () => void say(reply));
        chips.append(chip);
      }
      return chips;
    }

    function render(action: Action, into: HTMLElement, entry?: Entry) {
      switch (action.type) {
        case "recommend_reflet": {
          into.append(cardNode(action.reflet));
          // Deux parfums proposés, deux fiches (Sandro, 11 septembre 2026).
          if (action.alternative) {
            into.append(el("p", "luma-alt-label", i18n.alternative));
            into.append(cardNode(action.alternative));
          }
          break;
        }
        case "show_product":
          // Déjà montré par la recommandation : ne pas doubler la carte.
          if (!into.querySelector(`.luma-card[data-handle="${action.product.handle}"]`)) into.append(cardNode(action.product));
          break;
        case "handoff_to_human": {
          const p = el("p", "luma-handoff");
          const link = el("a", undefined, i18n.writeTo) as HTMLAnchorElement;
          link.href = `mailto:${action.email}?subject=${encodeURIComponent("Maison Reflet — " + action.reason)}`;
          p.append(link);
          into.append(p);
          break;
        }
        case "propose_email_capture":
          if (entry && entry.role === "luma" && entry.emailDone) into.append(el("p", "luma-email-done", i18n.emailDone));
          else into.append(emailForm(entry));
          break;
        case "suggest_replies":
          // Toujours en dernier dans le message : sous la fiche, sous le formulaire.
          into.append(chipsNode(action.replies));
          break;
      }
      scrollToEnd();
    }

    /** Le champ email n'apparaît que quand Luma le propose ; consentement à part, décoché. */
    function emailForm(entry?: Entry): HTMLElement {
      const f = el("form", "luma-email") as HTMLFormElement;
      const mail = el("input", "luma-input") as HTMLInputElement;
      mail.type = "email";
      mail.required = true;
      mail.placeholder = i18n.emailLabel;
      mail.setAttribute("aria-label", i18n.emailLabel);
      mail.autocomplete = "email";
      const consentLabel = el("label", "luma-consent");
      const consent = el("input") as HTMLInputElement;
      consent.type = "checkbox";
      consentLabel.append(consent, el("span", undefined, i18n.emailConsent));
      const send = el("button", "luma-send", i18n.emailSend) as HTMLButtonElement;
      send.type = "submit";
      const row = el("div", "luma-email-row");
      row.append(mail, send);
      f.append(row, consentLabel);
      f.addEventListener("submit", async (e) => {
        e.preventDefault();
        send.disabled = true;
        try {
          const res = await fetch("/api/luma/profile", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ email: mail.value, consent: consent.checked, locale }),
          });
          if (!res.ok) throw new Error(String(res.status));
          f.replaceWith(el("p", "luma-email-done", i18n.emailDone));
          playStatic("emailDone");
          if (entry && entry.role === "luma") {
            entry.emailDone = true;
            saveTranscript();
          }
        } catch {
          send.disabled = false;
        }
      });
      return f;
    }

    /* ---------------- Reprise du fil ---------------- */

    function replay(entry: Entry, last: boolean) {
      if (entry.role === "visitor") return addVisitor(entry.text);
      void addLuma(entry.text, true).then((msg) => {
        if (entry.speech) msg.append(replayButton(entry.speech));
        for (const action of entry.actions) {
          // Les réponses toutes faites d'un tour passé n'ont plus de sens.
          if (action.type === "suggest_replies" && !last) continue;
          render(action, msg, entry);
        }
      });
    }

    async function fetchHistory(): Promise<{ role: string; content: string }[]> {
      const res = await fetch(`/api/luma/history?locale=${encodeURIComponent(locale)}`, { credentials: "same-origin" });
      if (!res.ok) return [];
      const data = (await res.json()) as { messages?: { role: string; content: string }[] };
      return (data.messages ?? []).filter((m) => m.content);
    }

    /**
     * Le visiteur a quitté la page pendant que Luma répondait : le fil s'arrête
     * sur sa question, mais le serveur a la réponse. On la rejoue (texte seul).
     */
    async function recoverLastReply() {
      const asked = transcript[transcript.length - 1];
      if (!asked || asked.role !== "visitor") return;
      try {
        const messages = await fetchHistory();
        const last = messages[messages.length - 1];
        const before = messages[messages.length - 2];
        if (last?.role === "assistant" && before?.role === "user" && before.content === asked.text) {
          const entry: Entry = { role: "luma", text: last.content, actions: [] };
          transcript.push(entry);
          saveTranscript();
          replay(entry, true);
        }
      } catch {
        /* la réponse n'est pas perdue : le modèle l'a en mémoire pour le tour suivant */
      }
    }

    let hydrated = false;
    async function hydrate() {
      if (hydrated) return;
      hydrated = true;
      if (transcript.length) {
        removeOpeningChips();
        transcript.forEach((entry, i) => replay(entry, i === transcript.length - 1));
        await recoverLastReply();
        return;
      }
      // Nouvel onglet, même session (cookie) : le texte revient du serveur, sans fiches.
      try {
        const messages = await fetchHistory();
        if (!messages.length) return;
        removeOpeningChips();
        for (const m of messages) {
          const entry: Entry =
            m.role === "user" ? { role: "visitor", text: m.content } : { role: "luma", text: m.content, actions: [] };
          transcript.push(entry);
          replay(entry, false);
        }
        saveTranscript();
        markResumable();
      } catch {
        /* pas d'historique : la conversation commence ici */
      }
    }

    // Un fil existe déjà dans cet onglet : le header le dit, et le panneau est prêt avant d'être ouvert.
    if (transcript.length) {
      markResumable();
      void hydrate();
    }

    /* ---------------- Un tour ---------------- */

    let busy = false;

    async function say(text: string) {
      const message = text.trim();
      if (!message || busy) return;
      busy = true;
      input!.value = "";
      input!.disabled = true;
      // Les réponses toutes faites appartiennent au tour qui les a proposées.
      for (const chips of log!.querySelectorAll(".luma-chips")) chips.remove();
      addVisitor(message);
      transcript.push({ role: "visitor", text: message });
      saveTranscript();
      markResumable();
      status!.textContent = i18n.thinking;
      const typing = showTyping();

      let lumaMsg: HTMLElement | null = null;
      let lumaText = "";
      let speech: Speech | undefined;
      let voicePaused = false;
      let fallbackReply = false;
      const pending: Action[] = [];
      try {
        const res = await fetch("/api/luma/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ message, locale, context: pageContext(), voice: voiceOn }),
        });
        if (!res.ok || !res.body) throw new Error(String(res.status));

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = "";
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          let cut: number;
          while ((cut = buffer.indexOf("\n\n")) >= 0) {
            const frame = buffer.slice(0, cut).trim();
            buffer = buffer.slice(cut + 2);
            if (!frame.startsWith("data:")) continue;
            const event = JSON.parse(frame.slice(5)) as Frame;
            if (event.type === "text") {
              status!.textContent = "";
              typing.remove();
              lumaText = event.text;
              lumaMsg = await addLuma(event.text);
            } else if (event.type === "action") {
              pending.push(event.action);
            } else if (event.type === "speak") {
              // La voix part tout de suite, pendant que le texte s'écrit.
              speech = { s: event.s, t: event.t, l: event.l };
              if (voiceOn) playSpeech(speech);
            } else if (event.type === "voice_paused") {
              voicePaused = true;
            } else if (event.type === "done") {
              fallbackReply = event.fallback;
            }
          }
        }
        if (!lumaMsg) {
          lumaText = i18n.unavailable;
          lumaMsg = await addLuma(lumaText);
        }
        const entry: Entry = { role: "luma", text: lumaText, actions: pending, speech };
        transcript.push(entry);
        saveTranscript();
        if (speech) lumaMsg.append(replayButton(speech));
        // Une réponse de secours n'a pas de script : sa phrase fixe est pré-générée.
        if (fallbackReply && !speech) playStatic(lumaText === i18n.unavailable ? "unavailable" : "fallback");
        if (voicePaused && voiceOn && !voicePausedShown) {
          voicePausedShown = true;
          lumaMsg.append(el("p", "luma-note", i18n.voicePaused));
        }
        for (const action of pending) render(action, lumaMsg, entry);
      } catch {
        status!.textContent = "";
        typing.remove();
        playStatic("unavailable");
        await addLuma(i18n.unavailable);
        transcript.push({ role: "luma", text: i18n.unavailable, actions: [] });
        saveTranscript();
      } finally {
        status!.textContent = "";
        typing.remove();
        busy = false;
        input!.disabled = false;
        input!.focus();
      }
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      void say(input!.value);
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        void say(input!.value);
      }
    });
    for (const chip of root.querySelectorAll<HTMLElement>("[data-luma-say]")) {
      chip.addEventListener("click", () => void say(chip.dataset.lumaSay ?? ""));
    }
  }
</script>

{/*
  `is:global` et non scopé : la conversation est construite par le script
  (document.createElement), et ces nœuds ne portent pas l'attribut de scope
  d'Astro — une feuille scopée ne les atteindrait pas. Toutes les classes sont
  préfixées `luma-`, il n'y a rien à protéger.
*/}
<style is:global>
  /* La pilule : encre, centrée en bas, d'où la modale sort. */
  .luma-pill {
    position: fixed;
    left: 50%;
    bottom: 20px;
    z-index: 55;
    display: flex;
    align-items: center;
    background: var(--ink);
    color: var(--bg);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translate(-50%, 12px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    pointer-events: none;
  }
  .luma-pill.is-visible { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .luma-pill-open {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 13px 6px 13px 20px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .luma-pill-name { font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
  .luma-pill-line { font-size: 14px; opacity: 0.8; }
  .luma-pill-close {
    padding: 13px 14px 13px 8px;
    border: 0;
    background: transparent;
    color: inherit;
    line-height: 0;
    opacity: 0.7;
    cursor: pointer;
  }
  .luma-pill-close:hover { opacity: 1; }

  .luma { position: fixed; inset: 0; z-index: 60; pointer-events: none; }
  .luma-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(31, 31, 31, 0.44);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .luma.is-open { pointer-events: auto; }
  .luma.is-open .luma-backdrop { opacity: 1; }

  /* Ordinateur : 720 px centrés, ancrés en bas, qui montent depuis le bord.
     La hauteur suit la conversation jusqu'à un plafond, puis le fil défile. */
  .luma-panel {
    position: fixed;
    left: 50%;
    bottom: 8px;
    width: min(720px, calc(100vw - 16px));
    min-height: 420px;
    max-height: min(78vh, 840px);
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px 36px 20px;
    background: var(--bg);
    border-radius: 8px;
    box-shadow: 0 -4px 40px rgba(0, 0, 0, 0.1);
    transform: translate(-50%, calc(100% + 8px));
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .luma.is-open .luma-panel { transform: translate(-50%, 0); }
  .luma-handle { display: none; }

  .luma-close {
    position: absolute;
    top: 16px;
    inset-inline-end: 16px;
    border: 0;
    background: transparent;
    padding: 4px;
    line-height: 0;
    cursor: pointer;
  }

  /* Le bouton voix, à gauche de la croix : opt-in, encre quand il est actif. */
  .luma-voice {
    position: absolute;
    top: 13px;
    inset-inline-end: 52px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid rgba(21, 14, 10, 0.16);
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 13px;
    color: inherit;
    cursor: pointer;
  }
  .luma-voice:hover { background: var(--paper); }
  .luma-voice[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .luma-replay {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    font-style: normal;
    color: inherit;
    opacity: 0.6;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .luma-replay:hover { opacity: 1; }
  .luma-note { font-size: 13px; font-style: normal; opacity: 0.6; }

  .luma-head { display: flex; flex-direction: column; gap: 4px; }
  .luma-title { margin: 0; font-size: 24px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .luma-subtitle { margin: 0; font-size: 14px; opacity: 0.7; }

  /* La conversation est la seule zone qui défile ; l'entête et le champ restent en place. */
  .luma-log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 4px 0;
    margin: 0 -8px;
    padding-inline: 8px;
  }

  /* Du texte, pas de bulles : Luma du côté de la lecture, en italique ; le visiteur de l'autre côté. */
  .luma-msg { display: flex; flex-direction: column; gap: 12px; max-width: 92%; }
  .luma-msg p { margin: 0; font-size: 16px; line-height: 1.5; }
  .luma-msg-luma strong { font-weight: 500; font-style: normal; }
  .luma-msg-luma { align-self: flex-start; font-style: italic; }
  .luma-msg-visitor { align-self: flex-end; text-align: end; opacity: 0.85; }
  .luma-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .luma-cursor {
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-inline-start: 2px;
    background: currentColor;
    vertical-align: -0.15em;
    animation: luma-blink 1s steps(2) infinite;
  }
  @keyframes luma-blink { to { opacity: 0; } }

  /* Les réponses toutes faites : un clic envoie. */
  .luma-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .luma-chip {
    padding: 8px 14px;
    border: 1px solid rgba(21, 14, 10, 0.16);
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-style: normal;
    font-size: 14px;
    color: inherit;
    cursor: pointer;
    text-align: start;
  }
  .luma-chip:hover { background: var(--paper); }

  /* La fiche d'un Reflet : visuel sur fond neutre, nom et prix, la phrase, les deux gestes du site. */
  /* Un message qui porte une fiche s'affranchit du retrait des messages texte : la fiche a toute la largeur. */
  .luma-msg-luma:has(.luma-card) { max-width: 100%; }
  .luma-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px;
    background: var(--paper);
    border-radius: 8px;
    font-style: normal;
  }
  .luma-card-media { flex: none; line-height: 0; }
  .luma-card-img { width: 96px; height: 96px; object-fit: cover; background: var(--sand); border-radius: 4px; }
  .luma-card-body { display: flex; flex-direction: column; gap: 10px; min-width: 0; flex: 1; }
  .luma-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .luma-card-name { font-size: 15px; font-weight: 500; text-transform: uppercase; }
  .luma-card-price { font-size: 14px; opacity: 0.75; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .luma-card-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 2px; }
  /* Le CTA panier du site : pilule rose, blanc, capitales (BoxCard, tiroir panier). */
  .luma-card-add {
    padding: 0 14px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: var(--rose);
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .luma-card-add:hover { opacity: 0.85; }
  .luma-card-add:disabled { cursor: default; }
  .luma-card-add.is-added { opacity: 0.6; }
  .luma-card-soldout { font-size: 13px; opacity: 0.6; }
  .luma-card-link,
  .luma-card-listen {
    font-size: 14px;
    font-weight: 500;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .luma-card-listen { padding: 0; border: 0; background: none; font: inherit; font-size: 14px; font-weight: 500; cursor: pointer; }

  .luma-alt-label { font-size: 12px; font-style: normal; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.6; }
  .luma-handoff a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .luma-handoff { font-style: normal; }

  .luma-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); margin: 0; }

  /* L'indicateur de frappe : le texte et trois points qui respirent. */
  .luma-typing { flex-direction: row; align-items: center; gap: 8px; font-size: 14px; opacity: 0.6; }
  .luma-dots { display: inline-flex; gap: 3px; align-items: center; }
  .luma-dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    animation: luma-bounce 1.2s ease-in-out infinite;
  }
  .luma-dots i:nth-child(2) { animation-delay: 0.15s; }
  .luma-dots i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes luma-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-3px); opacity: 1; }
  }

  .luma-form, .luma-email-row { display: flex; gap: 8px; }
  .luma-email { display: flex; flex-direction: column; gap: 10px; font-style: normal; }
  .luma-input {
    flex: 1;
    min-width: 0;
    padding: 12px 14px;
    border: 1px solid rgba(21, 14, 10, 0.16);
    border-radius: 4px;
    background: var(--paper);
    font: inherit;
    font-size: 15px;
    color: inherit;
  }
  .luma-input::placeholder { opacity: 0.5; }
  .luma-input:disabled { opacity: 0.6; }
  /* Le focus dans la charte, jamais le bleu du navigateur — visible au clavier, en encre. */
  .luma-input:focus { outline: none; border-color: var(--ink); }
  .luma-chip:focus-visible,
  .luma-send:focus-visible,
  .luma-close:focus-visible,
  .luma-card-add:focus-visible,
  .luma-card-link:focus-visible,
  .luma-card-media:focus-visible,
  .luma-alt-label:focus-visible,
  .luma-consent input:focus-visible,
  .luma-handoff a:focus-visible {
    outline: 1.5px solid var(--ink);
    outline-offset: 2px;
