---
/**
 * Carte produit pleine image, texte en surimpression en bas, bouton
 * « Add to bag » révélé au survol.
 *
 * Réutilisée par le catalogue (maquette « Produits », node 11003:9970) et la
 * home (Bestsellers). Le clic sur le bouton est câblé globalement par
 * initAddToCartButtons() (voir src/lib/cart.ts), rien à faire ici.
 *
 * Deux états, deux voiles, et deux couleurs de texte :
 *
 * - AU REPOS, `-veil` (permanent) reprend la maquette : transparent jusqu'à
 *   74 % de la hauteur puis --bg à 56 %. C'est lui qui rend l'encre lisible
 *   sur la photo. Sans lui, le nom et le prix passent sur le flacon.
 * - AU SURVOL, la carte bascule sur la SECONDE photo, `-overlay` assombrit
 *   toute la tuile et le texte passe en clair. Le prix quitte sa ligne pour
 *   rejoindre le CTA « ADD TO BAG », un rectangle pâle pleine largeur.
 *
 * Sans seconde photo dans Sanity (imageRecommandationHover), le survol garde
 * la même image : l'assombrissement et le CTA fonctionnent quand même.
 */
import { preventeCard } from "../lib/prevente-cards";
import { priceA11y } from "../lib/price-a11y";

interface Props {
  name: string;
  inspired?: string | null;
  inspiredByLabel: string;
  price: string;
  /** Prix normal barré (prévente), déjà formaté, ou null. */
  compare?: string | null;
  img: string | null;
  hoverImg?: string | null;
  href: string;
  variantId: string;
  /** Pastille d'angle, ex. « BEST SELLER ». Masquée si absente. */
  badge?: string | null;
  /** Libellés du bouton d'ajout (traduits par la page appelante). */
  addLabel?: string;
  addedLabel?: string;
  errorLabel?: string;
}

const {
  name,
  inspired,
  inspiredByLabel,
  price,
  compare = null,
  img,
  hoverImg,
  href,
  variantId,
  badge: badgeProp = null,
  addLabel = "Add to cart",
  addedLabel = "",
  errorLabel = "",
} = Astro.props;
import { withName } from "../i18n";

// Prévente ouverte : « PRÉCOMMANDE » en jaune remplace la pastille, et
// « Prix de lancement » coiffe le prix barré.
const prevente = await preventeCard(Astro.params.lang, Boolean(compare));
const a11y = priceA11y(Astro.params.lang);
const badge = prevente?.badge ?? badgeProp;
---

<div class="product-card">
  <a class="product-card-link" href={href} aria-label={name}></a>
  {img && <img class="product-card-img product-card-img-base" src={img} alt={name} loading="lazy" />}
  {hoverImg && <img class="product-card-img product-card-img-hover" src={hoverImg} alt="" loading="lazy" />}
  <div class="product-card-veil" aria-hidden="true"></div>
  <div class="product-card-overlay" aria-hidden="true"></div>
  {badge && <span class:list={["product-card-badge", { "is-prevente": prevente }]}>{badge}</span>}
  <div class="product-card-meta">
    <h3 translate="no">{name}</h3>
    <div class="product-card-row">
      {inspired ? <p class="product-card-inspired">{withName(inspiredByLabel, inspired)}</p> : <span></span>}
      <p class="product-card-price" translate="no">
        {/* L'étiquette visible est redite, à sa place, par le texte masqué devant le prix (lib/price-a11y.ts). */}
        {prevente?.launchLabel && <span class="product-card-launch" aria-hidden={compare ? "true" : undefined}>{prevente.launchLabel}</span>}
        <s class="price-was" data-money-compare={variantId} hidden={!compare}><span class="sr-only">{a11y.was}</span><span data-money-amount>{compare}</span></s>
        <span class="sr-only sr-launch">{a11y.now}</span><span data-money={variantId}>{price}</span>
      </p>
    </div>
    <div class="product-card-add-wrap">
      <button
        type="button"
        class="product-card-add"
        data-add-to-cart
        data-variant-id={variantId}
        data-added-label={addedLabel}
        data-error-label={errorLabel}
      >
        <span data-reco-add-label>{addLabel}</span>
        <span class="product-card-add-prices" translate="no">
          <s data-money-compare={variantId} hidden={!compare} aria-hidden="true">{compare}</s>
          <span data-money={variantId}>{price}</span>
        </span>
      </button>
    </div>
  </div>
</div>

<style>
  .product-card {
    flex: 1 0 0;
    min-width: 0;
    height: 100%;
    position: relative;
    overflow: hidden;
  }
  .product-card-link { position: absolute; inset: 0; z-index: 1; }
  .product-card-img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    /* La maquette ancre la photo en haut et laisse déborder 8,7 % en bas. On
       garde `bottom` : le débordement rognerait le pied du flacon, alors
       qu'en haut il n'y a que du fond — et cette zone est sous le voile. */
    object-position: bottom;
    pointer-events: none; transition: opacity 0.6s ease;
  }
  .product-card-img-hover { opacity: 0; }
  .product-card:hover .product-card-img-base { opacity: 0; }
  .product-card:hover .product-card-img-hover { opacity: 1; }

  /* Voile de lisibilité, valeurs de la maquette. */
  .product-card-veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(241, 238, 233, 0) 74%, rgba(241, 238, 233, 0.56) 100%);
    transition: opacity 0.4s ease;
  }
  /* Survol : le bas de la tuile s'assombrit pour porter le texte clair et le
     CTA. Les deux tiers du haut restent intacts — c'est la photo qu'on est venu
     voir, et un voile même léger sur toute la hauteur la ternit sans rien
     rendre plus lisible (Sandro, 24 sept.). Le dégradé part donc de rien à 62 %
     et descend jusqu'au pied, où il faut le plus de contraste. */
  .product-card-overlay {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(21, 14, 10, 0) 62%,
      rgba(21, 14, 10, 0.34) 80%,
      rgba(21, 14, 10, 0.68) 100%
    );
    opacity: 0; transition: opacity 0.5s ease;
  }
  .product-card:hover .product-card-overlay { opacity: 1; }
  /* Le voile clair du repos s'efface, sinon il éclaircit le bas de la tuile
     assombrie et le CTA perd son contraste. */
  .product-card:hover .product-card-veil { opacity: 0; }

  .product-card-badge {
    position: absolute; top: 0; inset-inline-start: 0; z-index: 2;
    padding: 11px 12px;
    background: var(--peach); color: var(--rose);
    font-size: 14px; font-weight: 500; text-transform: uppercase; line-height: 1;
  }
  .product-card-badge.is-prevente { background: var(--prevente); color: var(--ink); }

  .product-card-meta {
    position: absolute; inset-inline: 24px; bottom: 24px; z-index: 2; pointer-events: none;
    color: var(--ink);
    transition: color 0.35s ease;
  }
  .product-card:hover .product-card-meta { color: var(--paper); }
  .product-card-meta h3 { margin: 0; font-size: 18px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  /* « Specific Twist of X » à gauche, prix à droite, sur une même ligne. */
  .product-card-row {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    margin-top: 4px; letter-spacing: 0.96px;
  }
  .product-card-inspired { margin: 0; font-size: 16px; line-height: 1.5; }
  .product-card-price {
    margin: 0; font-size: 16px; line-height: 1.5; text-align: end; white-space: nowrap;
    transition: opacity 0.25s ease;
  }
  .product-card:hover .product-card-price { opacity: 0; }
  .product-card-launch {
    display: block;
    font-size: 11px; line-height: 16px; font-weight: 500; letter-spacing: 0.88px;
    text-transform: uppercase; color: var(--rose);
  }
  .product-card:hover .product-card-launch { opacity: 0; }
  .price-was { margin-inline-end: 8px; opacity: 0.6; text-decoration-thickness: 1px; }
  .price-was[hidden] { display: none; }
  .product-card-add-wrap {
    max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, margin-top 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .product-card:hover .product-card-add-wrap { max-height: 56px; opacity: 1; margin-top: 16px; }
  /* Rectangle pâle sur fond assombri, pas une pastille colorée — maquette du
     survol catalogue : libellé à gauche, prix à droite. */
  .product-card-add {
    pointer-events: auto; width: 100%; height: 56px; border: 0;
    background: var(--bg); color: var(--ink);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 24px; font: inherit; font-size: 16px; font-weight: 500; text-transform: uppercase;
    cursor: pointer; transition: background-color 0.15s;
  }
  .product-card-add:hover { background: var(--paper); }
  .product-card-add-prices { display: inline-flex; align-items: baseline; gap: 12px; white-space: nowrap; }
  .product-card-add-prices s { margin: 0; font-weight: 400; opacity: 0.62; }
  .product-card-add:disabled { opacity: 0.6; }

  @media (max-width: 900px) {
    .product-card { flex: 1 1 45%; min-height: 320px; }
    .product-card-meta { inset-inline: 16px; bottom: 16px; }
    .product-card-row { flex-direction: column; gap: 2px; }
    .product-card-price { text-align: start; }
  }

  /*
   * Carte étroite (deux colonnes sur téléphone, ~190 px) : les tailles de la
   * maquette (18/16) y faisaient passer le twist sur deux lignes et le bloc
   * entier montait sur le flacon (Sandro, 31 oct.). On mesure la carte et non
   * l'écran : le catalogue, une carte par ligne au même écran, garde ses tailles.
   */
  .product-card { container-type: inline-size; }
  @container (max-width: 300px) {
    .product-card-badge { padding: 7px 8px; font-size: 11px; }
    .product-card-meta { inset-inline: 12px; bottom: 12px; }
    .product-card-meta h3 { font-size: 15px; }
    .product-card-row { margin-top: 2px; letter-spacing: 0.3px; }
    .product-card-inspired { font-size: 13px; line-height: 1.35; }
    .product-card-price { font-size: 14px; line-height: 1.35; }
    .product-card-launch { margin-top: 4px; font-size: 10px; line-height: 14px; letter-spacing: 0.6px; }
    .price-was { margin-inline-end: 5px; }
  }
  /* Le texte occupe alors le bas du flacon : le voile clair monte plus haut et
     se fait plus dense, sinon l'encre se lit sur le verre. */
  @container (max-width: 300px) {
    .product-card-veil {
      background: linear-gradient(
        to bottom,
        rgba(241, 238, 233, 0) 52%,
        rgba(241, 238, 233, 0.7) 76%,
        rgba(241, 238, 233, 0.86) 100%
      );
    }
  }

  /* Pas de survol au doigt. iOS garde un :hover après un tap : la carte
     restait à moitié dans l'état survolé, CTA tronqué compris. Au doigt, la
     carte reste la photo, et le tap mène à la fiche. */
  @media (hover: none) {
    .product-card-add-wrap { display: none; }
    .product-card:hover .product-card-img-base { opacity: 1; }
    .product-card:hover .product-card-img-hover { opacity: 0; }
    .product-card:hover .product-card-overlay { opacity: 0; }
    .product-card:hover .product-card-veil { opacity: 1; }
    .product-card:hover .product-card-meta { color: var(--ink); }
    .product-card:hover .product-card-price,
    .product-card:hover .product-card-launch { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card-img,
    .product-card-overlay,
    .product-card-veil,
    .product-card-meta,
    .product-card-price,
    .product-card-add-wrap { transition: none; }
  }
</style>
