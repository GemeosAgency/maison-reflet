---
/**
 * Les filtres du business (produit, pays, source, langue, commandes de test) :
 * un formulaire GET, chaque changement recharge la page avec l'URL qui va
 * bien — partageable, et la période reste. Les options viennent de ce qui
 * existe vraiment sur la période (facettes), pas d'une liste en dur.
 */
import type { Filters, Product } from "../../lib/admin/business";
import { countryName } from "../../lib/admin/geo";
import { LOCALE_LABEL, type Range } from "../../lib/admin/data";
import { flagOf } from "../../lib/admin/business";

interface Props {
  filters: Filters;
  facets: { countries: string[]; sources: string[]; products: Product[] };
  range: Range;
}
const { filters, facets, range } = Astro.props;
const active = [filters.reflet, filters.country, filters.source, filters.locale].filter(Boolean).length;
const clearHref = `${Astro.url.pathname}?${range.query}${filters.test ? "&test=1" : ""}`;
const rangeParams = new URLSearchParams(range.query);
---

<form class="adm-filters" method="get" slot="filters" data-filter-bar>
  {[...rangeParams.entries()].map(([k, v]) => <input type="hidden" name={k} value={v} />)}
  <span class="adm-filters-label">Filtrer</span>
  <select name="reflet" aria-label="Produit" class:list={{ "is-set": Boolean(filters.reflet) }}>
    <option value="">Tous les produits</option>
    <optgroup label="Les Reflets">{facets.products.filter((p) => p.kind === "reflet").map((r) => <option value={r.handle} selected={filters.reflet === r.handle}>{r.name}</option>)}</optgroup>
    {facets.products.some((p) => p.kind === "coffret") && <optgroup label="Les coffrets">{facets.products.filter((p) => p.kind === "coffret").map((r) => <option value={r.handle} selected={filters.reflet === r.handle}>{r.name}</option>)}</optgroup>}
  </select>
  <select name="country" aria-label="Pays" class:list={{ "is-set": Boolean(filters.country) }}>
    <option value="">Tous les pays</option>
    {facets.countries.map((c) => <option value={c} selected={filters.country === c}>{flagOf(c)} {countryName(c)}</option>)}
  </select>
  <select name="source" aria-label="Source" class:list={{ "is-set": Boolean(filters.source) }}>
    <option value="">Toutes les sources</option>
    {facets.sources.map((s) => <option value={s} selected={filters.source === s}>{s}</option>)}
  </select>
  <select name="locale" aria-label="Langue" class:list={{ "is-set": Boolean(filters.locale) }}>
    <option value="">Toutes les langues</option>
    {Object.entries(LOCALE_LABEL).map(([k, v]) => <option value={k} selected={filters.locale === k}>{v}</option>)}
  </select>
  {/* Le réglage des données de test vit dans la barre latérale. On le reporte
      ici en champ caché : sans lui, appliquer un filtre le remettrait à zéro. */}
  {filters.test && <input type="hidden" name="test" value="1" />}
  {active > 0 && <span class="adm-filters-on">{active} filtre{active > 1 ? "s" : ""} actif{active > 1 ? "s" : ""}</span>}
  {active > 0 && <a class="adm-filters-clear" href={clearHref}>Tout effacer</a>}
  <noscript><button type="submit" class="btn btn-sm">Appliquer</button></noscript>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-filter-bar]")) {
    form.addEventListener("change", (e) => {
      if ((e.target as HTMLElement).closest("[data-tip]")) return;
      // Les champs vides ne polluent pas l'URL.
      for (const el of form.querySelectorAll<HTMLSelectElement | HTMLInputElement>("select, input[type=checkbox]")) el.disabled = el instanceof HTMLInputElement ? !el.checked : !el.value;
      form.submit();
    });
  }
</script>
