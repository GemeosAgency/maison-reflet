---
/** Le jour par jour du parcours : visiteurs, pages, fiches, écoutes, guide, ajouts. */
import ModalTemplate from "./ModalTemplate.astro";
import { fmtInt } from "../../lib/admin/data";
import type { Journey } from "../../lib/admin/business";
interface Props {
  byDay: Journey["byDay"];
  rangeLabel: string;
}
const { byDay, rangeLabel } = Astro.props;
const rows = [...byDay].reverse();
const tot = rows.reduce((a, d) => ({ visitors: a.visitors + d.visitors, pageViews: a.pageViews + d.pageViews, productViews: a.productViews + d.productViews, plays: a.plays + d.plays, guide: a.guide + d.guide, adds: a.adds + d.adds }), { visitors: 0, pageViews: 0, productViews: 0, plays: 0, guide: 0, adds: 0 });
---

<ModalTemplate id="days" title="Jour par jour" subtitle={`${rangeLabel} · heure de Dubaï · le jour cliqué est surligné`} wide>
  <div class="card tbl-card">
    <div class="tbl-wrap">
      <table class="tbl tbl-compact" data-paginate="50" data-paginate-noun="jours">
        <thead><tr><th>Jour</th><th class="num">Visiteurs</th><th class="num">Pages vues</th><th class="num">Fiches vues</th><th class="num">Écoutes</th><th class="num">Guide & carte</th><th class="num">Ajouts</th></tr></thead>
        <tbody>
          {
            rows.map((d) => (
              <tr data-row={d.key} class:list={{ muted: !d.visitors }}>
                <td class="nowrap">{d.label}</td>
                <td class="num">{fmtInt(d.visitors)}</td>
                <td class="num">{fmtInt(d.pageViews)}</td>
                <td class="num">{fmtInt(d.productViews)}</td>
                <td class="num">{fmtInt(d.plays)}</td>
                <td class="num">{fmtInt(d.guide)}</td>
                <td class="num">{fmtInt(d.adds)}</td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr><th>Total</th><th class="num">{fmtInt(tot.visitors)}</th><th class="num">{fmtInt(tot.pageViews)}</th><th class="num">{fmtInt(tot.productViews)}</th><th class="num">{fmtInt(tot.plays)}</th><th class="num">{fmtInt(tot.guide)}</th><th class="num">{fmtInt(tot.adds)}</th></tr>
        </tfoot>
      </table>
    </div>
  </div>
</ModalTemplate>
