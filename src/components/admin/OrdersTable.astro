---
/** Une liste de commandes : quand, numéro, pays, articles (vignettes), source, paiement, code, total net. Réutilisée dans les pages et les fenêtres. */
import ProductThumb from "./ProductThumb.astro";
import { fmtDate } from "../../lib/admin/data";
import { fmtMoney, flagOf, type RecentOrder } from "../../lib/admin/business";
import { countryName } from "../../lib/admin/geo";
interface Props {
  orders: RecentOrder[];
  limit?: number;
  compact?: boolean;
  empty?: string;
  showDiscount?: boolean;
}
const { orders, limit = 1000, compact = false, empty = "Aucune commande payée sur la période.", showDiscount = false } = Astro.props;
const rows = orders.slice(0, limit);
const itemText = (o: RecentOrder) => o.items.map((i) => `${i.quantity > 1 ? `${i.quantity} × ` : ""}${i.name}${i.format === "sample" ? " (échantillon)" : ""}`).join(", ") || "–";
---

<div class="tbl-wrap">
  <table class:list={["tbl", { "tbl-compact": compact }]} data-paginate="50" data-paginate-noun="commandes">
    <thead>
      <tr><th>Quand</th><th>N°</th><th>Pays</th><th>Articles</th><th>Source</th>{showDiscount && <th>Paiement</th>}{showDiscount && <th>Code</th>}{showDiscount && <th class="num">Remise</th>}<th class="num">Total</th></tr>
    </thead>
    <tbody>
      {rows.length === 0 && <tr><td colspan={showDiscount ? 9 : 6}><p class="empty">{empty}</p></td></tr>}
      {
        rows.map((o) => (
          <tr data-row={o.id} class:list={{ muted: o.cancelled }}>
            <td class="muted mono when">{fmtDate(o.created_at)}</td>
            <td class="mono nowrap">{o.name ?? o.id}{o.test && <span class="badge badge-warn badge-mini">test</span>}{o.cancelled && <span class="badge badge-mini">annulée</span>}{o.luma && <span class="badge badge-rose badge-mini" data-tip="Ce visiteur a parlé à Luma avant de commander.">Luma</span>}</td>
            <td class="nowrap" title={o.country ? countryName(o.country) : ""}>{o.country ? `${flagOf(o.country)} ${o.country}` : "–"}</td>
            <td>
              <span class="items">
                <span class="items-stack">{o.items.slice(0, 3).map((i) => <ProductThumb image={i.image} name={i.name} size={28} />)}</span>
                <span class="items-text">{itemText(o)}</span>
              </span>
            </td>
            <td class="nowrap">{o.source.label}{!o.linked && <span class="muted" data-tip="Commande sans parcours : passée avant le suivi, ou sans le cookie anonyme."> · sans parcours</span>}</td>
            {showDiscount && <td class="muted nowrap">{o.gateway ?? "–"}</td>}
            {showDiscount && <td>{o.discount_codes.length ? o.discount_codes.join(", ") : <span class="muted">–</span>}</td>}
            {showDiscount && <td class="num muted">{o.discounts ? `−${fmtMoney(o.discounts, o.currency)}` : "–"}</td>}
            <td class="num strong">
              {fmtMoney(o.total - o.refunded, o.currency)}
              {o.refunded > 0 && <span class="muted refund-note" data-tip="Remboursé après paiement ; le total affiché est net.">remb. {fmtMoney(o.refunded, o.currency)}</span>}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style is:global>
  .badge-mini { margin-inline-start: 6px; padding: 1px 7px 0; font-size: 10px; vertical-align: middle; }
  .refund-note { display: block; font-size: 11px; font-weight: 400; }
</style>
