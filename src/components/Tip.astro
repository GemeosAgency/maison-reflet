---
/**
 * Une infobulle sur un point d'interrogation cerclé : le détail n'apparaît qu'à
 * qui le demande, sans alourdir la ligne qu'il précise.
 *
 * Le survol ne suffit pas : au doigt il n'existe pas, et l'essentiel du trafic
 * est mobile. Le clic ouvre et ferme, Échap et un clic ailleurs referment, une
 * seule bulle reste ouverte à la fois. Le bouton est atteignable au clavier.
 *
 * `align` décide du bord d'accrochage : « centre » par défaut, « fin » quand la
 * bulle est trop près du bord droit pour être centrée (c'est le cas dans la
 * pilule d'écoute, où le point est le dernier élément de la ligne).
 */
interface Props {
  text: string;
  label: string;
  align?: "centre" | "fin";
}
const { text, label, align = "centre" } = Astro.props;
---

<span class:list={["tip", `is-${align}`]} data-tip>
  <button type="button" class="tip-btn" data-tip-btn aria-expanded="false" aria-label={label}>?</button>
  <span class="tip-box" role="tooltip">{text}</span>
</span>

<script>
  const fermer = (sauf?: Element | null) => {
    for (const tip of document.querySelectorAll<HTMLElement>("[data-tip].is-open")) {
      if (tip === sauf) continue;
      tip.classList.remove("is-open");
      tip.querySelector("[data-tip-btn]")?.setAttribute("aria-expanded", "false");
    }
  };
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element | null)?.closest("[data-tip-btn]");
    const tip = btn?.closest<HTMLElement>("[data-tip]");
    if (!tip) return fermer();
    fermer(tip);
    const ouvert = tip.classList.toggle("is-open");
    btn?.setAttribute("aria-expanded", String(ouvert));
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") fermer();
  });
</script>

<style>
  .tip { position: relative; display: inline-flex; flex-shrink: 0; }
  .tip-btn {
    position: relative;
    width: 17px;
    height: 17px;
    padding: 0;
    border: 1px solid rgba(21, 14, 10, 0.3);
    border-radius: 50%;
    background: transparent;
    color: var(--muted, rgba(21, 14, 10, 0.62));
    font: inherit;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  /* La cible tactile atteint 45 px sans agrandir le petit cercle visible. */
  .tip-btn::after { content: ""; position: absolute; inset: -14px; }
  .tip-btn:hover { border-color: var(--ink); color: var(--ink); }
  .tip-btn:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 2px; }
  .tip-box {
    position: absolute;
    bottom: calc(100% + 10px);
    z-index: 5;
    width: max-content;
    max-width: min(300px, calc(100vw - 32px));
    padding: 11px 14px;
    border-radius: 10px;
    /* Fond sombre : en clair, le papier de la bulle (#f7f5f2) est à deux points
       du fond de page (#f1eee9) et la bulle disparaissait. */
    background: var(--ink, #150e0a);
    box-shadow: 0 12px 30px rgba(21, 14, 10, 0.22);
    color: var(--bg, #f1eee9);
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0;
    /* La bulle se pose parfois dans un texte en capitales espacées (l'exergue
       du panier) : elle doit repartir de zéro, sinon elle se lit en capitales. */
    text-transform: none;
    text-align: start;
    white-space: normal;
    /*
     * Fermée, la bulle est RETIRÉE du flux et non seulement masquée : un élément
     * en position absolue compte dans le débordement même invisible, et celle-ci
     * ajoutait sept pixels de défilement horizontal à toute la page. Elle
     * apparaît donc d'un coup, sans fondu : animer une propriété discrète
     * demandait `allow-discrete` et `@starting-style`, dont le résultat était
     * une bulle ouverte restée transparente. Une infobulle instantanée est la
     * norme, une infobulle invisible est un bug.
     */
    display: none;
  }
  .is-centre .tip-box,
  .is-fin .tip-box { inset-inline-end: 0; }
  /* `:focus-within` épinglait la bulle : après un clic, le bouton gardait le
     focus et le second clic ne la refermait plus. On ne montre donc au focus
     que pour le clavier, où c'est le seul moyen de la lire. */
  .tip:hover .tip-box,
  .tip-btn:focus-visible ~ .tip-box,
  .tip.is-open .tip-box { display: block; }
</style>
