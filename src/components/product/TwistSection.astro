---
/**
 * « The Specific Twist » : titre à gauche, texte long à droite, grande image
 * panoramique bordée en dessous. Texte = specificTwist (Sanity), image =
 * imageTwist (Sanity) avec repli sur une image de la galerie.
 */
import type { ResponsiveImage } from "../../lib/sanity";

interface Props {
  title: string;
  text: string;
  img: ResponsiveImage | null;
}

const { title, text, img } = Astro.props;
---

<section class="twist">
  <div class="twist-head">
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  {
    img && (
      <div class="twist-img">
        <img src={img.src} srcset={img.srcset} sizes="100vw" alt="" loading="lazy" decoding="async" />
      </div>
    )
  }
</section>

<style>
  .twist {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 120px var(--gutter-x) 72px;
  }
  .twist-head {
    display: flex;
    align-items: flex-start;
    gap: 80px;
  }
  .twist-head h2 {
    margin: 0;
    max-width: 260px;
    font-size: 32px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
    flex-shrink: 0;
  }
  .twist-head p {
    margin: 0;
    font-size: 18px;
    line-height: 1.28;
    letter-spacing: 1.08px;
    white-space: pre-line;
  }
  .twist-img {
    height: 560px;
    border: 1px solid var(--ink);
    background: var(--sand);
    overflow: hidden;
  }
  .twist-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .twist { padding: 56px var(--gutter-x) 40px; gap: 24px; }
    .twist-head { flex-direction: column; gap: 16px; }
    .twist-head h2 { font-size: 26px; max-width: none; }
    .twist-head p { font-size: 16px; }
    .twist-img { height: 320px; }
  }
</style>
