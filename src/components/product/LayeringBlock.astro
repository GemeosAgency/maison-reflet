---
/**
 * « Se marie avec » : les duos de layering qui incluent ce Reflet — la carte du
 * partenaire, l'histoire du duo, le geste (lequel en premier, où) et un bouton
 * qui ajoute les deux flacons, et « La recommandation du parfumeur » à écouter
 * (fichier statique, voix des portraits). Les duos viennent de lib/layering.ts ;
 * un duo encore `candidate` porte un repère « à valider » tant que le nez n'a
 * pas tranché. Rien ne s'affiche si le Reflet n'est dans aucun duo.
 */
import { useTranslations, localePath, type Locale } from "../../i18n";
import LumaListen from "../LumaListen.astro";
import { accordAudioPath, duosFor, stripVoiceTags } from "../../lib/layering";
import { universeLabel } from "../../lib/universes";
import { formatPrice, getDisplayPrice, getPrimaryVariant, shopifyImage, type ShopifyProduct } from "../../lib/shopify";

interface Props {
  lang: Locale;
  handle: string;
  /** Tous les produits Shopify de la page : on y trouve le partenaire. */
  products: ShopifyProduct[];
}

const { lang, handle, products } = Astro.props;
const t = useTranslations(lang);

const me = products.find((p) => p.handle === handle);
const duos = duosFor(handle)
  .map(({ duo, partner, first }) => {
    const p = products.find((x) => x.handle === partner);
    if (!p || !me) return null;
    const variant = getPrimaryVariant(p);
    const price = getDisplayPrice(p);
    return {
      duo,
      first,
      partner: {
        handle: p.handle,
        name: p.title,
        href: localePath(lang, `/parfums/${p.handle}`),
        universe: universeLabel(p.handle, lang),
        price: formatPrice(price.amount, price.currencyCode),
        variantId: variant.id,
        img: p.featuredImage ? shopifyImage(p.featuredImage, [320, 640]) : null,
      },
      myVariantId: getPrimaryVariant(me).id,
    };
  })
  .filter((d): d is NonNullable<typeof d> => d !== null);
---

{
  duos.length > 0 && (
    <section class="layering">
      <div class="layering-head">
        <h2>{t("layering.title")}</h2>
      </div>
      <div class="layering-list">
        {duos.map(({ duo, first, partner, myVariantId }) => (
          <article class="layering-duo">
            <a class="layering-partner" href={partner.href}>
              {partner.img && (
                <img src={partner.img.src} srcset={partner.img.srcset} sizes="(max-width: 900px) 40vw, 260px" alt={partner.name} loading="lazy" decoding="async" />
              )}
            </a>
            <div class="layering-body">
              <p class="layering-kicker">
                <span>{duo.name[lang]}</span>
                {duo.status === "candidate" && <span class="layering-candidate">{t("layering.candidate")}</span>}
              </p>
              <h3>
                <a href={partner.href}>{partner.name}</a>
                {partner.universe && <span class="layering-universe">{partner.universe}</span>}
              </h3>
              <p class="layering-story">{duo.story[lang]}</p>
              <p class="layering-gesture">
                <strong>{t("layering.gesture")}</strong> {duo.gesture[lang]}
              </p>
              <LumaListen
                lang={lang}
                src={accordAudioPath(lang, duo.id)}
                text={stripVoiceTags(duo.recommendation[lang])}
                label={t("layering.recommendation")}
                moreLabel={t("layering.readRecommendation")}
              />
              <div class="layering-actions">
                <button
                  type="button"
                  class="layering-add"
                  data-layering-add
                  data-variants={`${first ? myVariantId : partner.variantId},${first ? partner.variantId : myVariantId}`}
                  data-added-label={t("cart.added")}
                  data-error-label={t("product.error")}
                >
                  <span data-layering-label>{t("layering.addBoth")}</span>
                </button>
                <span class="layering-price">
                  + <span data-money={partner.variantId}>{partner.price}</span>
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<script>
  import { bindLayeringAdds } from "../../lib/layering-client";
  bindLayeringAdds();
</script>

<style>
  .layering {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 0 var(--gutter-x) 96px;
  }
  .layering-head h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .layering-list { display: flex; flex-direction: column; gap: 32px; }
  .layering-duo {
    display: grid;
    grid-template-columns: minmax(180px, 260px) 1fr;
    gap: 40px;
    align-items: start;
    padding-top: 32px;
    border-top: 1px solid rgba(21, 14, 10, 0.12);
  }
  .layering-partner { display: block; aspect-ratio: 4 / 5; background: var(--sand); overflow: hidden; }
  .layering-partner img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .layering-partner:hover img { transform: scale(1.03); }
  .layering-body { display: flex; flex-direction: column; gap: 12px; max-width: 640px; }
  .layering-kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rose);
  }
  .layering-candidate {
    padding: 3px 9px 2px;
    border: 1px solid currentColor;
    border-radius: 100px;
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .layering-body h3 {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.1;
  }
  .layering-universe { font-size: 13px; opacity: 0.6; }
  .layering-story { margin: 0; font-size: 18px; line-height: 1.28; letter-spacing: 0.06em; }
  .layering-gesture { margin: 0; font-size: 15px; line-height: 1.4; opacity: 0.8; }
  .layering-gesture strong { font-weight: 500; opacity: 1; }
  .layering-actions { display: flex; align-items: center; gap: 20px; margin-top: 12px; }
  .layering-add {
    padding: 14px 28px;
    border: 0;
    border-radius: 2px;
    background: var(--rose);
    color: var(--paper);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .layering-add:hover { opacity: 0.88; }
  .layering-add:disabled { opacity: 0.6; cursor: wait; }
  .layering-price { font-size: 14px; opacity: 0.6; }

  @media (max-width: 900px) {
    .layering { padding-bottom: 64px; gap: 24px; }
    .layering-head h2 { font-size: 26px; }
    .layering-duo { grid-template-columns: 1fr; gap: 20px; }
    .layering-partner { max-width: 60%; }
    .layering-body h3 { font-size: 24px; flex-wrap: wrap; }
    .layering-story { font-size: 16px; }
  }
</style>
