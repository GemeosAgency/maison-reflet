---
/**
 * Panneau d'informations de la fiche produit (colonne sticky à droite) :
 * titre + contenance, note moyenne, description, rangées à séparateurs
 * (famille olfactive, pyramide en accordéon, jauges intensité/sillage),
 * sélecteur de quantité + « Add to bag », avantages sous le CTA.
 *
 * Le bouton d'achat gère sa propre quantité (pas le câblage global
 * [data-add-to-cart] qui ajoute toujours 1) — voir le <script> plus bas.
 */
import Tip from "../Tip.astro";
import ShippingPromise from "../ShippingPromise.astro";
import type { Locale } from "../../i18n";
interface NoteLevel {
  label: string;
  notes: string[];
}

interface Props {
  title: string;
  sizeLabel: string | null;
  rating: string;
  reviewCount: number;
  reviewsWord: string;
  descriptionHtml: string;
  famillesLabel: string;
  familles: string | null;
  pyramidLabel: string;
  pyramidImg: string | null;
  noteLevels: NoteLevel[];
  sillageLabel: string;
  sillage: number | null;
  sillageValueLabel: string | null;
  /**
   * Rangées à séparateurs sans étiquette, centrées — la page coffret y met
   * « 6 x 2 ML individual samples ». Affichées avant les rangées libellées.
   */
  plainRows?: string[];
  /** « INSPIRÉ DE » et sa référence — première rangée de la liste (Figma 11088-3736). */
  inspiredByLabel?: string;
  inspiredBy?: string | null;
  variantId: string;
  priceLabel: string;
  addLabel: string;
  addedLabel: string;
  errorLabel: string;
  decreaseLabel: string;
  increaseLabel: string;
  /** `note` ajoute une infobulle à la réassurance : l'explication n'encombre pas la colonne. */
  perks: { icon: string; label: string; note?: string }[];
  /** « Eau de parfum, 8 h de tenue et plus » : au Golfe, la tenue est le premier critère. */
  longevityLabel?: string;
  /** Libellé du bouton d'infobulle, pour les lecteurs d'écran. */
  tipLabel?: string;
  /** Langue de la page — pour la promesse de livraison. */
  lang: Locale;
  /** Vignette de la barre d'achat collante (la première photo de la galerie). */
  thumb?: { src: string; srcset?: string } | null;
}

const {
  title,
  sizeLabel,
  rating,
  reviewCount,
  reviewsWord,
  descriptionHtml,
  famillesLabel,
  familles,
  pyramidLabel,
  pyramidImg,
  noteLevels,
  sillageLabel,
  sillage,
  sillageValueLabel,
  plainRows = [],
  inspiredByLabel,
  inspiredBy,
  variantId,
  priceLabel,
  addLabel,
  addedLabel,
  errorLabel,
  decreaseLabel,
  increaseLabel,
  perks,
  longevityLabel,
  tipLabel,
  lang,
  thumb = null,
} = Astro.props;

// Une seule jauge : le sillage. L'intensité affichait la même valeur sur les six
// Reflets, elle ne disait donc rien de ce parfum-ci (Sandro, 16 sept.).
const gauges = [{ label: sillageLabel, value: sillage, valueLabel: sillageValueLabel }].filter((g) => g.value != null);

const hasPyramid = pyramidImg !== null || noteLevels.some((l) => l.notes.length > 0);
---

<div class="ppanel">
  <div class="ppanel-head">
    <div class="ppanel-title-line">
      <h1 class="ppanel-title">
        {title}
        {sizeLabel && <span class="ppanel-size">{sizeLabel}</span>}
      </h1>
      <span class="ppanel-price" data-money={variantId}>{priceLabel}</span>
    </div>
    <div class="ppanel-rating">
      <span class="ppanel-stars">
        {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="14" height="14" />)}
      </span>
      <strong>{rating}</strong>
      <span class="ppanel-rating-count">· {reviewCount} {reviewsWord}</span>
    </div>
    {descriptionHtml && <div class="ppanel-desc" set:html={descriptionHtml} />}
  </div>

  <div class="ppanel-editorial">
    <slot name="after-description" />
  </div>

  <div class="ppanel-meta">
    {
      inspiredBy && (
        <div class="ppanel-row">
          <span class="ppanel-row-label">{inspiredByLabel}</span>
          <span class="ppanel-row-value">{inspiredBy}</span>
        </div>
      )
    }
    {
      plainRows.map((row) => (
        <div class="ppanel-row is-plain">
          <span class="ppanel-row-value">{row}</span>
        </div>
      ))
    }
    {
      familles && (
        <div class="ppanel-row">
          <span class="ppanel-row-label">{famillesLabel}</span>
          <span class="ppanel-row-value">{familles}</span>
        </div>
      )
    }
    {
      hasPyramid && (
        <button type="button" class="ppanel-row ppanel-open-pyramid" data-pyramid-open>
          <span class="ppanel-row-label">{pyramidLabel}</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 4V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <path d="M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          </svg>
        </button>
      )
    }
    {
      gauges.map((g) => (
        <div class="ppanel-row">
          <span class="ppanel-row-label">{g.label}</span>
          <span class="ppanel-gauge">
            <span class="ppanel-gauge-bar" role="img" aria-label={`${g.valueLabel} (${g.value}/5)`}>
              {[1, 2, 3, 4, 5].map((i) => (
                <span class:list={["ppanel-gauge-seg", { "is-filled": i <= (g.value ?? 0) }]} />
              ))}
            </span>
            <span class="ppanel-row-value">{g.valueLabel}</span>
          </span>
        </div>
      ))
    }
    {/* Rangées apportées par la page : « Se marie avec » (LayeringRow). */}
    <slot name="after-rows" />
  </div>

  <div class="ppanel-buy">
    <div class="ppanel-buy-row">
      <div class="ppanel-qty">
        <button type="button" class="ppanel-qty-btn" data-qty-decrease aria-label={decreaseLabel}>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        </button>
        <span class="ppanel-qty-value" data-qty-value aria-live="polite">1</span>
        <button type="button" class="ppanel-qty-btn" data-qty-increase aria-label={increaseLabel}>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <button
        type="button"
        class="ppanel-add"
        data-panel-add
        data-variant-id={variantId}
        data-added-label={addedLabel}
        data-error-label={errorLabel}
      >
        <span>{addLabel}</span>
        <span data-panel-add-price data-money={variantId}>{priceLabel}</span>
      </button>
    </div>
    {/*
      Promesse de livraison juste sous le bouton : c'est le dernier doute avant
      l'ajout au panier — « quand est-ce que je le reçois, et combien ça
      coûte ». À Dubaï, le rebours du jour même s'y affiche.
    */}
    <div class="ppanel-reassure">
    <div class="ppanel-ship">
      <ShippingPromise lang={lang} mobileConcise />
    </div>
    <ul class="ppanel-perks">
      {
        perks.map((p) => (
          <li>
            <img src={p.icon} alt="" width="20" height="20" />
            <span>{p.label}</span>
            {p.note && <Tip text={p.note} label={tipLabel ?? ""} />}
          </li>
        ))
      }
      {
        longevityLabel && (
          <li>
            <img src="/brand/reassurance-tenue.svg" alt="" width="20" height="20" />
            {longevityLabel}
          </li>
        )
      }
    </ul>
    </div>
  </div>

  <div class="ppanel-after-perks">
    <slot name="after-perks" />
  </div>
</div>

{/*
  La barre d'achat collante. La fiche fait près de quatorze écrans de haut :
  passé le bouton principal, plus rien ne permettait d'acheter sans remonter.
  En mobile, une barre pleine largeur ; sur ordinateur, une carte flottante en
  bas à gauche, sur la colonne galerie (inspirée de Hears), parce que le panneau
  collant de droite disparaît dès qu'on quitte la galerie. Elle ne refait pas la
  logique d'ajout, elle relaie le clic au bouton du panneau : quantité, libellés
  et états restent à un seul endroit.
*/}
<div class="pbuy" data-sticky-buy hidden>
  {thumb && (
    <img
      class="pbuy-thumb"
      src={thumb.src}
      srcset={thumb.srcset || undefined}
      sizes="72px"
      alt=""
      width="72"
      height="72"
      loading="lazy"
    />
  )}
  <span class="pbuy-summary">
    <span class="pbuy-name">{title}{sizeLabel && <span class="pbuy-size">{sizeLabel}</span>}</span>
    <span class="pbuy-price" data-money={variantId}>{priceLabel}</span>
  </span>
  <button type="button" class="pbuy-add" data-sticky-add>
    <span>{addLabel}</span>
    <span class="pbuy-add-price" data-money={variantId}>{priceLabel}</span>
  </button>
</div>

<script>
  import { addToCart } from "../../lib/cart";


  /*
   * La rangée n'ouvre pas le tiroir elle-même : elle porte `data-pyramid-open`,
   * et c'est PyramidDrawer qui écoute tous les boutons de la page. Le tiroir est
   * monté par la page, hors du panneau, parce que celui-ci est `sticky` : voir
   * le commentaire du composant.
   */

  /*
   * La barre collante : elle apparaît quand le bouton principal sort de l'écran
   * par le haut, et se retire dès qu'il revient. Elle relaie son clic, donc elle
   * hérite de la quantité choisie et des états sans les redéclarer.
   */
  /*
   * La barre collante : elle apparaît quand le bouton principal est sorti par le
   * haut, et se retire dès qu'il revient. Elle ne refait pas la logique d'ajout,
   * elle relaie le clic du bouton du panneau — quantité, libellés et états
   * restent à un seul endroit.
   *
   * Les éléments sont cherchés au moment du montage, pas à l'évaluation du
   * module : la barre est rendue après le panneau et n'existe pas encore quand
   * ce fichier est évalué.
   */
  const monterBarre = () => {
    const barre = document.querySelector<HTMLElement>("[data-sticky-buy]");
    const principal = document.querySelector<HTMLElement>(".ppanel-buy-row");
    if (!barre || !principal) return;
    /*
     * La carte est rendue dans le panneau de droite, qui est `position: sticky`
     * — et un élément collant ouvre un contexte d'empilement à lui seul. Son
     * `z-index: 60` ne valait donc qu'à l'intérieur du panneau : dehors, la
     * carte se retrouvait au niveau du panneau, et les sections suivantes lui
     * passaient devant. On la remonte dans le <body>, où son plan vaut pour
     * toute la page.
     */
    if (barre.parentElement !== document.body) document.body.append(barre);
    // Permet à Luma de céder toute la place au CTA principal sur mobile, puis
    // de revenir en version compacte seulement avec la barre d'achat sticky.
    document.body.classList.add("has-sticky-buy");

    // Mobile : la barre n'arrive qu'une fois le bouton principal dépassé, pour
    // lui laisser la vedette. Ordinateur : dès qu'il n'est pas à l'écran, y
    // compris sous la ligne de flottaison d'un écran de portable peu haut.
    const ordinateur = matchMedia("(min-width: 900px)");
    let affichee = false;
    const relire = () => {
      const rect = principal.getBoundingClientRect();
      const sortie = ordinateur.matches ? rect.bottom < 0 || rect.top > innerHeight : rect.bottom < 0;
      if (sortie === affichee) return;
      affichee = sortie;
      barre.hidden = !sortie;
      // La pastille Luma se pose au même endroit : on la relève le temps que la
      // barre est là, sinon les deux se superposent.
      document.body.classList.toggle("pbuy-on", sortie);
    };

    let enAttente = false;
    const auDefilement = () => {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(() => {
        enAttente = false;
        relire();
      });
    };
    addEventListener("scroll", auDefilement, { passive: true });
    addEventListener("resize", auDefilement, { passive: true });
    relire();

    barre.querySelector<HTMLButtonElement>("[data-sticky-add]")?.addEventListener("click", () => {
      document.querySelector<HTMLButtonElement>("[data-panel-add]")?.click();
    });
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", monterBarre, { once: true });
  } else {
    monterBarre();
  }

  // Quantité + ajout au panier (quantité choisie, d'où un câblage dédié)
  const addBtn = document.querySelector<HTMLButtonElement>("[data-panel-add]");
  if (addBtn) {
    const qtyValue = document.querySelector<HTMLElement>("[data-qty-value]");
    let qty = 1;
    const renderQty = () => {
      if (qtyValue) qtyValue.textContent = String(qty);
    };
    document.querySelector("[data-qty-decrease]")?.addEventListener("click", () => {
      qty = Math.max(1, qty - 1);
      renderQty();
    });
    document.querySelector("[data-qty-increase]")?.addEventListener("click", () => {
      qty = Math.min(9, qty + 1);
      renderQty();
    });

    const labelEl = addBtn.querySelector("span");
    const defaultLabel = labelEl?.textContent ?? "";
    addBtn.addEventListener("click", async () => {
      const variantId = addBtn.dataset.variantId;
      if (!variantId) return;
      addBtn.disabled = true;
      try {
        await addToCart(variantId, qty);
        if (labelEl) labelEl.textContent = addBtn.dataset.addedLabel ?? defaultLabel;
      } catch (e) {
        console.error(e);
        if (labelEl) labelEl.textContent = addBtn.dataset.errorLabel ?? defaultLabel;
      } finally {
        addBtn.disabled = false;
        setTimeout(() => {
          if (labelEl) labelEl.textContent = defaultLabel;
        }, 1800);
      }
    });
  }
</script>

<style>
  /* ---- barre d'achat collante (mobile) ---- */
  .pbuy {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: none;
    align-items: center;
    gap: 14px;
    padding: 8px 12px calc(16px + env(safe-area-inset-bottom));
    background: var(--paper, #f7f5f2);
    border-top: 1px solid rgba(21, 14, 10, 0.1);
    box-shadow: 0 -8px 24px -16px rgba(21, 14, 10, 0.4);
  }
  .pbuy[hidden] { display: none; }
  .pbuy-summary {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pbuy-name {
    min-width: 0;
    display: block;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
  }
  .pbuy-size { margin-inline-start: 6px; color: var(--muted, rgba(21, 14, 10, 0.56)); }
  /* Le nom et la contenance restent en lettres latines en arabe : la ligne se
     lit donc de gauche à droite, sinon la marge passe du mauvais côté et
     « BOIS ALERT75 ML » se colle. Alignée à droite pour suivre la page. */
  :global([dir="rtl"]) .pbuy-name { direction: ltr; text-align: right; }
  .pbuy-price { font-size: 16px; font-weight: 500; line-height: 1.2; white-space: nowrap; }
  /* Sous 400 px, le nom et la contenance ne tiennent pas : « FIFTH SEASON 7… »
     ne rend service à personne, on garde le nom seul. */
  @media (max-width: 399px) {
    .pbuy-size { display: none; }
  }
  .pbuy-add {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border: 0;
    border-radius: 2px;
    background: var(--rose, #812538);
    color: var(--paper, #f7f5f2);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
  }
  .pbuy-add:active { opacity: 0.9; }
  .pbuy-thumb,
  .pbuy-add-price { display: none; }
  .pbuy:not([hidden]) { display: flex; animation: pbuy-in 0.3s ease both; }
  @keyframes pbuy-in {
    from { opacity: 0; transform: translateY(12px); }
  }
  /* Ordinateur : la colonne de droite n'est collante que le long de la galerie.
     Au-delà (notes, avis, FAQ…), plus de bouton : la carte prend le relais, en
     bas à gauche, sans sortir de la colonne galerie pour laisser Luma à droite. */
  @media (min-width: 900px) {
    .pbuy {
      inset-inline: 20px auto;
      bottom: 20px;
      gap: 20px;
      max-width: calc(50vw - 40px);
      padding: 12px;
      border: 1px solid rgba(21, 14, 10, 0.1);
      border-radius: 4px;
      box-shadow: 0 12px 32px -12px rgba(21, 14, 10, 0.28);
    }
    .pbuy-thumb {
      display: block;
      flex: 0 0 auto;
      width: 72px;
      height: 72px;
      object-fit: cover;
      background: rgba(21, 14, 10, 0.04);
    }
    .pbuy-name { font-size: 14px; }
    .pbuy-price { font-size: 16px; }
    .pbuy-add {
      gap: 20px;
      /* Le bouton est plus court que la vignette : centré, il garde
         (72 − 52) / 2 = 10 px d'air au-dessus et en dessous, en plus des 12 px
         de la carte. Les mêmes 10 px à droite, et l'air est égal des trois
         côtés (Sandro, 24 sept.). */
      margin-inline-end: 10px;
      min-height: 52px;
      padding: 0 24px;
      font-size: 14px;
      transition: opacity 0.15s;
    }
    .pbuy-add:hover { opacity: 0.92; }
    .pbuy-add-price { display: inline; }
  }
  /* Assez de place pour le prix dans le résumé et dans le bouton ? Non sous
     1100 px : on le garde dans le résumé seulement. */
  @media (min-width: 900px) and (max-width: 1099px) {
    .pbuy-add-price { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pbuy:not([hidden]) { animation: none; }
  }

  .ppanel {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ppanel-head { display: flex; flex-direction: column; gap: 8px; }
  .ppanel-title-line { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .ppanel-title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.64px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .ppanel-size { font-size: 16px; font-weight: 500; letter-spacing: 0.96px; }
  .ppanel-price { display: none; flex-shrink: 0; font-size: 18px; font-weight: 500; white-space: nowrap; }
  .ppanel-rating { display: flex; align-items: center; gap: 8px; font-size: 16px; }
  .ppanel-stars { display: inline-flex; gap: 2px; }
  .ppanel-rating strong { font-weight: 500; }
  .ppanel-rating-count { font-size: 14px; }
  .ppanel-desc { font-size: 16px; line-height: 1.32; letter-spacing: 0.96px; }
  .ppanel-desc :global(p) { margin: 0 0 0.6em; }
  .ppanel-desc :global(p:last-child) { margin-bottom: 0; }

  /* Rangées à séparateurs */
  .ppanel-meta { display: flex; flex-direction: column; }
  .ppanel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(21, 14, 10, 0.12);
  }
  .ppanel-meta > :last-child { border-bottom: 0; }
  .ppanel-meta { border-bottom: 1px solid rgba(21, 14, 10, 0.12); }
  .ppanel-row-label { font-size: 14px; font-weight: 500; text-transform: uppercase; }
  .ppanel-row-value { font-size: 16px; font-weight: 500; letter-spacing: 0.96px; }
  /* Rangée sans étiquette : la valeur occupe la ligne entière et se centre.
     20px de part et d'autre comme dans la maquette, au lieu des 14px des
     rangées libellées. */
  .ppanel-row.is-plain { justify-content: center; padding: 20px 0; }
  .ppanel-row.is-plain .ppanel-row-value { line-height: 1.28; text-align: center; }

  /* La rangée « Pyramide olfactive » est un bouton : même dessin que les
     autres rangées, plus le + à droite. */
  .ppanel-open-pyramid {
    width: 100%;
    background: none;
    border-inline: 0;
    border-bottom: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: start;
  }
  .ppanel-open-pyramid svg { width: 20px; height: 20px; flex-shrink: 0; }

  /* Jauge 5 segments */
  .ppanel-gauge { display: inline-flex; align-items: center; gap: 12px; }
  .ppanel-gauge-bar { display: inline-flex; gap: 2px; width: 56px; }
  .ppanel-gauge-seg { flex: 1 0 0; height: 8px; background: rgba(21, 14, 10, 0.12); }
  .ppanel-gauge-seg.is-filled { background: var(--rose); }

  /* Achat */
  .ppanel-buy { display: flex; flex-direction: column; gap: 32px; }
  .ppanel-buy-row { display: flex; gap: 12px; align-items: stretch; }
  .ppanel-qty { display: flex; }
  .ppanel-qty-btn,
  .ppanel-qty-value {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 1px solid #dbd5ce;
    margin-inline-end: -1px;
    background: transparent;
    color: var(--ink);
  }
  .ppanel-qty-btn { cursor: pointer; padding: 0; }
  .ppanel-qty-btn svg { width: 20px; height: 20px; }
  .ppanel-qty-value { font-size: 18px; font-weight: 500; }
  .ppanel-add {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 56px;
    padding: 8px 24px;
    border: 0;
    background: var(--rose);
    color: var(--paper);
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .ppanel-add:hover { opacity: 0.92; }
  .ppanel-add:disabled { opacity: 0.6; }

  /* Livraison et réassurances : une seule liste, un seul rythme. Le bloc gardait
     32 px entre la livraison et les deux lignes suivantes, puis 12 px entre
     elles : l'œil y lisait deux groupes au lieu d'un. */
