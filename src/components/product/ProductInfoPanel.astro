---
/**
 * Panneau d'informations de la fiche produit (colonne sticky à droite) :
 * titre + contenance, note moyenne, description, rangées à séparateurs
 * (famille olfactive, pyramide en accordéon, jauges intensité/sillage),
 * sélecteur de quantité + « Add to bag », avantages sous le CTA.
 *
 * Le bouton d'achat gère sa propre quantité (pas le câblage global
 * [data-add-to-cart] qui ajoute toujours 1) — voir le <script> plus bas.
 */
interface NoteLevel {
  label: string;
  notes: string[];
}

interface Props {
  title: string;
  sizeLabel: string | null;
  rating: string;
  reviewCount: number;
  reviewsWord: string;
  descriptionHtml: string;
  famillesLabel: string;
  familles: string | null;
  pyramidLabel: string;
  pyramidImg: string | null;
  /** Liste INCI, affichée au bas du tiroir de la pyramide. */
  ingredients?: (string | null)[];
  ingredientsLabel?: string;
  /** Libellé accessible de la croix du tiroir. */
  closeLabel?: string;
  noteLevels: NoteLevel[];
  intensityLabel: string;
  intensity: number | null;
  intensityValueLabel: string | null;
  sillageLabel: string;
  sillage: number | null;
  sillageValueLabel: string | null;
  /**
   * Rangées à séparateurs sans étiquette, centrées — la page coffret y met
   * « 6 x 2 ML individual samples ». Affichées avant les rangées libellées.
   */
  plainRows?: string[];
  variantId: string;
  priceLabel: string;
  addLabel: string;
  addedLabel: string;
  errorLabel: string;
  decreaseLabel: string;
  increaseLabel: string;
  perks: { icon: string; label: string }[];
}

const {
  title,
  sizeLabel,
  rating,
  reviewCount,
  reviewsWord,
  descriptionHtml,
  famillesLabel,
  familles,
  pyramidLabel,
  pyramidImg,
  ingredients = [],
  ingredientsLabel = "",
  closeLabel = "",
  noteLevels,
  intensityLabel,
  intensity,
  intensityValueLabel,
  sillageLabel,
  sillage,
  sillageValueLabel,
  plainRows = [],
  variantId,
  priceLabel,
  addLabel,
  addedLabel,
  errorLabel,
  decreaseLabel,
  increaseLabel,
  perks,
} = Astro.props;

const gauges = [
  { label: intensityLabel, value: intensity, valueLabel: intensityValueLabel },
  { label: sillageLabel, value: sillage, valueLabel: sillageValueLabel },
].filter((g) => g.value != null);

const hasPyramid = pyramidImg !== null || noteLevels.some((l) => l.notes.length > 0);
const pyramidLevels = noteLevels.filter((l) => l.notes.length > 0);
const inciList = ingredients.filter((i): i is string => Boolean(i));
---

<div class="ppanel">
  <div class="ppanel-head">
    <h1 class="ppanel-title">
      {title}
      {sizeLabel && <span class="ppanel-size">{sizeLabel}</span>}
    </h1>
    <div class="ppanel-rating">
      <span class="ppanel-stars">
        {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="14" height="14" />)}
      </span>
      <strong>{rating}</strong>
      <span class="ppanel-rating-count">· {reviewCount} {reviewsWord}</span>
    </div>
    {descriptionHtml && <div class="ppanel-desc" set:html={descriptionHtml} />}
  </div>

  <div class="ppanel-meta">
    {
      plainRows.map((row) => (
        <div class="ppanel-row is-plain">
          <span class="ppanel-row-value">{row}</span>
        </div>
      ))
    }
    {
      familles && (
        <div class="ppanel-row">
          <span class="ppanel-row-label">{famillesLabel}</span>
          <span class="ppanel-row-value">{familles}</span>
        </div>
      )
    }
    {
      hasPyramid && (
        <button type="button" class="ppanel-row ppanel-open-pyramid" data-pyramid-open>
          <span class="ppanel-row-label">{pyramidLabel}</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 4V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            <path d="M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          </svg>
        </button>
      )
    }
    {
      gauges.map((g) => (
        <div class="ppanel-row">
          <span class="ppanel-row-label">{g.label}</span>
          <span class="ppanel-gauge">
            <span class="ppanel-gauge-bar" role="img" aria-label={`${g.valueLabel} (${g.value}/5)`}>
              {[1, 2, 3, 4, 5].map((i) => (
                <span class:list={["ppanel-gauge-seg", { "is-filled": i <= (g.value ?? 0) }]} />
              ))}
            </span>
            <span class="ppanel-row-value">{g.valueLabel}</span>
          </span>
        </div>
      ))
    }
  </div>

  <div class="ppanel-buy">
    <div class="ppanel-buy-row">
      <div class="ppanel-qty">
        <button type="button" class="ppanel-qty-btn" data-qty-decrease aria-label={decreaseLabel}>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        </button>
        <span class="ppanel-qty-value" data-qty-value aria-live="polite">1</span>
        <button type="button" class="ppanel-qty-btn" data-qty-increase aria-label={increaseLabel}>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <button
        type="button"
        class="ppanel-add"
        data-panel-add
        data-variant-id={variantId}
        data-added-label={addedLabel}
        data-error-label={errorLabel}
      >
        <span>{addLabel}</span>
        <span data-panel-add-price>{priceLabel}</span>
      </button>
    </div>
    <ul class="ppanel-perks">
      {
        perks.map((p) => (
          <li>
            <img src={p.icon} alt="" width="20" height="20" />
            {p.label}
          </li>
        ))
      }
    </ul>
  </div>
</div>

{/*
  Tiroir de la pyramide olfactive (maquette node 11421:461). Même mécanique
  et même géométrie que le panier : 480px collés à droite avec 8px de marge,
  coins arrondis, voile à 56 %, glissement latéral. Rendu HORS de `.ppanel`
  parce que celui-ci est `position: sticky` — et surtout parce que le panneau
  du tiroir porte une ombre : un filtre sur un ancêtre créerait un bloc
  conteneur et le `position: fixed` ne serait plus relatif à la fenêtre.
*/}
{
  hasPyramid && (
    <div class="pyr" data-pyramid-drawer aria-hidden="true">
      <div class="pyr-backdrop" data-pyramid-close />
      <aside class="pyr-panel" role="dialog" aria-modal="true" aria-label={pyramidLabel}>
        <button type="button" class="pyr-close" data-pyramid-close aria-label={closeLabel}>
          <img src="/brand/close.svg" alt="" width="16" height="16" />
        </button>

        {pyramidImg && <img class="pyr-illu" src={pyramidImg} alt="" loading="lazy" decoding="async" />}

        <div class="pyr-body">
          <h2 class="pyr-title">{pyramidLabel}</h2>
          {pyramidLevels.length > 0 && (
            <dl class="pyr-rows">
              {pyramidLevels.map((l) => (
                <div class="pyr-row">
                  <dt>{l.label}</dt>
                  <dd>{l.notes.join(", ")}</dd>
                </div>
              ))}
            </dl>
          )}
          {inciList.length > 0 && (
            <p class="pyr-inci">
              <strong>{ingredientsLabel}</strong> {inciList.join(", ")}
            </p>
          )}
        </div>
      </aside>
    </div>
  )
}

<script>
  import { addToCart } from "../../lib/cart";

  /*
   * Tiroir de la pyramide olfactive. Mêmes gestes que le panier : voile
   * cliquable, croix, Échap, et scroll de la page bloqué pendant l'ouverture.
   */
  const pyrDrawer = document.querySelector<HTMLElement>("[data-pyramid-drawer]");
  if (pyrDrawer) {
    const openPyramid = () => {
      pyrDrawer.classList.add("is-open");
      pyrDrawer.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      pyrDrawer.querySelector<HTMLButtonElement>("[data-pyramid-close]")?.focus();
    };
    const closePyramid = () => {
      pyrDrawer.classList.remove("is-open");
      pyrDrawer.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      document.querySelector<HTMLButtonElement>("[data-pyramid-open]")?.focus();
    };
    document.querySelector<HTMLButtonElement>("[data-pyramid-open]")?.addEventListener("click", openPyramid);
    for (const el of pyrDrawer.querySelectorAll<HTMLElement>("[data-pyramid-close]")) {
      el.addEventListener("click", closePyramid);
    }
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && pyrDrawer.classList.contains("is-open")) closePyramid();
    });
  }

  // Quantité + ajout au panier (quantité choisie, d'où un câblage dédié)
  const addBtn = document.querySelector<HTMLButtonElement>("[data-panel-add]");
  if (addBtn) {
    const qtyValue = document.querySelector<HTMLElement>("[data-qty-value]");
    let qty = 1;
    const renderQty = () => {
      if (qtyValue) qtyValue.textContent = String(qty);
    };
    document.querySelector("[data-qty-decrease]")?.addEventListener("click", () => {
      qty = Math.max(1, qty - 1);
      renderQty();
    });
    document.querySelector("[data-qty-increase]")?.addEventListener("click", () => {
      qty = Math.min(9, qty + 1);
      renderQty();
    });

    const labelEl = addBtn.querySelector("span");
    const defaultLabel = labelEl?.textContent ?? "";
    addBtn.addEventListener("click", async () => {
      const variantId = addBtn.dataset.variantId;
      if (!variantId) return;
      addBtn.disabled = true;
      try {
        await addToCart(variantId, qty);
        if (labelEl) labelEl.textContent = addBtn.dataset.addedLabel ?? defaultLabel;
      } catch (e) {
        console.error(e);
        if (labelEl) labelEl.textContent = addBtn.dataset.errorLabel ?? defaultLabel;
      } finally {
        addBtn.disabled = false;
        setTimeout(() => {
          if (labelEl) labelEl.textContent = defaultLabel;
        }, 1800);
      }
    });
  }
</script>

<style>
  .ppanel {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ppanel-head { display: flex; flex-direction: column; gap: 8px; }
  .ppanel-title {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.64px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .ppanel-size { font-size: 16px; font-weight: 500; letter-spacing: 0.96px; }
  .ppanel-rating { display: flex; align-items: center; gap: 8px; font-size: 16px; }
  .ppanel-stars { display: inline-flex; gap: 2px; }
  .ppanel-rating strong { font-weight: 500; }
  .ppanel-rating-count { font-size: 14px; }
  .ppanel-desc { font-size: 16px; line-height: 1.32; letter-spacing: 0.96px; }
  .ppanel-desc :global(p) { margin: 0 0 0.6em; }
  .ppanel-desc :global(p:last-child) { margin-bottom: 0; }

  /* Rangées à séparateurs */
  .ppanel-meta { display: flex; flex-direction: column; }
  .ppanel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(21, 14, 10, 0.12);
  }
  .ppanel-meta > :last-child { border-bottom: 0; }
  .ppanel-meta { border-bottom: 1px solid rgba(21, 14, 10, 0.12); }
  .ppanel-row-label { font-size: 14px; font-weight: 500; text-transform: uppercase; }
  .ppanel-row-value { font-size: 16px; font-weight: 500; letter-spacing: 0.96px; }
  /* Rangée sans étiquette : la valeur occupe la ligne entière et se centre.
     20px de part et d'autre comme dans la maquette, au lieu des 14px des
     rangées libellées. */
  .ppanel-row.is-plain { justify-content: center; padding: 20px 0; }
  .ppanel-row.is-plain .ppanel-row-value { line-height: 1.28; text-align: center; }

  /* La rangée « Pyramide olfactive » est un bouton : même dessin que les
     autres rangées, plus le + à droite. */
  .ppanel-open-pyramid {
    width: 100%;
    background: none;
    border-inline: 0;
    border-bottom: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: start;
  }
  .ppanel-open-pyramid svg { width: 20px; height: 20px; flex-shrink: 0; }

  /* ---------- Tiroir de la pyramide olfactive ---------- */
  .pyr { position: fixed; inset: 0; z-index: 60; pointer-events: none; }
  .pyr-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(31, 31, 31, 0.56);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .pyr.is-open { pointer-events: auto; }
  .pyr.is-open .pyr-backdrop { opacity: 1; }
  .pyr-panel {
    position: fixed;
    top: 8px;
    right: 8px;
    bottom: 8px;
    width: 480px;
    max-width: 92vw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    overflow-y: auto;
    padding: 32px 32px 40px;
    background: var(--bg);
    border-radius: 8px;
    box-shadow: 0 -4px 40px rgba(0, 0, 0, 0.08);
    transform: translateX(calc(100% + 8px));
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .pyr.is-open .pyr-panel { transform: translateX(0); }
  .pyr-close {
    position: absolute;
    top: 16px;
    right: 16px;
    border: 0;
    background: transparent;
    padding: 4px;
    line-height: 0;
    cursor: pointer;
  }
  /* Le schéma est un visuel à part entière : on le laisse respirer en haut,
     le texte se cale en bas (justify-content: space-between du panneau). */
  .pyr-illu { align-self: center; width: 100%; max-width: 258px; height: auto; }
  .pyr-body { display: flex; flex-direction: column; gap: 40px; }
  .pyr-title {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .pyr-rows { margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .pyr-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    font-size: 16px;
    line-height: 1.36;
  }
  .pyr-row + .pyr-row { padding-top: 12px; border-top: 1px solid rgba(21, 14, 10, 0.12); }
  .pyr-row dt { font-weight: 500; white-space: nowrap; }
  .pyr-row dd { margin: 0; max-width: 272px; letter-spacing: 0.96px; text-align: end; }
  .pyr-inci { margin: 0; font-size: 14px; line-height: 1.32; letter-spacing: 0.84px; }
  .pyr-inci strong { font-weight: 500; letter-spacing: normal; }

  @media (max-width: 560px) {
    /* Plein écran, comme le panier sur petit écran. */
    .pyr-panel {
      top: 0;
      right: 0;
      bottom: 0;
      width: 100vw;
      max-width: 100vw;
      border-radius: 0;
      transform: translateX(100%);
      padding: 24px 20px 32px;
    }
    .pyr.is-open .pyr-panel { transform: translateX(0); }
    .pyr-body { gap: 24px; }
    .pyr-row { flex-direction: column; gap: 2px; }
    .pyr-row dd { max-width: none; text-align: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pyr-backdrop, .pyr-panel { transition: none; }
  }

  /* Jauge 5 segments */
  .ppanel-gauge { display: inline-flex; align-items: center; gap: 12px; }
  .ppanel-gauge-bar { display: inline-flex; gap: 2px; width: 56px; }
  .ppanel-gauge-seg { flex: 1 0 0; height: 8px; background: rgba(21, 14, 10, 0.12); }
  .ppanel-gauge-seg.is-filled { background: var(--rose); }

  /* Achat */
  .ppanel-buy { display: flex; flex-direction: column; gap: 32px; }
  .ppanel-buy-row { display: flex; gap: 12px; align-items: stretch; }
  .ppanel-qty { display: flex; }
  .ppanel-qty-btn,
  .ppanel-qty-value {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 1px solid #dbd5ce;
    margin-inline-end: -1px;
    background: transparent;
    color: var(--ink);
  }
  .ppanel-qty-btn { cursor: pointer; padding: 0; }
  .ppanel-qty-btn svg { width: 20px; height: 20px; }
  .ppanel-qty-value { font-size: 18px; font-weight: 500; }
  .ppanel-add {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 56px;
    padding: 8px 24px;
    border: 0;
    background: var(--rose);
    color: var(--paper);
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .ppanel-add:hover { opacity: 0.92; }
  .ppanel-add:disabled { opacity: 0.6; }

  .ppanel-perks {
    list-style: none;
    margin: 0;
    padding: 0 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ppanel-perks li { display: flex; align-items: center; gap: 8px; font-size: 16px; }
  .ppanel-perks img { flex-shrink: 0; }

  /* Sur petit écran, le libellé + prix du bouton ne tiennent pas à côté du
     sélecteur de quantité : le CTA passe en pleine largeur en dessous. */
  @media (max-width: 560px) {
    .ppanel-buy-row { flex-wrap: wrap; }
    .ppanel-add { flex: 1 1 100%; }
  }
</style>
