---
/**
 * Section « Scent Notes » : triptyque Tête / Cœur / Fond, chaque colonne étant
 * la photo d'une matière première avec le niveau en haut et les notes en bas.
 *
 * Deux modes :
 *
 * - `levels` seul (fiche parfum) : un seul triptyque, celui du parfum affiché.
 * - `tabs` (page coffret) : un triptyque par parfum du coffret, avec une barre
 *   d'onglets au-dessus. Le coffret met en avant les 6 parfums, il faut donc
 *   pouvoir passer de l'un à l'autre sans quitter la page.
 *
 * Deux choses à garder en tête :
 *
 * 1. La colonne respecte `--band-col` (le ratio de la maquette, 478,67 x 560).
 *    Les photos de la bibliothèque de matières font 958 x 1120, soit le même
 *    ratio : la matière tient donc dans le cadre telle qu'elle a été shootée,
 *    à n'importe quelle largeur d'écran. Avec l'ancienne hauteur figée de
 *    560px et une largeur fluide, le ratio se cassait dès qu'on quittait 1440
 *    et `object-fit: cover` rognait le sujet.
 *
 *    La bande occupe tout le container --page-max, comme les autres sections,
 *    pour que les bords s'alignent verticalement d'un bout à l'autre de la
 *    page.
 *
 * 2. La note en gras est CELLE DONT LA PHOTO EST AFFICHÉE (`keyIndex`), pas la
 *    première de la liste. Toutes les matières n'ont pas encore de photo dans
 *    Sanity : mettre la première en gras affichait du caramel sous un
 *    « Jasmin Sambac » en gras.
 */
import type { ResponsiveImage } from "../../lib/sanity";

interface Level {
  label: string;
  notes: string[];
  /** Index de la note dont la photo est affichée, -1 si aucune. */
  keyIndex: number;
  img: ResponsiveImage | null;
}

interface Tab {
  /** Identifiant stable (handle Shopify) — sert aux id ARIA. */
  id: string;
  label: string;
  levels: Level[];
}

interface Props {
  title: string;
  /** Mode « un seul parfum ». Ignoré si `tabs` est fourni. */
  levels?: Level[];
  /** Mode « plusieurs parfums » : une barre d'onglets au-dessus du triptyque. */
  tabs?: Tab[];
}

const { title, levels = [], tabs } = Astro.props;

// Un panneau = un triptyque. Une colonne vide (ni note ni photo) est retirée
// plutôt qu'affichée en cadre sable vide.
const panels = (tabs ?? [{ id: "unique", label: title, levels }])
  .map((p) => ({ ...p, levels: p.levels.filter((l) => l.notes.length > 0 || l.img) }))
  .filter((p) => p.levels.length > 0);

const hasTabs = Boolean(tabs) && panels.length > 1;
---

{
  panels.length > 0 && (
    <section class="snotes">
      <div class="snotes-head">
        <h2>{title}</h2>
        {hasTabs && (
          <div class="snotes-tabs" role="tablist" aria-label={title} data-snotes-tabs>
            {/* Pastille unique glissée d'un onglet à l'autre. Un fond posé sur
                chaque bouton ne peut que se fondre ; celle-ci se déplace. */}
            <span class="snotes-tabs-pill" data-snotes-pill aria-hidden="true"></span>
            {panels.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`snotes-tab-${p.id}`}
                class="snotes-tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`snotes-panel-${p.id}`}
                tabindex={i === 0 ? 0 : -1}
                data-snotes-tab={p.id}
              >
                {p.label}
              </button>
            ))}
          </div>
        )}
      </div>

      {panels.map((p, i) => (
        <div
          class="snotes-grid media-band"
          id={`snotes-panel-${p.id}`}
          role={hasTabs ? "tabpanel" : undefined}
          aria-labelledby={hasTabs ? `snotes-tab-${p.id}` : undefined}
          data-snotes-panel={p.id}
          hidden={hasTabs && i > 0}
        >
          {p.levels.map((l) => (
            <div class="snotes-col">
              {l.img && (
                /* Colonne = un tiers du container --page-max (1800px), donc
                   600px au plus en desktop. */
                <img
                  class="snotes-img"
                  src={l.img.src}
                  srcset={l.img.srcset}
                  sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, min(33vw, 600px)"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="snotes-level">{l.label}</span>
              <p class="snotes-list">
                {l.notes.map((n, j) => (
                  <span class:list={["snotes-note", { "is-key": j === l.keyIndex }]}>
                    {n}
                    {j < l.notes.length - 1 ? "," : ""}
                  </span>
                ))}
              </p>
            </div>
          ))}
        </div>
      ))}
    </section>
  )
}

<script>
  /*
   * Apparition en fondu des photos de matières.
   *
   * `loading="lazy"` reste dans le markup pour ne pas alourdir le premier
   * rendu, mais dès que la section approche du viewport on repasse TOUTES ses
   * images en `eager`, y compris celles des onglets masqués : sinon changer
   * d'onglet laisse un cadre sable le temps du téléchargement. Le fondu ne
   * joue donc qu'une fois, au premier chargement.
   */
  const revealImages = (root: ParentNode) => {
    root.querySelectorAll<HTMLImageElement>(".snotes-img").forEach((img) => {
      if (img.complete && img.naturalWidth > 0) {
        img.classList.add("is-loaded");
      } else {
        img.addEventListener("load", () => img.classList.add("is-loaded"), { once: true });
        // Une image en erreur ne doit pas rester invisible pour toujours.
        img.addEventListener("error", () => img.classList.add("is-loaded"), { once: true });
      }
    });
  };

  document.querySelectorAll<HTMLElement>(".snotes").forEach((section) => {
    revealImages(section);
    const preload = () =>
      section.querySelectorAll<HTMLImageElement>('.snotes-img[loading="lazy"]').forEach((img) => {
        img.loading = "eager";
      });
    if (!("IntersectionObserver" in window)) {
      preload();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        preload();
      },
      { rootMargin: "400px" }
    );
    io.observe(section);
  });

  document.querySelectorAll<HTMLElement>("[data-snotes-tabs]").forEach((bar) => {
    const tabs = [...bar.querySelectorAll<HTMLButtonElement>("[data-snotes-tab]")];
    const section = bar.closest("section");
    if (!section) return;
    const pill = bar.querySelector<HTMLElement>("[data-snotes-pill]");

    /*
     * Place la pastille sur l'onglet actif. offsetLeft est mesuré depuis le
     * bord de la barre, donc la valeur reste juste même quand la barre est
     * défilée, et en RTL.
     */
    const movePill = (tab: HTMLElement) => {
      if (!pill) return;
      bar.style.setProperty("--pill-w", `${tab.offsetWidth}px`);
      bar.style.setProperty("--pill-x", `${tab.offsetLeft - bar.clientLeft}px`);
    };

    const show = (id: string) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.snotesTab === id;
        tab.setAttribute("aria-selected", String(on));
        // Un seul onglet dans l'ordre de tabulation : les flèches font le
        // reste, c'est le comportement attendu d'un tablist.
        tab.tabIndex = on ? 0 : -1;
        if (on) movePill(tab);
      });
      section
        .querySelectorAll<HTMLElement>("[data-snotes-panel]")
        .forEach((panel) => {
          const on = panel.dataset.snotesPanel === id;
          panel.hidden = !on;
          if (!on) {
            panel.classList.remove("is-entering");
            return;
          }
          /*
           * Le panneau qui apparaît rejoue son animation d'entrée. On retire
           * la classe puis on force un recalcul avant de la remettre, sinon
           * un second clic sur le même onglet — ou deux clics rapprochés — ne
           * relancerait rien : la classe serait déjà là.
           *
           * On la laisse ensuite en place : l'animation se termine sur l'état
           * de repos, donc rien à nettoyer.
           */
          panel.classList.remove("is-entering");
          void panel.offsetWidth;
          panel.classList.add("is-entering");
        });
    };

    const active = () => tabs.find((t) => t.getAttribute("aria-selected") === "true") ?? tabs[0];

    /*
     * Position initiale SANS transition, sinon la pastille glisserait depuis
     * le bord gauche au chargement.
     *
     * La lecture de `offsetWidth` force le navigateur à recalculer les styles
     * tout de suite : la position part donc dans un rendu où la transition
     * n'existe pas encore, et `.is-ready` n'arme l'animation que pour les
     * changements suivants. Pas de requestAnimationFrame ici — il ne se
     * déclenche pas dans un onglet en arrière-plan, et la pastille resterait
     * invisible jusqu'à ce que l'onglet passe au premier plan.
     */
    if (pill && active()) {
      movePill(active());
      void bar.offsetWidth;
      pill.classList.add("is-ready");
    }

    // Les libellés bougent avec la police et la largeur : on recale.
    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(() => {
        const t = active();
        if (t) movePill(t);
      });
      ro.observe(bar);
      tabs.forEach((t) => ro.observe(t));
    }
    if (document.fonts?.ready) {
      document.fonts.ready.then(() => {
        const t = active();
        if (t) movePill(t);
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => show(tab.dataset.snotesTab ?? ""));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        // Le sens des flèches suit la direction du document : en arabe, la
        // flèche droite doit aller vers l'onglet visuellement à droite, qui
        // est le PRÉCÉDENT dans l'ordre du DOM.
        const rtl = getComputedStyle(bar).direction === "rtl";
        const next = tabs[(i + (rtl ? -step : step) + tabs.length) % tabs.length];
        show(next.dataset.snotesTab ?? "");
        next.focus();
        // La barre déborde à 6 onglets : l'onglet choisi doit rester visible.
        next.scrollIntoView({ inline: "nearest", block: "nearest" });
      });
    });
  });
</script>

<style>
  .snotes {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* En-tête = titre (+ onglets). Sans onglets, le `gap` ne s'applique à rien :
     le rendu de la fiche parfum est inchangé. */
  .snotes-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 112px var(--gutter-x) 40px;
    max-width: 100%;
  }
  .snotes h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 500;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
  }

  .snotes-tabs {
    position: relative;
    display: flex;
    padding: 4px;
    background: var(--sand);
    /* Six parfums ne tiennent pas sur un écran étroit : la barre défile
       plutôt que de casser la ligne ou de rogner les libellés. */
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .snotes-tabs::-webkit-scrollbar { display: none; }
  /*
   * La pastille est en position absolue DANS la barre, donc elle défile avec
   * les onglets quand la barre déborde. Sa largeur et sa position sont posées
   * en JS d'après l'onglet actif ; `--pill-x` / `--pill-w` restent à 0 tant
   * que le script n'a pas tourné, et `.is-ready` évite qu'elle glisse depuis
   * le bord gauche au premier rendu.
   */
  .snotes-tabs-pill {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--pill-w, 0);
    transform: translateX(var(--pill-x, 0));
    background: var(--bg);
    filter: drop-shadow(2px 2px 2px rgba(0, 0, 0, 0.04));
    opacity: 0;
    pointer-events: none;
  }
  .snotes-tabs-pill.is-ready {
    opacity: 1;
    transition:
      transform 0.34s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.34s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .snotes-tab {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    border: 0;
    background: transparent;
    padding: 19px 24px;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.48;
    white-space: nowrap;
    cursor: pointer;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }
  /* Le fond de l'état actif est porté par la pastille, plus par le bouton.
     Repli si le script ne tourne pas : sans pastille visible, l'onglet actif
     reprend son propre fond. */
  .snotes-tab[aria-selected="true"] { opacity: 1; }
  .snotes-tabs:not(:has(.snotes-tabs-pill.is-ready)) .snotes-tab[aria-selected="true"] {
    background: var(--bg);
    filter: drop-shadow(2px 2px 2px rgba(0, 0, 0, 0.04));
  }
  .snotes-tab:hover { opacity: 1; }
  .snotes-tab:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; }

  /* Pas de `width` ici : c'est .media-band (globale) qui la fixe. */
  .snotes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
  }
  /* `display: grid` bat la règle `hidden` du navigateur : sans ceci, tous les
     triptyques resteraient empilés à l'écran. */
  .snotes-grid[hidden] { display: none; }

  .snotes-col {
    position: relative;
    aspect-ratio: var(--band-col);
    overflow: hidden;
    background: var(--sand);
    padding: 32px;
  }
  /*
   * La matière apparaît en fondu une fois chargée, sur le fond sable de la
   * colonne. `.is-loaded` est posé par le script — y compris sur les images
   * déjà en cache — donc changer d'onglet n'entraîne aucun re-fondu.
   */
  .snotes-img {
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.2, 0, 0.2, 1);
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* `object-bottom` dans la maquette : si un jour une photo n'a pas le ratio
       de la bibliothèque, on rogne le haut (fond vide) plutôt que la matière,
       qui repose sur le bas du cadre. */
    object-position: center bottom;
  }
  .snotes-level {
    position: relative;
    z-index: 1;
    font-size: 18px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .snotes-list {
    position: absolute;
    z-index: 1;
    inset-inline-start: 32px;
    bottom: 32px;
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: 14px;
    letter-spacing: 0.84px;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .snotes-img.is-loaded { opacity: 1; transform: none; }

  /*
   * Entrée du panneau au changement d'onglet.
   *
   * Le fondu de `.snotes-img` ne joue qu'une fois, au premier chargement :
   * une fois l'image en cache elle est déjà opaque, donc changer d'onglet
   * l'affichait d'un coup. Ces keyframes rejouent une apparition à chaque
   * bascule, décalée d'une colonne à l'autre pour que le triptyque se pose
   * au lieu d'arriver d'un bloc.
   *
   * `both` fait tenir l'état final, qui est l'état de repos — la classe peut
   * donc rester sur le panneau visible sans rien figer.
   */
  @keyframes snotes-col-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes snotes-img-in {
    from { transform: scale(1.035); }
    to { transform: none; }
  }
  .snotes-grid.is-entering .snotes-col {
    animation: snotes-col-in 0.42s ease both;
  }
  .snotes-grid.is-entering .snotes-img {
    animation: snotes-img-in 0.85s cubic-bezier(0.2, 0, 0.2, 1) both;
  }
  .snotes-grid.is-entering .snotes-col:nth-child(2),
  .snotes-grid.is-entering .snotes-col:nth-child(2) .snotes-img {
    animation-delay: 0.07s;
  }
  .snotes-grid.is-entering .snotes-col:nth-child(3),
  .snotes-grid.is-entering .snotes-col:nth-child(3) .snotes-img {
    animation-delay: 0.14s;
  }

  .snotes-note.is-key { font-weight: 700; }

  /* Glissement et fondu sont du décor : on les retire si l'utilisateur a
     demandé moins d'animations, sans rien casser de l'état affiché. */
  @media (prefers-reduced-motion: reduce) {
    .snotes-tabs-pill.is-ready { transition: none; }
    .snotes-img { transition: none; transform: none; }
    .snotes-grid.is-entering .snotes-col,
    .snotes-grid.is-entering .snotes-img { animation: none; }
  }

  /* Sous 1100px les colonnes deviendraient trop étroites pour que la matière
     reste lisible : on passe à deux colonnes, puis une. */
  @media (max-width: 1100px) {
    .snotes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .snotes-head { padding: 56px var(--gutter-x) 24px; gap: 24px; }
    .snotes h2 { font-size: 26px; }
    .snotes-tab { padding: 14px 16px; }
    .snotes-grid { grid-template-columns: minmax(0, 1fr); }
    /* 3/4 plutôt que le ratio de maquette : en pleine largeur mobile, 0,855
       donnerait une colonne de 117vh de haut. */
    .snotes-col { aspect-ratio: 3 / 4; padding: 24px; }
    .snotes-list { inset-inline-start: 24px; bottom: 24px; }
  }
</style>
