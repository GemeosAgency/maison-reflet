---
/**
 * Le coffret découverte, en encart discret dans la colonne d'achat.
 *
 * Pourquoi ici : l'échantillon offert n'arrive qu'après l'achat, il récompense
 * une décision déjà prise et ne rassure pas celui qui hésite encore. Le coffret
 * découverte est la seule vraie porte d'entrée pour qui n'a rien choisi — mais
 * sa grande bannière vit tout en bas de la fiche, à près de 7 000 px, alors que
 * le doute se joue au niveau du bouton d'achat, vers 720 px.
 *
 * Le dessin est volontairement léger : un filet, le titre posé dessus, une
 * rangée basse. Une carte pleine hauteur passait avant le bouton d'achat dans
 * la hiérarchie, ce qui n'est pas son rôle (Sandro, 17 sept. : « beaucoup trop
 * gros, faut un truc plus discret »).
 */
import type { ResponsiveImage } from "../../lib/sanity";

interface Props {
  eyebrow: string;
  title: string;
  priceLabel: string;
  href: string;
  img: ResponsiveImage | null;
  ctaLabel: string;
}

const { eyebrow, title, priceLabel, href, img, ctaLabel } = Astro.props;
---

<div class="pdisc">
  <span class="pdisc-legend">{eyebrow}</span>
  <a class="pdisc-row" href={href}>
    <span class="pdisc-thumb">
      {img && <img src={img.src} srcset={img.srcset} sizes="88px" alt="" loading="lazy" decoding="async" />}
    </span>
    <span class="pdisc-text">
      <span class="pdisc-name">{title}</span>
      <span class="pdisc-price">{priceLabel}</span>
    </span>
    <span class="pdisc-cta">{ctaLabel}</span>
  </a>
</div>

<style>
  .pdisc {
    position: relative;
    margin-block-start: 30px;
    padding: 20px 16px 16px;
    border: 1px solid var(--line, rgba(21, 14, 10, 0.14));
  }
  /* Le titre posé sur le filet, qui s'interrompt derrière lui. */
  .pdisc-legend {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 16px;
    transform: translateY(-50%);
    padding-inline: 8px;
    background: var(--bg, #f1eee9);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted, rgba(21, 14, 10, 0.56));
  }
  .pdisc-row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 14px;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  .pdisc-thumb {
    display: block;
    aspect-ratio: 1;
    background: var(--sand, #e7dfd0);
    overflow: hidden;
  }
  .pdisc-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .pdisc-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .pdisc-name { font-size: 15px; line-height: 1.25; }
  .pdisc-price {
    font-size: 13px;
    color: var(--muted, rgba(21, 14, 10, 0.56));
    font-variant-numeric: tabular-nums;
  }
  .pdisc-cta {
    flex: none;
    padding: 9px 14px;
    border: 1px solid var(--line-strong, rgba(21, 14, 10, 0.2));
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .pdisc-row:hover .pdisc-cta,
  .pdisc-row:focus-visible .pdisc-cta {
    border-color: var(--ink, #150e0a);
    background: rgba(21, 14, 10, 0.04);
  }
  @media (max-width: 420px) {
    .pdisc-row { grid-template-columns: 56px 1fr; row-gap: 12px; }
    .pdisc-cta { grid-column: 1 / -1; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pdisc-cta { transition: none; }
  }
</style>
