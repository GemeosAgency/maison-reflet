---
/**
 * Bandeau « Se marie avec » — même mécanique et même géométrie que le tiroir
 * « Pyramide olfactive » (480 px collés à droite, 8 px de marge, coins à 8 px,
 * voile à 56 %, glissement, fermeture au voile / à la croix / par Échap),
 * ouvert par `layering:open` depuis la rangée du panneau (LayeringRow).
 *
 * Dedans : le partenaire d'accord en photo, l'accord du parfumeur (nom,
 * histoire, geste), « La recommandation du parfumeur » à écouter, et
 * « Ajouter les deux » avec le prix des deux flacons. Monté par la PAGE, hors
 * du panneau d'achat sticky (voir PyramidDrawer).
 */
import { useTranslations, localePath, type Locale } from "../../i18n";
import LumaListen from "../LumaListen.astro";
import { accordAudioPath, duosFor, stripVoiceTags } from "../../lib/layering";
import { universeLabel } from "../../lib/universes";
import { formatPrice, getDisplayPrice, getPrimaryVariant, shopifyImage, type ShopifyProduct } from "../../lib/shopify";

interface Props {
  lang: Locale;
  handle: string;
  products: ShopifyProduct[];
  closeLabel: string;
}

const { lang, handle, products, closeLabel } = Astro.props;
const t = useTranslations(lang);

const me = products.find((p) => p.handle === handle);
const first = duosFor(handle)[0];
const partnerProduct = first ? products.find((p) => p.handle === first.partner) : undefined;
const accord =
  first && me && partnerProduct
    ? (() => {
        const variant = getPrimaryVariant(partnerProduct);
        const price = getDisplayPrice(partnerProduct);
        const mine = getDisplayPrice(me);
        const myVariantId = getPrimaryVariant(me).id;
        return {
          duo: first.duo,
          variants: first.first ? `${myVariantId},${variant.id}` : `${variant.id},${myVariantId}`,
          total: formatPrice(String(Number(mine.amount) + Number(price.amount)), price.currencyCode),
          partner: {
            name: partnerProduct.title,
            href: localePath(lang, `/parfums/${partnerProduct.handle}`),
            universe: universeLabel(partnerProduct.handle, lang),
            img: partnerProduct.featuredImage ? shopifyImage(partnerProduct.featuredImage, [520, 780]) : null,
          },
        };
      })()
    : null;
---

{
  accord && (
    <div class="lay" data-layering-drawer aria-hidden="true">
      <div class="lay-backdrop" data-layering-close />
      <aside class="lay-panel" role="dialog" aria-modal="true" aria-label={t("layering.title")}>
        <button type="button" class="lay-close" data-layering-close aria-label={closeLabel}>
          <img src="/brand/close.svg" alt="" width="16" height="16" />
        </button>
        {accord.partner.img && (
          <a class="lay-illu" href={accord.partner.href} tabindex="-1" aria-hidden="true">
            <img src={accord.partner.img.src} srcset={accord.partner.img.srcset} sizes="258px" alt="" loading="lazy" decoding="async" />
          </a>
        )}
        <div class="lay-body">
          <div class="lay-head">
            <p class="lay-kicker">
              <span>{accord.duo.name[lang]}</span>
              {accord.duo.status === "candidate" && <span class="lay-candidate">{t("layering.candidate")}</span>}
            </p>
            <h2 class="lay-title">
              {t("layering.title")} <a href={accord.partner.href}>{accord.partner.name}</a>
            </h2>
            {accord.partner.universe && <p class="lay-universe">{accord.partner.universe}</p>}
          </div>
          <p class="lay-story">{accord.duo.story[lang]}</p>
          <p class="lay-gesture"><strong>{t("layering.gesture")}</strong> {accord.duo.gesture[lang]}</p>
          <LumaListen
            lang={lang}
            src={accordAudioPath(lang, accord.duo.id)}
            text={stripVoiceTags(accord.duo.recommendation[lang])}
            label={t("layering.recommendation")}
            moreLabel={t("layering.readRecommendation")}
          />
          <div class="lay-actions">
            <button
              type="button"
              class="lay-add"
              data-layering-add
              data-variants={accord.variants}
              data-added-label={t("cart.added")}
              data-error-label={t("product.error")}
            >
              <span data-layering-label>{t("layering.addBoth")}</span>
              <span data-money={accord.variants}>{accord.total}</span>
            </button>
          </div>
        </div>
      </aside>
    </div>
  )
}

<script>
  import { bindLayeringAdds } from "../../lib/layering-client";
  const drawer = document.querySelector<HTMLElement>("[data-layering-drawer]");
  if (drawer) {
    bindLayeringAdds(drawer);
    const open = () => {
      drawer.classList.add("is-open");
      drawer.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      drawer.querySelector<HTMLButtonElement>("[data-layering-close]")?.focus();
    };
    const close = () => {
      drawer.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      // La recommandation ne continue pas de parler derrière un bandeau fermé.
      for (const a of drawer.querySelectorAll<HTMLAudioElement>("audio")) a.pause();
      // Le focus retourne à la rangée qui a ouvert le bandeau.
      document.querySelector<HTMLButtonElement>("[data-layering-open]")?.focus();
    };
    document.addEventListener("layering:open", open);
    for (const el of drawer.querySelectorAll<HTMLElement>("[data-layering-close]")) el.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer.classList.contains("is-open")) close();
    });
  }
</script>

<style>
  .lay { position: fixed; inset: 0; z-index: 60; pointer-events: none; }
  .lay-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(31, 31, 31, 0.56);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .lay.is-open { pointer-events: auto; }
  .lay.is-open .lay-backdrop { opacity: 1; }
  .lay-panel {
    position: fixed;
    top: 8px;
    right: 8px;
    bottom: 8px;
    width: 480px;
    max-width: 92vw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    overflow-y: auto;
    padding: 32px 32px 40px;
    background: var(--bg);
    border-radius: 8px;
    box-shadow: 0 -4px 40px rgba(0, 0, 0, 0.08);
    transform: translateX(calc(100% + 8px));
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lay.is-open .lay-panel { transform: translateX(0); }
  .lay-close {
    position: absolute;
    top: 16px;
    right: 16px;
    border: 0;
    background: transparent;
    padding: 4px;
    line-height: 0;
    cursor: pointer;
  }
  /* Le partenaire en photo, à la place du schéma de la pyramide : même largeur, même ombre portée. */
  .lay-illu {
    display: block;
    align-self: center;
    width: 100%;
    max-width: 258px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--sand);
    box-shadow:
      45px 77px 36px rgba(31, 31, 31, 0.01),
      25px 43px 30px rgba(31, 31, 31, 0.05),
      11px 19px 22px rgba(31, 31, 31, 0.09),
      3px 5px 12px rgba(31, 31, 31, 0.1);
  }
  .lay-illu img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lay-body { display: flex; flex-direction: column; gap: 20px; }
  .lay-head { display: flex; flex-direction: column; gap: 8px; }
  .lay-kicker { margin: 0; display: flex; align-items: center; gap: 10px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--rose); }
  .lay-candidate { padding: 3px 9px 2px; border: 1px solid currentColor; border-radius: 100px; font-size: 10px; letter-spacing: 0.1em; }
  .lay-title { margin: 0; font-size: 24px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .lay-title a { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(21, 14, 10, 0.3); }
  .lay-title a:hover { text-decoration-color: currentColor; }
  .lay-universe { margin: 0; font-size: 14px; opacity: 0.6; }
  .lay-story { margin: 0; font-size: 16px; line-height: 1.36; letter-spacing: 0.96px; }
  .lay-gesture { margin: 0; font-size: 14px; line-height: 1.4; opacity: 0.8; }
  .lay-gesture strong { font-weight: 500; opacity: 1; }
  .lay-body :global(.listen) { margin-top: 0; }
  .lay-actions { display: flex; align-items: center; gap: 16px; }
  /* Comme le bouton principal : libellé à gauche, prix des deux à droite — sans prendre toute la largeur (Sandro). */
  .lay-add {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding: 13px 20px;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .lay-add:hover { background: var(--ink); color: var(--bg); }
  .lay-add:disabled { opacity: 0.6; cursor: wait; }

  @media (max-width: 560px) {
    .lay-panel {
      top: 0;
      right: 0;
      bottom: 0;
      width: 100vw;
      max-width: 100vw;
      border-radius: 0;
      transform: translateX(100%);
      padding: 24px 20px 32px;
    }
    .lay.is-open .lay-panel { transform: translateX(0); }
    .lay-illu { max-width: 200px; }
    .lay-body { gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lay-backdrop, .lay-panel { transition: none; }
  }
</style>
