---
/**
 * « Pas encore décidé ? Être prévenu au lancement » : l'action moins
 * engageante que la précommande (Sandro, 30 oct.). Un e-mail, rien d'autre.
 *
 * Le bouton se déplie sur place (pas de fenêtre par-dessus la fiche), puis
 * laisse la confirmation, qui rappelle que la précommande reste possible.
 *
 * L'inscription passe par /api/subscribe avec `source: "notify"` : liste
 * Klaviyo des prospects de la prévente, nourrie jusqu'au lancement, et un
 * événement « Notify Me Requested » qui garde le parfum demandé, pour lui
 * envoyer le bon le jour J (un segment par parfum).
 */
import type { Locale } from "../../i18n";
import { useTranslations } from "../../i18n";

interface Props {
  lang: Locale;
  handle: string;
  name: string;
  /** Prix de précommande déjà formaté, pour la confirmation. */
  priceLabel: string;
}

const { lang, handle, name, priceLabel } = Astro.props;
const t = useTranslations(lang);
const fill = (s: string) => s.replace("{name}", name).replace("{price}", priceLabel);
---

<div class="notify" data-notify data-handle={handle} data-name={name}>
  <button type="button" class="notify-open" data-notify-open aria-expanded="false">
    <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
      <path d="M5.5 13.5V9a4.5 4.5 0 0 1 9 0v4.5l1.5 1.5H4z M8.2 17a1.9 1.9 0 0 0 3.6 0" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
    {t("notify.open")}
  </button>

  <form class="notify-box" data-notify-form hidden novalidate>
    <div class="notify-head">
      <div class="notify-text">
        <p class="notify-title">{t("notify.title")}</p>
        <p class="notify-body">{fill(t("notify.body"))}</p>
      </div>
      <button type="button" class="notify-close" data-notify-close aria-label={t("product.close")}>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
      </button>
    </div>
    <div class="notify-fields">
      <input
        class="notify-input"
        type="email"
        name="email"
        autocomplete="email"
        inputmode="email"
        required
        placeholder={t("notify.placeholder")}
        aria-label={t("notify.placeholder")}
      />
      <button type="submit" class="notify-submit">{t("notify.submit")}</button>
    </div>
    <p class="notify-msg" data-notify-msg role="alert" data-invalid={t("notify.invalid")} data-error={t("notify.error")}></p>
    <p class="notify-consent">{t("notify.consent")}</p>
  </form>

  <div class="notify-box notify-done" data-notify-done hidden>
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
      <circle cx="10" cy="10" r="8" fill="currentColor" />
      <path d="M6.4 10.2l2.4 2.4 4.8-4.8" fill="none" stroke="var(--paper)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <div class="notify-text">
      <p class="notify-title">{t("notify.doneTitle")}</p>
      <p class="notify-body">{fill(t("notify.doneBody"))}</p>
    </div>
  </div>
</div>

<script>
  import { identify } from "../../lib/klaviyo";

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  for (const root of document.querySelectorAll<HTMLElement>("[data-notify]")) {
    const open = root.querySelector<HTMLButtonElement>("[data-notify-open]");
    const form = root.querySelector<HTMLFormElement>("[data-notify-form]");
    const done = root.querySelector<HTMLElement>("[data-notify-done]");
    const msg = root.querySelector<HTMLElement>("[data-notify-msg]");
    const input = form?.querySelector<HTMLInputElement>("input[name=email]");
    const submit = form?.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!open || !form || !done || !input || !submit) continue;

    const deplier = (ouvert: boolean) => {
      open.hidden = ouvert;
      form.hidden = !ouvert;
      open.setAttribute("aria-expanded", String(ouvert));
      if (ouvert) input.focus();
      else open.focus();
    };
    open.addEventListener("click", () => deplier(true));
    root.querySelector("[data-notify-close]")?.addEventListener("click", () => deplier(false));

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim().toLowerCase();
      if (!EMAIL_RE.test(email)) {
        if (msg) msg.textContent = msg.dataset.invalid ?? "";
        input.focus();
        return;
      }
      if (msg) msg.textContent = "";
      submit.disabled = true;
      const locale = document.documentElement.lang || undefined;
      try {
        const res = await fetch("/api/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, locale, source: "notify", handle: root.dataset.handle, url: location.pathname }),
        });
        const data = await res.json().catch(() => null);
        if (!res.ok || !data?.ok) throw new Error(data?.error || String(res.status));
        form.hidden = true;
        done.hidden = false;
        try {
          identify({ email, site_locale: locale });
        } catch {
          // le tracking ne doit jamais faire échouer l'inscription
        }
      } catch {
        if (msg) msg.textContent = msg.dataset.error ?? "";
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .notify-open {
    width: 100%;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 16px;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .notify-open:hover { background: rgba(21, 14, 10, 0.04); }
  .notify-open[hidden],
  .notify-box[hidden] { display: none; }

  .notify-box {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border: 1px solid rgba(21, 14, 10, 0.16);
    background: #fff;
  }
  .notify-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .notify-text { display: flex; flex-direction: column; gap: 4px; }
  .notify-title { margin: 0; font-size: 16px; line-height: 1.2; font-weight: 500; text-transform: uppercase; }
  .notify-body { margin: 0; font-size: 14px; line-height: 1.36; }
  .notify-close {
    flex-shrink: 0;
    display: flex;
    padding: 4px;
    margin: -2px -4px 0 0;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .notify-fields { display: flex; gap: 8px; }
  .notify-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 48px;
    box-sizing: border-box;
    padding: 0 16px;
    border: 1px solid #dbd5ce;
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }
  .notify-input::placeholder { color: rgba(21, 14, 10, 0.45); }
  .notify-input:focus { outline: none; border-color: var(--ink); }
  .notify-submit {
    flex-shrink: 0;
    height: 48px;
    padding: 0 24px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
  }
  .notify-submit:disabled { opacity: 0.6; }
  .notify-msg { margin: -4px 0 0; font-size: 13px; color: var(--rose); }
  .notify-msg:empty { display: none; }
  .notify-consent { margin: 0; font-size: 12px; line-height: 1.33; opacity: 0.6; }
  .notify-done { flex-direction: row; gap: 12px; }
  .notify-done svg { flex-shrink: 0; margin-top: 1px; color: var(--ink); }

  @media (max-width: 899px) {
    .notify-fields { flex-direction: column; }
    .notify-submit { width: 100%; }
  }
</style>
