---
/**
 * Galerie de la fiche produit : une MOSAÏQUE sur ordinateur (Sandro, 12 sept.
 * 2026 : six photos empilées faisaient un long défilement), un carrousel
 * horizontal à snap sur mobile. Les images sont les photos produit Shopify
 * (la galerie ne vit que là — voir la page), dans l'ordre de Shopify.
 *
 * Le rythme de la mosaïque : la première photo pleine largeur, puis deux
 * détails côte à côte, une pleine largeur, deux côte à côte… Une photo qui
 * resterait seule sur une rangée de paire passe en pleine largeur. Avec les
 * six photos d'Ultra Cuir : flacon · framboises + étiquette · main · bouchon
 * + boîte — quatre rangées au lieu de six.
 *
 * Un clic sur une photo l'ouvre en grand (Sandro : « comme sur les sites bien
 * faits ») : une visionneuse plein écran sur le fond du site, flèches, compteur,
 * clavier (Échap, ← →), balayage au doigt ; le clic sur l'image passe à la
 * suivante, le clic à côté referme.
 */
import type { ResponsiveImage } from "../../lib/sanity";
import { useTranslations, type Locale } from "../../i18n";

interface Props {
  images: (ResponsiveImage & { alt: string })[];
  lang: Locale;
  /**
   * Ratio d'un cliché. 720/896 sur la fiche parfum, 1/1 sur la page coffret
   * (maquette Discovery : deux carrés de 720).
   */
  ratio?: string;
}

const { images, lang, ratio = "720 / 896" } = Astro.props;
const t = useTranslations(lang);

/** Pleine largeur ou moitié : la première, puis un cycle « paire, paire, pleine ». */
function isFull(i: number, count: number): boolean {
  if (i === 0) return true;
  const pos = (i - 1) % 3; // 0 et 1 : la paire ; 2 : la pleine largeur
  if (pos === 2) return true;
  // Début de paire sans partenaire (dernière photo) : pleine largeur.
  return pos === 0 && i === count - 1;
}
---

<div class="pgallery-shell">
  <div class="pgallery" style={`--pgallery-ratio: ${ratio}`} data-pgallery>
    {
      images.map((im, i) => (
        <button
          type="button"
          class:list={["pgallery-shot", { "is-full": isFull(i, images.length) }]}
          data-gallery-open={i}
          aria-label={`${t("gallery.enlarge")} — ${im.alt} (${i + 1}/${images.length})`}
        >
          <img
            src={i < 2 ? im.src : undefined}
            srcset={i < 2 ? im.srcset : undefined}
            data-src={i > 1 ? im.src : undefined}
            data-srcset={i > 1 ? im.srcset : undefined}
            sizes={isFull(i, images.length) ? "(max-width: 900px) 100vw, 50vw" : "(max-width: 900px) 100vw, 25vw"}
            alt={im.alt}
            loading={i < 2 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : i === 1 ? "low" : undefined}
            decoding="async"
          />
        </button>
      ))
    }
  </div>
</div>

{/* La visionneuse : une seule par page, cachée tant qu'aucune photo n'est ouverte. */}
<div class="plightbox" data-lightbox role="dialog" aria-modal="true" aria-label={t("gallery.viewer")} aria-hidden="true" hidden>
  <div class="plightbox-backdrop" data-lightbox-close></div>
  <button type="button" class="plightbox-close" data-lightbox-close aria-label={t("gallery.close")}>
    <img src="/brand/close.svg" alt="" width="16" height="16" />
  </button>
  <button type="button" class="plightbox-nav plightbox-prev" data-lightbox-prev aria-label={t("gallery.prev")}>
    <svg width="14" height="24" viewBox="0 0 14 24" aria-hidden="true"><path d="M12 2 2 12l10 10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <figure class="plightbox-figure">
    <img class="plightbox-img" data-lightbox-img alt="" sizes="100vw" decoding="async" />
  </figure>
  <button type="button" class="plightbox-nav plightbox-next" data-lightbox-next aria-label={t("gallery.next")}>
    <svg width="14" height="24" viewBox="0 0 14 24" aria-hidden="true"><path d="m2 2 10 10L2 22" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  {/* Les autres photos en vignettes, cliquables (Sandro) ; la photo affichée est marquée. */}
  <div class="plightbox-thumbs" data-lightbox-thumbs>
    {
      images.map((im, i) => (
        <button type="button" class="plightbox-thumb" data-lightbox-thumb={i} aria-label={`${im.alt} (${i + 1}/${images.length})`}>
          <img src={im.src} srcset={im.srcset} sizes="72px" alt="" loading="lazy" decoding="async" />
        </button>
      ))
    }
  </div>
  <p class="plightbox-count" data-lightbox-count aria-live="polite"></p>
</div>

<script>
  const gallery = document.querySelector<HTMLElement>("[data-pgallery]");
  const box = document.querySelector<HTMLElement>("[data-lightbox]");
  if (gallery && box) {
    // Le rétrécissement de type ne suit pas dans les fonctions : on fige la référence.
    const lb: HTMLElement = box;
    const originalButtons = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".pgallery-shot"));
    const shots = originalButtons.map((button) => button.querySelector<HTMLImageElement>("img")!);
    const img = lb.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const count = lb.querySelector<HTMLElement>("[data-lightbox-count]")!;
    const closeBtn = lb.querySelector<HTMLButtonElement>(".plightbox-close")!;
    let index = 0;
    let lastFocused: HTMLElement | null = null;

    // `loading=lazy` charge encore plusieurs diapositives horizontales jugées
    // proches du viewport. Les sources suivantes ne sont donc renseignées que
    // lorsqu'elles approchent réellement de l'écran.
    const hydrate = (source: HTMLImageElement) => {
      if (source.dataset.src) source.src = source.dataset.src;
      if (source.dataset.srcset) source.srcset = source.dataset.srcset;
      source.removeAttribute("data-src");
      source.removeAttribute("data-srcset");
    };
    const deferred = shots.slice(2);
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            hydrate(entry.target as HTMLImageElement);
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "600px" }
      );
      deferred.forEach((source) => observer.observe(source));
    } else {
      deferred.forEach(hydrate);
    }

    const prepareNextImage = (next: number) => {
      // Prépare toujours la prochaine image après la courante, sans lancer le
      // reste de la galerie. Le premier swipe reste ainsi instantané.
      if (shots[next + 1]) hydrate(shots[next + 1]);
    };
    let scrollFrame = 0;
    gallery.addEventListener("scroll", () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = 0;
        // Fonctionne aussi en RTL, où scrollLeft est négatif selon le moteur.
        const galleryCenter = gallery.getBoundingClientRect().left + gallery.clientWidth / 2;
        const current = shots.reduce(
          (closest, source, sourceIndex) => {
            const rect = source.getBoundingClientRect();
            const distance = Math.abs(rect.left + rect.width / 2 - galleryCenter);
            return distance < closest.distance ? { index: sourceIndex, distance } : closest;
          },
          { index: 0, distance: Number.POSITIVE_INFINITY }
        ).index;
        prepareNextImage(current);
      });
    }, { passive: true });
    /*
     * Boucle mobile : un clone du dernier avant le premier, et un clone du
     * premier après le dernier. Quand le snap tombe sur un clone, on revient
     * sans animation sur son original — visuellement la bande est continue.
     * Le clone précédent est hydraté après `load`, donc il ne concurrence pas
     * le LCP. Sur desktop les clones sont masqués et la mosaïque ne change pas.
     */
    let loopTimer: number | undefined;
    if (matchMedia("(max-width: 900px)").matches && originalButtons.length > 1) {
      const firstOriginal = originalButtons[0];
      const lastOriginal = originalButtons[originalButtons.length - 1];
      const before = lastOriginal.cloneNode(true) as HTMLButtonElement;
      const after = firstOriginal.cloneNode(true) as HTMLButtonElement;
      before.classList.add("is-loop-clone");
      after.classList.add("is-loop-clone");
      before.removeAttribute("data-gallery-open");
      after.removeAttribute("data-gallery-open");
      before.setAttribute("aria-hidden", "true");
      after.setAttribute("aria-hidden", "true");
      before.tabIndex = -1;
      after.tabIndex = -1;
      before.querySelector("img")?.setAttribute("alt", "");
      after.querySelector("img")?.setAttribute("alt", "");
      gallery.prepend(before);
      gallery.append(after);

      // Déplacement strictement horizontal : scrollIntoView pourrait aussi
      // faire descendre la page au chargement pour montrer le bas de l'image.
      const alignSlide = (button: HTMLElement) => {
        const galleryRect = gallery.getBoundingClientRect();
        const buttonRect = button.getBoundingClientRect();
        const rtl = getComputedStyle(gallery).direction === "rtl";
        const left = gallery.scrollLeft + (rtl ? buttonRect.right - galleryRect.right : buttonRect.left - galleryRect.left);
        gallery.scrollTo({ left, behavior: "auto" });
      };
      // Le premier original reste la vue initiale malgré le clone ajouté avant.
      alignSlide(firstOriginal);

      const hydrateBefore = () => {
        // Le clone ET sa cible doivent être prêts : sinon le raccord vers le
        // dernier original peut révéler une image vide pendant une frame.
        hydrate(shots[shots.length - 1]);
        const source = before.querySelector<HTMLImageElement>("img");
        if (source) hydrate(source);
      };
      const preparePrevious = () => {
        // Après `load` uniquement : ce clone ne concurrence ni le LCP ni la
        // seconde image, déjà prête pour le premier geste vers l'avant.
        window.setTimeout(hydrateBefore, 250);
      };
      if (document.readyState === "complete") preparePrevious();
      else window.addEventListener("load", preparePrevious, { once: true });

      const normalizeLoop = () => {
        const center = gallery.getBoundingClientRect().left + gallery.clientWidth / 2;
        const visible = Array.from(gallery.querySelectorAll<HTMLButtonElement>(".pgallery-shot")).reduce(
          (closest, button) => {
            const rect = button.getBoundingClientRect();
            const distance = Math.abs(rect.left + rect.width / 2 - center);
            return distance < closest.distance ? { button, distance } : closest;
          },
          { button: firstOriginal, distance: Number.POSITIVE_INFINITY }
        ).button;
        if (visible === before) alignSlide(lastOriginal);
        else if (visible === after) alignSlide(firstOriginal);
      };
      gallery.addEventListener("scroll", () => {
        clearTimeout(loopTimer);
        loopTimer = window.setTimeout(normalizeLoop, 90);
      }, { passive: true });
      before.addEventListener("click", () => open(shots.length - 1));
      after.addEventListener("click", () => open(0));
    }

    function show(i: number) {
      index = (i + shots.length) % shots.length;
      const src = shots[index];
      hydrate(src);
      // Le même srcset que la vignette, avec sizes=100vw : le navigateur prend
      // la plus grande source disponible.
      img.classList.remove("is-in");
      img.src = src.currentSrc || src.src;
      img.srcset = src.srcset;
      img.alt = src.alt;
      // Forcer un rendu entre les deux classes pour que le fondu joue — sans
      // requestAnimationFrame, qui ne vient pas dans un onglet en arrière-plan.
      void img.offsetWidth;
      img.classList.add("is-in");
      count.textContent = `${index + 1} / ${shots.length}`;
      lb.classList.toggle("is-single", shots.length < 2);
      lb.querySelectorAll<HTMLButtonElement>("[data-lightbox-thumb]").forEach((th, k) => {
        const active = k === index;
        th.classList.toggle("is-active", active);
        th.setAttribute("aria-current", active ? "true" : "false");
        if (active && typeof th.scrollIntoView === "function") th.scrollIntoView({ inline: "center", block: "nearest" });
      });
    }
    function open(i: number) {
      lastFocused = document.activeElement as HTMLElement | null;
      lb.hidden = false;
      lb.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      show(i);
      void lb.offsetWidth;
      lb.classList.add("is-open");
      closeBtn.focus();
    }
    function close() {
      lb.classList.remove("is-open");
      lb.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      window.setTimeout(() => {
        lb.hidden = true;
      }, 250);
      lastFocused?.focus();
    }

    for (const btn of gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-open]")) {
      btn.addEventListener("click", () => open(Number(btn.dataset.galleryOpen ?? 0)));
    }
    for (const c of lb.querySelectorAll("[data-lightbox-close]")) c.addEventListener("click", close);
    for (const th of lb.querySelectorAll<HTMLButtonElement>("[data-lightbox-thumb]")) {
      th.addEventListener("click", () => show(Number(th.dataset.lightboxThumb ?? 0)));
    }
    lb.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(index - 1));
    lb.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(index + 1));
    // Le clic sur la photo elle-même : la suivante.
    img.addEventListener("click", () => shots.length > 1 && show(index + 1));
    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") show(index + 1);
      else if (e.key === "ArrowLeft") show(index - 1);
    });
    // Balayage au doigt : un geste horizontal net change de photo.
    let touchX: number | null = null;
    lb.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch") touchX = e.clientX;
    });
    lb.addEventListener("pointerup", (e) => {
      if (touchX === null) return;
      const dx = e.clientX - touchX;
      touchX = null;
      if (Math.abs(dx) < 40) return;
      show(dx < 0 ? index + 1 : index - 1);
    });
  }
</script>

<style>
  .pgallery-shell { position: relative; }
  .pgallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .pgallery-shot {
    display: block;
    padding: 0;
    border: 0;
    aspect-ratio: var(--pgallery-ratio, 720 / 896);
    background: var(--sand);
    overflow: hidden;
    cursor: zoom-in;
  }
  .pgallery-shot.is-loop-clone { display: none; }
  .pgallery-shot:focus-visible { outline: 1px solid var(--ink); outline-offset: -3px; }
  .pgallery-shot.is-full { grid-column: 1 / -1; }
  .pgallery-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ===== Visionneuse ===== */
  .plightbox {
    position: fixed;
    inset: 0;
    /* Au-dessus du panier et de Luma (60). */
    z-index: 70;
    display: grid;
    grid-template-columns: 72px 1fr 72px;
    grid-template-rows: 1fr auto auto;
    align-items: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .plightbox.is-open { opacity: 1; }
  .plightbox[hidden] { display: none; }
  .plightbox-backdrop { position: absolute; inset: 0; background: rgba(241, 238, 233, 0.97); cursor: zoom-out; }
  .plightbox-figure {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 0 8px;
    box-sizing: border-box;
    pointer-events: none;
    min-width: 0;
    min-height: 0;
  }
  .plightbox-img {
    /* Le cadre, et non la résolution intrinsèque du fichier, fixe désormais la
       taille du preview. Toutes les photos d'une galerie occupent donc la même
       surface, comme sur New Oud, même si leurs sources ont des dimensions
       légèrement différentes. */
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    pointer-events: auto;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .plightbox-img.is-in { opacity: 1; transform: none; }
  .plightbox-close,
  .plightbox-nav {
    position: relative;
    z-index: 1;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
    padding: 12px;
    line-height: 0;
  }
  .plightbox-close { position: absolute; top: 16px; inset-inline-end: 16px; }
  .plightbox-nav { grid-row: 1; justify-self: center; opacity: 0.6; transition: opacity 0.2s ease; }
  .plightbox-nav:hover { opacity: 1; }
  .plightbox-prev { grid-column: 1; }
  .plightbox-next { grid-column: 3; }
  [dir="rtl"] .plightbox-nav svg { transform: scaleX(-1); }
  .plightbox.is-single .plightbox-nav { visibility: hidden; }
  /* La rangée de vignettes : toutes les photos, la courante pleine et soulignée d'encre. */
  .plightbox-thumbs {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 14px 24px 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .plightbox-thumbs::-webkit-scrollbar { display: none; }
  .plightbox-thumb {
    flex: 0 0 auto;
    width: 56px;
    height: 70px;
    padding: 0;
    border: 0;
    background: var(--sand);
    overflow: hidden;
    cursor: pointer;
    opacity: 0.5;
    outline: 1px solid transparent;
    outline-offset: 2px;
    transition: opacity 0.2s ease, outline-color 0.2s ease;
  }
  .plightbox-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .plightbox-thumb:hover { opacity: 0.85; }
  .plightbox-thumb.is-active { opacity: 1; outline-color: var(--ink); }
  .plightbox.is-single .plightbox-thumbs { display: none; }
  .plightbox-count {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 3;
    margin: 0;
    padding: 12px 0 20px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.08em;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
  .plightbox-close:focus-visible,
  .plightbox-nav:focus-visible { outline: 1px solid var(--ink); outline-offset: 2px; }

  @media (max-width: 900px) {
    /* Le header garde son sticky natif, comme sur Hears : il reste dans le
       flux au chargement puis se fixe sans changement de mode pendant le
       scroll. Le vrai ratio 4/5 ci-dessous évite le crop qui faisait croire
       que le header mordait sur le haut du flacon. */
    .pgallery {
      display: flex;
      flex-direction: row;
      gap: 2px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .pgallery::-webkit-scrollbar { display: none; }
    .pgallery-shot {
      /* L'image suivante dépasse légèrement : l'invitation au swipe est dans
         la composition elle-même, sans pastille ni pagination superposée. */
      flex: 0 0 calc(100% - 32px);
      scroll-snap-align: start;
      aspect-ratio: 4 / 5;
    }
    .pgallery-shot.is-loop-clone { display: block; }
    /* Permet à la dernière photo de s'aligner elle aussi sur le bord de départ. */
    .pgallery::after { content: ""; flex: 0 0 30px; }
    .plightbox { grid-template-columns: 44px 1fr 44px; }
    .plightbox-figure { padding: 64px 0 8px; }
    .plightbox-thumbs { justify-content: flex-start; padding: 12px 16px 0; }
    .plightbox-thumb { width: 44px; height: 55px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .plightbox,
    .plightbox-img { transition: none; }
  }
</style>
