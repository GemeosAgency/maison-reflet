---
/**
 * Galerie de la fiche produit : images empilées verticalement (desktop),
 * carrousel horizontal à snap sur mobile. Les images sont les photos produit
 * Shopify (la galerie ne vit que là — voir la page).
 */
import type { ResponsiveImage } from "../../lib/sanity";

interface Props {
  images: (ResponsiveImage & { alt: string })[];
  /**
   * Ratio d'un cliché. 720/896 sur la fiche parfum, 1/1 sur la page coffret
   * (maquette Discovery : deux carrés de 720).
   */
  ratio?: string;
}

const { images, ratio = "720 / 896" } = Astro.props;
---

<div class="pgallery" style={`--pgallery-ratio: ${ratio}`}>
  {
    images.map((im, i) => (
      <div class="pgallery-shot">
        <img
          src={im.src}
          srcset={im.srcset}
          sizes="(max-width: 900px) 100vw, 50vw"
          alt={im.alt}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : undefined}
          decoding="async"
        />
      </div>
    ))
  }
</div>

<style>
  .pgallery {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pgallery-shot {
    aspect-ratio: var(--pgallery-ratio, 720 / 896);
    background: var(--sand);
    overflow: hidden;
  }
  .pgallery-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .pgallery {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .pgallery-shot {
      flex: 0 0 100%;
      scroll-snap-align: start;
      aspect-ratio: 4 / 5;
    }
  }
</style>
