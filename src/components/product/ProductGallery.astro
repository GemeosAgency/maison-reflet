---
/**
 * Galerie de la fiche produit : une MOSAÏQUE sur ordinateur (Sandro, 12 sept.
 * 2026 : six photos empilées faisaient un long défilement), un carrousel
 * horizontal à snap sur mobile. Les images sont les photos produit Shopify
 * (la galerie ne vit que là — voir la page), dans l'ordre de Shopify.
 *
 * Le rythme de la mosaïque : la première photo pleine largeur, puis deux
 * détails côte à côte, une pleine largeur, deux côte à côte… Une photo qui
 * resterait seule sur une rangée de paire passe en pleine largeur. Avec les
 * six photos d'Ultra Cuir : flacon · framboises + étiquette · main · bouchon
 * + boîte — quatre rangées au lieu de six.
 */
import type { ResponsiveImage } from "../../lib/sanity";

interface Props {
  images: (ResponsiveImage & { alt: string })[];
  /**
   * Ratio d'un cliché. 720/896 sur la fiche parfum, 1/1 sur la page coffret
   * (maquette Discovery : deux carrés de 720).
   */
  ratio?: string;
}

const { images, ratio = "720 / 896" } = Astro.props;

/** Pleine largeur ou moitié : la première, puis un cycle « paire, paire, pleine ». */
function isFull(i: number, count: number): boolean {
  if (i === 0) return true;
  const pos = (i - 1) % 3; // 0 et 1 : la paire ; 2 : la pleine largeur
  if (pos === 2) return true;
  // Début de paire sans partenaire (dernière photo) : pleine largeur.
  return pos === 0 && i === count - 1;
}
---

<div class="pgallery" style={`--pgallery-ratio: ${ratio}`}>
  {
    images.map((im, i) => (
      <div class:list={["pgallery-shot", { "is-full": isFull(i, images.length) }]}>
        <img
          src={im.src}
          srcset={im.srcset}
          sizes={isFull(i, images.length) ? "(max-width: 900px) 100vw, 50vw" : "(max-width: 900px) 100vw, 25vw"}
          alt={im.alt}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : undefined}
          decoding="async"
        />
      </div>
    ))
  }
</div>

<style>
  .pgallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .pgallery-shot {
    aspect-ratio: var(--pgallery-ratio, 720 / 896);
    background: var(--sand);
    overflow: hidden;
  }
  .pgallery-shot.is-full { grid-column: 1 / -1; }
  .pgallery-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .pgallery {
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .pgallery-shot {
      flex: 0 0 100%;
      scroll-snap-align: start;
      aspect-ratio: 4 / 5;
    }
  }
</style>
