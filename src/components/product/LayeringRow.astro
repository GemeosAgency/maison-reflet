---
/**
 * « Se marie avec » dans le panneau d'achat — une rangée au dessin exact de
 * « Pyramide olfactive » (libellé, le partenaire à droite, le +), qui ouvre
 * le bandeau de droite LayeringDrawer par l'événement `layering:open`. Même
 * découplage que `pyramid:open` : le bandeau est monté par la page, hors du
 * panneau sticky (voir PyramidDrawer pour le pourquoi). Décision Sandro,
 * 12 septembre 2026 : « le bandeau de droite qui s'ouvre comme pour la
 * pyramide olfactive, pour garder la cohérence ».
 * Rien ne s'affiche si le Reflet n'est dans aucun accord (lib/layering.ts).
 */
import { useTranslations, type Locale } from "../../i18n";
import { duosFor } from "../../lib/layering";
import type { ShopifyProduct } from "../../lib/shopify";

interface Props {
  lang: Locale;
  handle: string;
  products: ShopifyProduct[];
}

const { lang, handle, products } = Astro.props;
const t = useTranslations(lang);
const first = duosFor(handle)[0];
const partner = first ? products.find((p) => p.handle === first.partner) : undefined;
---

{
  partner && (
    <button type="button" class="lrow" data-layering-open>
      <span class="lrow-label">{t("layering.title")}</span>
      <span class="lrow-partner">{partner.title}</span>
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M10 4V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
        <path d="M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
      </svg>
    </button>
  )
}

<script>
  document
    .querySelector<HTMLButtonElement>("[data-layering-open]")
    ?.addEventListener("click", () => document.dispatchEvent(new CustomEvent("layering:open")));
</script>

<style>
  .lrow {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border: 0;
    border-top: 1px solid rgba(21, 14, 10, 0.12);
    background: none;
    font: inherit;
    color: inherit;
    text-align: start;
    cursor: pointer;
  }
  .lrow:focus { outline: none; }
  .lrow:focus-visible { outline: 1px solid var(--ink); outline-offset: 3px; }
  .lrow-label { font-size: 14px; font-weight: 500; text-transform: uppercase; }
  .lrow-partner { margin-inline-start: auto; font-size: 16px; font-weight: 500; letter-spacing: 0.96px; }
  .lrow svg { width: 20px; height: 20px; flex-shrink: 0; }
</style>
