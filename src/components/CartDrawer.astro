---
/**
 * Panier — modale coulissante globale (incluse une seule fois dans Layout.astro),
 * ouverte depuis l'icône panier du header sur n'importe quelle page.
 *
 * "Choisis ton échantillon" : détecté automatiquement sur toute variante dont
 * le TITRE contient "sample", "échantillon" ou "2 ml". La section se
 * masque tant que sampleOptions est vide. La gratuité vient de la remise
 * automatique Shopify "Échantillon offert dès 1 flacon 75 ml" — la variante
 * 2 ml est vendable seule à 15 AED.
 *
 * Seuil de livraison offerte : il dépend de la DEVISE du panier, pas d'une
 * constante. Shopify n'a qu'une remise automatique "Free shipping" (minimum
 * 400 AED) qu'il convertit à la volée dans la devise du client ; la table de
 * `src/lib/markets.ts` annonce l'équivalent local, arrondi au-dessus. Sans
 * cela, un panier en euros affichait une barre calée sur 400 — c'est-à-dire
 * une jauge quatre fois trop longue.
 */
import { getAllProducts, getPrimaryVariant, isCoffret, isSampleVariantTitle, shopifyImage } from "../lib/shopify";
import { getInspiredByMap } from "../lib/sanity";
import { LAYERING, accordAudioPath } from "../lib/layering";
import { type Locale, localePath, useTranslations } from "../i18n";
import { DEFAULT_COUNTRY, freeShippingThreshold, getCountry, intlLocale } from "../lib/markets";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allProducts = await getAllProducts();
const inspiredMap = await getInspiredByMap();

// Plus grande vignette du panier : 120 px de côté, soit 240 en densité 2x.
const THUMB_WIDTH = 240;

// Catalogue des suggestions du panier : parfums réels (hors coffrets).
// getPrimaryVariant exclut la variante échantillon (0 AED) — sinon la carte
// ajouterait un échantillon au lieu du parfum plein tarif.
const upsellCatalog = allProducts
  .filter((p) => !isCoffret(p))
  .map((p) => {
    const variant = getPrimaryVariant(p);
    return {
      handle: p.handle,
      title: p.title,
      inspiredBy: inspiredMap[p.handle] ?? null,
      // Vignette de 120 px (240 en densité 2x). Le panier est monté dans
      // Layout.astro, donc ces images partent sur CHAQUE page : servies
      // brutes, c'était jusqu'à 7,4 Mo par parfum.
      img: p.featuredImage ? shopifyImage(p.featuredImage, [THUMB_WIDTH]).src : null,
      variantId: variant.id,
      price: Number(variant.price.amount),
      currency: variant.price.currencyCode,
    };
  });

/*
 * L'accord du parfumeur (lib/layering.ts) : quand un Reflet est dans le panier
 * et pas son partenaire, le tiroir propose le partenaire avec la
 * recommandation audio du parfumeur — le geste qui fait passer d'un flacon à
 * deux. Les données du partenaire (prix, image, variante) viennent de
 * upsellCatalog ; ici seulement le duo, son histoire et son audio.
 */
const accords = LAYERING.map((d) => ({
  id: d.id,
  pair: d.pair,
  name: d.name[lang],
  audio: accordAudioPath(lang, d.id),
}));

// Détection des variantes "échantillon" sur l'ensemble du catalogue.
const sampleOptions = allProducts.flatMap((p) =>
  p.variants.nodes
    .filter((v) => v.availableForSale && isSampleVariantTitle(v.title))
    .map((v) => ({
      productHandle: p.handle,
      productTitle: p.title,
      inspiredBy: inspiredMap[p.handle] ?? null,
      variantId: v.id,
      // Image propre à la variante échantillon si définie dans Shopify,
      // sinon repli sur l'image principale du produit (flacon 75 ml).
      img: (() => {
        const im = v.image ?? p.featuredImage;
        return im ? shopifyImage(im, [THUMB_WIDTH]).src : null;
      })(),
    }))
);

/*
 * Chemin de fiche par handle. Construit côté serveur parce que le tiroir sait
 * distinguer un parfum d'un coffret (isCoffret), alors que les lignes de
 * panier arrivent de la Storefront API au runtime et n'ont que le handle.
 * Une variante échantillon porte le handle de SON parfum : le lien tombe donc
 * bien sur la fiche du parfum.
 */
const productPaths = Object.fromEntries(
  allProducts.map((p) => [
    p.handle,
    localePath(lang, `${isCoffret(p) ? "/coffrets" : "/parfums"}/${p.handle}`),
  ])
);

const FREE_SHIPPING_THRESHOLD = freeShippingThreshold(getCountry(DEFAULT_COUNTRY).currency);
---

<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer-backdrop" data-cart-drawer-backdrop></div>
  <aside class="cart-drawer-panel" role="dialog" aria-label={t("cart.bagTitle")}>
    <button type="button" class="cart-drawer-close" data-cart-drawer-close aria-label={t("cart.close")}>
      <img src="/brand/close.svg" alt="" width="16" height="16" />
    </button>

    <div class="cart-drawer-scroll">
      <div class="cart-drawer-header">
        <h2 class="cart-drawer-title">
          {t("cart.bagTitle")} <span data-cart-drawer-count>0</span>
        </h2>
        <div class="cart-shipping">
          <div class="cart-shipping-row">
            <span data-cart-shipping-msg></span>
            <span class="cart-shipping-static">{t("cart.freeShippingLabel")}</span>
          </div>
          <div class="cart-shipping-track">
            <div class="cart-shipping-fill" data-cart-shipping-fill></div>
            <div class="cart-shipping-thumb" data-cart-shipping-thumb></div>
          </div>
        </div>
      </div>

      <div class="cart-drawer-divider"></div>

      <div data-cart-drawer-lines class="cart-drawer-lines"></div>

      <div class="cart-drawer-divider" data-cart-sample-divider hidden></div>
      <div class="cart-sample" data-cart-sample-section hidden>
        <div class="cart-sample-head">
          <p>{t("cart.selectSample")}</p>
          <span class="cart-badge">{t("cart.free")}</span>
        </div>
        <button type="button" class="cart-sample-row" data-cart-sample-toggle>
          <img data-cart-sample-img alt="" width="48" height="48" />
          <span data-cart-sample-label></span>
          <img src="/brand/chevron.svg" class="chev-down" alt="" width="8" height="8" />
        </button>
        <ul class="cart-sample-options" data-cart-sample-options hidden></ul>
      </div>

      {/* L'accord du parfumeur : le Reflet qui se marie avec celui du panier, sa recommandation à écouter, un geste pour l'ajouter. */}
      <div class="cart-drawer-divider" data-cart-accord-divider hidden></div>
      <div class="cart-accord" data-cart-accord-section hidden>
        <p class="cart-upsell-title">{t("cart.accordTitle")}</p>
        <div data-cart-accord-body></div>
      </div>

      {/*
        Suggestions du panier. C'était la mécanique « 2 achetés, le 3e
        offert » (barre de progression, décompte, pastille OFFERT), retirée
        en septembre 2026 — l'offre n'a plus cours et la remise automatique
        Shopify est désactivée. Il reste une simple sélection de parfums
        absents du panier, sous le même titre que sur la fiche produit.
      */}
      <div class="cart-drawer-divider" data-cart-upsell-divider hidden></div>
      <div class="cart-upsell" data-cart-upsell-section hidden>
        <p class="cart-upsell-title">{t("product.related")}</p>
        <div class="cart-upsell-scroll" data-cart-upsell-list></div>
      </div>
    </div>

    <div class="cart-drawer-footer">
      <div class="cart-drawer-subtotal-row">
        <span>{t("cart.subtotal")}</span>
        <strong data-cart-drawer-subtotal></strong>
      </div>
      <a class="cart-drawer-checkout" data-cart-drawer-checkout href="#">{t("cart.checkout")}</a>
      <ul class="cart-drawer-perks">
        <li><img src="/brand/reassurance-livraison.svg" alt="" width="20" height="20" /> {t("cart.perkShipping")}</li>
        <li><img src="/brand/reassurance-cadeau.svg" alt="" width="20" height="20" /> {t("cart.perkGift")}</li>
      </ul>
    </div>
  </aside>
</div>

<script type="application/json" id="cart-upsell-catalog" is:inline set:html={JSON.stringify(upsellCatalog)} />
<script type="application/json" id="cart-sample-options" is:inline set:html={JSON.stringify(sampleOptions)} />
<script type="application/json" id="cart-product-paths" is:inline set:html={JSON.stringify(productPaths)} />
<script type="application/json" id="cart-accords" is:inline set:html={JSON.stringify(accords)} />
<script
  type="application/json"
  id="cart-drawer-i18n"
  is:inline
  set:html={JSON.stringify({
    freeShippingRemaining: t("cart.freeShippingRemaining"),
    freeShippingUnlocked: t("cart.freeShippingUnlocked"),
    free: t("cart.free"),
    add: t("cart.add"),
    added: t("cart.added"),
    remove: t("cart.remove"),
    decrease: t("cart.decrease"),
    increase: t("cart.increase"),
    empty: t("cart.empty"),
    error: t("cart.error"),
    inspiredBy: t("product.inspiredBy"),
    accordWith: t("cart.accordWith"),
    accordListen: t("layering.recommendation"),
    threshold: FREE_SHIPPING_THRESHOLD,
    thumbWidth: THUMB_WIDTH,
  })}
/>

<script>
  import {
    loadCart,
    addToCart,
    removeFromCart,
    setVariantQuantity,
    swapCartLine,
    trackCheckoutDeparture,
    visibleQuantity,
  } from "../lib/cart";
  import { formatPrice, type ShopifyCart } from "../lib/shopify";
  import { freeShippingThreshold, intlLocale } from "../lib/markets";
  import { getActiveCurrency, hydratePrices, pageLocale } from "../lib/country";
  import type { CartUpdatedEvent } from "../lib/cart";

  type UpsellItem = {
    handle: string;
    title: string;
    inspiredBy: string | null;
    img: string | null;
    variantId: string;
    price: number;
    currency: string;
  };
  type Accord = { id: string; pair: [string, string]; name: string; audio: string | null };
  type SampleOption = {
    productHandle: string;
    productTitle: string;
    inspiredBy: string | null;
    variantId: string;
    img: string | null;
  };

  const upsellCatalog: UpsellItem[] = JSON.parse(
    document.getElementById("cart-upsell-catalog")?.textContent ?? "[]"
  );
  const productPaths: Record<string, string> = JSON.parse(
    document.getElementById("cart-product-paths")?.textContent ?? "{}"
  );
  /** Lien vers la fiche produit, ou null pour un handle inconnu du catalogue. */
  const productHref = (handle: string): string | null => productPaths[handle] ?? null;
  const sampleOptions: SampleOption[] = JSON.parse(
    document.getElementById("cart-sample-options")?.textContent ?? "[]"
  );
  const accords: Accord[] = JSON.parse(document.getElementById("cart-accords")?.textContent ?? "[]");
  const I18N = JSON.parse(document.getElementById("cart-drawer-i18n")?.textContent ?? "{}");
  /**
   * Seuil applicable à la devise du panier. Le panier peut basculer de devise
   * en cours de session (changement de pays), d'où une lecture à chaque rendu
   * plutôt qu'une constante figée au chargement.
   */
  const thresholdFor = (currency: string): number =>
    freeShippingThreshold(currency) || I18N.threshold || 400;
  const THUMB_WIDTH: number = I18N.thumbWidth ?? 240;

  const drawer = document.querySelector<HTMLElement>("[data-cart-drawer]");
  const backdrop = drawer?.querySelector<HTMLElement>("[data-cart-drawer-backdrop]");
  const closeBtn = drawer?.querySelector<HTMLButtonElement>("[data-cart-drawer-close]");
  const countEl = drawer?.querySelector<HTMLElement>("[data-cart-drawer-count]");
  const shippingMsg = drawer?.querySelector<HTMLElement>("[data-cart-shipping-msg]");
  const shippingFill = drawer?.querySelector<HTMLElement>("[data-cart-shipping-fill]");
  const shippingThumb = drawer?.querySelector<HTMLElement>("[data-cart-shipping-thumb]");
  const linesEl = drawer?.querySelector<HTMLElement>("[data-cart-drawer-lines]");
  const sampleDivider = drawer?.querySelector<HTMLElement>("[data-cart-sample-divider]");
  const sampleSection = drawer?.querySelector<HTMLElement>("[data-cart-sample-section]");
  const sampleImg = drawer?.querySelector<HTMLImageElement>("[data-cart-sample-img]");
  const sampleLabel = drawer?.querySelector<HTMLElement>("[data-cart-sample-label]");
  const sampleToggle = drawer?.querySelector<HTMLButtonElement>("[data-cart-sample-toggle]");
  const sampleOptionsList = drawer?.querySelector<HTMLElement>("[data-cart-sample-options]");
  const accordDivider = drawer?.querySelector<HTMLElement>("[data-cart-accord-divider]");
  const accordSection = drawer?.querySelector<HTMLElement>("[data-cart-accord-section]");
  const accordBody = drawer?.querySelector<HTMLElement>("[data-cart-accord-body]");
  const upsellDivider = drawer?.querySelector<HTMLElement>("[data-cart-upsell-divider]");
  const upsellSection = drawer?.querySelector<HTMLElement>("[data-cart-upsell-section]");
  const upsellList = drawer?.querySelector<HTMLElement>("[data-cart-upsell-list]");
  const subtotalEl = drawer?.querySelector<HTMLElement>("[data-cart-drawer-subtotal]");
  const checkoutLink = drawer?.querySelector<HTMLAnchorElement>("[data-cart-drawer-checkout]");

  let currentCart: ShopifyCart | null = null;
  let reconciling = false;

  // InitiateCheckout Meta + rafraîchissement des ids publicitaires du panier,
  // sans bloquer la navigation vers le checkout (voir lib/cart.ts).
  checkoutLink?.addEventListener("click", () => {
    trackCheckoutDeparture(currentCart);
  });

  function openDrawer() {
    drawer?.classList.add("is-open");
    drawer?.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }
  function closeDrawer() {
    stopAccordAudio();
    drawer?.classList.remove("is-open");
    drawer?.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    sampleOptionsList?.setAttribute("hidden", "");
  }

  document.addEventListener("cart:open", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDrawer();
  });

  /**
   * Borne la largeur d'une image du CDN Shopify.
   *
   * Les lignes de panier viennent de la Storefront API au runtime, pas du
   * build : elles ne passent donc pas par shopifyImage() de lib/shopify.ts.
   * Sans le paramètre `width`, le CDN sert le fichier d'origine — jusqu'à
   * 7,4 Mo pour un rendu de flacon — dans une vignette de 120 px.
   */
  function sizedUrl(url: string, width: number): string {
    try {
      const u = new URL(url);
      u.searchParams.set("width", String(width));
      return u.href;
    } catch {
      return url; // URL relative ou malformée : on n'y touche pas
    }
  }

  type GroupedLine = {
    variantId: string;
    productTitle: string;
    variantTitle: string;
    handle: string;
    img: { url: string } | null;
    quantity: number;
    amount: number;
    currency: string;
  };

  /**
   * Regroupe les lignes par variante : une remise automatique Shopify peut
   * scinder une même variante en plusieurs lignes de panier (unités payantes
   * + unité remisée à 0) — on les fusionne en une seule ligne affichée,
   * quantité et montant sommés.
   */
  function groupLines(cart: ShopifyCart | null): GroupedLine[] {
    const groups = new Map<string, GroupedLine>();
    for (const line of cart?.lines.nodes ?? []) {
      if (sampleOptions.some((s) => s.variantId === line.merchandise.id)) continue;
      const existing = groups.get(line.merchandise.id);
      if (existing) {
        existing.quantity += line.quantity;
        existing.amount += Number(line.cost.totalAmount.amount);
      } else {
        groups.set(line.merchandise.id, {
          variantId: line.merchandise.id,
          productTitle: line.merchandise.product.title,
          variantTitle: line.merchandise.title,
          handle: line.merchandise.product.handle,
          img: line.merchandise.product.featuredImage,
          quantity: line.quantity,
          amount: Number(line.cost.totalAmount.amount),
          currency: line.cost.totalAmount.currencyCode,
        });
      }
    }
    return Array.from(groups.values());
  }

  function lineHtml(line: GroupedLine): string {
    const catalogEntry = upsellCatalog.find((p) => p.handle === line.handle);
    // Ligne remisée à 0 par une remise automatique Shopify (voir groupLines) :
    // on annonce le cadeau via le badge plutôt que d'afficher un prix à 0.
    const priceHtml =
      line.amount === 0
        ? `<span class="cart-badge">${I18N.free}</span>`
        : `<span class="cart-line-price">${formatPrice(String(line.amount), line.currency, intlLocale(pageLocale()))}</span>`;
    // Vignette et nom cliquables vers la fiche. Pas la ligne entière : elle
    // contient les boutons de quantité et « Retirer ».
    const href = productHref(line.handle);
    const nom = `<span class="cart-line-title">${line.productTitle}</span>${line.variantTitle !== "Default Title" ? ` · ${line.variantTitle}` : ""}`;
    const vignette = line.img
      ? `<img class="cart-line-img" src="${sizedUrl(line.img.url, THUMB_WIDTH)}" alt="${line.productTitle}" width="120" height="120" />`
      : "";
    return `
      <div class="cart-line" data-variant-id="${line.variantId}">
        ${vignette && href ? `<a class="cart-line-img-link" href="${href}" tabindex="-1" aria-hidden="true">${vignette}</a>` : vignette}
        <div class="cart-line-body">
          <div class="cart-line-text">
            <div class="cart-line-top">
              ${href ? `<a class="cart-line-name" href="${href}">${nom}</a>` : `<span class="cart-line-name">${nom}</span>`}
              ${priceHtml}
            </div>
            ${catalogEntry?.inspiredBy ? `<p class="cart-line-inspired">${I18N.inspiredBy} ${catalogEntry.inspiredBy}</p>` : ""}
          </div>
          <div class="cart-line-bottom">
            <div class="cart-line-qty">
              <button type="button" class="cart-qty-btn" data-line-decrease aria-label="${I18N.decrease}">
                <svg viewBox="0 0 20 20" fill="none"><path d="M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </button>
              <span class="cart-qty-value">${line.quantity}</span>
              <button type="button" class="cart-qty-btn" data-line-increase aria-label="${I18N.increase}">
                <svg viewBox="0 0 20 20" fill="none"><path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              </button>
            </div>
            <button type="button" class="cart-line-remove" data-line-remove>${I18N.remove}</button>
          </div>
        </div>
      </div>`;
  }

  function upsellCardHtml(p: UpsellItem): string {
    // Les prix des suggestions viennent du catalogue cuit au build (AED) :
    // `data-money` les fait relire dans la devise du pays choisi, comme
    // partout ailleurs dans la page.
    const price = `<span class="cart-upsell-price" data-money="${p.variantId}">${formatPrice(String(p.price), p.currency, intlLocale(pageLocale()))}</span>`;
    const href = productHref(p.handle);
    const vignette = p.img ? `<img src="${p.img}" alt="${p.title}" width="120" height="120" />` : "";
    return `
      <div class="cart-upsell-card">
        ${vignette && href ? `<a class="cart-upsell-card-img-link" href="${href}" tabindex="-1" aria-hidden="true">${vignette}</a>` : vignette}
        <div class="cart-upsell-card-body">
          <div class="cart-upsell-card-text">
            ${href ? `<a class="cart-upsell-card-name" href="${href}">${p.title}</a>` : `<p class="cart-upsell-card-name">${p.title}</p>`}
            ${p.inspiredBy ? `<p class="cart-upsell-card-inspired">${I18N.inspiredBy} ${p.inspiredBy}</p>` : ""}
          </div>
          <div class="cart-upsell-cta">
            <button type="button" class="cart-upsell-add" data-add-to-cart data-variant-id="${p.variantId}">
              <svg viewBox="0 0 20 20" fill="none"><path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              <span data-reco-add-label>${I18N.add}</span>
            </button>
            ${price}
          </div>
        </div>
      </div>`;
  }

  /* ------------------------------------------------ l'accord du parfumeur */

  function accordHtml(a: Accord, mine: UpsellItem, partner: UpsellItem): string {
    const href = productHref(partner.handle);
    const price = `<span class="cart-upsell-price" data-money="${partner.variantId}">${formatPrice(String(partner.price), partner.currency, intlLocale(pageLocale()))}</span>`;
    const vignette = partner.img ? `<img src="${partner.img}" alt="${partner.title}" width="120" height="120" />` : "";
    // Même ligne d'écoute que les portraits (LumaListen) : bouton rond, libellé, durée, onde en lecture.
    const listen = a.audio
      ? `
        <div class="cart-accord-listen" data-accord-listen data-src="${a.audio}">
          <button type="button" class="cart-accord-play" data-accord-play aria-label="${I18N.accordListen}" aria-pressed="false">
            <svg class="cart-accord-ico-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1.5v9l8-4.5z" fill="currentColor"/></svg>
            <svg class="cart-accord-ico-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 1.5h2.5v9h-2.5zM7 1.5h2.5v9H7z" fill="currentColor"/></svg>
            <span class="cart-accord-eq" aria-hidden="true"><i></i><i></i><i></i></span>
          </button>
          <span class="cart-accord-listen-label">${I18N.accordListen}</span>
          <span class="cart-accord-time" data-accord-time aria-hidden="true">–:––</span>
        </div>`
      : "";
    return `
      <div class="cart-accord-card">
        ${vignette && href ? `<a class="cart-upsell-card-img-link" href="${href}" tabindex="-1" aria-hidden="true">${vignette}</a>` : vignette}
        <div class="cart-accord-body">
          <p class="cart-accord-kicker">${a.name} · ${I18N.accordWith.replace("{name}", mine.title)}</p>
          ${href ? `<a class="cart-upsell-card-name" href="${href}">${partner.title}</a>` : `<p class="cart-upsell-card-name">${partner.title}</p>`}
          ${listen}
          <div class="cart-upsell-cta">
            <button type="button" class="cart-upsell-add" data-add-to-cart data-variant-id="${partner.variantId}">
              <svg viewBox="0 0 20 20" fill="none"><path d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              <span data-reco-add-label>${I18N.add}</span>
            </button>
            ${price}
          </div>
        </div>
      </div>`;
  }

  /*
   * Un seul lecteur pour la recommandation, créé au premier besoin. Il porte
   * data-listen-audio pour que les autres lecteurs de la page (portraits) le
   * mettent en pause quand ils démarrent, et le jeton data-user-play attendu
   * par la garde globale de Layout (aucune lecture sans geste). Après la fin
   * ou la fermeture du tiroir, la source est relâchée : rien à reprendre pour
   * une touche média ou un casque (le « fantôme » audio de septembre).
   */
  let accordAudio: HTMLAudioElement | null = null;
  const accordDurations = new Map<string, number>();
  const fmtTime = (sec: number) => (Number.isFinite(sec) ? `${Math.floor(sec / 60)}:${String(Math.floor(sec % 60)).padStart(2, "0")}` : "–:––");

  function accordPlayer(): HTMLAudioElement {
    if (accordAudio) return accordAudio;
    const a = document.createElement("audio");
    a.preload = "metadata";
    a.hidden = true;
    a.setAttribute("data-listen-audio", "");
    drawer?.append(a);
    for (const ev of ["play", "pause", "timeupdate", "loadedmetadata", "durationchange"]) a.addEventListener(ev, renderAccordPlayer);
    a.addEventListener("loadedmetadata", () => {
      const src = a.getAttribute("src");
      if (src && Number.isFinite(a.duration)) accordDurations.set(src, a.duration);
    });
    a.addEventListener("ended", () => {
      releaseAccordAudio();
      renderAccordPlayer();
    });
    accordAudio = a;
    return a;
  }
  function releaseAccordAudio() {
    if (!accordAudio) return;
    accordAudio.pause();
    accordAudio.removeAttribute("src");
    accordAudio.load();
  }
  function stopAccordAudio() {
    releaseAccordAudio();
    renderAccordPlayer();
  }
  function renderAccordPlayer() {
    const wrap = accordBody?.querySelector<HTMLElement>("[data-accord-listen]");
    if (!wrap) return;
    const src = wrap.dataset.src ?? "";
    const a = accordAudio;
    const same = !!a && a.getAttribute("src") === src;
    const playing = same && !a!.paused && !a!.ended;
    wrap.classList.toggle("is-playing", playing);
    wrap.querySelector("[data-accord-play]")?.setAttribute("aria-pressed", String(playing));
    const time = wrap.querySelector<HTMLElement>("[data-accord-time]");
    if (time) {
      const known = accordDurations.get(src);
      time.textContent = same && (playing || a!.currentTime > 0) ? fmtTime(a!.currentTime) : fmtTime(known ?? (same ? a!.duration : NaN));
    }
  }
  drawer?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>("[data-accord-play]");
    if (!btn || !e.isTrusted) return;
    const src = btn.closest<HTMLElement>("[data-accord-listen]")?.dataset.src;
    if (!src) return;
    const a = accordPlayer();
    if (a.getAttribute("src") !== src) {
      a.setAttribute("src", src);
      a.load();
    }
    if (a.paused) {
      for (const other of document.querySelectorAll<HTMLAudioElement>("[data-listen-audio]")) if (other !== a) other.pause();
      a.dataset.userPlay = "1";
      a.play().catch(() => {});
    } else a.pause();
  });

  /*
   * Réconciliation de l'échantillon offert.
   *
   * Renvoie le panier tel que Shopify le rend APRÈS la mutation, ou null si
   * rien n'était à faire. C'est l'appelant (render) qui réaffiche ce panier :
   * pendant la mutation, l'événement cart:updated est volontairement ignoré
   * (voir `reconciling`), donc sans ce retour l'écran restait figé sur l'état
   * d'avant — un panier vidé de ses parfums affichait encore « SAC 1 » et une
   * barre de livraison calée sur les 15 AED de l'échantillon.
   *
   * `lastAttempt` mémorise l'état de panier sur lequel une mutation vient
   * d'être tentée : si Shopify renvoie exactement le même état (variante
   * indisponible, userError…), on n'insiste pas — sinon render et
   * ensureSampleLine se relanceraient l'un l'autre sans fin.
   */
  let lastAttempt = "";
  const cartSignature = (cart: ShopifyCart) =>
    cart.lines.nodes.map((l) => `${l.merchandise.id}:${l.quantity}`).sort().join("|");
  const isSampleLine = (l: ShopifyCart["lines"]["nodes"][number]) =>
    sampleOptions.some((s) => s.variantId === l.merchandise.id);

  async function ensureSampleLine(
    cart: ShopifyCart,
    desiredVariantId?: string
  ): Promise<ShopifyCart | null> {
    if (reconciling || sampleOptions.length === 0) return null;
    const eligible = cart.lines.nodes.some((l) =>
      upsellCatalog.some((p) => p.variantId === l.merchandise.id)
    );
    const sampleLines = cart.lines.nodes.filter(isSampleLine);
    const existingSampleLine = sampleLines[0];
    const target = desiredVariantId ?? existingSampleLine?.merchandise.id ?? sampleOptions[0]?.variantId;

    // Un seul échantillon, en un seul exemplaire : un deuxième onglet ou deux
    // réconciliations croisées peuvent avoir fusionné deux ajouts en une
    // ligne à quantité 2 — dont une unité payante (la remise n'en offre
    // qu'une par commande).
    const needsFix =
      (!eligible && sampleLines.length > 0) ||
      (eligible &&
        !!target &&
        (existingSampleLine?.merchandise.id !== target ||
          existingSampleLine.quantity !== 1 ||
          sampleLines.length > 1));
    if (!needsFix) {
      lastAttempt = "";
      return null;
    }

    const signature = cartSignature(cart) + (desiredVariantId ? `>${desiredVariantId}` : "");
    if (signature === lastAttempt) return null;
    lastAttempt = signature;

    reconciling = true;
    try {
      let next: ShopifyCart | null = cart;
      if (!eligible) {
        for (const line of sampleLines) next = (await removeFromCart(line.id)) ?? next;
        return next;
      }
      for (const extra of sampleLines.slice(1)) next = (await removeFromCart(extra.id)) ?? next;
      if (existingSampleLine) {
        // Une seule mutation : la ligne change de variante (et revient à
        // quantité 1). Le retrait suivi d'un ajout coûtait deux
        // allers-retours et faisait disparaître l'échantillon entre les deux.
        next = (await swapCartLine(existingSampleLine.id, target!)) ?? next;
      } else {
        // Ajout technique : il peut survenir au chargement de la page (panier
        // éligible sans ligne échantillon), le tiroir n'a pas à surgir, et ce
        // n'est pas un achat à déclarer aux régies (track: false).
        next = await addToCart(target!, 1, { openDrawer: false, track: false });
      }
      return next;
    } finally {
      reconciling = false;
    }
  }

  /** Lance la réconciliation et réaffiche le panier qu'elle renvoie. */
  function reconcileAndRender(cart: ShopifyCart) {
    ensureSampleLine(cart)
      .then((next) => {
        if (next) render(next);
      })
      .catch(() => {
        // Réseau ou Shopify indisponible : l'affichage courant reste, le
        // prochain cart:updated retentera.
      });
  }

  function render(cart: ShopifyCart | null) {
    currentCart = cart;
    if (countEl) countEl.textContent = String(visibleQuantity(cart));

    // Lignes du panier (regroupées par variante — voir groupLines)
    const grouped = groupLines(cart);
    if (linesEl) {
      linesEl.innerHTML = grouped.length
        ? grouped.map(lineHtml).join("")
        : `<p class="cart-empty">${I18N.empty}</p>`;
    }

    // Livraison offerte
    const currency = cart?.cost.subtotalAmount.currencyCode ?? getActiveCurrency();
    const money = (amount: string | number) =>
      formatPrice(String(amount), currency, intlLocale(pageLocale()));
    const threshold = thresholdFor(currency);
    const subtotal = Number(cart?.cost.subtotalAmount.amount ?? 0);
    const pct = Math.max(0, Math.min(100, (subtotal / threshold) * 100));
    if (shippingFill) shippingFill.style.width = `${pct}%`;
    if (shippingThumb) shippingThumb.style.left = `${pct}%`;
    if (shippingMsg) {
      const remaining = threshold - subtotal;
      shippingMsg.textContent =
        remaining > 0
          ? I18N.freeShippingRemaining.replace("{amount}", money(remaining))
          : I18N.freeShippingUnlocked;
    }

    // Échantillon offert
    const hasSampleFeature = sampleOptions.length > 0;
    const existingSample = cart?.lines.nodes.find((l) =>
      sampleOptions.some((s) => s.variantId === l.merchandise.id)
    );
    const showSample = hasSampleFeature && !!existingSample;
    sampleDivider?.toggleAttribute("hidden", !showSample);
    sampleSection?.toggleAttribute("hidden", !showSample);
    if (showSample && existingSample) {
      const opt = sampleOptions.find((s) => s.variantId === existingSample.merchandise.id);
      if (opt) {
        if (sampleImg) {
          sampleImg.src = opt.img ?? "";
          sampleImg.alt = opt.productTitle;
        }
        if (sampleLabel) {
          sampleLabel.textContent = [opt.productTitle, opt.inspiredBy ? `${I18N.inspiredBy} ${opt.inspiredBy}` : null]
            .filter(Boolean)
            .join(" · ");
        }
      }
      if (sampleOptionsList) {
        sampleOptionsList.innerHTML = sampleOptions
          .map(
            (s) => `
          <li>
            <button type="button" class="cart-sample-option" data-sample-variant="${s.variantId}">
              ${s.img ? `<img src="${s.img}" alt="" width="32" height="32" />` : ""}
              <span>${[s.productTitle, s.inspiredBy ? `${I18N.inspiredBy} ${s.inspiredBy}` : null].filter(Boolean).join(" · ")}</span>
            </button>
          </li>`
          )
          .join("");
      }
    }

    // L'accord du parfumeur : le premier flacon (pas l'échantillon) du panier
    // dont le partenaire d'accord manque. Un seul à la fois — c'est une
    // recommandation, pas un rayon.
    const fullBottles = grouped.filter((l) => !sampleOptions.some((s) => s.variantId === l.variantId)).map((l) => l.handle);
    const bottlesInCart = new Set(fullBottles);
    let accordPick: { a: Accord; mine: UpsellItem; partner: UpsellItem } | null = null;
    for (const handle of fullBottles) {
      const a = accords.find((d) => d.pair.includes(handle));
      if (!a) continue;
      const partnerHandle = a.pair[0] === handle ? a.pair[1] : a.pair[0];
      if (bottlesInCart.has(partnerHandle)) continue;
      const mine = upsellCatalog.find((p) => p.handle === handle);
      const partner = upsellCatalog.find((p) => p.handle === partnerHandle);
      if (mine && partner) {
        accordPick = { a, mine, partner };
        break;
      }
    }
    accordDivider?.toggleAttribute("hidden", !accordPick);
    accordSection?.toggleAttribute("hidden", !accordPick);
    if (accordBody) {
      const currentSrc = accordBody.querySelector<HTMLElement>("[data-accord-listen]")?.dataset.src ?? null;
      if (!accordPick || accordPick.a.audio !== currentSrc) stopAccordAudio();
      accordBody.innerHTML = accordPick ? accordHtml(accordPick.a, accordPick.mine, accordPick.partner) : "";
      if (accordPick) {
        void hydratePrices(accordBody);
        // La durée s'affiche avant la lecture : on charge les métadonnées du fichier (quelques ko).
        if (accordPick.a.audio && !accordDurations.has(accordPick.a.audio)) {
          const a = accordPlayer();
          if (a.getAttribute("src") !== accordPick.a.audio) {
            a.setAttribute("src", accordPick.a.audio);
            a.load();
          }
        }
        renderAccordPlayer();
      }
    }

    // Suggestions : les parfums qui ne sont pas déjà dans le panier. Masquées
    // quand le panier est vide (rien à compléter) et quand l'accord du
    // parfumeur est affiché — une Maison recommande, elle n'étale pas un rayon
    // (Sandro, 12 sept. : « too much en plus de l'accord »). Elles ne
    // reviennent que sans accord : coffret seul, ou les deux flacons d'un
    // accord déjà dans le sac.
    const inCart = new Set((cart?.lines.nodes ?? []).map((l) => l.merchandise.product.handle));
    const suggestions = upsellCatalog.filter((p) => !inCart.has(p.handle));
    const showUpsell = grouped.length > 0 && suggestions.length > 0 && !accordPick;
    upsellDivider?.toggleAttribute("hidden", !showUpsell);
    upsellSection?.toggleAttribute("hidden", !showUpsell);
    if (showUpsell && upsellList) {
      upsellList.innerHTML = suggestions.map(upsellCardHtml).join("");
      void hydratePrices(upsellList);
    }

    // Sous-total + checkout
    if (subtotalEl) {
      subtotalEl.textContent = money(cart?.cost.subtotalAmount.amount ?? 0);
    }
    if (checkoutLink) checkoutLink.href = cart?.checkoutUrl ?? "#";

    if (cart) reconcileAndRender(cart);
  }

  /*
   * Quantité : affichage immédiat, envoi regroupé.
   *
   * Avant, un clic sur + ou − attendait la réponse de Shopify avant de bouger
   * d'un pixel, et chaque clic lançait sa propre série de mutations : quatre
   * clics rapprochés faisaient quatre allers-retours en file, à la queue les
   * uns des autres. Désormais le nombre change tout de suite et seule la
   * DERNIÈRE valeur part au serveur.
   *
   * Les montants, eux, attendent la réponse : une remise automatique ne se
   * recalcule pas au prorata (le 3e exemplaire est offert), donc un total
   * deviné à l'écran sauterait ensuite à la correction. Mieux vaut le laisser
   * pâlir un instant — voir `.is-pending` dans les styles.
   */
  const pendingQty = new Map<string, number>();
  let flushTimer: number | undefined;

  function displayedQuantity(variantId: string): number {
    const queued = pendingQty.get(variantId);
    if (queued !== undefined) return queued;
    return groupLines(currentCart).find((g) => g.variantId === variantId)?.quantity ?? 0;
  }

  function queueQuantity(variantId: string, quantity: number) {
    const next = Math.max(0, quantity);
    pendingQty.set(variantId, next);

    const lineEl = linesEl?.querySelector<HTMLElement>(`.cart-line[data-variant-id="${variantId}"]`);
    if (lineEl) {
      const value = lineEl.querySelector<HTMLElement>(".cart-qty-value");
      if (value) value.textContent = String(next);
      lineEl.classList.add("is-pending");
      if (next === 0) lineEl.hidden = true;
    }
    // Le compteur du sac suit tout de suite : c'est une somme d'unités, pas
    // un prix, on peut la deviner sans risque.
    if (countEl && currentCart) {
      const avant = groupLines(currentCart).find((g) => g.variantId === variantId)?.quantity ?? 0;
      countEl.textContent = String(Math.max(0, visibleQuantity(currentCart) + next - avant));
    }

    window.clearTimeout(flushTimer);
    flushTimer = window.setTimeout(flushQuantities, 260);
  }

  async function flushQuantities() {
    const jobs = [...pendingQty.entries()];
    pendingQty.clear();
    let cart = currentCart;
    for (const [variantId, quantity] of jobs) {
      cart = await setVariantQuantity(variantId, quantity, cart);
    }
    render(cart);
  }

  // Délégation sur le conteneur des lignes, reconstruit à chaque rendu
  linesEl?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const lineEl = target.closest<HTMLElement>("[data-variant-id]");
    const variantId = lineEl?.dataset.variantId;
    if (!variantId || !currentCart) return;

    if (target.closest("[data-line-remove]")) {
      queueQuantity(variantId, 0);
    } else if (target.closest("[data-line-increase]")) {
      queueQuantity(variantId, displayedQuantity(variantId) + 1);
    } else if (target.closest("[data-line-decrease]")) {
      queueQuantity(variantId, displayedQuantity(variantId) - 1);
    }
  });

  // Choix de l'échantillon
  sampleToggle?.addEventListener("click", () => {
    sampleOptionsList?.toggleAttribute("hidden");
  });
  sampleOptionsList?.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-sample-variant]");
    const variantId = btn?.dataset.sampleVariant;
    if (!variantId || !currentCart) return;
    sampleOptionsList.setAttribute("hidden", "");

    /*
     * Le choix s'affiche IMMÉDIATEMENT. Avant, on attendait l'aller-retour
     * Shopify : la ligne était retirée, un rendu intermédiaire vidait la
     * section, puis l'ajout la remplissait — d'où l'échantillon qui
     * disparaissait avant de revenir.
     */
    const opt = sampleOptions.find((s) => s.variantId === variantId);
    if (opt) {
      if (sampleImg) {
        sampleImg.src = opt.img ?? "";
        sampleImg.alt = opt.productTitle;
      }
      if (sampleLabel) {
        sampleLabel.textContent = [
          opt.productTitle,
          opt.inspiredBy ? `${I18N.inspiredBy} ${opt.inspiredBy}` : null,
        ]
          .filter(Boolean)
          .join(" · ");
      }
    }

    // Le panier renvoyé par la mutation suffit : pas de loadCart en plus.
    const next = await ensureSampleLine(currentCart, variantId);
    render(next ?? currentCart);
  });

  // Les cartes upsell utilisent [data-add-to-cart] : gérées par le câblage
  // global (initAddToCartButtons, voir Layout.astro) — pas de code ici.
  document.addEventListener("cart:updated", (e) => {
    const cart = (e as CartUpdatedEvent).detail.cart;
    // Un rendu reconstruit les lignes : le faire alors qu'un clic sur +/- est
    // encore en attente d'envoi effacerait le nombre que le visiteur vient de
    // voir changer. On garde le panier de côté, le prochain flush rendra.
    // Idem pendant un échange d'échantillon : le rendu intermédiaire est
    // exactement ce qui faisait clignoter la section (voir ensureSampleLine).
    if (pendingQty.size > 0 || reconciling) {
      currentCart = cart;
      return;
    }
    render(cart);
  });

  loadCart()
    .then(render)
    .catch(() => render(null));
</script>

<style is:global>
  /*
   * is:global volontaire : une bonne partie du contenu (lignes du panier,
   * cartes upsell, options d'échantillon) est injectée via innerHTML côté
   * client, donc APRÈS le rendu Astro — le CSS scopé par défaut ne peut pas
   * cibler ce contenu (l'attribut data-astro-cid n'est ajouté qu'aux éléments
   * présents dans le template au moment du build). Les classes sont
   * préfixées "cart-" pour limiter tout risque de collision.
   */
  .cart-drawer [hidden] { display: none !important; }
  .cart-drawer { position: fixed; inset: 0; z-index: 60; pointer-events: none; }
  .cart-drawer-backdrop {
    position: fixed; inset: 0; background: rgba(21, 14, 10, 0.56);
    opacity: 0; transition: opacity 0.4s ease;
  }
  .cart-drawer.is-open { pointer-events: auto; }
  .cart-drawer.is-open .cart-drawer-backdrop { opacity: 1; }
  .cart-drawer-panel {
    position: fixed; top: 8px; right: 8px; bottom: 8px; width: 480px; max-width: 92vw;
    background: var(--paper); border-radius: 8px; box-shadow: 0 -4px 80px rgba(0, 0, 0, 0.08);
    display: flex; flex-direction: column; overflow: hidden;
    transform: translateX(calc(100% + 8px)); transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .cart-drawer.is-open .cart-drawer-panel { transform: translateX(0); }
  .cart-drawer-close {
    position: absolute; top: 16px; right: 16px; z-index: 1; border: 0; background: transparent;
    padding: 4px; cursor: pointer; line-height: 0;
  }
  .cart-drawer-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 32px; display: flex; flex-direction: column; gap: 24px; }
  .cart-drawer-divider { height: 1px; background: rgba(21, 14, 10, 0.12); flex-shrink: 0; }
  /* Le bas du sac, contre le bouton de paiement, est aux suggestions (l'accord du parfumeur, sinon
     « Vous aimerez aussi ») ; le haut à ce que le visiteur a déjà (Sandro, 12 sept.). */
  .cart-drawer-divider[data-cart-accord-divider]:not([hidden]),
  .cart-drawer-divider[data-cart-upsell-divider]:not([hidden]) { margin-top: auto; }

  .cart-drawer-header { display: flex; flex-direction: column; gap: 16px; }
  .cart-drawer-title { margin: 0; display: flex; gap: 6px; align-items: baseline; font-size: 24px; font-weight: 500; text-transform: uppercase; color: var(--ink); }
  .cart-drawer-title span { font-size: 16px; font-weight: 400; }
  .cart-shipping { display: flex; flex-direction: column; gap: 8px; }
  .cart-shipping-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--ink); }
  .cart-shipping-static { font-size: 12px; opacity: 0.64; white-space: nowrap; }
  .cart-shipping-track { position: relative; height: 4px; background: rgba(21, 14, 10, 0.12); }
  .cart-shipping-fill { position: absolute; inset: 0 auto 0 0; height: 4px; background: var(--rose); transition: width 0.3s ease; }
  .cart-shipping-thumb {
    position: absolute; top: -6px; width: 16px; height: 16px; margin-left: -8px;
    border-radius: 50%; background: var(--rose); border: 2px solid var(--paper); transition: left 0.3s ease;
  }

  .cart-drawer-lines { display: flex; flex-direction: column; gap: 24px; }
  .cart-empty { margin: 0; font-size: 16px; opacity: 0.7; }
  .cart-line { display: flex; gap: 20px; }
  .cart-line-img { width: 120px; height: 120px; object-fit: cover; background: var(--sand); flex-shrink: 0; }
  .cart-line-body { flex: 1 0 0; min-width: 0; display: flex; flex-direction: column; gap: 12px; justify-content: center; }
  .cart-line-text { display: flex; flex-direction: column; gap: 2px; }
  .cart-line-top { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
  /* Liens vers la fiche : aucune décoration, ni au repos ni au survol. */
  .cart-line-name { font-size: 14px; font-weight: 400; color: var(--ink); }
  .cart-line-img-link,
  .cart-upsell-card-img-link { display: block; flex-shrink: 0; line-height: 0; }
  .cart-upsell-card-img-link img { display: block; }
  .cart-line-title { font-size: 16px; font-weight: 500; text-transform: uppercase; }
  .cart-line-price { font-size: 14px; font-weight: 500; color: var(--ink); white-space: nowrap; }
  /* Quantité déjà changée à l'écran, montant pas encore confirmé par Shopify
     (voir queueQuantity) : le prix pâlit le temps de l'aller-retour. */
  .cart-line.is-pending .cart-line-price,
  .cart-line.is-pending .cart-badge { opacity: 0.4; transition: opacity 0.15s ease; }
  .cart-line-inspired { margin: 0; font-size: 14px; color: var(--ink); }
  .cart-line-bottom { display: flex; align-items: center; justify-content: space-between; }
  .cart-line-qty { display: flex; }
  .cart-qty-btn {
    display: flex; align-items: center; justify-content: center; width: 32px; height: 32px;
    border: 1px solid #dbd5ce; background: transparent; cursor: pointer; color: var(--ink); margin-inline-end: -1px;
  }
  .cart-qty-btn svg { width: 14px; height: 14px; }
  .cart-qty-value {
    display: flex; align-items: center; justify-content: center; width: 32px; height: 32px;
    border: 1px solid #dbd5ce; margin-inline-end: -1px; font-size: 16px; font-weight: 500; color: var(--ink);
  }
  .cart-line-remove { border: 0; background: transparent; padding: 0; font-size: 12px; font-weight: 500; text-decoration: underline; color: var(--ink); cursor: pointer; }

  .cart-sample { display: flex; flex-direction: column; gap: 12px; }
  .cart-sample-head { display: flex; align-items: center; justify-content: space-between; }
  .cart-sample-head p { margin: 0; font-size: 14px; font-weight: 500; text-transform: uppercase; color: var(--ink); }
  .cart-badge { display: inline-flex; align-items: center; padding: 4.5px 6px; border-radius: 8px; background: #efc5a9; color: var(--rose); font-size: 12px; font-weight: 500; text-transform: uppercase; }
  .cart-sample-row {
    display: flex; align-items: center; gap: 16px; width: 100%; border: 0; background: var(--cream);
    border-radius: 4px; padding: 0 16px 0 0; overflow: hidden; cursor: pointer; font: inherit; text-align: start;
  }
  .cart-sample-row img:first-child { width: 48px; height: 48px; object-fit: cover; }
  .cart-sample-row span { flex: 1 0 0; min-width: 0; font-size: 14px; font-weight: 500; color: var(--ink); }
  .chev-down { transform: rotate(180deg); flex-shrink: 0; }
  .cart-sample-options { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .cart-sample-options[hidden] { display: none; }
  .cart-sample-option {
    display: flex; align-items: center; gap: 12px; width: 100%; border: 0; background: var(--cream);
    padding: 8px 16px; cursor: pointer; font: inherit; font-size: 14px; color: var(--ink); text-align: start;
  }
  .cart-sample-option:hover { opacity: 0.8; }
  .cart-sample-option img { width: 32px; height: 32px; object-fit: cover; }

  /* L'accord du parfumeur : la carte du partenaire, l'histoire, l'écoute, le geste. */
