---
/**
 * Bannière « The Discovery Set » : image à gauche, titre, description, mention
 * de l'avoir et bouton à droite. Contenu éditorial depuis Sanity (coffret),
 * prix depuis Shopify, assemblés par la page appelante.
 *
 * Le bouton porte le prix à sa droite et prend le bordeaux de la maison, comme
 * le bouton d'achat des fiches : c'était le seul appel du site à ressembler à
 * un lien de rubrique alors qu'il vend un produit (Sandro).
 */
import Tip from "./Tip.astro";
import type { ResponsiveImage } from "../lib/sanity";

interface Props {
  title: string;
  description: string | null;
  priceLabel: string;
  href: string;
  img: ResponsiveImage | null;
  ctaLabel: string;
  /** « Déduit de votre premier flacon » : la raison d'acheter, au-dessus du bouton. */
  creditLabel?: string | null;
  creditNote?: string | null;
  tipLabel?: string | null;
}

const { title, description, priceLabel, href, img, ctaLabel, creditLabel = null, creditNote = null, tipLabel = null } =
  Astro.props;
---

<section class="dset">
  <div class="dset-img">
    {
      img && (
        <img
          src={img.src}
          srcset={img.srcset}
          sizes="(max-width: 900px) 100vw, 56vw"
          alt={title}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
  <div class="dset-text">
    <h2>{title}</h2>
    {description && <p class="dset-desc">{description}</p>}
    {
      creditLabel && (
        <p class="dset-credit">
          <span>{creditLabel}</span>
          {creditNote && <Tip text={creditNote} label={tipLabel ?? ""} />}
        </p>
      )
    }
    <a class="dset-cta" href={href}>
      <span>{ctaLabel}</span>
      <span class="dset-cta-price">{priceLabel}</span>
    </a>
  </div>
</section>

<style>
  .dset {
    display: flex;
    align-items: flex-end;
    gap: 64px;
    padding: 96px var(--gutter-x) 72px;
  }
  .dset-img {
    flex: 0 0 56%;
    max-width: 816px;
    /* Ratio de la maquette (816 x 560) — voir PerfumerWord. */
    aspect-ratio: 816 / 560;
    background: var(--sand);
    overflow: hidden;
  }
  .dset-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }
  .dset-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 56px;
  }
  .dset-text h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .dset-desc {
    margin: 0;
    max-width: 416px;
    font-size: 18px;
    line-height: 1.32;
    letter-spacing: 1.08px;
  }
  /* L'avoir se dit juste avant le bouton, sur un fond légèrement teinté : à
     l'encre et non en bordeaux, qui est ici la couleur des alertes. */
  .dset-credit {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 8px 12px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--rose) 8%, transparent);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  /* Même dessin que le bouton d'achat des fiches : libellé à gauche, prix à
     droite, sur toute la largeur du texte. */
  .dset-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: 420px;
    height: 56px;
    padding: 0 22px;
    background: var(--rose);
    color: var(--bg);
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    transition: opacity 0.15s;
  }
  .dset-cta:hover { opacity: 0.92; }
  .dset-cta-price { font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .dset { flex-direction: column; align-items: stretch; gap: 24px; padding: 56px var(--gutter-x) 40px; }
    /* Pleine largeur mobile : voir PerfumerWord. */
    .dset-img { flex: none; max-width: none; aspect-ratio: 3 / 2; }
    .dset-text { padding-bottom: 0; }
    .dset-text h2 { font-size: 26px; }
    .dset-desc { font-size: 16px; max-width: none; }
  }
</style>
