---
/**
 * Bannière « The Discovery Set » : image à gauche, titre + description +
 * prix + CTA à droite. Contenu éditorial depuis Sanity (coffret), prix
 * depuis Shopify — assemblés par la page appelante.
 */
import type { ResponsiveImage } from "../lib/sanity";

interface Props {
  title: string;
  description: string | null;
  priceLabel: string;
  href: string;
  img: ResponsiveImage | null;
  ctaLabel: string;
}

const { title, description, priceLabel, href, img, ctaLabel } = Astro.props;
---

<section class="dset">
  <div class="dset-img">
    {
      img && (
        <img
          src={img.src}
          srcset={img.srcset}
          sizes="(max-width: 900px) 100vw, 56vw"
          alt={title}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
  <div class="dset-text">
    <h2>{title}</h2>
    {description && <p class="dset-desc">{description}</p>}
    <p class="dset-price">{priceLabel}</p>
    <a class="dset-cta" href={href}>
      {ctaLabel}
      <img src="/brand/arrow-right.svg" alt="" width="12" height="12" />
    </a>
  </div>
</section>

<style>
  .dset {
    display: flex;
    align-items: flex-end;
    gap: 64px;
    padding: 96px var(--gutter-x) 72px;
  }
  .dset-img {
    flex: 0 0 56%;
    max-width: 816px;
    height: 560px;
    background: var(--sand);
    overflow: hidden;
  }
  .dset-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }
  .dset-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 56px;
  }
  .dset-text h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .dset-desc {
    margin: 0;
    max-width: 416px;
    font-size: 18px;
    line-height: 1.32;
    letter-spacing: 1.08px;
  }
  .dset-price {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.96px;
  }
  .dset-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 20px;
    background: var(--sand);
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    transition: opacity 0.15s;
  }
  .dset-cta:hover { opacity: 0.85; }

  @media (max-width: 900px) {
    .dset { flex-direction: column; align-items: stretch; gap: 24px; padding: 56px var(--gutter-x) 40px; }
    .dset-img { flex: none; max-width: none; height: 320px; }
    .dset-text { padding-bottom: 0; }
    .dset-text h2 { font-size: 26px; }
    .dset-desc { font-size: 16px; max-width: none; }
  }
</style>
