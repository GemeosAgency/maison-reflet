---
/**
 * Bannière « The Discovery Set » : image à gauche, titre, description, mention
 * de l'avoir et bouton à droite. Contenu éditorial depuis Sanity (coffret),
 * prix depuis Shopify, assemblés par la page appelante.
 *
 * Maquette du 30 oct. (Figma 11026:16157) : le prix sur sa propre ligne sous
 * la description, puis un bouton bordeaux compact « Shop now → ». Il garde le
 * bordeaux de la maison : c'est un appel qui vend un produit.
 */
import Tip from "./Tip.astro";
import type { ResponsiveImage } from "../lib/sanity";

interface Props {
  title: string;
  description: string | null;
  priceLabel: string;
  href: string;
  img: ResponsiveImage | null;
  ctaLabel: string;
  /** « Déduit de votre premier flacon » : la raison d'acheter, au-dessus du bouton. */
  creditLabel?: string | null;
  creditNote?: string | null;
  tipLabel?: string | null;
}

const { title, description, priceLabel, href, img, ctaLabel, creditLabel = null, creditNote = null, tipLabel = null } =
  Astro.props;
---

<section class="dset">
  <div class="dset-img">
    {
      img && (
        <img
          src={img.src}
          srcset={img.srcset}
          sizes="(max-width: 900px) 100vw, 56vw"
          alt={title}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
  <div class="dset-text">
    <h2>{title}</h2>
    {description && <p class="dset-desc">{description}</p>}
    {
      creditLabel && (
        <p class="dset-credit">
          <span>{creditLabel}</span>
          {creditNote && <Tip text={creditNote} label={tipLabel ?? ""} />}
        </p>
      )
    }
    <p class="dset-price">{priceLabel}</p>
    <a class="dset-cta" href={href}>
      <span>{ctaLabel}</span>
      {/* Même tracé que /brand/arrow-right.svg, en ligne pour prendre la couleur du bouton. */}
      <svg class="dset-arrow" viewBox="0 0 13.5 11.0459" width="12" height="10" fill="none" aria-hidden="true">
        <path d="M0.75 4.77297C0.335786 4.77297 0 5.10876 0 5.52297C0 5.93718 0.335786 6.27297 0.75 6.27297V5.52297V4.77297ZM13.2803 6.0533C13.5732 5.76041 13.5732 5.28553 13.2803 4.99264L8.50736 0.21967C8.21447 -0.0732236 7.73959 -0.0732236 7.4467 0.21967C7.15381 0.512563 7.15381 0.987437 7.4467 1.28033L11.6893 5.52297L7.4467 9.76561C7.15381 10.0585 7.15381 10.5334 7.4467 10.8263C7.73959 11.1192 8.21447 11.1192 8.50736 10.8263L13.2803 6.0533ZM0.75 5.52297V6.27297H12.75V5.52297V4.77297H0.75V5.52297Z" fill="currentColor" />
      </svg>
    </a>
  </div>
</section>

<style>
  .dset {
    display: flex;
    align-items: flex-end;
    gap: 64px;
    padding: 96px var(--gutter-x) 72px;
  }
  .dset-img {
    flex: 0 0 56%;
    max-width: 816px;
    /* Ratio de la maquette (816 x 560) — voir PerfumerWord. */
    aspect-ratio: 816 / 560;
    background: var(--sand);
    overflow: hidden;
  }
  .dset-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: bottom;
  }
  .dset-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 48px;
  }
  .dset-text h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .dset-desc {
    margin: 0;
    max-width: 416px;
    font-size: 18px;
    line-height: 1.32;
    letter-spacing: 1.08px;
  }
  /* L'avoir se dit juste avant le bouton, sur un fond légèrement teinté : à
     l'encre et non en bordeaux, qui est ici la couleur des alertes. */
  .dset-credit {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 8px 12px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--rose) 8%, transparent);
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .dset-price {
    margin: -8px 0 8px;
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: 0.96px;
  }
  /* Bouton de la maquette : 48 px de haut, 20 px de côté, flèche de 12 px. */
  .dset-cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 20px;
    background: var(--rose);
    color: var(--paper, #f1eee9);
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .dset-cta:hover { opacity: 0.92; }
  .dset-arrow { flex: none; }
  :global([dir="rtl"]) .dset-arrow { transform: scaleX(-1); }

  @media (max-width: 900px) {
    .dset { flex-direction: column; align-items: stretch; gap: 24px; padding: 56px var(--gutter-x) 40px; }
    /* Pleine largeur mobile : voir PerfumerWord. */
    .dset-img { flex: none; max-width: none; aspect-ratio: 3 / 2; }
    .dset-text { padding-bottom: 0; }
    .dset-text h2 { font-size: 26px; }
    .dset-desc { font-size: 16px; max-width: none; }
  }
</style>
