---
/**
 * Bandeau réassurance (icône + texte), pleine largeur — réutilisé par la page
 * produit (sélection propre à chaque parfum) et la home (bibliothèque complète).
 */
import { Picture } from "astro:assets";
import texture from "../assets/brand/texture-reassurance.jpg";

interface Props {
  items: { icone: string | null; lignes: string[] }[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="reassurance full-bleed">
      {/* Texture à 20 % d'opacité : une qualité basse ne se voit pas, et
          l'AVIF pèse une fraction du JPEG de 486 Kio servi jusqu'ici. */}
      <Picture
        class="reassurance-texture"
        src={texture}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[640, 1024, 1600]}
        sizes="100vw"
        quality={45}
        alt=""
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
      <div class="reassurance-inner">
        {items.map((r) => (
          <div class="reassurance-item">
            {r.icone && <img src={r.icone} alt="" width="40" height="40" />}
            <p>
              {r.lignes.map((ligne) => (
                <>
                  {ligne}
                  <br />
                </>
              ))}
            </p>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  /* .reassurance = simple canvas full-bleed (fond couleur bord à bord).
     .reassurance-inner = colonne de contenu plafonnée à la même largeur que
     <main> (--page-max) et centrée, pour que les items s'alignent avec le reste
     du site sur très grand écran au lieu de s'écarter jusqu'aux bords réels
     de la fenêtre (justify-content: space-between sur 100vw). */
  .reassurance { position: relative; background: var(--sand); overflow: hidden; }
  /* Texture papier discrète par-dessus le fond sable (design v2). */
  .reassurance-texture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
    pointer-events: none;
  }
  .reassurance > :global(picture) { display: contents; }
  .reassurance-inner {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 64px var(--gutter-x);
  }
  .reassurance-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 200px;
    flex-shrink: 0;
  }
  .reassurance-item img { width: 40px; height: 40px; }
  .reassurance-item p {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    text-align: center;
    line-height: 1.28;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .reassurance-inner { flex-wrap: wrap; justify-content: center; padding: 32px 20px; gap: 32px; }
  }
  /* Téléphone : deux par ligne. Une seule colonne de quatre prenait presque
     deux écrans pour quatre pictos. */
  @media (max-width: 560px) {
    .reassurance-inner { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 16px; padding: 40px 20px; }
    .reassurance-item { width: auto; gap: 12px; }
    .reassurance-item img { width: 32px; height: 32px; }
    .reassurance-item p { font-size: 13px; }
  }
</style>
