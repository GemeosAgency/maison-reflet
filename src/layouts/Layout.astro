---
import { type Locale, locales, localeNames, localePath, isRtl, useTranslations } from "../i18n";

type Breadcrumb = { label: string; href?: string };

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description = "Maison Reflet — Parfums franco-arabes",
  lang,
  breadcrumbs = [{ label: useTranslations(lang)("nav.home") }],
} = Astro.props;
const t = useTranslations(lang);

const indexable = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
const rest = Astro.url.pathname.replace(/^\/(fr|ar|en)/, "") || "/";

const navLinks = [
  { href: localePath(lang, "/parfums"), label: t("nav.perfumes") },
  { href: localePath(lang, "/maison"), label: t("nav.maison") },
  { href: "#", label: t("nav.services") },
  { href: "#", label: t("nav.faq") },
];
---

<!doctype html>
<html lang={lang} dir={isRtl(lang) ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/fonts/ppneuemontreal-book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ppneuemontreal-medium.woff2" as="font" type="font/woff2" crossorigin />
    {locales.map((loc) => <link rel="alternate" hreflang={loc} href={localePath(loc, rest)} />)}
    <title>{title} | Maison Reflet</title>
    <style is:global>
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-thin.woff2") format("woff2");
        font-weight: 100;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-book.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-italic.woff2") format("woff2");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-medium.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-semibolditalic.woff2") format("woff2");
        font-weight: 600;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      :root { --rose: #812538; --ink: #1f1f1f; --cream: #eee3d6; --cream-2: #faf9ee; }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: "PP Neue Montreal", "Hanken Grotesk", system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }
    </style>
  </head>
  <body>
    <script is:inline define:vars={{ lang }}>
      document.cookie = "lang=" + lang + ";path=/;max-age=31536000;samesite=lax";
    </script>

    <div class="promo-banner">
      <p>{t("banner.promo")}</p>
    </div>

    <header class="site-header">
      <nav class="site-nav">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a href={localePath(lang, "/")} class="site-logo" aria-label="Maison Reflet">
        <img src="/brand/logo.svg" alt="Maison Reflet" height="28" />
      </a>
      <div class="site-actions">
        <button type="button" class="currency">
          <img src="/brand/flag.png" alt="" width="20" height="20" class="flag" />
          AE (AED د.إ)
          <img src="/brand/chevron.svg" alt="" width="8" height="8" class="chev" />
        </button>
        <div class="icons">
          <img src="/brand/search.svg" alt="Search" width="20" height="20" />
          <img src="/brand/account.svg" alt="Account" width="20" height="20" />
          <a href={localePath(lang, "/panier")} class="bag" aria-label={t("nav.panier")}>
            <img src="/brand/bag.svg" alt="" width="20" height="20" />
            <span data-cart-count class="cart-count"></span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <div class="footer-main">
          <nav class="footer-crumbs" aria-label="Breadcrumb">
            {
              breadcrumbs.map((c, i) => (
                <>
                  {i > 0 && (
                    <span class="crumb-sep" aria-hidden="true">
                      /
                    </span>
                  )}
                  {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumb-current">{c.label}</span>}
                </>
              ))
            }
          </nav>
          <div class="footer-menu">
            <div class="footer-col">
              <p class="footer-col-title">{t("footer.discover")}</p>
              <div class="footer-col-links">
                <a href={localePath(lang, "/parfums")}>{t("nav.perfumes")}</a>
                <a href="#">{t("nav.services")}</a>
                <a href={localePath(lang, "/maison")}>{t("nav.maison")}</a>
              </div>
            </div>
            <div class="footer-col">
              <p class="footer-col-title">{t("footer.social")}</p>
              <div class="footer-col-links">
                <a href="#" target="_blank" rel="noopener">Instagram</a>
                <a href="#" target="_blank" rel="noopener">TikTok</a>
              </div>
            </div>
            <div class="footer-col">
              <p class="footer-col-title">{t("footer.legal")}</p>
              <div class="footer-col-links">
                <a href="#">{t("footer.legalTerms")}</a>
                <a href="#">{t("footer.privacyPolicy")}</a>
                <a href="#">{t("footer.salesConditions")}</a>
                <a href="#">{t("footer.cookieManagement")}</a>
              </div>
            </div>
          </div>
          <a href={localePath(lang, "/")} class="footer-logo" aria-label="Maison Reflet">
            <img src="/brand/logo.svg" alt="Maison Reflet" height="28" />
          </a>
        </div>
        <div class="footer-flourish" aria-hidden="true">
          <img src="/brand/footer-flourish.svg" alt="" />
        </div>
      </div>
      <div class="footer-bottom">
        <ul class="lang-switch">
          {
            locales.map((loc) => (
              <li>
                <a href={localePath(loc, rest)} aria-current={loc === lang ? "true" : undefined}>
                  {localeNames[loc]}
                </a>
              </li>
            ))
          }
        </ul>
        <p>&copy; {new Date().getFullYear()} Maison Reflet</p>
      </div>
    </footer>

    <style>
      .promo-banner { background: #efc5a9; }
      .promo-banner p {
        margin: 0; padding: 10.5px 48px; text-align: center;
        color: var(--rose); font-size: 14px; font-weight: 500; text-transform: uppercase;
      }
      .site-header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 80px;
        max-width: 1800px;
        margin: 0 auto;
        padding: 0 40px;
        border-bottom: 0.8px solid rgba(0, 0, 0, 0.1);
      }
      .site-nav { display: flex; gap: 24px; align-items: center; width: 300px; }
      .site-nav a { font-size: 16px; padding: 8px 0; }
      .site-nav a:hover { opacity: 0.6; }
      .site-logo {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
      }
      .site-logo img { height: 28px; width: auto; }
      .site-actions { display: flex; gap: 24px; align-items: center; }
      .currency {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px 8px 8px;
        border: 0;
        background: none;
        border-radius: 100px;
        font: inherit;
        text-transform: uppercase;
        cursor: pointer;
      }
      .currency .flag { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; }
      .currency .chev { transform: rotate(180deg); }
      .icons { display: flex; gap: 16px; align-items: center; }
      .bag { position: relative; display: inline-flex; }
      .cart-count { font-size: 12px; margin-inline-start: 2px; }
      main { min-height: 50vh; max-width: 1800px; margin: 0 auto; }

      /* Footer (d'après le Figma) */
      .site-footer { max-width: 1800px; margin: 0 auto; }
      .footer-top { display: flex; align-items: flex-start; gap: 120px; padding: 0 8px 8px 24px; }
      .footer-main { flex: 1 0 0; min-width: 0; display: flex; flex-direction: column; }
      .footer-crumbs {
        display: flex; align-items: center; gap: 12px; padding: 24px 0;
        border-bottom: 0.8px solid rgba(0, 0, 0, 0.1); font-size: 14px;
      }
      .footer-crumbs a, .footer-crumbs .crumb-current { color: var(--ink); }
      .footer-crumbs a { opacity: 0.48; }
      .footer-crumbs a:hover { opacity: 0.7; }
      .crumb-sep { opacity: 0.3; font-size: 12px; }
      .footer-menu { display: flex; flex-wrap: wrap; gap: 64px; margin-top: 32px; }
      .footer-col { width: 256px; display: flex; flex-direction: column; gap: 16px; }
      .footer-col-title {
        margin: 0; font-size: 14px; font-weight: 500; text-transform: uppercase; color: #1c1e1d;
      }
      .footer-col-links { display: flex; flex-direction: column; gap: 8px; }
      .footer-col-links a { font-size: 16px; color: #585b5a; }
      .footer-col-links a:hover { opacity: 0.7; }
      .footer-logo { display: block; margin-top: auto; padding-top: 32px; }
      .footer-logo img { height: 28px; width: auto; }
      .footer-flourish { width: 391px; max-width: 40%; aspect-ratio: 391 / 408; flex-shrink: 0; }
      .footer-flourish img { width: 100%; height: 100%; display: block; }

      .footer-bottom {
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
        padding: 24px 40px; background: var(--ink); color: var(--cream-2); font-size: 14px;
      }
      .footer-bottom p { margin: 0; opacity: 0.7; }
      .lang-switch { list-style: none; display: flex; gap: 1rem; margin: 0; padding: 0; }
      .lang-switch a { opacity: 0.7; }
      .lang-switch a[aria-current="true"] { opacity: 1; text-decoration: underline; }

      @media (max-width: 720px) {
        .site-header { padding: 0 20px; }
        .site-nav { display: none; }
        .promo-banner p { padding: 10.5px 20px; font-size: 12px; }
      }
      @media (max-width: 900px) {
        .footer-top { flex-direction: column; gap: 40px; padding: 0 20px 32px; }
        .footer-flourish { width: 220px; max-width: 60%; align-self: center; }
        .footer-menu { gap: 32px; }
        .footer-logo { padding-top: 24px; }
        .footer-bottom { padding: 20px; }
      }
    </style>

    <script>
      import { loadCart, type CartUpdatedEvent } from "../lib/cart";
      import type { ShopifyCart } from "../lib/shopify";
      const countEl = document.querySelector<HTMLElement>("[data-cart-count]");
      function renderCount(cart: ShopifyCart | null) {
        if (!countEl) return;
        const q = cart?.totalQuantity ?? 0;
        countEl.textContent = q > 0 ? `(${q})` : "";
      }
      document.addEventListener("cart:updated", (e) =>
        renderCount((e as CartUpdatedEvent).detail.cart)
      );
      loadCart().then(renderCount).catch(() => {});
    </script>
  </body>
</html>
