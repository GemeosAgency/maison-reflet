---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Maison Reflet — Parfums franco-arabes, collection Les 6 Reflets" } =
  Astro.props;

// Indexation contrôlée par variable d'env : tant que PUBLIC_ALLOW_INDEXING
// n'est pas "true", tout le site est en noindex (pré-lancement). Le jour du
// lancement, on met PUBLIC_ALLOW_INDEXING=true sur la prod uniquement.
const indexable = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <title>{title} | Maison Reflet</title>
  </head>
  <body>
    <header>
      <a href="/">Maison Reflet</a>
      <nav>
        <a href="/parfums">Les 6 Reflets</a>
        <a href="/maison">La Maison</a>
        <a href="/panier">Panier<span data-cart-count></span></a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Maison Reflet</p>
    </footer>

    <script>
      import { loadCart, type CartUpdatedEvent } from "../lib/cart";
      import type { ShopifyCart } from "../lib/shopify";

      const countEl = document.querySelector<HTMLElement>("[data-cart-count]");

      function renderCount(cart: ShopifyCart | null) {
        if (!countEl) return;
        const quantity = cart?.totalQuantity ?? 0;
        countEl.textContent = quantity > 0 ? ` (${quantity})` : "";
      }

      document.addEventListener("cart:updated", (event) => {
        renderCount((event as CartUpdatedEvent).detail.cart);
      });

      loadCart()
        .then(renderCount)
        .catch(() => {
          // Réseau ou API indisponible : on laisse le compteur vide, sans casser la page
        });
    </script>
  </body>
</html>
