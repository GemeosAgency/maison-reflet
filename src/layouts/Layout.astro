---
import {
  type Locale,
  locales,
  localeNames,
  localePath,
  isRtl,
  fallbackLocale,
  useTranslations,
} from "../i18n";
import CartDrawer from "../components/CartDrawer.astro";
import CountryDrawer from "../components/CountryDrawer.astro";
import LumaAdvisor from "../components/LumaAdvisor.astro";
import {
  COUNTRIES,
  DEFAULT_COUNTRY,
  formatMoney,
  freeShippingThreshold,
  getCountry,
  countryPill,
} from "../lib/markets";

type Breadcrumb = { label: string; href?: string };

interface Props {
  title: string;
  description?: string;
  lang: Locale;
  breadcrumbs?: Breadcrumb[];
  /** Image de partage (URL absolue ou chemin racine). Repli sur le visuel de marque. */
  ogImage?: string | null;
  /** "product" pour une fiche produit/coffret — sinon "website". */
  ogType?: "website" | "product";
  /** JSON-LD à injecter (Product, BreadcrumbList…), déjà sérialisé par la page. */
  jsonLd?: unknown[];
}

const {
  title,
  description = "Maison Reflet — Parfums franco-arabes",
  lang,
  breadcrumbs = [{ label: useTranslations(lang)("nav.home") }],
  ogImage = null,
  ogType = "website",
  jsonLd = [],
} = Astro.props;
const t = useTranslations(lang);

const indexable = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
const rest = Astro.url.pathname.replace(/^\/(fr|ar|en)/, "") || "/";

/*
 * État initial du sélecteur de pays : le marché primaire, cuit au build. Le
 * choix réel du visiteur vit dans un cookie et n'est connu que du navigateur —
 * `country.ts` recale pastille, prix et seuils au chargement.
 */
const initialCountry = getCountry(DEFAULT_COUNTRY);
const initialThreshold = formatMoney(
  freeShippingThreshold(initialCountry.currency),
  initialCountry.currency,
  lang
);
const initialPill = countryPill(initialCountry, lang);

/*
 * URLs absolues pour le référencement. Astro.site vient de la config `site`
 * (alimentée par PUBLIC_SITE_URL par environnement) : indispensable car Google
 * IGNORE un hreflang en URL relative — c'est ce qui rendait tout le dispositif
 * FR/AR/EN invisible jusqu'ici. Repli sur Astro.url si `site` manque, pour ne
 * jamais produire de balise cassée.
 */
const base = Astro.site ?? new URL(Astro.url.origin);
const absolute = (path: string) => new URL(path, base).href;

const canonical = absolute(Astro.url.pathname);
const socialImage = absolute(ogImage ?? "/brand/logo-email.png");

// og:locale attend une balise de type "fr_FR" et non "fr".
const ogLocales: Record<Locale, string> = { fr: "fr_FR", ar: "ar_AE", en: "en_US" };

const structuredData = [
  // Présent sur toutes les pages : identité de la marque pour le Knowledge Graph.
  {
    "@context": "https://schema.org",
    "@type": "Brand",
    name: "Maison Reflet",
    url: absolute(localePath(lang, "/")),
    logo: absolute("/brand/logo-email.png"),
  },
  // Fil d'Ariane : repris tel quel par Google sous le titre du résultat.
  ...(breadcrumbs.length > 1
    ? [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: breadcrumbs.map((c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.label,
            ...(c.href ? { item: absolute(c.href) } : {}),
          })),
        },
      ]
    : []),
  ...jsonLd,
];

// Tracking onsite Klaviyo. Chargé seulement si la clé publique (company ID)
// est définie — chaque environnement peut donc pointer vers un compte
// différent ou désactiver le tracking en retirant la variable.
// LIMITE À CONNAÎTRE : Klaviyo ne documente aucun réglage de scope du cookie
// (__kla_id est posé en first-party sur le domaine qui charge klaviyo.js) ni
// de tracking cross-domaine officiel. Staging et prod remontent donc dans le
// MÊME compte tant qu'ils partagent cette clé ; pour isoler les données de
// test, créer un compte sandbox Klaviyo et mettre sa clé dans la variable
// Preview de Vercel. Voir README.md § Klaviyo.
const klaviyoCompanyId = import.meta.env.PUBLIC_KLAVIYO_COMPANY_ID;

const navLinks = [
  { href: localePath(lang, "/parfums"), label: t("nav.perfumes") },
  // "Discovery" pointe vers la page du coffret découverte — handle Shopify
  // du Discovery Set (à ajuster si le produit est renommé côté Shopify).
  { href: localePath(lang, "/coffrets/sample-box"), label: t("nav.discovery") },
  { href: localePath(lang, "/maison"), label: t("nav.maison") },
];
---

<!doctype html>
<html lang={lang} dir={isRtl(lang) ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph : sans ces balises, un lien partagé (WhatsApp, Instagram,
         LinkedIn) s'affiche sans image ni titre soigné. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Maison Reflet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      locales
        .filter((loc) => loc !== lang)
        .map((loc) => <meta property="og:locale:alternate" content={ogLocales[loc]} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" href="/fonts/ppneuemontreal-book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ppneuemontreal-medium.woff2" as="font" type="font/woff2" crossorigin />
    {locales.map((loc) => <link rel="alternate" hreflang={loc} href={absolute(localePath(loc, rest))} />)}
    <!-- x-default : version servie à un visiteur dont la langue ne correspond
         à aucune des nôtres. C'est exactement ce que fait detectLocale() —
         repli sur fallbackLocale — donc on pointe la même version. Surtout,
         PAS le chemin sans préfixe de langue : hors "/", il n'existe pas. -->
    <link rel="alternate" hreflang="x-default" href={absolute(localePath(fallbackLocale, rest))} />
    {
      structuredData.map((data) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
        />
      ))
    }
    {
      klaviyoCompanyId && (
        <script
          is:inline
          async
          type="text/javascript"
          src={`https://static.klaviyo.com/onsite/js/${klaviyoCompanyId}/klaviyo.js`}
        />
      )
    }
    <title>{title} | Maison Reflet</title>
    <style is:global>
      /*
       * L'attribut `hidden` doit toujours l'emporter.
       *
       * Le navigateur le rend avec `[hidden] { display: none }` dans SA feuille
       * de style — et une règle d'auteur bat toujours celle du navigateur,
       * quelle que soit la spécificité. Le moindre `display: flex` sur un
       * composant annule donc son propre `hidden` : la pastille « Livraison
       * vers … » s'est affichée vide en permanence sur le staging pour cette
       * seule raison. `!important` est ici le seul moyen de rétablir la
       * priorité, et il vaut pour tous les composants à venir.
       *
       * Piège de vérification associé : lire `el.hidden` en JavaScript ne dit
       * rien de ce qui est à l'écran, seulement de l'attribut. C'est
       * `getComputedStyle(el).display` qu'il faut regarder.
       */
      [hidden] {
        display: none !important;
      }

      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-thin.woff2") format("woff2");
        font-weight: 100;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-book.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-italic.woff2") format("woff2");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-medium.woff2") format("woff2");
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-semibolditalic.woff2") format("woff2");
        font-weight: 600;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "PP Neue Montreal";
        src: url("/fonts/ppneuemontreal-bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      :root {
        /*
         * Palette v2 (refonte du design, août 2026) : fond plus neutre, encre
         * brun-noir plus profonde, deux surfaces claires. Les anciens noms
         * --cream/--cream-2 restent des alias vers les nouvelles valeurs pour
         * ne pas casser les usages existants — à résorber au fil des refontes.
         */
        --rose: #812538;
        --ink: #150e0a;
        --bg: #f1eee9;
        --paper: #f7f5f2;
        --sand: #e7dfd0;
        --peach: #efc5a9;
        --cream: var(--bg);
        --cream-2: var(--paper);

        /*
         * --page-max : LE container du site. Un seul plafond, partagé par
         * <main>, le footer, la réassurance et les bandes de médias, pour que
         * toutes les sections s'alignent sur les mêmes bords. Les sections
         * "lisibles" se décalent en plus de --gutter-x à l'intérieur, comme
         * dans la maquette où la bande d'images va bord à bord et le texte est
         * rentré de 72px.
         *
         * --band-col : ratio d'une colonne de triptyque (478,67 x 560 dans le
         * Figma). Les photos de matières de la bibliothèque Sanity font
         * 958 x 1120, soit le MÊME ratio à 0,07 % près : en respectant ce
         * ratio, la matière tient dans le cadre telle qu'elle a été shootée,
         * sans recadrage, à n'importe quelle largeur.
         */
        --page-max: 1800px;
        --band-col: 478.6667 / 560;
        /*
         * Gouttière horizontale partagée par tout le contenu "lisible" (texte
         * de héros, titres de section, réassurance…), y compris à l'intérieur
         * des bandeaux/images en full-bleed. Sans ça chaque section retapait
         * sa propre valeur (64px, 72px, parfois 24px par erreur), et le texte
         * ne s'alignait plus avec le reste de la page une fois le fond étiré
         * en pleine largeur. Fluide (clamp) pour éviter les sauts brusques
         * entre les breakpoints — seule la LARGEUR DE LECTURE aligne les
         * sections entre elles, pas le fond/les grilles d'images qui restent
         * full-bleed comme dans le Figma.
         */
        --gutter-x: clamp(20px, 4.44vw, 64px);
        /* Hauteur de la barre collante. Partagée : les panneaux `sticky` des
           fiches produit et coffret s'en servent pour ne pas passer dessous,
           et html.scroll-padding-top pour que les ancres restent visibles. */
        --header-h: 80px;
        /* Hauteur du bandeau promo, mesurée sur le rendu (le Figma dit 31px,
           notre bandeau a son propre padding). Sert, avec --header-h, à
           plafonner les héros à la hauteur réellement visible. */
        --banner-h: 42px;
        /* Place restante sous le bandeau et la barre de navigation : c'est la
           hauteur maximale d'un héros pour que son texte reste au-dessus de
           la ligne de flottaison. `svh` et non `vh` : sur mobile, `vh` compte
           la barre d'URL et le bas du visuel passerait dessous. */
        --hero-max-h: calc(100svh - var(--header-h) - var(--banner-h));
      }
      html { scroll-padding-top: var(--header-h); }
      * { box-sizing: border-box; }
      /*
       * PAS de overflow-x:hidden ici : ça casse position:sticky pour tout
       * descendant (ex. le panneau info de la fiche produit) — bug CSS connu
       * (un ancêtre avec un overflow non-`visible` devient la référence de scroll
       * du sticky, qui cesse alors de fonctionner). Le débordement horizontal
       * de .full-bleed est déjà neutralisé par ses propres marges négatives
       * calc(50% - 50vw), vérifié sans scrollbar sur tous les breakpoints.
       */
      html, body { margin: 0; }
      body {
        background: var(--cream);
        color: var(--ink);
        font-family: "PP Neue Montreal", "Hanken Grotesk", system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }

      /*
       * <main> est plafonné à --page-max (voir plus bas) pour garder les longs
       * paragraphes lisibles sur très grand écran. Mais certaines sections
       * (héros, grilles produits, bandeau réassurance…) sont conçues dans le
       * Figma pour toucher les bords du navigateur, quelle que soit sa largeur.
       * Cette classe leur fait ignorer le plafond de <main> en s'étirant sur
       * 100% de la largeur de la fenêtre, où qu'elles soient imbriquées.
       */
      /*
       * !important nécessaire : ces sections définissent presque toutes leur
       * propre `width: 100%` (relatif à leur parent capé à --page-max) dans le CSS
       * scopé Astro, dont la spécificité (boostée par l'attribut data-astro-cid)
       * l'emporterait sinon sur cette classe utilitaire globale.
       */
      .full-bleed { width: 100vw !important; margin-left: calc(50% - 50vw) !important; margin-right: calc(50% - 50vw) !important; }

      /*
       * Bande de médias : occupe toute la largeur du container --page-max.
       *
       * Différence avec .full-bleed, qui s'étire jusqu'au bord de l'écran :
       * une media-band s'arrête au container --page-max, donc à la MÊME
       * verticale que le reste de la page. Les colonnes portent
       * `aspect-ratio: var(--band-col)`, donc la hauteur suit la largeur et le
       * sujet n'est jamais rogné — c'est ce qui remplace l'ancienne hauteur
       * figée de 560px.
       *
       * `100%` et non `100vw` : <main> n'a pas de padding, donc 100% vaut déjà
       * la largeur du viewport — sans compter la scrollbar, contrairement à
       * 100vw qui provoquerait un débordement horizontal.
       *
       * Pas de !important ici (contrairement à .full-bleed) : les composants
       * concernés ne définissent pas leur propre largeur. Si l'un le fait un
       * jour, sa règle scopée gagnera — à vérifier en même temps.
       */
      .media-band { width: min(100%, var(--page-max)); margin-inline: auto; }
    </style>
  </head>
  <body>
    <script is:inline define:vars={{ lang }}>
      document.cookie = "lang=" + lang + ";path=/;max-age=31536000;samesite=lax";
    </script>

    <div class="promo-banner">
      {/*
        Le seuil dépend de la devise du pays choisi (voir src/lib/markets.ts).
        Le HTML statique porte celui du marché primaire ; l'attribut garde le
        gabarit traduit pour que `hydrateShippingThresholds` n'ait plus qu'à
        remplacer le montant, sans retraduire la phrase dans le navigateur.
      */}
      <p data-free-shipping-threshold={t("banner.promo")}>
        {t("banner.promo").replace("{amount}", initialThreshold)}
      </p>
    </div>

    {/*
      Barre de navigation collante. Le conteneur est pleine largeur pour que
      le fond couvre l'écran entier au-delà de --page-max, tandis que le
      <header> garde sa colonne de contenu. Le bandeau promo, lui, défile :
      c'est une promo, pas un outil de navigation.
    */}
    <div class="site-header-sticky">
      <header class="site-header">
      <nav class="site-nav">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a href={localePath(lang, "/")} class="site-logo" aria-label="Maison Reflet">
        <img src="/brand/logo.svg" alt="Maison Reflet" height="28" />
      </a>
      <div class="site-actions">
        {/* Luma : un nom et une ligne, pas un badge (brief §5). Sur mobile, le nom seul. */}
        <button type="button" class="luma-trigger" data-luma-open aria-label={t("luma.open")}>
          <span class="luma-trigger-name">{t("luma.name")}</span>
          <span class="luma-trigger-line">{t("luma.tagline")}</span>
        </button>
        <button
          type="button"
          class="currency"
          data-region-open
          aria-label={t("region.open")}
        >
          <img
            src={`/flags/${initialCountry.code.toLowerCase()}.png`}
            srcset={`/flags/${initialCountry.code.toLowerCase()}.png 1x, /flags/${initialCountry.code.toLowerCase()}@2x.png 2x`}
            alt=""
            width="20"
            height="20"
            class="flag"
            data-region-flag
          />
          <span class="currency-label" data-region-label>{initialPill}</span>
          <img src="/brand/chevron.svg" alt="" width="8" height="8" class="chev" />
        </button>
        <div class="icons">
          <img class="icon-desktop" src="/brand/search.svg" alt="Search" width="20" height="20" />
          <img class="icon-desktop" src="/brand/account.svg" alt="Account" width="20" height="20" />
          <a href={localePath(lang, "/panier")} class="bag" aria-label={t("nav.panier")} data-cart-open-trigger>
            <img src="/brand/bag.svg" alt="" width="20" height="20" />
            <span data-cart-count class="cart-count"></span>
          </a>
        </div>
      </div>
      </header>
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <div class="footer-main">
          <nav class="footer-crumbs" aria-label="Breadcrumb">
            {
              breadcrumbs.map((c, i) => (
                <>
                  {i > 0 && (
                    <span class="crumb-sep" aria-hidden="true">
                      /
                    </span>
                  )}
                  {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumb-current">{c.label}</span>}
                </>
              ))
            }
          </nav>
          <div class="footer-menu">
            <div class="footer-col">
              <p class="footer-col-title">{t("footer.discover")}</p>
              <div class="footer-col-links">
                <a href={localePath(lang, "/parfums")}>{t("nav.perfumes")}</a>
                <a href="#">{t("nav.services")}</a>
                <a href={localePath(lang, "/maison")}>{t("nav.maison")}</a>
              </div>
            </div>
            <div class="footer-col">
              <p class="footer-col-title">{t("footer.social")}</p>
              <div class="footer-col-links">
                <a href="#" target="_blank" rel="noopener">Instagram</a>
                <a href="#" target="_blank" rel="noopener">TikTok</a>
              </div>
            </div>
            <div class="footer-col">
              <p class="footer-col-title">{t("footer.legal")}</p>
              <div class="footer-col-links">
                <a href="#">{t("footer.legalTerms")}</a>
                <a href="#">{t("footer.privacyPolicy")}</a>
                <a href="#">{t("footer.salesConditions")}</a>
                <a href="#">{t("footer.cookieManagement")}</a>
              </div>
            </div>
            <div class="footer-col footer-signup">
              <p class="footer-col-title">{t("footer.signup.title")}</p>
              <p class="footer-signup-text">{t("footer.signup.text")}</p>
              <form class="footer-signup-form" data-signup-form>
                <input
                  type="email"
                  name="email"
                  required
                  placeholder={t("footer.signup.emailPlaceholder")}
                  aria-label={t("footer.signup.emailPlaceholder")}
                />
                <button
                  type="submit"
                  data-msg-sending={t("footer.signup.sending")}
                  data-msg-success={t("footer.signup.success")}
                  data-msg-error={t("footer.signup.error")}
                >
                  {t("footer.signup.subscribe")}
                </button>
              </form>
              <p class="footer-signup-msg" data-signup-msg role="status" aria-live="polite" />
              <p class="footer-signup-disclaimer">{t("footer.signup.disclaimer")}</p>
            </div>
          </div>
          <a href={localePath(lang, "/")} class="footer-logo" aria-label="Maison Reflet">
            <img src="/brand/logo.svg" alt="Maison Reflet" height="28" />
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">{t("footer.copyright").replace("{year}", String(new Date().getFullYear()))}</p>
        <div class="footer-lang">
          <button type="button" class="footer-region" data-region-open>
            {t("region.shippedCount").replace("{count}", String(COUNTRIES.length))}
          </button>
          <span>{t("footer.countryLanguage")}</span>
          <ul class="lang-switch">
            {
              locales.map((loc) => (
                <li>
                  <a href={localePath(loc, rest)} aria-current={loc === lang ? "true" : undefined}>
                    {localeNames[loc]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </footer>

    <CartDrawer lang={lang} />
    <CountryDrawer lang={lang} rest={rest} />
    <LumaAdvisor lang={lang} />

    <style>
      .promo-banner { background: #efc5a9; }
      .promo-banner p {
        margin: 0; padding: 10.5px 48px; text-align: center;
        color: var(--rose); font-size: 14px; font-weight: 500; text-transform: uppercase;
      }
      /* z-index 20 : au-dessus du contenu, en dessous du panier (60). */
      .site-header-sticky {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--bg);
      }
      .site-header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 80px;
        max-width: var(--page-max);
        margin: 0 auto;
        padding: 0 40px;
        border-bottom: 0.8px solid rgba(0, 0, 0, 0.1);
      }
      .site-nav { display: flex; gap: 24px; align-items: center; width: 300px; }
      .site-nav a { font-size: 16px; padding: 8px 0; }
      .site-nav a:hover { opacity: 0.6; }
      .site-logo {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
      }
      .site-logo img { height: 28px; width: auto; }
      .site-actions { display: flex; gap: 24px; align-items: center; }
      .luma-trigger {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        padding: 8px 0;
        border: 0;
        background: none;
        font: inherit;
        font-size: 14px;
        color: inherit;
        cursor: pointer;
      }
      .luma-trigger:hover { opacity: 0.6; }
      .luma-trigger-name { font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
      .luma-trigger-line { opacity: 0.7; }
      .luma-trigger-line::before { content: "·"; margin-inline-end: 8px; }
      .currency {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px 8px 8px;
        border: 0;
        background: none;
        border-radius: 100px;
        font: inherit;
        text-transform: uppercase;
        cursor: pointer;
      }
      .currency .flag { width: 20px; height: 20px; border-radius: 50%; object-fit: cover; }
      .currency .chev { transform: rotate(180deg); }
      .icons { display: flex; gap: 16px; align-items: center; }
      .bag { position: relative; display: inline-flex; }
      .cart-count { font-size: 12px; margin-inline-start: 2px; }
      main { min-height: 50vh; max-width: var(--page-max); margin: 0 auto; }

      /* Footer (d'après le Figma) */
      .site-footer { background: var(--ink); color: var(--cream); }
      .footer-top { max-width: var(--page-max); margin: 0 auto; display: flex; align-items: flex-start; padding: 40px var(--gutter-x) 32px; }
      .footer-main { flex: 1 0 0; min-width: 0; display: flex; flex-direction: column; }
      .footer-crumbs {
        display: flex; align-items: center; gap: 12px; padding: 0 0 24px; font-size: 14px;
      }
      .footer-crumbs a, .footer-crumbs .crumb-current { color: var(--cream); }
      .footer-crumbs a { opacity: 0.56; }
      .footer-crumbs a:hover { opacity: 0.8; }
      .crumb-sep { opacity: 0.4; font-size: 12px; }
      .footer-menu { display: flex; flex-wrap: wrap; gap: 64px; margin-top: 8px; }
      .footer-col { flex: 1 0 0; min-width: 200px; display: flex; flex-direction: column; gap: 16px; }
      .footer-col-title {
        margin: 0; font-size: 16px; font-weight: 500; text-transform: uppercase; color: var(--cream);
      }
      .footer-col-links { display: flex; flex-direction: column; gap: 8px; }
      .footer-col-links a { font-size: 16px; color: rgba(241, 238, 233, 0.56); }
      .footer-col-links a:hover { opacity: 0.8; }
      .footer-logo { display: block; margin-top: auto; padding-top: 32px; }
      .footer-logo img { height: 28px; width: auto; filter: brightness(0) invert(1); }

      .footer-signup-text { margin: 0; font-size: 16px; line-height: 1.24; color: rgba(241, 238, 233, 0.8); }
      .footer-signup-form { display: flex; flex-direction: column; gap: 12px; }
      .footer-signup-form input {
        height: 48px; padding: 8px 24px; border-radius: 8px;
        border: 1px solid rgba(231, 223, 208, 0.12); background: rgba(231, 223, 208, 0.08);
        color: var(--cream); font: inherit; font-size: 16px;
      }
      .footer-signup-form input::placeholder { color: rgba(231, 223, 208, 0.8); }
      .footer-signup-form button {
        height: 48px; border: 0; border-radius: 999px; background: var(--rose); color: var(--cream);
        font: inherit; font-size: 16px; font-weight: 500; cursor: pointer; transition: opacity 0.15s;
      }
      .footer-signup-form button:hover { opacity: 0.9; }
      .footer-signup-form button:disabled { opacity: 0.6; }
      .footer-signup-msg { margin: -4px 0 0; min-height: 1em; font-size: 14px; color: var(--cream); }
      .footer-signup-disclaimer { margin: 0; font-size: 12px; line-height: 1.24; color: rgba(241, 238, 233, 0.56); }

      .footer-bottom {
        max-width: var(--page-max); margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
        padding: 24px var(--gutter-x); font-size: 14px;
      }
      .footer-copyright { margin: 0; color: rgba(231, 223, 208, 0.56); }
      .footer-lang { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .footer-lang > span { opacity: 0.56; }
      .footer-region {
        border: 0;
        background: transparent;
        padding: 0;
        font: inherit;
        color: inherit;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }
      .lang-switch { list-style: none; display: flex; gap: 1rem; margin: 0; padding: 0; }
      .lang-switch a { opacity: 0.8; font-weight: 500; }
      .lang-switch a[aria-current="true"] { opacity: 1; text-decoration: underline; }

      @media (max-width: 720px) {
        /* Nav masquée => .site-actions devient l'unique enfant en flux :
           on le cale à droite pour laisser le logo centré respirer. */
        .site-header { padding: 0 20px; justify-content: flex-end; }
        .site-nav { display: none; }
        /* Les icônes placeholder (recherche, compte) chevauchent le logo
           centré sur petit écran — masquées en attendant le menu mobile
           (burger) de la refonte.

           Le sélecteur de pays, lui, RESTE : sans lui, la seule porte d'entrée
           du tiroir sur mobile serait le lien du pied de page. Il se réduit à
           son drapeau — la devise et le chevron ne tiendraient pas à côté du
           logo. */
        /* La colonne de gauche est vide (nav masquée) et le logo est
           absolument centré : le drapeau s'y installe, à l'opposé du panier.
           Le laisser dans le flux à droite le faisait chevaucher le logo de
           douze pixels. */
        .currency {
          position: absolute;
          /* Décalé de 10 px et rembourré de 10 px : le drapeau reste aligné
             sur la gouttière de 20 px, mais la cible tactile fait 40 px. */
          inset-inline-start: 10px;
          top: 50%;
          transform: translateY(-50%);
          padding: 8px 10px;
        }
        .currency-label,
        .currency .chev { display: none; }
        .icon-desktop { display: none; }
        .luma-trigger-line { display: none; }
        .site-logo img { height: 22px; }
        .promo-banner p { padding: 10.5px 20px; font-size: 12px; }
      }
      @media (max-width: 900px) {
        .footer-top { flex-direction: column; padding: 32px var(--gutter-x); }
        .footer-menu { gap: 32px; }
        .footer-logo { padding-top: 24px; }
        .footer-bottom { padding: 20px var(--gutter-x); flex-direction: column; align-items: flex-start; }
      }
    </style>

    <script>
      import { loadCart, initAddToCartButtons, visibleQuantity, type CartUpdatedEvent } from "../lib/cart";
      import { initKlaviyo, identify } from "../lib/klaviyo";
      import { initMetaPixel } from "../lib/meta";
      import { initGa4 } from "../lib/ga4";
      import type { ShopifyCart } from "../lib/shopify";

      // Identité Klaviyo first-party (utm_email, rejeu de la file locale) —
      // fonctionne aussi quand klaviyo.js est bloqué par un bloqueur de contenu.
      initKlaviyo();

      // Pixel Meta + PageView (double flux navigateur/serveur, voir lib/meta.ts).
      // Inerte tant que PUBLIC_META_PIXEL_ID n'est pas définie.
      initMetaPixel();

      // gtag.js + page_view (aiguillage gtag/relais, voir lib/ga4.ts).
      // Inerte tant que PUBLIC_GA4_MEASUREMENT_ID n'est pas définie.
      initGa4();

      // Câblage global des boutons "Add to bag" (cartes produit/coffret, quelle
      // que soit la page) — voir cart.ts pour la raison de la délégation unique.
      initAddToCartButtons();

      // Icône panier du header : ouvre la modale (voir CartDrawer.astro) au
      // lieu de naviguer — href gardé en repli si le JS ne s'exécute pas.
      document.querySelectorAll<HTMLAnchorElement>("[data-cart-open-trigger]").forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent("cart:open"));
        });
      });

      const countEl = document.querySelector<HTMLElement>("[data-cart-count]");
      function renderCount(cart: ShopifyCart | null) {
        if (!countEl) return;
        const q = visibleQuantity(cart);
        countEl.textContent = q > 0 ? `(${q})` : "";
      }
      document.addEventListener("cart:updated", (e) =>
        renderCount((e as CartUpdatedEvent).detail.cart)
      );
      loadCart().then(renderCount).catch(() => {});

      // Newsletter du footer — même endpoint que le formulaire du teaser
      // (src/middleware.ts), et identifie aussi le profil dans Klaviyo.
      const signupForm = document.querySelector<HTMLFormElement>("[data-signup-form]");
      const signupMsg = document.querySelector<HTMLElement>("[data-signup-msg]");
      const signupButton = signupForm?.querySelector<HTMLButtonElement>("button");
      signupForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const input = signupForm.querySelector<HTMLInputElement>("input[name=email]");
        const email = input?.value.trim();
        if (!email || !signupButton) return;

        signupButton.disabled = true;
        if (signupMsg) signupMsg.textContent = signupButton.dataset.msgSending ?? "";

        // Langue de la page (fr/ar/en, posée sur <html lang>) : stockée sur le
        // profil Klaviyo pour aiguiller les futurs emails par langue (splits
        // sur la propriété perso `site_locale` — prérequis de la version
        // arabe). Nom délibérément distinct de "locale" : Klaviyo réserve ce
        // nom pour un champ système du profil, une propriété perso homonyme
        // serait invisible dans le picker du champ système (constaté en réel).
        const locale = document.documentElement.lang || undefined;

        try {
          const res = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, locale, source: "footer" }),
          });
          const data = await res.json().catch(() => null);
          if (res.ok && data?.ok) {
            if (signupMsg) signupMsg.textContent = signupButton.dataset.msgSuccess ?? "";
            signupForm.reset();
            try {
              identify({ email, site_locale: locale });
            } catch {
              // le tracking ne doit jamais faire échouer l'inscription
            }
          } else if (signupMsg) {
            signupMsg.textContent = data?.error || signupButton.dataset.msgError || "";
          }
        } catch {
          if (signupMsg) signupMsg.textContent = signupButton.dataset.msgError ?? "";
        } finally {
          signupButton.disabled = false;
        }
      });
    </script>
  </body>
</html>
