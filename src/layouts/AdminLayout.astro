---
/**
 * La tour de contrôle — mise en page de l'administration (/admin).
 *
 * L'UX des outils internes Gemeos (barre latérale, cartes, indicateurs,
 * tableaux) dans l'UI de Maison Reflet : ses couleurs (encre, papier, sable,
 * rose), sa PP Neue Montreal, ses rayons courts. Pages rendues côté serveur,
 * protégées par la session admin (lib/admin/auth.ts). Français seulement.
 *
 * Ici aussi : la période (7/30/90 jours ou deux dates sur mesure), la boîte de
 * dialogue des fenêtres de détail (contenu dans des <template data-modal-template>),
 * les infobulles (« ? » avec data-tip) et l'infobulle des courbes du temps.
 */
import { RANGES, type Range, rangeForDays } from "../lib/admin/data";

interface Props {
  title: string;
  section: "overview" | "ventes" | "trafic" | "live" | "luma" | "conversations" | "questions" | "rgpd";
  admin: { email: string };
  range?: Range;
  subtitle?: string;
  showRange?: boolean;
}
const { title, section, admin, range = rangeForDays(30), subtitle, showRange = true } = Astro.props;

// Neuf pages, un rôle chacune, aucun bloc en double (redécoupage du 14 septembre avec Sandro).
const groups = [
  {
    label: "Business",
    items: [
      { key: "overview", href: "/admin", label: "Vue d'ensemble" },
      { key: "ventes", href: "/admin/ventes", label: "Ventes" },
      { key: "trafic", href: "/admin/trafic", label: "Trafic & sources" },
      { key: "live", href: "/admin/live", label: "En direct", live: true },
    ],
  },
  {
    label: "Luma",
    items: [
      { key: "luma", href: "/admin/luma", label: "Luma" },
      { key: "conversations", href: "/admin/conversations", label: "Conversations" },
      { key: "questions", href: "/admin/questions", label: "Questions" },
    ],
  },
  {
    label: "Données",
    items: [{ key: "rgpd", href: "/admin/rgpd", label: "RGPD & suivi" }],
  },
] as const;

// La période dans l'URL, en gardant les filtres de la page.
const withRange = (q: string) => {
  const u = new URL(Astro.url);
  for (const k of ["days", "from", "to", "page"]) u.searchParams.delete(k);
  const extra = u.searchParams.toString();
  return `${u.pathname}?${q}${extra ? `&${extra}` : ""}`;
};
const keptParams = [...Astro.url.searchParams.entries()].filter(([k]) => !["days", "from", "to", "page"].includes(k));

/*
 * Les données de test se commandent depuis l'entête, pas page par page.
 * Auparavant seules Luma et Questions portaient la case : Ventes, Trafic et la
 * vue d'ensemble n'avaient aucun moyen de les montrer, alors qu'elles lisent les
 * mêmes tables. Le réglage vit dans l'URL, donc il survit à la navigation entre
 * onglets tant que les liens gardent les paramètres.
 */
const avecTest = Astro.url.searchParams.get("test") === "1";
/*
 * Les liens de la barre latérale portent le réglage : sans ça, passer de Ventes
 * à Trafic le perdait et l'on croyait le bouton cassé. « En direct » et « RGPD »
 * ignorent la période mais gardent les données de test, qui les concernent.
 */
const lienSection = (clef: string, href: string) => {
  const p = new URLSearchParams(clef === "live" || clef === "rgpd" ? "" : range.query);
  if (avecTest) p.set("test", "1");
  const q = p.toString();
  return q ? `${href}?${q}` : href;
};
const lienTest = (() => {
  const u = new URL(Astro.url);
  u.searchParams.delete("page");
  if (avecTest) u.searchParams.delete("test");
  else u.searchParams.set("test", "1");
  const q = u.searchParams.toString();
  return `${u.pathname}${q ? `?${q}` : ""}`;
})();
const now = new Intl.DateTimeFormat("fr-FR", { timeZone: "Asia/Dubai", weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" }).format(new Date());
const todayKey = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Dubai", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Tour de contrôle · Maison Reflet</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/ppneuemontreal-book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ppneuemontreal-medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ppneuemontreal-thin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="adm">
    <aside class="adm-side">
      <a class="adm-brand" href="/admin">
        <span class="adm-brand-name">Maison Reflet</span>
        <span class="adm-brand-sub">Tour de contrôle</span>
      </a>
      <nav class="adm-nav" aria-label="Sections">
        {
          groups.map((g) => (
            <div class="adm-nav-group">
              <p class="adm-nav-label">{g.label}</p>
              {g.items.map((n) => (
                <a class:list={["adm-nav-link", { "is-active": n.key === section }]} href={lienSection(n.key, n.href)} aria-current={n.key === section ? "page" : undefined}>
                  {n.label}
                  {"live" in n && n.live && <span class="adm-live-dot" aria-hidden="true"></span>}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
      <div class="adm-side-foot">
        {/* Un interrupteur, pas une case : il change ce qu'on lit sur TOUTES les
            pages, et il doit se voir au premier coup d'œil quand il est allumé. */}
        <a
          class:list={["adm-switch", { "is-on": avecTest }]}
          href={lienTest}
          role="switch"
          aria-checked={avecTest ? "true" : "false"}
          title={avecTest ? "Masquer les données de staging, des previews et du local" : "Afficher aussi les données de staging, des previews et du local"}
        >
          <span class="adm-switch-track" aria-hidden="true"><span class="adm-switch-knob"></span></span>
          <span class="adm-switch-label">Données de test</span>
        </a>
        <a class="adm-side-link" href="/" target="_blank" rel="noopener">Voir le site ↗</a>
        <p class="adm-user">{admin.email}</p>
        <form method="post" action="/api/admin/logout"><button type="submit" class="adm-link-btn">Se déconnecter</button></form>
      </div>
    </aside>
    <main class="adm-main">
      <header class="adm-head">
        <div class="adm-head-text">
          <p class="adm-kicker">{now}</p>
          <h1 class="adm-title">{title}</h1>
          {subtitle && <p class="adm-subtitle">{subtitle}</p>}
        </div>
        {
          showRange && (
            <div class="adm-range-wrap">
              <nav class="adm-range" aria-label="Période">
                {RANGES.map((d) => <a class:list={["adm-range-btn", { "is-active": range.preset === d }]} href={withRange(`days=${d}`)}>{d} j</a>)}
                <details class="adm-custom" data-custom-range>
                  <summary class:list={["adm-range-btn", "adm-range-custom", { "is-active": range.preset === null }]}>{range.preset === null ? range.label : "Sur mesure"}</summary>
                  <form class="adm-custom-pop" method="get">
                    {keptParams.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
                    <label class="field"><span>Du</span><input type="date" name="from" value={range.fromKey} max={todayKey} required /></label>
                    <label class="field"><span>Au</span><input type="date" name="to" value={range.toKey} max={todayKey} required /></label>
                    <button type="submit" class="btn btn-sm btn-rose">Appliquer</button>
                  </form>
                </details>
              </nav>
              <p class="adm-range-label">{range.preset ? `Du ${new Intl.DateTimeFormat("fr-FR", { timeZone: "Asia/Dubai", day: "numeric", month: "short" }).format(range.from)} au ${new Intl.DateTimeFormat("fr-FR", { timeZone: "Asia/Dubai", day: "numeric", month: "short" }).format(range.to)} · comparé aux ${range.days} jours d'avant` : `${range.days} jour${range.days > 1 ? "s" : ""} · comparé aux ${range.days} jours d'avant`}</p>
            </div>
          )
        }
      </header>
      <slot name="filters" />
      <slot />
    </main>

    <dialog class="adm-modal" data-dialog>
      <div class="adm-modal-box">
        <header class="adm-modal-head">
          <div>
            <h2 class="adm-modal-title" data-modal-title></h2>
            <p class="adm-modal-sub muted" data-modal-subtitle></p>
          </div>
          <button type="button" class="adm-modal-close" data-modal-close aria-label="Fermer">✕</button>
        </header>
        <div class="adm-modal-body" data-modal-body></div>
      </div>
    </dialog>
    <div class="adm-tipbox" data-tipbox role="tooltip" hidden></div>
    <div class="adm-chart-tip" data-chart-tip hidden></div>

    <script>
      /* ---- fenêtres de détail : un <template data-modal-template> copié dans la boîte ---- */
      // `data-dialog`, pas `data-modal` : les courbes portent déjà `data-modal="days"` et passeraient avant dans le DOM.
      const dialog = document.querySelector<HTMLDialogElement>("[data-dialog]")!;
      const body = dialog.querySelector<HTMLElement>("[data-modal-body]")!;
      const titleEl = dialog.querySelector<HTMLElement>("[data-modal-title]")!;
      const subEl = dialog.querySelector<HTMLElement>("[data-modal-subtitle]")!;
      let opener: HTMLElement | null = null;
      const openModal = (id: string, highlight?: string, from?: HTMLElement) => {
        const tpl = document.querySelector<HTMLTemplateElement>(`template[data-modal-template="${id}"]`);
        if (!tpl) return;
        opener = from ?? null;
        titleEl.textContent = tpl.dataset.title ?? "";
        subEl.textContent = tpl.dataset.subtitle ?? "";
        subEl.hidden = !tpl.dataset.subtitle;
        dialog.classList.toggle("is-wide", tpl.dataset.wide === "1");
        // La fenêtre d'un Reflet reprend sa couleur signature ; les autres restent neutres.
        titleEl.style.color = tpl.dataset.titleColor ?? "";
        dialog.style.setProperty("--accent", tpl.dataset.accent ?? "transparent");
        body.replaceChildren(tpl.content.cloneNode(true));
        paginate(body);
        brancherCourbes(body);
        if (!dialog.open) dialog.showModal();
        /*
         * `showModal()` place la boîte dans la couche supérieure : tout ce qui
         * vit en dehors est peint dessous, quel que soit le z-index. Les deux
         * infobulles s'affichaient donc correctement mais restaient invisibles
         * derrière la fenêtre. On les emmène dedans le temps de l'ouverture.
         */
        dialog.append(tipbox, chartTip);
        body.scrollTop = 0;
        if (highlight) {
          const row = body.querySelector<HTMLElement>(`[data-row="${highlight}"]`);
          if (row) {
            row.classList.add("is-hl");
            requestAnimationFrame(() => row.scrollIntoView({ block: "center" }));
          }
        }
      };
      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement;
        if (t.closest("[data-tip]")) return; // le « ? » est géré plus bas, sans ouvrir la fenêtre derrière
        const btn = t.closest<HTMLElement>("[data-open-modal]");
        if (btn) {
          e.preventDefault();
          openModal(btn.dataset.openModal!, btn.dataset.highlight, btn);
          return;
        }
        if (t.closest("[data-modal-close]")) dialog.close();
        else if (t === dialog) dialog.close(); // le voile
      });
      // Entrée ou Espace sur un élément cliquable qui n'est pas un vrai bouton (carte, ligne de tableau).
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const t = e.target as HTMLElement;
        if (t.tagName === "BUTTON" || t.tagName === "A" || t.tagName === "INPUT" || t.tagName === "SELECT") return;
        const el = t.closest<HTMLElement>("[data-open-modal]");
        if (!el) return;
        e.preventDefault();
        openModal(el.dataset.openModal!, el.dataset.highlight, el);
      });
      dialog.addEventListener("close", () => {
        body.replaceChildren();
        // Les infobulles retournent dans la page, où elles servent aussi.
        document.body.append(tipbox, chartTip);
        tipbox.hidden = true;
        chartTip.hidden = true;
        opener?.focus();
      });

      /* ---- infobulles : le « ? » et tout élément data-tip ---- */
      const tipbox = document.querySelector<HTMLElement>("[data-tipbox]")!;
      const chartTip = document.querySelector<HTMLElement>("[data-chart-tip]")!;
      let tipFor: HTMLElement | null = null;
      const showTip = (el: HTMLElement) => {
        tipFor = el;
        tipbox.textContent = el.dataset.tip ?? "";
        tipbox.hidden = false;
        const r = el.getBoundingClientRect();
        const w = Math.min(320, window.innerWidth - 24);
        tipbox.style.width = `${w}px`;
        let left = r.left + r.width / 2 - w / 2;
        left = Math.max(12, Math.min(window.innerWidth - w - 12, left));
        const below = r.bottom + 10 + tipbox.offsetHeight < window.innerHeight;
        tipbox.style.left = `${left}px`;
        tipbox.style.top = `${below ? r.bottom + 10 : r.top - tipbox.offsetHeight - 10}px`;
        tipbox.dataset.place = below ? "below" : "above";
      };
      const hideTip = () => {
        tipbox.hidden = true;
        tipFor = null;
      };
      document.addEventListener("pointerover", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (el && el !== tipFor) showTip(el);
        else if (!el && tipFor && !(e.target as HTMLElement).closest("[data-tipbox]")) hideTip();
      });
      document.addEventListener("focusin", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (el) showTip(el);
      });
      document.addEventListener("focusout", () => hideTip());
      document.addEventListener("click", (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>("[data-tip]");
        if (!el) return;
        e.preventDefault();
        tipFor === el && !tipbox.hidden ? hideTip() : showTip(el);
      });
      window.addEventListener(
        "scroll",
        () => {
          if (tipFor) hideTip();
          chartTip.hidden = true;
        },
        { passive: true }
      );

      /* ---- les courbes du temps : survol = infobulle et repère ; clic = le jour par jour ----
         Branché par portée, pas une fois pour toutes : les courbes des fenêtres
         de détail sont clonées depuis un <template> après coup et n'existaient
         pas au chargement — elles restaient muettes au survol. */
      type Pt = { k: string; l: string; p: string; s: string | null };
      const brancherCourbes = (scope: ParentNode) => {
      for (const chart of scope.querySelectorAll<HTMLElement>("[data-chart]")) {
        if (chart.dataset.branchee) continue;
        chart.dataset.branchee = "1";
        const plot = chart.querySelector<HTMLElement>("[data-plot]");
        if (!plot) continue;
        const points = JSON.parse(chart.dataset.points ?? "[]") as Pt[];
        const guide = chart.querySelector<HTMLElement>("[data-guide]");
        const pLabel = chart.dataset.primaryLabel ?? "";
        const sLabel = chart.dataset.secondaryLabel ?? "";
        const indexAt = (clientX: number) => {
          const r = plot.getBoundingClientRect();
          return Math.max(0, Math.min(points.length - 1, Math.floor(((clientX - r.left) / r.width) * points.length)));
        };
        plot.addEventListener("pointermove", (e) => {
          if (!points.length) return;
          const i = indexAt(e.clientX);
          const pt = points[i];
          if (guide) {
            guide.hidden = false;
            guide.style.left = `${((i + 0.5) / points.length) * 100}%`;
          }
          chartTip.innerHTML = `<strong>${pt.l}</strong><span>${pLabel ? `${pLabel} · ` : ""}${pt.p}</span>${pt.s !== null ? `<span class="muted">${sLabel ? `${sLabel} · ` : ""}${pt.s}</span>` : ""}`;
          chartTip.hidden = false;
          const w = chartTip.offsetWidth;
          let x = e.clientX + 14;
          if (x + w > window.innerWidth - 12) x = e.clientX - w - 14;
          chartTip.style.left = `${x}px`;
          chartTip.style.top = `${e.clientY - chartTip.offsetHeight / 2}px`;
        });
        plot.addEventListener("pointerleave", () => {
          chartTip.hidden = true;
          if (guide) guide.hidden = true;
        });
        if (chart.dataset.modal) {
          plot.addEventListener("click", (e) => {
            const i = indexAt(e.clientX);
            openModal(chart.dataset.modal!, points[i]?.k);
          });
        }
      }
      };
      brancherCourbes(document);

      /* ---- pagination des longs tableaux : 50 lignes, puis « les 50 suivantes » ---- */
      const paginate = (scope: ParentNode) => {
        for (const table of scope.querySelectorAll<HTMLTableElement>("table[data-paginate]:not([data-paginated])")) {
          table.dataset.paginated = "1";
          const size = Number(table.dataset.paginate) || 50;
          const noun = table.dataset.paginateNoun ?? "lignes";
          const rows = [...table.tBodies].flatMap((tb) => [...tb.rows]);
          if (rows.length <= size) continue;
          let shown = size;
          const pager = document.createElement("div");
          pager.className = "pager";
          const info = document.createElement("span");
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "btn btn-sm btn-ghost";
          const render = () => {
            rows.forEach((r, i) => (r.hidden = i >= shown));
            info.textContent = `${Math.min(shown, rows.length)} ${noun} sur ${rows.length}`;
            btn.textContent = `Afficher les ${Math.min(size, rows.length - shown)} suivant${Math.min(size, rows.length - shown) > 1 ? "s" : ""}`;
            btn.hidden = shown >= rows.length;
          };
          btn.addEventListener("click", () => {
            shown += size;
            render();
          });
          pager.append(info, btn);
          (table.closest(".tbl-wrap") ?? table).after(pager);
          render();
        }
      };
      paginate(document);

      /* ---- la période sur mesure : fermer le volet en cliquant ailleurs ---- */
      const custom = document.querySelector<HTMLDetailsElement>("[data-custom-range]");
      document.addEventListener("click", (e) => {
        if (custom?.open && !custom.contains(e.target as Node)) custom.open = false;
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: "PP Neue Montreal"; src: url("/fonts/ppneuemontreal-thin.woff2") format("woff2"); font-weight: 100; font-display: swap; }
  @font-face { font-family: "PP Neue Montreal"; src: url("/fonts/ppneuemontreal-book.woff2") format("woff2"); font-weight: 400; font-display: swap; }
  @font-face { font-family: "PP Neue Montreal"; src: url("/fonts/ppneuemontreal-italic.woff2") format("woff2"); font-weight: 400; font-style: italic; font-display: swap; }
  @font-face { font-family: "PP Neue Montreal"; src: url("/fonts/ppneuemontreal-medium.woff2") format("woff2"); font-weight: 500; font-display: swap; }
  @font-face { font-family: "PP Neue Montreal"; src: url("/fonts/ppneuemontreal-bold.woff2") format("woff2"); font-weight: 700; font-display: swap; }

  :root {
    --rose: #812538;
    --rose-deep: #6a1e2e;
    --rose-soft: rgba(129, 37, 56, 0.08);
    --ink: #150e0a;
    --bg: #f1eee9;
    --paper: #f7f5f2;
    --paper-2: #fbfaf8;
    --sand: #e7dfd0;
    --line: rgba(21, 14, 10, 0.09);
    --line-strong: rgba(21, 14, 10, 0.2);
    --muted: rgba(21, 14, 10, 0.56);
    --muted-2: rgba(21, 14, 10, 0.38);
    --ok: #3f6b4f;
    --ok-soft: rgba(63, 107, 79, 0.12);
    --warn: #a8641e;
    --warn-soft: rgba(168, 100, 30, 0.12);
    --side-w: 248px;
    --shadow: 0 1px 2px rgba(21, 14, 10, 0.04), 0 10px 30px -18px rgba(21, 14, 10, 0.18);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { color-scheme: light; }
  body.adm {
    margin: 0;
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--side-w) minmax(0, 1fr);
    background: var(--bg);
    color: var(--ink);
    font-family: "PP Neue Montreal", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    line-height: 1.4;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* ---- barre latérale ---- */
  .adm-side { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; gap: 28px; padding: 28px 18px 24px; background: var(--paper); border-right: 1px solid var(--line); overflow-y: auto; }
  .adm-brand { display: flex; flex-direction: column; gap: 4px; padding: 0 12px; }
  .adm-brand-name { font-size: 13px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; }
  .adm-brand-sub { font-size: 11px; color: var(--rose); letter-spacing: 0.1em; text-transform: uppercase; }
  .adm-nav { display: flex; flex-direction: column; gap: 18px; }
  .adm-nav-group { display: flex; flex-direction: column; gap: 2px; }
  .adm-nav-label { margin: 0 0 6px; padding: 0 12px; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted-2); }
  .adm-nav-link { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-radius: 8px; font-size: 14px; color: var(--muted); transition: background-color 0.15s ease, color 0.15s ease; }
  .adm-nav-link:hover { color: var(--ink); background: rgba(21, 14, 10, 0.04); }
  .adm-nav-link.is-active { color: var(--rose); background: var(--rose-soft); font-weight: 500; }
  .adm-live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); animation: adm-pulse 2.2s ease-out infinite; }
  @keyframes adm-pulse { 0% { box-shadow: 0 0 0 0 rgba(63, 107, 79, 0.45); } 70% { box-shadow: 0 0 0 7px rgba(63, 107, 79, 0); } 100% { box-shadow: 0 0 0 0 rgba(63, 107, 79, 0); } }
  .adm-side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 8px; padding: 0 12px; font-size: 12px; color: var(--muted); }
  .adm-side-link:hover { color: var(--ink); }
  .adm-user { margin: 0; word-break: break-all; }
  .adm-link-btn { padding: 0; border: 0; background: none; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .adm-link-btn:hover { color: var(--ink); }

  /* ---- en-tête et période ---- */
  .adm-main { padding: 30px 40px 72px; display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .adm-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-bottom: 4px; }
  /* Éteint il se fait oublier, allumé il passe en bordeaux : on doit savoir d'un
     coup d'œil qu'on ne regarde pas les vrais chiffres. */
  .adm-switch { display: flex; align-items: center; gap: 10px; padding: 4px 0 10px; color: var(--muted); font-size: 13px; }
  .adm-switch:hover { color: var(--ink); }
  .adm-switch-track {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 18px;
    border-radius: 999px;
    background: rgba(21, 14, 10, 0.16);
    transition: background-color 0.2s ease;
  }
  .adm-switch-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: 0 1px 2px rgba(21, 14, 10, 0.22);
    transition: transform 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .adm-switch.is-on { color: var(--rose); }
  .adm-switch.is-on .adm-switch-track { background: var(--rose); }
  .adm-switch.is-on .adm-switch-knob { transform: translateX(14px); }
  @media (prefers-reduced-motion: reduce) {
    .adm-switch-track, .adm-switch-knob { transition: none; }
  }
  .adm-kicker { margin: 0 0 6px; font-size: 12px; color: var(--muted); }
  .adm-kicker::first-letter { text-transform: uppercase; }
  .adm-title { margin: 0; font-size: 34px; font-weight: 400; line-height: 1.05; letter-spacing: -0.015em; }
  .adm-subtitle { margin: 8px 0 0; color: var(--muted); max-width: 720px; }
  .adm-range-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
  .adm-range { position: relative; display: inline-flex; align-items: center; padding: 3px; border: 1px solid var(--line); border-radius: 100px; background: var(--paper); }
  .adm-range-btn { display: inline-block; padding: 7px 14px; border-radius: 100px; font-size: 13px; color: var(--muted); cursor: pointer; list-style: none; white-space: nowrap; }
  .adm-range-btn::-webkit-details-marker { display: none; }
  .adm-range-btn:hover { color: var(--ink); }
  .adm-range-btn.is-active { background: var(--ink); color: var(--bg); }
  .adm-range-label { margin: 0; font-size: 11px; color: var(--muted-2); }
  .adm-custom { position: relative; }
  .adm-custom-pop { position: absolute; right: 0; top: calc(100% + 10px); z-index: 20; display: flex; align-items: flex-end; gap: 10px; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); box-shadow: var(--shadow); }
  .adm-custom-pop .field span { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .adm-custom-pop input[type="date"] { padding: 8px 10px; border: 1px solid var(--line-strong); border-radius: 8px; background: var(--paper); font: inherit; font-size: 13px; color: var(--ink); }

  /* ---- grilles et cartes ---- */
  .grid { display: grid; gap: 16px; }
  .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .span-2 { grid-column: span 2; }
  .card { background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 20px 22px; min-width: 0; box-shadow: var(--shadow); }
  .card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .card-title { display: inline-flex; align-items: center; gap: 6px; margin: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .card-note { margin: 0; font-size: 12px; color: var(--muted); text-align: end; }
  .card-note a, a.card-note { color: var(--rose); }
  .card-foot { margin: 14px 0 0; font-size: 12px; color: var(--muted); line-height: 1.5; }
  .section-title { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin: 10px 0 -6px; }
  .section-title h2 { margin: 0; font-size: 20px; font-weight: 400; letter-spacing: -0.01em; }
  .section-title p { margin: 0; font-size: 12px; color: var(--muted); }
  .section-title.is-major { margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--line); }
  .section-title.is-major h2 { font-size: 24px; }
  .anchors { display: inline-flex; gap: 4px; padding: 3px; border: 1px solid var(--line); border-radius: 100px; background: var(--paper); }
  .anchors a { padding: 6px 14px; border-radius: 100px; font-size: 13px; color: var(--muted); }
  .anchors a:hover { color: var(--ink); background: rgba(21, 14, 10, 0.04); }
  .pt-list { display: grid; grid-template-columns: 1fr; gap: 4px; }
  .pt-row { display: grid; grid-template-columns: 36px minmax(120px, 1fr) auto; align-items: center; gap: 14px; width: 100%; padding: 6px 8px; margin: 0 -8px; border: 0; border-radius: 10px; background: none; text-align: start; color: inherit; cursor: pointer; }
  .pt-row:hover { background: rgba(21, 14, 10, 0.045); }
  .pt-name { font-weight: 500; font-size: 14px; }
  .pt-sub { display: block; font-size: 11px; color: var(--muted); font-weight: 400; }
  .pt-stats { display: grid; grid-template-columns: repeat(4, 64px); gap: 8px; text-align: end; font-size: 11px; color: var(--muted); white-space: nowrap; }
  .pt-stats b { display: block; font-weight: 400; color: var(--ink); font-size: 14px; font-variant-numeric: tabular-nums; }
  @media (min-width: 1700px) { .pt-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 24px; } }

  /* ---- indicateurs ---- */
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; }
  .kpi { display: flex; flex-direction: column; gap: 8px; text-align: start; }
  .kpi-click { cursor: pointer; transition: border-color 0.15s ease; }
  .kpi-click:hover, .kpi-click:focus-visible { border-color: var(--line-strong); outline: none; }
  .kpi-label { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .kpi-value { font-size: 32px; font-weight: 400; line-height: 1; letter-spacing: -0.015em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kpi-value .unit { font-size: 14px; color: var(--muted); margin-inline-start: 6px; letter-spacing: 0.04em; }
  .kpi-foot { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; font-size: 12px; color: var(--muted); }
  .kpi-sub { font-size: 12px; color: var(--muted); }
  .kpi-rose .kpi-value { color: var(--rose); }
  /* Le chiffre d'un Reflet dans sa propre couleur plutôt que dans le rouge de la
     Maison : c'est de ce parfum-là qu'on parle. */
  .kpi-teinte .kpi-value { color: var(--encre, var(--rose)); }
  /* La carte du chiffre : dans le rouge de la Maison, pas en noir (Sandro, 14 sept.). */
  .kpi-hero { grid-column: span 2; background: var(--rose); color: var(--paper); border-color: var(--rose); }
  .kpi-hero .kpi-label, .kpi-hero .kpi-sub, .kpi-hero .kpi-foot { color: rgba(247, 245, 242, 0.7); }
  .kpi-hero .kpi-value { font-size: 52px; font-weight: 100; color: var(--paper); }
  .kpi-hero .kpi-value .unit { color: rgba(247, 245, 242, 0.7); font-size: 16px; }
  .kpi-hero .tip { border-color: rgba(247, 245, 242, 0.45); color: rgba(247, 245, 242, 0.8); }
  .kpi-hero .tip:hover, .kpi-hero .tip:focus-visible { border-color: var(--paper); color: var(--paper); }
  .kpi-hero .delta.is-good { color: #dff2e3; }
  .kpi-hero .delta.is-bad { color: #f6d3da; }
  .kpi-hero .delta.is-none { color: rgba(247, 245, 242, 0.55); }
  .kpi-hero.kpi-click:hover { border-color: var(--rose-deep); background: var(--rose-deep); }
  .kpi-more { margin-top: auto; font-size: 11px; color: var(--rose); letter-spacing: 0.04em; opacity: 0; transition: opacity 0.15s ease; }
  .kpi-hero .kpi-more { color: rgba(247, 245, 242, 0.85); }
  .kpi-click:hover .kpi-more, .kpi-click:focus-visible .kpi-more { opacity: 1; }
  .delta { display: inline-flex; align-items: center; gap: 3px; font-size: 12px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .delta.is-good { color: var(--ok); }
  .delta.is-bad { color: var(--rose); }
  .delta.is-none { color: var(--muted-2); }
  .delta-arrow { font-size: 9px; }

  /* ---- le « ? » ---- */
  .tip { display: inline-flex; align-items: center; justify-content: center; width: 15px; height: 15px; padding: 0; border: 1px solid var(--line-strong); border-radius: 50%; background: none; color: var(--muted); font-size: 10px; line-height: 1; cursor: help; vertical-align: middle; letter-spacing: 0; text-transform: none; }
  .tip:hover, .tip:focus-visible { border-color: var(--ink); color: var(--ink); outline: none; }
  .adm-tipbox { position: fixed; z-index: 60; padding: 10px 12px; border: 1px solid rgba(241, 238, 233, 0.22); border-radius: 10px; background: var(--ink); color: var(--bg); font-size: 12.5px; line-height: 1.45; box-shadow: 0 12px 30px -12px rgba(21, 14, 10, 0.5); pointer-events: none; }
  .adm-chart-tip { position: fixed; z-index: 60; display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; border-radius: 8px; background: var(--ink); color: var(--bg); font-size: 12px; line-height: 1.4; pointer-events: none; white-space: nowrap; }
  .adm-chart-tip strong { font-weight: 500; }
  .adm-chart-tip .muted { color: rgba(241, 238, 233, 0.6); }

  /* ---- graphiques ---- */
  .chart { display: block; width: 100%; color: var(--ink); }
  .tchart { display: grid; grid-template-columns: 44px minmax(0, 1fr); grid-template-rows: var(--tchart-h, 200px) 24px; column-gap: 8px; width: 100%; color: var(--ink); padding-top: 6px; }
  .tchart-y { position: relative; grid-row: 1; grid-column: 1; }
  .tchart-ylabel { position: absolute; right: 0; transform: translateY(-50%); font-size: 10px; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tchart-plot { position: relative; grid-row: 1; grid-column: 2; min-width: 0; }
  .tchart-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
  .tchart-dot { position: absolute; width: 7px; height: 7px; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 0 2px var(--paper); pointer-events: none; }
  .tchart-dot.is-small { width: 5px; height: 5px; }
  .tchart-guide { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--ink); opacity: 0.35; transform: translateX(-50%); pointer-events: none; }
  .tchart-x { position: relative; grid-row: 2; grid-column: 2; }
  .tchart-xlabel { position: absolute; top: 7px; transform: translateX(-50%); font-size: 10px; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .tchart.is-clickable .tchart-plot { cursor: pointer; }
  .spark { display: block; }
  .donut { display: block; }
  .donut-row { display: grid; grid-template-columns: 120px 1fr; gap: 18px; align-items: center; }
  .stack { display: flex; height: 12px; border-radius: 6px; overflow: hidden; background: var(--sand); gap: 2px; }
  .stack.is-empty { opacity: 0.6; }
  .stack-seg { display: block; height: 100%; min-width: 3px; position: relative; }
  .legend { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 13px; }
  .legend li { display: grid; grid-template-columns: 10px 1fr auto; align-items: center; gap: 10px; }
  .legend .dot { width: 10px; height: 10px; border-radius: 50%; }
  .legend-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .legend-num { font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }
  .legend-btn { display: grid; grid-template-columns: 10px 1fr auto; align-items: center; gap: 10px; width: 100%; padding: 4px 6px; margin: -4px -6px; border: 0; border-radius: 6px; background: none; text-align: start; cursor: pointer; }
  .legend-btn:hover { background: rgba(21, 14, 10, 0.04); }
  .hbars { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .hbar { display: grid; grid-template-columns: minmax(120px, 1.5fr) minmax(40px, 1.4fr) auto; align-items: center; gap: 12px; width: 100%; padding: 5px 8px; margin: 0 -8px; border: 0; border-radius: 8px; background: none; font-size: 13px; text-align: start; color: inherit; }
  .hbar-btn { cursor: pointer; }
  .hbar-btn:hover, a.hbar:hover { background: rgba(21, 14, 10, 0.045); }
  .hbar-label { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  .hbar-prefix { font-size: 15px; line-height: 1; }
  .hbar-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hbar-track { display: block; height: 6px; border-radius: 3px; background: var(--sand); overflow: hidden; }
  .hbar-fill { display: block; height: 100%; border-radius: 3px; }
  .hbar-value { min-width: 28px; text-align: end; font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }
  .gauge { display: block; height: 6px; border-radius: 3px; background: var(--sand); overflow: hidden; }
  .gauge-fill { display: block; height: 100%; border-radius: 3px; }
  .fsteps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .fstep { display: grid; grid-template-columns: 96px 1fr 56px 44px; align-items: center; gap: 12px; font-size: 13px; }
  .fstep-label { color: var(--muted); display: flex; flex-direction: column; gap: 1px; }
  .fstep-sub { font-size: 11.5px; color: var(--muted-2, var(--muted)); font-variant-numeric: tabular-nums; }
  /* Une marche cliquable ouvre le détail, comme un segment de barre empilée. */
  .fstep-btn {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .fstep-btn:hover .fstep-fill { opacity: 1; }
  .fstep-bar { display: block; height: 22px; border-radius: 5px; background: var(--sand); overflow: hidden; }
  .fstep-fill { display: block; height: 100%; background: var(--ink); opacity: 0.75; border-radius: 5px; transition: width 0.4s ease; }
  .fstep:nth-child(2) .fstep-fill { opacity: 0.6; }
  .fstep:nth-child(3) .fstep-fill { opacity: 0.45; }
  .fstep:nth-child(4) .fstep-fill { opacity: 0.3; }
  .fstep:last-child .fstep-fill { background: var(--rose); opacity: 1; }
  .fstep-value { text-align: end; font-variant-numeric: tabular-nums; }
  .fstep-rate { font-size: 11px; color: var(--muted); text-align: end; font-variant-numeric: tabular-nums; }

  /* ---- listes à l'ancienne (pages Luma) ---- */
  .bars { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .bars li { display: grid; grid-template-columns: minmax(90px, 1fr) minmax(60px, 2fr) auto; align-items: center; gap: 12px; font-size: 13px; }
  .bars .bar-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bars .bar-count { min-width: 32px; text-align: end; font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }

  /* ---- tableaux ---- */
  .tbl-card { padding: 0; overflow: hidden; }
  .tbl-card .card-head { padding: 18px 22px 0; margin-bottom: 10px; }
  .tbl-wrap { overflow-x: auto; }
  .tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
  .tbl th { padding: 10px 22px; text-align: start; font-size: 10px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); white-space: nowrap; }
  .tbl td { padding: 12px 22px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .tbl tbody tr:last-child td { border-bottom: 0; }
  .tbl tbody tr:hover { background: rgba(255, 255, 255, 0.55); }
  .tbl tr.is-hl td { background: var(--rose-soft); }
  .tbl tr[data-open-modal] { cursor: pointer; }
  .tbl .num { text-align: end; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tbl .when, .tbl .nowrap { white-space: nowrap; }
  .tbl .muted { color: var(--muted); }
  .tbl .lead { font-weight: 500; }
  .tbl td.strong, .strong { font-weight: 500; }
  .tbl a.row-link { display: block; }
  .tbl .cell-q { max-width: 420px; }
  .tbl .cell-gauge { min-width: 120px; }
  .tbl .cell-gauge .gauge { margin-top: 6px; }
  .tbl-compact th { padding: 8px 14px; }
  .tbl-compact td { padding: 9px 14px; }
  .ellipsis { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* ---- produits ---- */
  .pthumb { display: inline-flex; flex: none; width: var(--s); height: var(--s); border-radius: 8px; overflow: hidden; background: var(--sand); align-items: center; justify-content: center; vertical-align: middle; }
  .pthumb-portrait { height: calc(var(--s) * 1.25); }
  .pthumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pthumb-fallback { font-size: calc(var(--s) * 0.4); color: var(--muted); }
  .items { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .items .pthumb { border: 2px solid var(--paper); }
  .items-stack { display: inline-flex; align-items: center; }
  .items-stack .pthumb + .pthumb { margin-inline-start: -10px; }
  .items-text { min-width: 0; }
  .pcell { display: inline-flex; align-items: center; gap: 10px; }
  .ptiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  /* --teinte, --trait, --encre et --voile sont posés par la vignette elle-même,
     d'après la couleur signature du Reflet (voir lib/admin/couleurs.ts). */
  .ptile { position: relative; display: grid; grid-template-columns: 72px 1fr; gap: 14px; align-items: start; padding: 14px 14px 14px 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--paper); text-align: start; cursor: pointer; box-shadow: var(--shadow); transition: border-color 0.15s ease, transform 0.2s ease, box-shadow 0.2s ease; color: inherit; overflow: hidden; }
  .ptile::before { content: ""; position: absolute; inset-inline-start: 0; inset-block: 0; width: 4px; background: var(--teinte, var(--sand)); }
  .ptile:hover { border-color: var(--line-strong); transform: translateY(-2px); box-shadow: 0 1px 2px rgba(21, 14, 10, 0.05), 0 18px 34px -20px rgba(21, 14, 10, 0.3); }
  .ptile:hover { background: linear-gradient(var(--voile, transparent), var(--voile, transparent)), var(--paper); }
  .ptile.is-focus { border-color: var(--trait, var(--rose)); }
  .ptile-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .ptile-name { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 15px; font-weight: 500; line-height: 1.2; color: var(--encre, var(--ink)); }
  .ptile-kind { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted-2); }
  .ptile-revenue { font-size: 22px; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; line-height: 1.1; }
  .ptile-revenue .unit { font-size: 12px; color: var(--muted); margin-inline-start: 4px; }
  .ptile-share { display: block; height: 4px; border-radius: 2px; background: var(--voile, var(--sand)); overflow: hidden; }
  .ptile-share span { display: block; height: 100%; background: var(--trait, var(--rose)); }
  .ptile-stats { display: grid; grid-template-columns: repeat(3, minmax(0, auto)); justify-content: start; gap: 4px 12px; margin: 2px 0 0; font-size: 11px; color: var(--muted); white-space: nowrap; }
  .ptile-stats b { display: block; font-weight: 400; color: var(--ink); font-variant-numeric: tabular-nums; font-size: 13px; }
  .ptile-warn { font-size: 11px; color: var(--warn); }
  .ptile-rate { color: var(--muted); }
  .heat { display: grid; grid-template-columns: 34px repeat(24, minmax(0, 1fr)); gap: 3px; align-items: center; }
  .heat-corner, .heat-hour, .heat-day { font-size: 10px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .heat-hour { text-align: center; }
  .heat-day { text-align: end; padding-inline-end: 4px; }
  .heat-cell { display: block; aspect-ratio: 1.6; border-radius: 3px; min-height: 12px; }
  .adm-filters-check { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border: 1px solid var(--line-strong); border-radius: 100px; font-size: 13px; color: var(--muted); cursor: pointer; }
  .adm-filters-check:has(input:checked) { border-color: var(--warn); color: var(--warn); }
  .adm-filters-check input { accent-color: var(--warn); margin: 0; }
  .hbar-thumb { display: block; width: 22px; height: 22px; border-radius: 5px; object-fit: cover; background: var(--sand); }
  /* Le repère d'un Reflet, partout où son nom apparaît sans sa photo. */
  .pastille { display: inline-block; width: 9px; height: 9px; border-radius: 50%; flex: none; background: var(--teinte, var(--sand)); }
  /* Une carte qui ne porte qu'un graphique : moins d'air autour, pas d'ombre. */
  .card-flat { padding: 14px 16px; box-shadow: none; }
  .seqs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .seq { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 10px; background: rgba(255, 255, 255, 0.4); font-size: 13px; }
  .seq-steps { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .seq-step { padding: 3px 9px; border-radius: 100px; background: var(--sand); white-space: nowrap; }
  .seq-step:first-child { background: var(--ink); color: var(--bg); }
  .seq-arrow { color: var(--muted-2); font-size: 12px; }
  .seq-count { font-variant-numeric: tabular-nums; color: var(--muted); white-space: nowrap; }

  /* ---- badges, boutons, filtres ---- */
