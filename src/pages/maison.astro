---
import { toHTML, type PortableTextComponents } from "@portabletext/to-html";
import Layout from "../layouts/Layout.astro";
import { getPageBySlug, urlForImage } from "../lib/sanity";

// Contenu géré dans le Sanity Studio : document "Page" avec le slug "maison"
// (on accepte aussi "la-maison" par tolérance pour l'éditeur).
const page = (await getPageBySlug("maison")) ?? (await getPageBySlug("la-maison"));

// Le schéma "page" autorise blocs de texte + images : on sérialise les images
// via le CDN Sanity, le reste suit le rendu HTML par défaut de Portable Text.
const components: Partial<PortableTextComponents> = {
  types: {
    image: ({ value }) =>
      `<img src="${urlForImage(value).width(1200).url()}" alt="" loading="lazy" />`,
  },
};

const contentHtml =
  page?.content && Array.isArray(page.content) ? toHTML(page.content, { components }) : "";
---

<Layout
  title={page?.title ?? "La Maison"}
  description="L'histoire de Maison Reflet, maison de parfums franco-arabe"
>
  <article class="page-content">
    {
      page ? (
        <>
          <h1>{page.title}</h1>
          <div set:html={contentHtml} />
        </>
      ) : (
        <>
          <h1>La Maison</h1>
          <p>
            Cette page attend son contenu : dans le Sanity Studio, créer un document
            « Page » avec le slug <code>maison</code>, puis relancer un build.
          </p>
        </>
      )
    }
  </article>
</Layout>

<style>
  .page-content {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .page-content :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
