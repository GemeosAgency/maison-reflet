---
/**
 * Luma : ce qu'elle fait, ce que ça coûte, où ça coince, ce qu'elle recommande
 * et par quelles portes on arrive. Les écoutes, les accords et le comportement
 * sur le site sont dans Trafic & sources ; le lien avec les ventes est en bref
 * ici et détaillé sur la vue d'ensemble.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import Kpi from "../../components/admin/Kpi.astro";
import Tip from "../../components/admin/Tip.astro";
import ProductThumb from "../../components/admin/ProductThumb.astro";
import { readSession } from "../../lib/admin/auth";
import { panne } from "../../lib/admin/panne";
import { overview, reflets, parseRange, fmtInt, fmtPct, fmtMs, fmtUsd, fmtDate, entryLabel, localeLabel } from "../../lib/admin/data";
import { business, loadCatalog, delta } from "../../lib/admin/business";
import { timeChart, sparkline, hbars } from "../../lib/admin/charts";
export const prerender = false;

const admin = await readSession(Astro.cookies);
if (!admin) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const range = parseRange(Astro.url.searchParams);
const withTest = Astro.url.searchParams.get("test") === "1";
let o: Awaited<ReturnType<typeof overview>>;
let r: Awaited<ReturnType<typeof reflets>>;
let catalog: Awaited<ReturnType<typeof loadCatalog>>;
let b: Awaited<ReturnType<typeof business>> | null = null;
try {
  [o, r, catalog, b] = await Promise.all([overview(range, withTest), reflets(range, withTest), loadCatalog(), business(range, { test: withTest || undefined }).catch(() => null)]);
} catch (error) {
  return panne(error, "Luma", Astro.url);
}
const imageOf = (handle: string) => catalog.products.find((p) => p.handle === handle)?.image ?? null;
// Mêmes couleurs que sur Ventes et Trafic : un Reflet se reconnaît partout pareil.
const teintes = new Map(catalog.products.map((p) => [p.handle, p.couleur]));
const traitDe = (handle: string) => teintes.get(handle)?.trait ?? "var(--rose)";
const pct = (v: number | null) => (v === null ? "–" : `${(v * 100).toFixed(v < 0.1 ? 1 : 0).replace(".", ",")} %`);
const perCost = o.conversations ? o.cost / o.conversations : null;
const rows = (list: { label: string; count: number }[], color = "var(--ink)") => list.slice(0, 7).map((x) => ({ label: x.label, value: x.count, text: fmtInt(x.count), color }));
const recoRows = [...r.per].sort((x, y) => y.recommended - x.recommended);
const maxReco = Math.max(1, ...r.per.map((p) => p.recommended));
---

<AdminLayout title="Luma" section="luma" admin={admin} range={range} subtitle={`La conseillère · ${range.label} : conversations, fiches montrées, emails, coût, incidents, ce qu'elle recommande.`}>
  <form class="adm-filters" method="get" slot="filters" data-filter-bar>
    {[...new URLSearchParams(range.query).entries()].map(([k, v]) => <input type="hidden" name={k} value={v} />)}
    <span class="adm-filters-label">Afficher</span>
  </form>
  <section class="kpis">
    <Kpi label="Conversations" value={fmtInt(o.conversations)} sub={`${fmtInt(o.userTurns)} messages de visiteurs · ${o.conversations ? (o.userTurns / o.conversations).toFixed(1).replace(".", ",") : "–"} par conversation`} />
    <Kpi label="Fiches montrées" value={fmtPct(o.withCard, o.conversations)} sub={`${fmtInt(o.withCard)} conversation${o.withCard > 1 ? "s" : ""} avec une carte Reflet`} />
    <Kpi tone="rose" label="Emails captés" value={fmtInt(o.emails)} sub={`${fmtPct(o.emails, o.conversations)} des conversations`} />
    <Kpi label="Coût estimé" tip="lumaCost" value={fmtUsd(o.cost)} sub={`${perCost === null ? "–" : fmtUsd(perCost)} par conversation · ${fmtInt(o.tokensIn / 1000)} k lus, ${fmtInt(o.tokensOut / 1000)} k écrits`} />
    <Kpi label="Latence" value={fmtMs(o.p50)} sub={`médiane · p95 ${fmtMs(o.p95)}`} />
    {b && <Kpi label="Convertissent" tip="lumaConversion" value={b.kpis.lumaTalkers ? pct(b.kpis.lumaConversion) : "–"} delta={b.kpis.lumaTalkers ? delta(b.kpis.lumaConversion, b.previous.kpis.lumaConversion) : undefined} sub={b.kpis.lumaTalkers ? `${fmtInt(b.kpis.lumaTalkers)} visiteur${b.kpis.lumaTalkers > 1 ? "s" : ""} reliés · ${pct(b.kpis.otherConversion)} pour les autres` : "en attente de conversations reliées au parcours"} />}
  </section>

  <section class="grid grid-3">
    <div class="card span-2">
      <div class="card-head"><h2 class="card-title">Conversations et messages, par jour</h2><p class="card-note">aire : conversations · barres : messages de visiteurs</p></div>
      <Fragment set:html={timeChart(o.seriesConversations, { secondary: o.seriesTurns, height: 190, primaryColor: "var(--rose)", secondaryColor: "var(--ink)", primaryFormat: (v) => `${v} conversation${v > 1 ? "s" : ""}`, secondaryFormat: (v) => `${v} message${v > 1 ? "s" : ""}`, primaryLabel: "" })} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Incidents et signaux</h2><p class="card-note">par jour</p></div>
      <ul class="bars incidents">
        {
          o.incidents.map((i) => (
            <li>
              <span class="bar-label">{i.label}</span>
              <Fragment set:html={sparkline(i.spark, { width: 120, height: 26, color: i.key === "email_capture_proposed" ? "var(--ink)" : "var(--rose)" })} />
              <span class="bar-count">{fmtInt(i.count)}</span>
            </li>
          ))
        }
      </ul>
      <p class="card-foot">Une réponse de secours = Luma n'a pas pu répondre elle-même. Le passage à un humain envoie vers contact@maisonreflet.com.</p>
    </div>
  </section>

  <section class="grid grid-3">
    <div class="card tbl-card span-2">
      <div class="card-head"><h2 class="card-title">Ce qu'elle recommande</h2><p class="card-note">{fmtInt(r.recommendedTotal)} recommandation{r.recommendedTotal > 1 ? "s" : ""} · l'alternative est le second Reflet proposé</p></div>
      <div class="tbl-wrap">
        <table class="tbl">
          <thead><tr><th>Reflet</th><th class="cell-gauge">Recommandé</th><th class="num">Part</th><th class="num">En alternative</th></tr></thead>
          <tbody>
            {
              recoRows.map((p) => (
                <tr>
                  <td><span class="pcell"><ProductThumb image={imageOf(p.handle)} name={p.name} size={36} /><strong style={`color:${teintes.get(p.handle)?.encre ?? "var(--ink)"}`}>{p.name}</strong></span></td>
                  <td class="cell-gauge"><span class="mono">{fmtInt(p.recommended)}</span><span class="gauge"><span class="gauge-fill" style={`width:${(p.recommended / maxReco) * 100}%;background:${traitDe(p.handle)}`}></span></span></td>
                  <td class="num muted">{fmtPct(p.recommended, r.recommendedTotal)}</td>
                  <td class="num">{fmtInt(p.alternative)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Par où on arrive</h2><p class="card-note">entrée · page</p></div>
      <Fragment set:html={hbars(rows(o.byEntry))} />
      <p class="modal-section-title spaced">Pages</p>
      <Fragment set:html={hbars(rows(o.byPage, "var(--rose)"))} />
    </div>
  </section>

  <section class="grid grid-4">
    {
      [
        ["Ce qu'ils portent déjà", r.doors.origins],
        ["Ce qu'ils portent aujourd'hui", r.doors.wears],
        ["Pour qui", r.doors.forWhom],
        ["Quelle occasion", r.doors.occasion],
      ].map(([title, list]) => (
        <div class="card">
          <div class="card-head"><h2 class="card-title">{title}</h2></div>
          <Fragment set:html={hbars(rows(list as { label: string; count: number }[]))} />
        </div>
      ))
    }
  </section>

  <section class="grid grid-2">
    <div class="card">
      <div class="card-head"><h2 class="card-title">Langues et pays</h2></div>
      <div class="grid grid-2 tight">
        <Fragment set:html={hbars(rows(o.byLocale))} />
        <Fragment set:html={hbars(rows(o.byCountry, "var(--rose)"))} />
      </div>
    </div>
    <div class="card tbl-card">
      <div class="card-head"><h2 class="card-title">Dernières conversations</h2><a class="card-note" href={`/admin/conversations?${range.query}`}>Toutes →</a></div>
      <div class="tbl-wrap">
        <table class="tbl tbl-compact">
          <thead><tr><th>Quand</th><th>Langue</th><th>Première question</th><th class="num">Tours</th><th></th></tr></thead>
          <tbody>
            {o.recent.length === 0 && <tr><td colspan="5"><p class="empty">Aucune conversation sur la période.</p></td></tr>}
            {
              o.recent.map((c) => (
                <tr>
                  <td class="muted mono when"><a class="row-link" href={`/admin/conversations/${c.id}?${range.query}`}>{fmtDate(c.createdAt)}</a></td>
                  <td>{localeLabel(c.locale)}{c.country ? ` · ${c.country}` : ""}</td>
                  <td class="cell-q"><span class="ellipsis" title={c.firstQuestion}>{c.firstQuestion || "—"}</span></td>
                  <td class="num">{c.turns}</td>
                  <td>{c.hasEmail && <span class="badge badge-rose">email</span>} {c.fallback && <span class="badge badge-warn">secours</span>}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</AdminLayout>

<style>
  .incidents li { grid-template-columns: minmax(100px, 1fr) 120px 40px; }
  .pcell { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; }
  .spaced { margin-top: 16px; }
  .tight { gap: 8px 24px; }
</style>
