---
/**
 * Vue d'ensemble : le business depuis le site, en un regard. Le chiffre, les
 * paniers (validés, abandonnés, en cours, total), par Reflet, les sources, les
 * pays, le parcours, Luma en bref, ce qui se passe maintenant, les dernières
 * commandes. Filtrable par Reflet, pays, source, langue.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import FilterBar from "../../components/admin/FilterBar.astro";
import { readSession } from "../../lib/admin/auth";
import { parseDays, fmtInt, fmtPct, fmtUsd, fmtDate, loadLuma, buildConversations, estimateCost } from "../../lib/admin/data";
import { business, live, parseFilters, hasFilters, fmtMoney, fmtMoneyShort } from "../../lib/admin/business";
import { barsAndLine, donut, gauge } from "../../lib/admin/charts";
export const prerender = false;

const admin = await readSession(Astro.cookies);
if (!admin) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const days = parseDays(Astro.url.searchParams.get("days"));
const filters = parseFilters(Astro.url.searchParams);
const [b, now, luma] = await Promise.all([business(days, filters), live().catch(() => null), loadLuma(days).catch(() => null)]);
const convs = luma ? buildConversations(luma) : [];
const cur = b.currency;
const money = (n: number) => fmtMoney(n, cur);
const pct = (v: number | null) => (v === null ? "–" : `${(v * 100).toFixed(v < 0.1 ? 1 : 0).replace(".", ",")} %`);
const q = (extra: string) => {
  const u = new URL(Astro.url);
  u.pathname = extra;
  return `${u.pathname}${u.search}`;
};
const maxReflet = Math.max(1, ...b.perReflet.map((r) => r.revenue));
const roseGauge = (part: number) => gauge(part, { color: "var(--rose)" });
const maxCountry = Math.max(1, ...b.countries.map((c) => Math.max(c.visitors, 1)));
const funnelMax = Math.max(1, b.funnel.visitors);
const subtitle = hasFilters(filters) ? `Vue filtrée, ${days} derniers jours, heure de Dubaï.` : `Tout ce qui se passe depuis le site sur les ${days} derniers jours, heure de Dubaï.`;
---

<AdminLayout title="Vue d'ensemble" section="overview" admin={admin} days={days} subtitle={subtitle}>
  <FilterBar slot="filters" filters={filters} facets={b.facets} days={days} />

  <section class="kpis kpis-hero">
    <div class="card kpi kpi-hero kpi-rose">
      <span class="kpi-label">Chiffre d'affaires</span>
      <span class="kpi-value">{fmtMoneyShort(b.kpis.revenue)}<span class="unit">{cur}</span></span>
      <span class="kpi-sub">{fmtInt(b.kpis.orders)} commande{b.kpis.orders > 1 ? "s" : ""} · panier moyen {b.kpis.aov === null ? "–" : money(b.kpis.aov)} · {fmtInt(b.kpis.units)} flacon{b.kpis.units > 1 ? "s" : ""}</span>
    </div>
    <div class="card kpi"><span class="kpi-label">Paniers validés</span><span class="kpi-value">{fmtMoneyShort(b.carts.paid.total)}<span class="unit">{cur}</span></span><span class="kpi-sub">{fmtInt(b.carts.paid.count)} commande{b.carts.paid.count > 1 ? "s" : ""} payée{b.carts.paid.count > 1 ? "s" : ""}</span></div>
    <div class="card kpi"><span class="kpi-label">Paniers abandonnés</span><span class="kpi-value">{fmtMoneyShort(b.carts.abandoned.total)}<span class="unit">{cur}</span></span><span class="kpi-sub">{fmtInt(b.carts.abandoned.count)} départ{b.carts.abandoned.count > 1 ? "s" : ""} en paiement sans commande{b.carts.open.count ? ` · ${fmtInt(b.carts.open.count)} en cours` : ""}</span></div>
    <div class="card kpi"><span class="kpi-label">Panier total</span><span class="kpi-value">{fmtMoneyShort(b.carts.all.total)}<span class="unit">{cur}</span></span><span class="kpi-sub">{fmtInt(b.carts.all.count)} panier{b.carts.all.count > 1 ? "s" : ""} arrivé{b.carts.all.count > 1 ? "s" : ""} au paiement · {b.carts.all.total ? fmtPct(b.carts.paid.total, b.carts.all.total) : "–"} encaissé</span></div>
    <div class="card kpi"><span class="kpi-label">Visiteurs</span><span class="kpi-value">{fmtInt(b.kpis.visitors)}</span><span class="kpi-sub">conversion {pct(b.kpis.conversion)} · {pct(b.kpis.checkoutRate)} vont au paiement</span></div>
  </section>

  <section class="grid grid-3">
    <div class="card span-2">
      <div class="card-head"><h2 class="card-title">Chiffre d'affaires et commandes, par jour</h2><p class="card-note">barres : {cur} encaissés · points : commandes</p></div>
      <Fragment set:html={barsAndLine(b.series.revenue, b.series.orders, { height: 180, barFormat: money, lineFormat: (v) => `${v} commande${v > 1 ? "s" : ""}` })} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Les paniers</h2><a class="card-note" href={q("/admin/ventes")}>Le détail →</a></div>
      <div class="stack" aria-hidden="true">
        {b.carts.all.total > 0 && <span style={`width:${(b.carts.paid.total / b.carts.all.total) * 100}%;background:var(--rose)`}></span>}
        {b.carts.all.total > 0 && <span style={`width:${(b.carts.abandoned.total / b.carts.all.total) * 100}%;background:var(--ink);opacity:.35`}></span>}
        {b.carts.all.total > 0 && <span style={`width:${(b.carts.open.total / b.carts.all.total) * 100}%;background:var(--warn);opacity:.7`}></span>}
      </div>
      <ul class="legend">
        <li><span class="dot" style="background:var(--rose)"></span><span>Validés</span><span class="legend-num">{fmtInt(b.carts.paid.count)} · {money(b.carts.paid.total)}</span></li>
        <li><span class="dot" style="background:var(--ink);opacity:.35"></span><span>Abandonnés</span><span class="legend-num">{fmtInt(b.carts.abandoned.count)} · {money(b.carts.abandoned.total)}</span></li>
        <li><span class="dot" style="background:var(--warn);opacity:.7"></span><span>En cours (moins d'une heure)</span><span class="legend-num">{fmtInt(b.carts.open.count)} · {money(b.carts.open.total)}</span></li>
      </ul>
      <p class="card-foot">Un panier compte à partir du départ en paiement. Sans commande une heure après, il est abandonné. Récupération : {pct(b.carts.recoveryRate)} des départs finissent payés.</p>
    </div>
  </section>

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Par Reflet</h2><p class="card-note">ventes, paniers abandonnés, et ce qui précède : fiches vues, ajouts</p></div>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Reflet</th><th class="cell-gauge">Chiffre d'affaires</th><th class="num">Flacons</th><th class="num">Commandes</th><th class="num">Abandonnés</th><th class="num">Fiches vues</th><th class="num">Ajouts</th><th class="num">Fiche → achat</th></tr></thead>
        <tbody>
          {
            b.perReflet.map((r) => (
              <tr class:list={{ "is-focus": filters.reflet === r.handle }}>
                <td class="lead"><a class="row-link" href={`${Astro.url.pathname}?days=${days}&reflet=${r.handle}`}>{r.name}</a></td>
                <td class="cell-gauge"><span class="mono">{money(r.revenue)}</span> <span class="muted">{b.kpis.revenue ? fmtPct(r.revenue, b.kpis.revenue) : ""}</span><Fragment set:html={roseGauge(r.revenue / maxReflet)} /></td>
                <td class="num">{fmtInt(r.units)}</td>
                <td class="num">{fmtInt(r.orders)}</td>
                <td class="num">{r.abandoned ? <span>{fmtInt(r.abandoned)} <span class="muted">· {money(r.abandonedTotal)}</span></span> : <span class="muted">–</span>}</td>
                <td class="num">{fmtInt(r.views)}</td>
                <td class="num">{fmtInt(r.adds)}</td>
                <td class="num">{r.views ? fmtPct(r.orders, r.views) : "–"}</td>
              </tr>
            ))
          }
          {b.other.units > 0 && <tr><td class="muted">Autres articles <span class="muted">({b.other.titles.join(", ")})</span></td><td class="mono">{money(b.other.revenue)}</td><td class="num">{fmtInt(b.other.units)}</td><td colspan="5"></td></tr>}
        </tbody>
      </table>
    </div>
  </section>

  <section class="grid grid-3">
    <div class="card">
      <div class="card-head"><h2 class="card-title">D'où viennent-ils</h2><a class="card-note" href={q("/admin/trafic")}>Trafic & sources →</a></div>
      <div class="donut-row">
        <Fragment set:html={donut(b.channels.map((c) => ({ label: c.channel, value: c.visitors, color: c.color })), { size: 120 })} />
        <ul class="legend">
          {b.channels.length === 0 && <li class="muted">Aucune visite suivie sur la période.</li>}
          {b.channels.slice(0, 6).map((c) => <li><span class="dot" style={`background:${c.color}`}></span><span>{c.channel}</span><span class="legend-num">{fmtInt(c.visitors)} · {c.orders ? `${fmtInt(c.orders)} cmd` : "–"}</span></li>)}
        </ul>
      </div>
      {
        b.sources.length > 0 && (
          <ul class="bars sources">
            {b.sources.slice(0, 6).map((s) => (
              <li>
                <span class="bar-label" title={s.label}>{s.label}</span>
                <span class="gauge"><span class="gauge-fill" style={`width:${(s.visitors / Math.max(1, b.sources[0]?.visitors ?? 1, ...b.sources.map((x) => x.visitors))) * 100}%;background:var(--ink)`}></span></span>
                <span class="bar-count">{fmtInt(s.visitors)} vis.{s.revenue ? ` · ${fmtMoneyShort(s.revenue)} ${cur}` : ""}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Pays</h2><p class="card-note">visiteurs · commandes · CA</p></div>
      {
        b.countries.length === 0 ? (
          <p class="empty">Rien sur la période.</p>
        ) : (
          <ul class="bars countries">
            {b.countries.slice(0, 8).map((c) => (
              <li>
                <span class="bar-label" title={c.name}><a href={`${Astro.url.pathname}?days=${days}&country=${c.code}`}>{c.name}</a></span>
                <span class="gauge"><span class="gauge-fill" style={`width:${(c.visitors / maxCountry) * 100}%;background:var(--ink)`}></span></span>
                <span class="bar-count">{fmtInt(c.visitors)}{c.orders ? ` · ${fmtInt(c.orders)} · ${fmtMoneyShort(c.revenue)}` : ""}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Le parcours</h2><p class="card-note">visiteurs distincts</p></div>
      <div class="funnel funnel-wide">
        {
          [
            ["Visiteurs", b.funnel.visitors],
            ["Fiche vue", b.funnel.viewers],
            ["Ajout panier", b.funnel.adders],
            ["Paiement", b.funnel.checkouts],
            ["Commande", b.funnel.orders],
          ].map(([label, v]) => (
            <div class="funnel-row">
              <span class="muted">{label}</span>
              <span class="funnel-bar" style={`width:${Math.max(1, ((v as number) / funnelMax) * 100)}%`}></span>
              <span class="num mono">{fmtInt(v as number)}</span>
            </div>
          ))
        }
      </div>
      <p class="card-foot">{b.funnel.viewers ? `${fmtPct(b.funnel.adders, b.funnel.viewers)} des fiches vues finissent au panier` : "En attente des premières visites."}{b.funnel.checkouts ? ` · ${fmtPct(b.funnel.orders, b.funnel.checkouts)} des paiements aboutissent` : ""}</p>
    </div>
  </section>

  <section class="grid grid-3">
    <div class="card live-card">
      <div class="card-head"><h2 class="card-title">Maintenant</h2><a class="card-note" href="/admin/live">Le globe →</a></div>
      {
        now ? (
          <div class="kpis">
            <div class="kpi"><span class="kpi-label">Sur le site</span><span class="kpi-value">{fmtInt(now.visitorsNow)}</span><span class="kpi-sub">visiteur{now.visitorsNow > 1 ? "s" : ""} ces {now.windowMinutes} dernières minutes</span></div>
            <div class="kpi"><span class="kpi-label">Aujourd'hui</span><span class="kpi-value">{fmtInt(now.today.visitors)}</span><span class="kpi-sub">{fmtInt(now.today.orders)} commande{now.today.orders > 1 ? "s" : ""} · {fmtMoney(now.today.revenue, now.today.currency)}</span></div>
          </div>
        ) : (
          <p class="empty">Indisponible.</p>
        )
      }
      {now && now.countries.length > 0 && <div class="tag-list">{now.countries.slice(0, 6).map((c) => <span class="badge badge-soft">{c.name} · {c.visitors}</span>)}</div>}
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Luma, en bref</h2><a class="card-note" href={`/admin/luma?days=${days}`}>La vue Luma →</a></div>
      {
        luma ? (
          <div class="kpis">
            <div class="kpi"><span class="kpi-label">Conversations</span><span class="kpi-value">{fmtInt(convs.length)}</span><span class="kpi-sub">{fmtPct(convs.filter((c) => c.withCard).length, convs.length)} avec une fiche montrée</span></div>
            <div class="kpi"><span class="kpi-label">Emails captés</span><span class="kpi-value">{fmtInt(convs.filter((c) => c.hasEmail).length)}</span><span class="kpi-sub">coût estimé {fmtUsd(estimateCost(luma.messages))}</span></div>
          </div>
        ) : (
          <p class="empty">Indisponible.</p>
        )
      }
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Le suivi</h2></div>
      <dl class="facts">
        <dt>Événements du site</dt><dd>{b.tracked.since ? `depuis le ${fmtDate(b.tracked.since)}` : "aucun encore"}</dd>
        <dt>Première commande</dt><dd>{b.tracked.firstOrder ? fmtDate(b.tracked.firstOrder) : "aucune sur la période"}</dd>
        <dt>Commandes sans parcours</dt><dd>{fmtInt(b.tracked.unlinkedOrders)} <span class="muted">(avant le suivi, ou sans cookie)</span></dd>
        <dt>Commandes de test écartées</dt><dd>{fmtInt(b.tracked.testOrders)}</dd>
      </dl>
    </div>
  </section>

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Dernières commandes</h2><a class="card-note" href={q("/admin/ventes")}>Toutes les ventes →</a></div>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Quand</th><th>N°</th><th>Pays</th><th>Articles</th><th>Source</th><th>Code</th><th class="num">Total</th></tr></thead>
        <tbody>
          {b.recentOrders.length === 0 && <tr><td colspan="7"><p class="empty">Aucune commande payée sur la période. Elles arrivent ici par le webhook Shopify <span class="mono">orders/paid</span>.</p></td></tr>}
          {
            b.recentOrders.slice(0, 8).map((o) => (
              <tr>
                <td class="muted mono when">{fmtDate(o.created_at)}</td>
                <td class="mono">{o.name ?? o.id}</td>
                <td>{o.country ?? "–"}</td>
                <td>{o.items.join(", ") || "–"}</td>
                <td>{o.source.label}{!o.linked && <span class="muted"> · sans parcours</span>}</td>
                <td>{o.discount_codes.length ? o.discount_codes.join(", ") : <span class="muted">–</span>}</td>
                <td class="num strong">{fmtMoney(o.total, o.currency ?? cur)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<style>
  .kpis-hero { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .sources { margin-top: 16px; }
  .sources li, .countries li { grid-template-columns: minmax(90px, 1fr) minmax(60px, 1.4fr) auto; }
  .funnel-wide .funnel-row { grid-template-columns: 90px 1fr 44px; }
  .funnel-row:nth-child(5) .funnel-bar { background: var(--rose); }
  .funnel-row:nth-child(4) .funnel-bar { background: var(--ink); opacity: 0.3; }
  .tbl tr.is-focus td { background: rgba(129, 37, 56, 0.05); }
  .live-card .tag-list { margin-top: 14px; }
  @media (max-width: 1300px) { .kpis-hero { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .kpis-hero { grid-template-columns: 1fr; } }
</style>
