---
/**
 * Vue d'ensemble : le business depuis le site, en un regard. Le chiffre et sa
 * variation, les paniers (validés, abandonnés, en cours, total), la courbe du
 * temps, les produits en vignettes, les sources, les pays, le parcours, le
 * direct, Luma en bref, les dernières commandes. Tout ce qui est cliquable
 * ouvre une fenêtre de détail ; chaque « ? » explique le chiffre.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import FilterBar from "../../components/admin/FilterBar.astro";
import Kpi from "../../components/admin/Kpi.astro";
import Tip from "../../components/admin/Tip.astro";
import ProductTiles from "../../components/admin/ProductTiles.astro";
import ProductModal from "../../components/admin/ProductModal.astro";
import SourceModal from "../../components/admin/SourceModal.astro";
import CountryModal from "../../components/admin/CountryModal.astro";
import DaysModal from "../../components/admin/DaysModal.astro";
import ModalTemplate from "../../components/admin/ModalTemplate.astro";
import OrdersTable from "../../components/admin/OrdersTable.astro";
import CartsTable from "../../components/admin/CartsTable.astro";
import { readSession } from "../../lib/admin/auth";
import { parseRange, fmtInt, fmtPct, fmtUsd, fmtDate, loadLuma, buildConversations, estimateCost } from "../../lib/admin/data";
import { business, live, parseFilters, hasFilters, fmtMoney, fmtMoneyShort, delta, filtersQuery } from "../../lib/admin/business";
import { timeChart, hbars, funnelSteps, stackBar } from "../../lib/admin/charts";
export const prerender = false;

const admin = await readSession(Astro.cookies);
if (!admin) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const range = parseRange(Astro.url.searchParams);
const filters = parseFilters(Astro.url.searchParams);
const [b, now, luma] = await Promise.all([business(range, filters), live().catch(() => null), loadLuma(range).catch(() => null)]);
const convs = luma ? buildConversations(luma) : [];
const cur = b.currency;
const money = (n: number) => fmtMoney(n, cur);
const pct = (v: number | null) => (v === null ? "–" : `${(v * 100).toFixed(v < 0.1 ? 1 : 0).replace(".", ",")} %`);
const q = `${range.query}${filtersQuery(filters)}`;
const k = b.kpis;
const pk = b.previous.kpis;
const subtitle = hasFilters(filters) ? `Vue filtrée · ${range.label}, heure de Dubaï.` : `Tout ce qui se passe depuis le site · ${range.label}, heure de Dubaï.`;
const cartParts = [
  { label: "Validés", value: b.carts.paid.total, color: "#812538", text: `${fmtInt(b.carts.paid.count)} · ${money(b.carts.paid.total)}`, modal: "orders" },
  { label: `Abandonnés${b.carts.abandoned.atCheckout ? ` (dont ${fmtInt(b.carts.abandoned.atCheckout)} au paiement)` : ""}`, value: b.carts.abandoned.total, color: "#a8641e", text: `${fmtInt(b.carts.abandoned.count)} · ${money(b.carts.abandoned.total)}`, modal: "carts" },
  { label: "En cours (moins d'une heure)", value: b.carts.open.total, color: "#cfc6b8", text: `${fmtInt(b.carts.open.count)} · ${money(b.carts.open.total)}`, modal: "carts" },
];
const countryRows = b.countries.slice(0, 8).map((c) => ({ label: c.name, prefix: c.flag, value: c.visitors, text: `${fmtInt(c.visitors)}${c.orders ? ` · ${fmtInt(c.orders)} cmd · ${fmtMoneyShort(c.revenue)}` : ""}`, modal: `country:${c.code}` }));
const sourceRows = b.sources.slice(0, 7).map((s) => ({ label: s.label, value: s.visitors, text: `${fmtInt(s.visitors)}${s.revenue ? ` · ${fmtMoneyShort(s.revenue)} ${cur}` : ""}`, color: s.color, modal: `source:${s.label}` }));
const channelParts = b.channels.map((c) => ({ label: c.channel, value: c.visitors, color: c.color, text: `${fmtInt(c.visitors)}${c.orders ? ` · ${fmtInt(c.orders)} cmd` : ""}` }));
---

<AdminLayout title="Vue d'ensemble" section="overview" admin={admin} range={range} subtitle={subtitle}>
  <FilterBar slot="filters" filters={filters} facets={b.facets} range={range} />

  <section class="kpis kpis-hero">
    <Kpi tone="hero" label="Chiffre d'affaires" tip="revenue" value={fmtMoneyShort(k.revenue)} unit={cur} delta={delta(k.revenue, pk.revenue)} sub={`${fmtInt(k.orders)} commande${k.orders > 1 ? "s" : ""} · panier moyen ${k.aov === null ? "–" : money(k.aov)} · ${fmtInt(k.units)} flacon${k.units > 1 ? "s" : ""}`} modal="orders" />
    <Kpi label="Paniers validés" tip="cartsPaid" value={fmtMoneyShort(b.carts.paid.total)} unit={cur} delta={delta(k.orders, pk.orders)} sub={`${fmtInt(b.carts.paid.count)} commande${b.carts.paid.count > 1 ? "s" : ""}`} modal="orders" />
    <Kpi label="Paniers abandonnés" tip="cartsAbandoned" value={fmtMoneyShort(b.carts.abandoned.total)} unit={cur} delta={delta(k.abandonedTotal, pk.abandonedTotal)} deltaInvert sub={`${fmtInt(b.carts.abandoned.count)} panier${b.carts.abandoned.count > 1 ? "s" : ""}${b.carts.abandoned.atCheckout ? `, ${fmtInt(b.carts.abandoned.atCheckout)} au paiement` : ""}${b.carts.open.count ? ` · ${fmtInt(b.carts.open.count)} en cours` : ""}`} modal="carts" />
    <Kpi label="Panier total" tip="cartsAll" value={fmtMoneyShort(b.carts.all.total)} unit={cur} delta={delta(k.cartsTotal, pk.cartsTotal)} sub={`${fmtInt(b.carts.all.count)} panier${b.carts.all.count > 1 ? "s" : ""} · ${b.carts.all.total ? fmtPct(b.carts.paid.total, b.carts.all.total) : "–"} encaissé`} modal="carts-all" />
    <Kpi label="Visiteurs" tip="visitors" value={fmtInt(k.visitors)} delta={delta(k.visitors, pk.visitors)} sub={`${fmtInt(k.buyers)} acheteur${k.buyers > 1 ? "s" : ""}`} modal="days" />
  </section>

  <section class="kpis kpis-rates">
    <Kpi tone="rose" label="Taux de conversion" tip="conversion" value={pct(k.conversion)} delta={delta(k.conversion, pk.conversion)} sub={`${fmtInt(k.orders)} commande${k.orders > 1 ? "s" : ""} pour ${fmtInt(k.visitors)} visiteurs`} />
    <Kpi label="Ajout au sac" tip="addRate" value={pct(k.addRate)} delta={delta(k.addRate, pk.addRate)} sub={`${fmtInt(k.adders)} visiteur${k.adders > 1 ? "s" : ""}`} />
    <Kpi label="Vont au paiement" tip="checkoutRate" value={pct(k.checkoutRate)} delta={delta(k.checkoutRate, pk.checkoutRate)} sub={`${fmtInt(k.checkouts)} départ${k.checkouts > 1 ? "s" : ""}`} />
    <Kpi label="Panier moyen" tip="aov" value={k.aov === null ? "–" : fmtMoneyShort(k.aov)} unit={k.aov === null ? undefined : cur} delta={delta(k.aov, pk.aov)} sub="par commande payée" />
    <Kpi label="Par acheteur" tip="aovPerBuyer" value={k.aovPerBuyer === null ? "–" : fmtMoneyShort(k.aovPerBuyer)} unit={k.aovPerBuyer === null ? undefined : cur} delta={delta(k.aovPerBuyer, pk.aovPerBuyer)} sub={`${fmtInt(k.buyers)} acheteur${k.buyers > 1 ? "s" : ""} distinct${k.buyers > 1 ? "s" : ""}`} />
    <Kpi label="Panier moyen, tous paniers" tip="avgCart" value={k.avgCart === null ? "–" : fmtMoneyShort(k.avgCart)} unit={k.avgCart === null ? undefined : cur} delta={delta(k.avgCart, pk.avgCart)} sub="payés ou non" />
    <Kpi label="Chiffre par visiteur" tip="revenuePerVisitor" value={k.revenuePerVisitor === null ? "–" : fmtMoneyShort(k.revenuePerVisitor)} unit={k.revenuePerVisitor === null ? undefined : cur} delta={delta(k.revenuePerVisitor, pk.revenuePerVisitor)} sub="ce que vaut une visite" />
  </section>

  <section class="grid grid-3">
    <div class="card span-2">
      <div class="card-head"><h2 class="card-title">Chiffre d'affaires et commandes, par jour <Tip of="byDay" /></h2><p class="card-note">aire : {cur} encaissés · barres : commandes · un clic ouvre le jour</p></div>
      <Fragment set:html={timeChart(b.series.revenue, { secondary: b.series.orders, height: 210, primaryFormat: (v) => fmtMoneyShort(v), secondaryFormat: (v) => `${v} commande${v > 1 ? "s" : ""}`, primaryLabel: "chiffre", secondaryLabel: "", modal: "days" })} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Les paniers <Tip of="cartsAbandoned" /></h2><a class="card-note" href={`/admin/ventes?${q}`}>Le détail →</a></div>
      <Fragment set:html={stackBar(cartParts)} />
      <p class="card-foot">{pct(b.carts.recoveryRate)} des paniers finissent payés{b.carts.checkoutRecoveryRate !== null ? `, ${pct(b.carts.checkoutRecoveryRate)} des départs en paiement` : ""}.{b.carts.estimated ? ` ${fmtInt(b.carts.estimated)} montant${b.carts.estimated > 1 ? "s" : ""} estimé${b.carts.estimated > 1 ? "s" : ""} (≈).` : ""}</p>
    </div>
  </section>

  <div class="section-title"><h2>Les produits</h2><p>chiffre, part, flacons — un clic ouvre le détail</p></div>
  <ProductTiles products={b.perProduct} currency={cur} focus={filters.reflet} />
  {b.other.units > 0 && <p class="card-foot">Autres articles vendus : {b.other.titles.join(", ")} — {fmtInt(b.other.units)} unité{b.other.units > 1 ? "s" : ""}, {money(b.other.revenue)}.</p>}

  <section class="grid grid-3">
    <div class="card">
      <div class="card-head"><h2 class="card-title">D'où viennent-ils <Tip of="source" /></h2><a class="card-note" href={`/admin/trafic?${q}`}>Trafic & sources →</a></div>
      <Fragment set:html={stackBar(channelParts)} />
      <div class="sources-list"><Fragment set:html={hbars(sourceRows)} /></div>
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Pays</h2><p class="card-note">visiteurs · commandes · chiffre</p></div>
      <Fragment set:html={hbars(countryRows)} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Le parcours <Tip of="funnel" /></h2><p class="card-note">visiteurs distincts</p></div>
      <Fragment set:html={funnelSteps(b.funnel, fmtInt)} />
      <p class="card-foot">{b.funnel[1].value ? `${fmtPct(b.funnel[2].value, b.funnel[1].value)} des fiches vues finissent au sac` : "En attente des premières visites."}{b.funnel[3].value ? ` · ${fmtPct(b.funnel[4].value, b.funnel[3].value)} des paiements aboutissent` : ""}</p>
    </div>
  </section>

  <section class="grid grid-3">
    <div class="card live-card">
      <div class="card-head"><h2 class="card-title">Maintenant <Tip of="liveNow" /></h2><a class="card-note" href="/admin/live">Le globe →</a></div>
      {
        now ? (
          <div class="kpis kpis-inline">
            <div class="kpi"><span class="kpi-label">Sur le site</span><span class="kpi-value">{fmtInt(now.visitorsNow)}</span><span class="kpi-sub">visiteur{now.visitorsNow > 1 ? "s" : ""} ces {now.windowMinutes} dernières minutes</span></div>
            <div class="kpi"><span class="kpi-label">Aujourd'hui</span><span class="kpi-value">{fmtInt(now.today.visitors)}</span><span class="kpi-sub">{fmtInt(now.today.orders)} commande{now.today.orders > 1 ? "s" : ""} · {fmtMoney(now.today.revenue, now.today.currency)}</span></div>
          </div>
        ) : (
          <p class="empty">Indisponible.</p>
        )
      }
      {now && now.countries.length > 0 && <div class="tag-list">{now.countries.slice(0, 6).map((c) => <span class="badge badge-soft">{c.name} · {c.visitors}</span>)}</div>}
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Luma, en bref</h2><a class="card-note" href={`/admin/luma?${range.query}`}>La vue Luma →</a></div>
      {
        luma ? (
          <div class="kpis kpis-inline">
            <div class="kpi"><span class="kpi-label">Conversations</span><span class="kpi-value">{fmtInt(convs.length)}</span><span class="kpi-sub">{fmtPct(convs.filter((c) => c.withCard).length, convs.length)} avec une fiche montrée</span></div>
            <div class="kpi"><span class="kpi-label">Emails captés</span><span class="kpi-value">{fmtInt(convs.filter((c) => c.hasEmail).length)}</span><span class="kpi-sub">coût estimé {fmtUsd(estimateCost(luma.messages))} <Tip of="lumaCost" /></span></div>
          </div>
        ) : (
          <p class="empty">Indisponible.</p>
        )
      }
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Le suivi</h2></div>
      <dl class="facts">
        <dt>Événements du site</dt><dd>{b.tracked.since ? `depuis le ${fmtDate(b.tracked.since)}` : "aucun encore"}</dd>
        <dt>Première commande</dt><dd>{b.tracked.firstOrder ? fmtDate(b.tracked.firstOrder) : "aucune sur la période"}</dd>
        <dt>Commandes sans parcours <Tip of="unlinked" /></dt><dd>{fmtInt(b.tracked.unlinkedOrders)}</dd>
        <dt>Visiteurs d'avant le suivi <Tip of="beforeTracking" /></dt><dd>{fmtInt(b.tracked.beforeTracking)}</dd>
        <dt>Commandes de test écartées</dt><dd>{fmtInt(b.tracked.testOrders)}</dd>
      </dl>
    </div>
  </section>

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Dernières commandes</h2><a class="card-note" href={`/admin/ventes?${q}`}>Toutes les ventes →</a></div>
    <OrdersTable orders={b.recentOrders} limit={8} />
  </section>

  <!-- Les fenêtres de détail -->
  {b.perProduct.map((p) => <ProductModal product={p} currency={cur} totalRevenue={k.revenue} />)}
  {b.sources.map((s) => <SourceModal source={s} currency={cur} />)}
  {b.countries.map((c) => <CountryModal country={c} currency={cur} />)}
  <DaysModal byDay={b.byDay} currency={cur} rangeLabel={range.label} />
  <ModalTemplate id="orders" title="Les commandes" subtitle={`${fmtInt(k.orders)} commande${k.orders > 1 ? "s" : ""} payée${k.orders > 1 ? "s" : ""} · ${money(k.revenue)} · ${range.label}`} wide>
    <div class="card tbl-card"><OrdersTable orders={b.recentOrders} showDiscount /></div>
  </ModalTemplate>
  <ModalTemplate id="carts" title="Paniers abandonnés et en cours" subtitle={`${fmtInt(b.carts.abandoned.count)} abandonné${b.carts.abandoned.count > 1 ? "s" : ""} (${money(b.carts.abandoned.total)}) · ${fmtInt(b.carts.open.count)} en cours · un panier compte dès le premier ajout au sac`} wide>
    <div class="card tbl-card"><CartsTable carts={b.abandonedCarts} /></div>
  </ModalTemplate>
  <ModalTemplate id="carts-all" title="Tous les paniers" subtitle={`${fmtInt(b.carts.all.count)} panier${b.carts.all.count > 1 ? "s" : ""} · ${money(b.carts.all.total)} mis au panier, ${money(b.carts.paid.total)} encaissés · ${range.label}`} wide>
    <div class="kpis">
      <Kpi tone="rose" label="Validés" value={fmtMoneyShort(b.carts.paid.total)} unit={cur} sub={`${fmtInt(b.carts.paid.count)} panier${b.carts.paid.count > 1 ? "s" : ""} payé${b.carts.paid.count > 1 ? "s" : ""}`} />
      <Kpi label="Abandonnés" value={fmtMoneyShort(b.carts.abandoned.total)} unit={cur} sub={`${fmtInt(b.carts.abandoned.count)} panier${b.carts.abandoned.count > 1 ? "s" : ""}${b.carts.abandoned.atCheckout ? `, ${fmtInt(b.carts.abandoned.atCheckout)} au paiement` : ""}`} />
      <Kpi label="En cours" value={fmtMoneyShort(b.carts.open.total)} unit={cur} sub={`${fmtInt(b.carts.open.count)} panier${b.carts.open.count > 1 ? "s" : ""} de moins d'une heure`} />
      <Kpi label="Part encaissée" value={b.carts.all.total ? fmtPct(b.carts.paid.total, b.carts.all.total) : "–"} sub="de la valeur mise au panier" />
      <Kpi label="Panier moyen, tous paniers" tip="avgCart" value={k.avgCart === null ? "–" : fmtMoneyShort(k.avgCart)} unit={k.avgCart === null ? undefined : cur} />
    </div>
    <div class="card tbl-card"><CartsTable carts={b.allCarts} empty="Aucun panier sur la période." /></div>
  </ModalTemplate>
</AdminLayout>

<style>
  .kpis-hero { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .kpis-rates { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; }
  .kpis-rates :global(.kpi) { padding: 14px 16px; border-radius: 12px; gap: 6px; }
  .kpis-rates :global(.kpi-value) { font-size: 24px; }
  @media (max-width: 1500px) { .kpis-rates { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .kpis-rates { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .kpis-inline { gap: 10px; }
  .kpis-inline .kpi-value { font-size: 28px; }
  .sources-list { margin-top: 16px; }
  .live-card .tag-list { margin-top: 14px; }
  @media (max-width: 1300px) { .kpis-hero { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .kpis-hero { grid-template-columns: 1fr; } }
</style>
