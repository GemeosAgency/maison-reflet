---
/**
 * Parcours sur le site : ce que les visiteurs font, dans l'ordre où ils le font.
 * Combien de pages, combien de temps, s'ils reviennent ; la courbe des visites
 * et des écoutes ; le parcours en marches ; les produits vus, écoutés, ajoutés ;
 * les pages où l'on arrive, où l'on passe, où l'on part, et les chemins les plus
 * suivis ; le guide et sa carte, le menu, les écoutes, les accords du parfumeur.
 */
import AdminLayout from "../../layouts/AdminLayout.astro";
import FilterBar from "../../components/admin/FilterBar.astro";
import Kpi from "../../components/admin/Kpi.astro";
import Tip from "../../components/admin/Tip.astro";
import ProductTiles from "../../components/admin/ProductTiles.astro";
import ProductModal from "../../components/admin/ProductModal.astro";
import ProductThumb from "../../components/admin/ProductThumb.astro";
import JourneyDaysModal from "../../components/admin/JourneyDaysModal.astro";
import { readSession } from "../../lib/admin/auth";
import { parseRange, fmtInt, fmtPct, fmtDate, fmtDuration } from "../../lib/admin/data";
import { journey, parseFilters, delta, thumb } from "../../lib/admin/business";
import { timeChart, hbars, funnelSteps, donut } from "../../lib/admin/charts";
export const prerender = false;

const admin = await readSession(Astro.cookies);
if (!admin) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const range = parseRange(Astro.url.searchParams);
const filters = parseFilters(Astro.url.searchParams);
const j = await journey(range, filters);
const k = j.kpis;
const pk = j.previous;
const pct = (v: number | null) => (v === null ? "–" : `${(v * 100).toFixed(v < 0.1 ? 1 : 0).replace(".", ",")} %`);
const dec = (v: number | null) => (v === null ? "–" : v.toFixed(1).replace(".", ","));
const thumbPrefix = (image: string | null) => (image ? `<img class="hbar-thumb" src="${thumb(image, 60)}" alt="" loading="lazy">` : "");
const pageRows = j.topPages.map((p) => ({ label: p.label, value: p.count, text: fmtInt(p.count) }));
const landingRows = j.landingPages.map((p) => ({ label: p.label, value: p.count, text: fmtInt(p.count), color: "var(--ok)" }));
const exitRows = j.exitPages.map((p) => ({ label: p.label, value: p.count, text: fmtInt(p.count), color: "var(--warn)" }));
const depthRows = j.depth.map((d) => ({ label: d.label, value: d.count, text: fmtPct(d.count, k.visitors) }));
const guideRows = j.guideFilters.map((g) => ({ label: g.label, value: g.count, text: fmtInt(g.count) }));
const mapRows = j.mapSelects.map((m) => ({ label: m.name, prefix: thumbPrefix(m.image), value: m.count, text: fmtInt(m.count), modal: `product:${m.handle}` }));
const menuRows = j.menu.map((m) => ({ label: m.name, prefix: thumbPrefix(m.image), value: m.count, text: fmtInt(m.count), modal: `product:${m.handle}` }));
const listenRows = j.listens.perReflet.map((l) => ({ label: l.name, prefix: thumbPrefix(l.image), value: l.plays, text: `${fmtInt(l.plays)}${l.plays ? ` · ${fmtPct(l.completes, l.plays)} au bout` : ""}`, color: "var(--rose)", modal: `product:${l.handle}` }));
const sourceRows = j.listens.bySource.map((s) => ({ label: s.label, value: s.count, text: fmtPct(s.count, j.listens.total) }));
const subtitle = j.tracked.since ? `Ce que les visiteurs font, dans l'ordre où ils le font · ${range.label}.` : "En attente des premières visites suivies.";
---

<AdminLayout title="Parcours sur le site" section="site" admin={admin} range={range} subtitle={subtitle}>
  <FilterBar slot="filters" filters={filters} facets={j.facets} range={range} />

  <section class="kpis">
    <Kpi label="Visiteurs" tip="visitors" value={fmtInt(k.visitors)} delta={delta(k.visitors, pk.visitors)} sub={`${fmtInt(k.returning)} revenu${k.returning > 1 ? "s" : ""} au moins une fois`} modal="days" />
    <Kpi label="Pages par visite" tip="pagesPerVisit" value={dec(k.pagesPerVisit)} delta={delta(k.pagesPerVisit, pk.pagesPerVisit)} sub="vues de page par visiteur" />
    <Kpi label="Durée moyenne" tip="avgDuration" value={k.avgDurationMs === null ? "–" : fmtDuration(k.avgDurationMs)} delta={delta(k.avgDurationMs, pk.avgDurationMs)} sub="du premier au dernier geste" />
    <Kpi label="Rebond" tip="bounce" value={pct(k.bounceRate)} delta={delta(k.bounceRate, pk.bounceRate)} deltaInvert sub="une seule page vue" />
    <Kpi tone="rose" label="Écoutes" tip="listens" value={fmtInt(k.plays)} delta={delta(k.plays, pk.plays)} sub={`${fmtInt(k.listeners)} visiteur${k.listeners > 1 ? "s" : ""} · ${k.plays ? fmtPct(k.completes, k.plays) : "–"} jusqu'au bout`} />
    <Kpi label="Conversations Luma" tip="lumaSessions" value={fmtInt(j.lumaSessions)} sub={k.visitors ? `${fmtPct(j.lumaSessions, k.visitors)} des visiteurs` : undefined} />
  </section>

  <section class="grid grid-3">
    <div class="card span-2">
      <div class="card-head"><h2 class="card-title">Visiteurs et écoutes, par jour <Tip of="byDay" /></h2><p class="card-note">aire : visiteurs · barres : écoutes</p></div>
      <Fragment set:html={timeChart(j.series.visitors, { secondary: j.series.plays, height: 210, primaryColor: "var(--ink)", secondaryColor: "var(--rose)", primaryFormat: (v) => `${v}`, secondaryFormat: (v) => `${v} écoute${v > 1 ? "s" : ""}`, primaryLabel: "visiteurs", modal: "days" })} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Le parcours <Tip of="funnel" /></h2><p class="card-note">visiteurs distincts</p></div>
      <Fragment set:html={funnelSteps(j.funnel, fmtInt)} />
      <p class="card-foot">{k.viewers ? `${fmtPct(k.listeners, k.viewers)} des visiteurs qui ouvrent une fiche écoutent le portrait · ${fmtPct(k.adders, k.viewers)} mettent au sac` : "En attente des premières fiches vues."}</p>
    </div>
  </section>

  <div class="section-title"><h2>Les produits</h2><p>fiches vues, écoutes, ajouts — un clic ouvre le détail</p></div>
  <ProductTiles products={[...j.perProduct].sort((x, y) => y.views - x.views)} currency={j.currency} focus={filters.reflet} mode="journey" />

  <section class="grid grid-3">
    <div class="card">
      <div class="card-head"><h2 class="card-title">Les pages <Tip of="topPages" /></h2><p class="card-note">visiteurs distincts, toutes langues</p></div>
      <Fragment set:html={hbars(pageRows)} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Les chemins les plus suivis <Tip of="sequences" /></h2><p class="card-note">les trois premières pages</p></div>
      {
        j.sequences.length === 0 ? (
          <p class="empty">Pas encore de visite de deux pages ou plus.</p>
        ) : (
          <ol class="seqs">
            {j.sequences.map((s) => (
              <li class="seq">
                <span class="seq-steps">{s.steps.map((st, i) => [i > 0 && <span class="seq-arrow" aria-hidden="true">→</span>, <span class="seq-step">{st}</span>])}</span>
                <span class="seq-count">{fmtInt(s.count)}</span>
              </li>
            ))}
          </ol>
        )
      }
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Arrivées et sorties</h2><p class="card-note">vert : première page · brun : dernière page <Tip of="exits" /></p></div>
      <p class="modal-section-title">Ils arrivent par <Tip of="landing" /></p>
      <Fragment set:html={hbars(landingRows.slice(0, 5))} />
      <p class="modal-section-title spaced">Ils repartent depuis</p>
      <Fragment set:html={hbars(exitRows.slice(0, 5))} />
    </div>
  </section>

  <section class="grid grid-3">
    <div class="card">
      <div class="card-head"><h2 class="card-title">Le guide des six <Tip of="guideFilters" /></h2><p class="card-note">{fmtInt(j.guideVisitors)} visiteur{j.guideVisitors > 1 ? "s" : ""} sur le guide</p></div>
      <p class="modal-section-title">Filtres activés</p>
      <Fragment set:html={hbars(guideRows.slice(0, 6))} />
      <p class="modal-section-title spaced">Ouverts sur la carte <Tip of="mapSelects" /></p>
      <Fragment set:html={hbars(mapRows.filter((r) => r.value > 0).slice(0, 6))} />
      <p class="card-foot">« Se marie avec… » affiché {fmtInt(j.mapPairs)} fois.</p>
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Le menu <Tip of="menu" /></h2><p class="card-note">Reflets mis en avant</p></div>
      <Fragment set:html={hbars(menuRows.filter((r) => r.value > 0))} />
      <p class="modal-section-title spaced">Profondeur des visites <Tip of="depth" /></p>
      <Fragment set:html={hbars(depthRows)} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Les écoutes <Tip of="listens" /></h2><p class="card-note">{fmtInt(j.listens.total)} lecture{j.listens.total > 1 ? "s" : ""} · {j.listens.total ? fmtPct(j.listens.completes, j.listens.total) : "–"} jusqu'au bout <Tip of="listenComplete" /></p></div>
      <div class="donut-row">
        <Fragment set:html={donut(j.listens.byKind, { size: 100 })} />
        <ul class="legend">
          {j.listens.byKind.map((d) => <li><span class="dot" style={`background:${d.color}`}></span><span class="legend-label">{d.label}</span><span class="legend-num">{fmtInt(d.value)}</span></li>)}
          {sourceRows.map((s) => <li><span class="dot" style="background:var(--sand)"></span><span class="legend-label">{s.label}</span><span class="legend-num">{s.text}</span></li>)}
        </ul>
      </div>
      <p class="modal-section-title spaced">Portraits par Reflet</p>
      <Fragment set:html={hbars(listenRows.filter((r) => r.value > 0))} />
    </div>
  </section>

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Les accords du parfumeur <Tip of="accords" /></h2><p class="card-note">recommandations écoutées, « Ajouter les deux », ajouts depuis le panier, carte</p></div>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>Accord</th><th>Les deux Reflets</th><th class="num">Écoutes</th><th class="num">Jusqu'au bout</th><th class="num">Ajouter les deux</th><th class="num">Depuis le panier</th><th class="num">Sur la carte</th></tr></thead>
        <tbody>
          {
            j.accords.map((a) => (
              <tr>
                <td class="lead">{a.name}</td>
                <td>
                  <span class="items">
                    <span class="items-stack">{a.pair.map((pr) => <ProductThumb image={pr.image} name={pr.name} size={28} />)}</span>
                    <span class="items-text muted">{a.pair.map((pr) => pr.name).join(" + ")}</span>
                  </span>
                </td>
                <td class="num">{fmtInt(a.plays)}</td>
                <td class="num muted">{a.plays ? fmtPct(a.completes, a.plays) : "–"}</td>
                <td class="num strong">{fmtInt(a.addsBoth)}</td>
                <td class="num strong">{fmtInt(a.cartAdds)}</td>
                <td class="num muted">{fmtInt(a.mapPairs)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <p class="card-foot">Événements anonymes du site depuis le {j.tracked.since ? fmtDate(j.tracked.since) : "—"}. Les sources et les pays sont dans Trafic & sources, les ventes dans Ventes & paniers.</p>

  {j.perProduct.map((p) => <ProductModal product={p} currency={j.currency} totalRevenue={j.perProduct.reduce((n, x) => n + x.revenue, 0)} />)}
  <JourneyDaysModal byDay={j.byDay} rangeLabel={range.label} />
</AdminLayout>

<style>
  .spaced { margin-top: 16px; }
  .card-note :global(.tip) { vertical-align: baseline; }
</style>
