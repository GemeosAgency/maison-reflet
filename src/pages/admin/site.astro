---
/** Le comportement sur le site : le parcours par Reflet, les filtres du guide, la carte, le menu, les écoutes. */
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readSession } from "../../lib/admin/auth";
import { site, parseDays, fmtInt, fmtPct, fmtDate } from "../../lib/admin/data";
import { bars } from "../../lib/admin/charts";
export const prerender = false;

const admin = await readSession(Astro.cookies);
if (!admin) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const days = parseDays(Astro.url.searchParams.get("days"));
const s = await site(days);
const max = (rows: { count: number }[]) => Math.max(1, ...rows.map((x) => x.count));
const maxViews = Math.max(1, ...s.funnel.map((f) => f.views));
---

<AdminLayout title="Site" section="site" admin={admin} days={days} subtitle={s.since ? `Événements anonymes du site depuis le ${fmtDate(s.since)}. Les sources de trafic restent dans GA4.` : "En attente des premiers événements du site."}>
  {
    !s.since && (
      <p class="note">Cette page se remplit dès que la table <strong>site_events</strong> existe (migration <strong>0003_admin.sql</strong>, à coller dans le SQL Editor de Supabase) et que le site déployé envoie ses événements : fiches vues, écoutes, filtres du guide, carte des six, menu, ajouts au panier, départs en paiement.</p>
    )
  }
  <section class="kpis">
    <div class="card kpi"><span class="kpi-label">Visiteurs suivis</span><span class="kpi-value">{fmtInt(s.visitors)}</span><span class="kpi-sub">{fmtInt(s.total)} événements</span></div>
    <div class="card kpi"><span class="kpi-label">Écoutes</span><span class="kpi-value">{fmtInt(s.audio.plays)}</span><span class="kpi-sub">{fmtPct(s.audio.completes, s.audio.plays)} jusqu'au bout</span></div>
    <div class="card kpi"><span class="kpi-label">Fiches vues</span><span class="kpi-value">{fmtInt(s.funnel.reduce((n, f) => n + f.views, 0))}</span><span class="kpi-sub">visiteurs distincts, tous Reflets</span></div>
    <div class="card kpi kpi-rose"><span class="kpi-label">Ajouts panier</span><span class="kpi-value">{fmtInt(s.funnel.reduce((n, f) => n + f.adds, 0))}</span><span class="kpi-sub">{fmtInt(s.funnel.reduce((n, f) => n + f.checkouts, 0))} départs en paiement</span></div>
  </section>

  <section class="card">
    <div class="card-head"><h2 class="card-title">Visiteurs suivis par jour</h2></div>
    <Fragment set:html={bars(s.seriesVisitors, { height: 140 })} />
  </section>

  <section class="card">
    <div class="card-head"><h2 class="card-title">Le parcours, par Reflet</h2><p class="card-note">visiteurs distincts : fiche vue → portrait écouté → ajout au panier → paiement</p></div>
    <div class="grid grid-3 funnels">
      {
        s.funnel.map((f) => (
          <div class="funnel-card">
            <p class="funnel-name">{f.name}</p>
            <div class="funnel">
              {[
                ["Fiche vue", f.views],
                ["Écouté", f.plays],
                ["Ajouté", f.adds],
                ["Paiement", f.checkouts],
              ].map(([label, v]) => (
                <div class="funnel-row">
                  <span class="muted">{label}</span>
                  <span class="funnel-bar" style={`width:${Math.max(1, ((v as number) / maxViews) * 100)}%`}></span>
                  <span class="num mono">{fmtInt(v as number)}</span>
                </div>
              ))}
            </div>
            <p class="funnel-rate muted">{fmtPct(f.adds, f.views)} des fiches vues finissent au panier</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="grid grid-3">
    {
      [
        ["Filtres du guide", s.filters],
        ["Carte des six · Reflets ouverts", s.mapSelects],
        ["Menu · Reflets mis en avant", s.menu],
        ["Écoutes par source", s.audio.bySource],
        ["Pays", s.byCountry],
        ["Langues", s.byLocale],
      ].map(([title, rows]) => (
        <div class="card">
          <div class="card-head"><h2 class="card-title">{title}</h2></div>
          {(rows as { label: string; count: number }[]).length === 0 ? (
            <p class="empty">Rien sur la période.</p>
          ) : (
            <ul class="bars">
              {(rows as { label: string; count: number }[]).slice(0, 8).map((x) => (
                <li>
                  <span class="bar-label" title={x.label}>{x.label}</span>
                  <span class="gauge"><span class="gauge-fill" style={`width:${(x.count / max(rows as { count: number }[])) * 100}%;background:var(--ink)`}></span></span>
                  <span class="bar-count">{fmtInt(x.count)}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </section>
  <p class="card-foot">La carte des six a été ouverte en mode accord {fmtInt(s.mapPairs)} fois (« Se marie avec… »).</p>
</AdminLayout>

<style>
  .funnels { margin-top: 4px; }
  .funnel-card { padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: rgba(255, 255, 255, 0.4); }
  .funnel-name { margin: 0 0 10px; font-size: 15px; font-weight: 500; }
  .funnel-row { grid-template-columns: 76px 1fr 40px; }
  .funnel-rate { margin: 10px 0 0; font-size: 12px; }
</style>
