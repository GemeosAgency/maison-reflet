---
/** Ventes & paniers : le chiffre dans le détail, les produits, les paniers abandonnés un par un, les pays, les codes, toutes les commandes. */
import AdminLayout from "../../layouts/AdminLayout.astro";
import FilterBar from "../../components/admin/FilterBar.astro";
import Kpi from "../../components/admin/Kpi.astro";
import Tip from "../../components/admin/Tip.astro";
import ProductTiles from "../../components/admin/ProductTiles.astro";
import ProductModal from "../../components/admin/ProductModal.astro";
import CountryModal from "../../components/admin/CountryModal.astro";
import DaysModal from "../../components/admin/DaysModal.astro";
import OrdersTable from "../../components/admin/OrdersTable.astro";
import CartsTable from "../../components/admin/CartsTable.astro";
import { readSession } from "../../lib/admin/auth";
import { panne } from "../../lib/admin/panne";
import { parseRange, fmtInt, fmtPct } from "../../lib/admin/data";
import { business, parseFilters, fmtMoney, fmtMoneyShort, delta } from "../../lib/admin/business";
import { TIPS } from "../../lib/admin/tips";
import { timeChart, hbars, donut, heatmap } from "../../lib/admin/charts";
import ModalTemplate from "../../components/admin/ModalTemplate.astro";
export const prerender = false;

const admin = await readSession(Astro.cookies);
if (!admin) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const range = parseRange(Astro.url.searchParams);
const filters = parseFilters(Astro.url.searchParams);
let b: Awaited<ReturnType<typeof business>>;
try {
  b = await business(range, filters);
} catch (error) {
  return panne(error, "Ventes", Astro.url);
}
const cur = b.currency;
const money = (n: number) => fmtMoney(n, cur);
const k = b.kpis;
const pk = b.previous.kpis;
const countryRows = b.countries.filter((c) => c.orders).slice(0, 10).map((c) => ({ label: c.name, prefix: c.flag, value: c.revenue, text: `${fmtInt(c.orders)} · ${fmtMoneyShort(c.revenue)} ${cur}`, color: "var(--rose)", modal: `country:${c.code}` }));
// Quand un Reflet est filtré, la courbe prend sa couleur : on sait de qui on parle
// sans relire l'en-tête.
const teintes = new Map(b.perProduct.map((p) => [p.handle, p.couleur]));
const courbe = filters.reflet ? teintes.get(filters.reflet)?.trait : undefined;
// La part de chaque Reflet dans le chiffre, en une seule barre.
const codeRows = b.discountCodes.slice(0, 10).map((d) => ({ label: d.code, value: d.orders, text: `${fmtInt(d.orders)} · −${fmtMoneyShort(d.discounts)} ${cur}`, color: "var(--warn)" }));
---

<AdminLayout title="Ventes" section="ventes" admin={admin} range={range} subtitle={`Tout l'argent : ce qui a été payé et ce qui a failli l'être · ${range.label}.`}>
  <FilterBar slot="filters" filters={filters} facets={b.facets} range={range} />

  <section class="kpis">
    <Kpi tone="rose" label="Chiffre net" tip="revenue" value={fmtMoneyShort(k.revenue)} unit={cur} delta={delta(k.revenue, pk.revenue)} sub={k.refunded ? `brut ${money(k.revenueGross)} · remboursé ${money(k.refunded)}` : "TTC, livraison comprise, rien de remboursé"} />
    <Kpi label="Commandes" tip="orders" value={fmtInt(k.orders)} delta={delta(k.orders, pk.orders)} sub={`${fmtInt(k.units)} flacon${k.units > 1 ? "s" : ""} ou coffret${k.units > 1 ? "s" : ""}${k.samples ? ` · ${fmtInt(k.samples)} échantillon${k.samples > 1 ? "s" : ""}` : ""}`} />
    {k.cancelled > 0 && <Kpi label="Annulées" tip="cancelled" value={fmtInt(k.cancelled)} sub={`${money(k.cancelledTotal)} écartés du chiffre`} modal="cancelled" />}
    <Kpi label="Panier moyen" tip="aov" value={k.aov === null ? "–" : fmtMoneyShort(k.aov)} unit={k.aov === null ? undefined : cur} delta={delta(k.aov, pk.aov)} sub={k.orders ? `${(k.units / k.orders).toFixed(1).replace(".", ",")} flacon par commande · ${k.aovPerBuyer === null ? "–" : money(k.aovPerBuyer)} par acheteur` : undefined} tipText={`${TIPS.aov} ${TIPS.aovPerBuyer}`} />
    <Kpi label="Abandonnés" tip="cartsAbandoned" value={fmtMoneyShort(b.carts.abandoned.total)} unit={cur} delta={delta(k.abandonedTotal, pk.abandonedTotal)} deltaInvert sub={`${fmtInt(b.carts.abandoned.count)} panier${b.carts.abandoned.count > 1 ? "s" : ""}${b.carts.abandoned.atCheckout ? `, ${fmtInt(b.carts.abandoned.atCheckout)} au paiement` : ""} · ${b.carts.all.count ? fmtPct(b.carts.abandoned.count, b.carts.all.count) : "–"} des paniers`} modal="carts" />
    {/* La marge se met juste après le panier moyen : c'est la question qui suit
        « combien j'ai vendu », et elle n'a de sens qu'à côté du chiffre. */}
    <Kpi
      tone={k.marge !== null && k.marge < 0 ? "rose" : undefined}
      label="Marge brute"
      tip="marge"
      modal={k.marge === null ? undefined : "marge"}
      value={k.marge === null ? "–" : fmtMoneyShort(k.marge)}
      unit={k.marge === null ? undefined : cur}
      sub={
        k.marge === null
          ? "aucun coût de revient saisi dans Sanity"
          : `${k.margeTaux === null ? "–" : `${Math.round(k.margeTaux * 100)} %`} du chiffre · ${money(k.cout ?? 0)} de coût${k.coutsManquants ? ` · ${k.coutsManquants} produit${k.coutsManquants > 1 ? "s" : ""} sans coût` : ""}`
      }
    />
    {k.discounts > 0 && <Kpi label="Remises" tip="discounts" value={fmtMoneyShort(k.discounts)} unit={cur} sub={`${b.discountCodes.length} code${b.discountCodes.length > 1 ? "s" : ""} utilisé${b.discountCodes.length > 1 ? "s" : ""}`} />}
  </section>

  <section class="grid grid-2">
    <div class="card">
      <div class="card-head"><h2 class="card-title">Chiffre d'affaires et commandes, par jour <Tip of="byDay" /></h2><p class="card-note">aire : {cur} · barres : commandes</p></div>
      <Fragment set:html={timeChart(b.series.revenue, { secondary: b.series.orders, height: 190, primaryColor: courbe, primaryFormat: (v) => fmtMoneyShort(v), secondaryFormat: (v) => `${v} commande${v > 1 ? "s" : ""}`, primaryLabel: "chiffre", modal: "days" })} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Paniers abandonnés, par jour <Tip of="cartsAbandoned" /></h2><p class="card-note">{money(b.carts.abandoned.total)} au total</p></div>
      <Fragment set:html={timeChart(b.series.abandoned, { height: 190, primaryColor: "var(--warn)", primaryFormat: (v) => fmtMoneyShort(v), primaryLabel: "abandonné", modal: "days" })} />
    </div>
  </section>

  <div class="section-title"><h2>Par produit</h2><p>chiffre, part, flacons et marge · un clic ouvre le détail</p></div>
  <ProductTiles products={b.perProduct} currency={cur} focus={filters.reflet} />
  {b.other.units > 0 && <p class="card-foot">Autres articles vendus : {b.other.titles.join(", ")} · {fmtInt(b.other.units)} unité{b.other.units > 1 ? "s" : ""}, {money(b.other.revenue)}.</p>}

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Paniers abandonnés et en cours <Tip of="cartsAbandoned" /></h2><p class="card-note">≈ montant estimé d'après le catalogue</p></div>
    <CartsTable carts={b.abandonedCarts} />
  </section>

  <section class:list={["grid", b.discountCodes.length ? "grid-3" : "grid-2"]}>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Pays, par chiffre</h2><p class="card-note">commandes et chiffre · un clic ouvre le pays</p></div>
      <Fragment set:html={hbars(countryRows)} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Formats et paiement <Tip of="formats" /></h2><p class="card-note">ce qui se vend, comment c'est payé</p></div>
      <div class="donut-row">
        <Fragment set:html={donut(b.formats, { size: 100 })} />
        <ul class="legend">{b.formats.map((d) => <li><span class="dot" style={`background:${d.color}`}></span><span class="legend-label">{d.label}</span><span class="legend-num">{fmtInt(d.value)}</span></li>)}</ul>
      </div>
      <p class="modal-section-title spaced">Modes de paiement <Tip of="gateway" /></p>
      <Fragment set:html={hbars(b.gateways.map((g) => ({ label: g.label, value: g.count, text: `${fmtInt(g.count)} · ${fmtPct(g.count, k.orders)}` })))} />
    </div>
    {
      b.discountCodes.length > 0 && (
        <div class="card">
          <div class="card-head"><h2 class="card-title">Codes de réduction <Tip of="discounts" /></h2><p class="card-note">commandes · remise</p></div>
          <Fragment set:html={hbars(codeRows)} />
        </div>
      )
    }
  </section>

  <section class="card">
    <div class="card-head"><h2 class="card-title">Quand ils commandent <Tip of="heatOrders" /></h2><p class="card-note">commandes payées par heure de Dubaï et jour de semaine</p></div>
    <Fragment set:html={heatmap(b.heat.orders, { format: (v) => `${v} commande${v > 1 ? "s" : ""}` })} />
  </section>

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Commandes</h2><p class="card-note">{fmtInt(k.orders)} sur la période{b.tracked.testOrders ? ` · ${b.tracked.testOrders} de test écartée${b.tracked.testOrders > 1 ? "s" : ""}` : ""}</p></div>
    <OrdersTable orders={b.recentOrders} showDiscount />
  </section>

  {b.perProduct.map((p) => <ProductModal product={p} currency={cur} totalRevenue={k.revenue} />)}
  {b.countries.map((c) => <CountryModal country={c} currency={cur} />)}
  <DaysModal byDay={b.byDay} currency={cur} rangeLabel={range.label} />
  {/*
    Le détail de la marge : d'où part le chiffre, ce qu'on en retire, ce qu'il
    reste. Chaque ligne dit AUSSI ce qu'elle ne couvre pas, parce qu'une marge
    incomplète qu'on croit complète est pire qu'une marge absente.
  */}
  {k.marge !== null && (
    <ModalTemplate id="marge" title="La marge brute, ligne à ligne" subtitle={`${range.label} · ${money(k.marge)} sur ${money(k.revenue)}`}>
      <div class="card">
        <dl class="marge-lignes">
          <div class="marge-ligne">
            <dt>Chiffre net encaissé</dt>
            <dd>{money(k.revenue)}</dd>
          </div>
          <div class="marge-ligne is-sub">
            <dt>dont livraison facturée au client</dt>
            <dd>{money(k.shipping)}</dd>
          </div>
          <div class="marge-ligne is-sub">
            <dt>remises et bons d'achat accordés</dt>
            <dd>{k.discounts ? `– ${money(k.discounts)}` : "aucun"}</dd>
          </div>
          <div class="marge-ligne is-total">
            <dt>Coût de revient des unités vendues</dt>
            <dd>– {money(k.cout ?? 0)}</dd>
          </div>
          <div class="marge-ligne is-sub">
            <dt>flacons</dt>
            <dd>– {money(k.coutDetail.flacons)}</dd>
          </div>
          <div class="marge-ligne is-sub">
            <dt>coffrets</dt>
            <dd>– {money(k.coutDetail.coffrets)}</dd>
          </div>
          <div class="marge-ligne is-sub">
            <dt>échantillons offerts</dt>
            <dd>– {money(k.coutDetail.echantillons)}</dd>
          </div>
          <div class="marge-ligne is-result">
            <dt>Marge brute</dt>
            <dd>{money(k.marge)}{k.margeTaux !== null ? ` · ${Math.round(k.margeTaux * 100)} %` : ""}</dd>
          </div>
        </dl>
        <p class="card-foot">
          Ce qui n'est PAS déduit ici, faute de le connaître : le transport que nous payons au transporteur (la ligne ci-dessus est ce que le client a payé, pas notre facture), les frais de paiement, la publicité et les charges fixes. La marge brute dit si le produit gagne de l'argent, pas si l'entreprise en gagne.
          {k.coutsManquants > 0 ? ` ${fmtInt(k.coutsManquants)} produit${k.coutsManquants > 1 ? "s" : ""} vendu${k.coutsManquants > 1 ? "s" : ""} sur la période n'a pas de coût de revient dans Sanity : il n'est pas compté.` : ""}
        </p>
      </div>
    </ModalTemplate>
  )}

  <ModalTemplate id="cancelled" title="Commandes annulées" subtitle={`${fmtInt(k.cancelled)} commande${k.cancelled > 1 ? "s" : ""} · ${money(k.cancelledTotal)} écartés du chiffre · ${range.label}`} wide>
    <div class="card tbl-card"><OrdersTable orders={b.cancelledOrders} showDiscount empty="Aucune commande annulée sur la période." /></div>
  </ModalTemplate>
</AdminLayout>

<style>
  .spaced { margin-top: 16px; }
  .marge-lignes { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .marge-ligne { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; font-size: 15px; }
  .marge-ligne dd { margin: 0; font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* Les sous-lignes détaillent la ligne au-dessus : décalées, plus petites, plus pâles. */
  .marge-ligne.is-sub { padding-inline-start: 18px; font-size: 13.5px; color: var(--muted); }
  .marge-ligne.is-total { padding-top: 10px; border-top: 1px solid var(--line); }
  .marge-ligne.is-result { padding-top: 12px; border-top: 1px solid var(--ink); font-size: 17px; font-weight: 500; }
</style>
