---
/** Ventes & paniers : le chiffre dans le détail, les produits, les paniers abandonnés un par un, les pays, les codes, toutes les commandes. */
import AdminLayout from "../../layouts/AdminLayout.astro";
import FilterBar from "../../components/admin/FilterBar.astro";
import Kpi from "../../components/admin/Kpi.astro";
import Tip from "../../components/admin/Tip.astro";
import ProductTiles from "../../components/admin/ProductTiles.astro";
import ProductModal from "../../components/admin/ProductModal.astro";
import CountryModal from "../../components/admin/CountryModal.astro";
import DaysModal from "../../components/admin/DaysModal.astro";
import OrdersTable from "../../components/admin/OrdersTable.astro";
import CartsTable from "../../components/admin/CartsTable.astro";
import { readSession } from "../../lib/admin/auth";
import { parseRange, fmtInt, fmtPct } from "../../lib/admin/data";
import { business, parseFilters, fmtMoney, fmtMoneyShort, delta } from "../../lib/admin/business";
import { timeChart, hbars } from "../../lib/admin/charts";
export const prerender = false;

const admin = await readSession(Astro.cookies);
if (!admin) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const range = parseRange(Astro.url.searchParams);
const filters = parseFilters(Astro.url.searchParams);
const b = await business(range, filters);
const cur = b.currency;
const money = (n: number) => fmtMoney(n, cur);
const k = b.kpis;
const pk = b.previous.kpis;
const countryRows = b.countries.filter((c) => c.orders).slice(0, 10).map((c) => ({ label: c.name, prefix: c.flag, value: c.revenue, text: `${fmtInt(c.orders)} · ${fmtMoneyShort(c.revenue)} ${cur}`, color: "var(--rose)", modal: `country:${c.code}` }));
const codeRows = b.discountCodes.slice(0, 10).map((d) => ({ label: d.code, value: d.orders, text: `${fmtInt(d.orders)} · −${fmtMoneyShort(d.discounts)} ${cur}`, color: "var(--warn)" }));
---

<AdminLayout title="Ventes & paniers" section="ventes" admin={admin} range={range} subtitle={`Ce qui a été payé et ce qui a failli l'être · ${range.label}.`}>
  <FilterBar slot="filters" filters={filters} facets={b.facets} range={range} />

  <section class="kpis">
    <Kpi tone="rose" label="Chiffre d'affaires" tip="revenue" value={fmtMoneyShort(k.revenue)} unit={cur} delta={delta(k.revenue, pk.revenue)} sub="TTC, livraison comprise" />
    <Kpi label="Commandes" tip="orders" value={fmtInt(k.orders)} delta={delta(k.orders, pk.orders)} sub={`${fmtInt(k.units)} flacon${k.units > 1 ? "s" : ""}`} />
    <Kpi label="Panier moyen" tip="aov" value={k.aov === null ? "–" : fmtMoneyShort(k.aov)} unit={k.aov === null ? undefined : cur} delta={delta(k.aov, pk.aov)} sub={k.orders ? `${(k.units / k.orders).toFixed(1).replace(".", ",")} flacon par commande` : undefined} />
    <Kpi label="Par acheteur" tip="aovPerBuyer" value={k.aovPerBuyer === null ? "–" : fmtMoneyShort(k.aovPerBuyer)} unit={k.aovPerBuyer === null ? undefined : cur} delta={delta(k.aovPerBuyer, pk.aovPerBuyer)} sub={`${fmtInt(k.buyers)} acheteur${k.buyers > 1 ? "s" : ""} distinct${k.buyers > 1 ? "s" : ""}`} />
    <Kpi label="Panier moyen, tous paniers" tip="avgCart" value={k.avgCart === null ? "–" : fmtMoneyShort(k.avgCart)} unit={k.avgCart === null ? undefined : cur} delta={delta(k.avgCart, pk.avgCart)} sub={`${fmtInt(k.cartsCount)} panier${k.cartsCount > 1 ? "s" : ""}, payés ou non`} />
    <Kpi label="Remises" tip="discounts" value={fmtMoneyShort(k.discounts)} unit={cur} sub={`${b.discountCodes.length} code${b.discountCodes.length > 1 ? "s" : ""} utilisé${b.discountCodes.length > 1 ? "s" : ""}`} />
    <Kpi label="Livraison facturée" tip="shipping" value={fmtMoneyShort(k.shipping)} unit={cur} />
    <Kpi label="Abandonnés" tip="cartsAbandoned" value={fmtMoneyShort(b.carts.abandoned.total)} unit={cur} delta={delta(k.abandonedTotal, pk.abandonedTotal)} deltaInvert sub={`${fmtInt(b.carts.abandoned.count)} panier${b.carts.abandoned.count > 1 ? "s" : ""}${b.carts.abandoned.atCheckout ? `, ${fmtInt(b.carts.abandoned.atCheckout)} au paiement` : ""} · ${b.carts.all.count ? fmtPct(b.carts.abandoned.count, b.carts.all.count) : "–"} des paniers`} />
  </section>

  <section class="grid grid-2">
    <div class="card">
      <div class="card-head"><h2 class="card-title">Chiffre d'affaires et commandes, par jour <Tip of="byDay" /></h2><p class="card-note">aire : {cur} · barres : commandes</p></div>
      <Fragment set:html={timeChart(b.series.revenue, { secondary: b.series.orders, height: 190, primaryFormat: (v) => fmtMoneyShort(v), secondaryFormat: (v) => `${v} commande${v > 1 ? "s" : ""}`, primaryLabel: "chiffre", modal: "days" })} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Paniers abandonnés, par jour <Tip of="cartsAbandoned" /></h2><p class="card-note">{money(b.carts.abandoned.total)} au total</p></div>
      <Fragment set:html={timeChart(b.series.abandoned, { height: 190, primaryColor: "var(--warn)", primaryFormat: (v) => fmtMoneyShort(v), primaryLabel: "abandonné", modal: "days" })} />
    </div>
  </section>

  <div class="section-title"><h2>Par produit</h2><p>chiffre, part, flacons, paniers abandonnés — un clic ouvre le détail</p></div>
  <ProductTiles products={b.perProduct} currency={cur} focus={filters.reflet} />
  {b.other.units > 0 && <p class="card-foot">Autres articles vendus : {b.other.titles.join(", ")} — {fmtInt(b.other.units)} unité{b.other.units > 1 ? "s" : ""}, {money(b.other.revenue)}.</p>}

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Paniers abandonnés et en cours <Tip of="cartsAbandoned" /></h2><p class="card-note">≈ montant estimé d'après le catalogue</p></div>
    <CartsTable carts={b.abandonedCarts} />
  </section>

  <section class="grid grid-2">
    <div class="card">
      <div class="card-head"><h2 class="card-title">Pays, par chiffre d'affaires</h2><p class="card-note">commandes · chiffre — un clic ouvre le pays</p></div>
      <Fragment set:html={hbars(countryRows)} />
    </div>
    <div class="card">
      <div class="card-head"><h2 class="card-title">Codes de réduction <Tip of="discounts" /></h2><p class="card-note">commandes · remise</p></div>
      <Fragment set:html={hbars(codeRows)} />
    </div>
  </section>

  <section class="card tbl-card">
    <div class="card-head"><h2 class="card-title">Commandes</h2><p class="card-note">{fmtInt(k.orders)} sur la période{b.tracked.testOrders ? ` · ${b.tracked.testOrders} de test écartée${b.tracked.testOrders > 1 ? "s" : ""}` : ""}</p></div>
    <OrdersTable orders={b.recentOrders} showDiscount />
  </section>

  {b.perProduct.map((p) => <ProductModal product={p} currency={cur} totalRevenue={k.revenue} />)}
  {b.countries.map((c) => <CountryModal country={c} currency={cur} />)}
  <DaysModal byDay={b.byDay} currency={cur} rangeLabel={range.label} />
</AdminLayout>
