---
import Layout from "../../layouts/Layout.astro";
import { formatPrice, getAllProducts } from "../../lib/shopify";

// Récupéré au build (SSG) — chaque déploiement Vercel re-fetch le catalogue Shopify à jour.
const products = await getAllProducts();
---

<Layout title="Les 6 Reflets" description="La collection de parfums Maison Reflet">
  <h1>Les 6 Reflets</h1>

  <div class="grid">
    {
      products.map((product) => (
        <a href={`/parfums/${product.handle}`} class="card">
          {product.featuredImage && (
            <img
              src={product.featuredImage.url}
              alt={product.featuredImage.altText ?? product.title}
              width={product.featuredImage.width}
              height={product.featuredImage.height}
              loading="lazy"
            />
          )}
          <h2>{product.title}</h2>
          <p>
            {formatPrice(
              product.priceRange.minVariantPrice.amount,
              product.priceRange.minVariantPrice.currencyCode
            )}
          </p>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
  }
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .card img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
