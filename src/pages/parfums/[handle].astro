---
import Layout from "../../layouts/Layout.astro";
import AddToCartButton from "../../components/AddToCartButton.astro";
import { formatPrice, getAllProducts, type ShopifyProduct } from "../../lib/shopify";
import { getParfumContent, urlForImage } from "../../lib/sanity";

// SSG : génère une page statique par produit Shopify au moment du build.
// Le produit complet est passé en props — un seul fetch catalogue pour tout
// le site, pas de re-fetch par page.
// Si tu préfères du rendu à la demande (produits qui changent souvent),
// passe en mode "server" pour cette route — voir la doc Astro sur les modes de rendu.
export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

interface Props {
  product: ShopifyProduct;
}

const { product } = Astro.props;

// Contenu éditorial Sanity, relié via le handle Shopify.
// Peut être null si le parfum n'a pas encore de fiche éditoriale créée dans le Studio.
const parfumContent = await getParfumContent(product.handle);

// Les fiches Sanity peuvent être partielles (histoire sans notes, etc.) :
// chaque bloc éditorial ne s'affiche que si son contenu existe.
const notes = parfumContent?.notesOlfactives;
const noteGroups = [
  { label: "Tête", items: notes?.tete ?? [] },
  { label: "Cœur", items: notes?.coeur ?? [] },
  { label: "Fond", items: notes?.fond ?? [] },
].filter((group) => group.items.length > 0);
const imagesEditoriales = parfumContent?.imagesEditoriales ?? [];
---

<Layout title={product.title} description={product.description}>
  <article>
    <h1>{product.title}</h1>

    {
      product.featuredImage && (
        <img
          src={product.featuredImage.url}
          alt={product.featuredImage.altText ?? product.title}
          width={product.featuredImage.width}
          height={product.featuredImage.height}
        />
      )
    }

    <p class="price">
      {
        formatPrice(
          product.priceRange.minVariantPrice.amount,
          product.priceRange.minVariantPrice.currencyCode
        )
      }
    </p>

    <div set:html={product.descriptionHtml} />

    <AddToCartButton variants={product.variants.nodes} />

    {
      parfumContent && (
        <section class="editorial">
          {parfumContent.histoire && (
            <>
              <h2>L'histoire</h2>
              <p>{parfumContent.histoire}</p>
            </>
          )}

          {noteGroups.length > 0 && (
            <>
              <h2>Notes olfactives</h2>
              <div class="notes">
                {noteGroups.map((group) => (
                  <div>
                    <h3>{group.label}</h3>
                    <ul>
                      {group.items.map((note) => (
                        <li>{note}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </>
          )}

          {parfumContent.inspirationCulturelle && (
            <>
              <h2>Inspiration culturelle</h2>
              <p>{parfumContent.inspirationCulturelle}</p>
            </>
          )}

          {imagesEditoriales.length > 0 && (
            <div class="editorial-images">
              {imagesEditoriales.map((img) => (
                <img src={urlForImage(img).width(800).url()} alt="" loading="lazy" />
              ))}
            </div>
          )}
        </section>
      )
    }
  </article>
</Layout>

<style>
  .notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .editorial-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .editorial-images img {
    width: 100%;
    height: auto;
  }
</style>
