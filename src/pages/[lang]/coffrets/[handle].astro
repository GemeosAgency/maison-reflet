---
/**
 * Page coffret v2 (maquette Figma « Discovery », septembre 2026) — assemblage
 * de sections : galerie + panneau sticky, Scent Notes à onglets (un par parfum
 * du coffret), Perfumer's word, réassurance, avis, You may also like, piliers,
 * FAQ. Commerce (prix / variantes / panier) = Shopify ; éditorial = Sanity.
 *
 * Comme la fiche parfum, chaque section se masque si son contenu n'est pas
 * rempli dans le Studio : un coffret cadeau sans parfums liés n'affichera pas
 * le triptyque à onglets, un coffret sans mot du parfumeur sautera la section.
 * La maquette décrit le Discovery Set, qui est le coffret le mieux garni ;
 * cette route sert tous les coffrets et se dégrade proprement pour les autres.
 */
import Layout from "../../../layouts/Layout.astro";
import Faq from "../../../components/Faq.astro";
import Pillars from "../../../components/Pillars.astro";
import Reassurance from "../../../components/Reassurance.astro";
import LumaAsk from "../../../components/LumaAsk.astro";
import RelatedProducts from "../../../components/RelatedProducts.astro";
import Reviews from "../../../components/Reviews.astro";
import ProductGallery from "../../../components/product/ProductGallery.astro";
import ProductInfoPanel from "../../../components/product/ProductInfoPanel.astro";
import ScentNotes from "../../../components/product/ScentNotes.astro";
import PerfumerWord from "../../../components/product/PerfumerWord.astro";
import {
  formatPrice,
  getAllProducts,
  getDisplayPrice,
  getPrimaryVariant,
  isCoffret,
  secondaryImage,
  shopifyImage,
  type ShopifyProduct,
} from "../../../lib/shopify";
import {
  getBestSellerMap,
  getCoffretByHandle,
  getInspiredByMap,
  getReassurances,
  getRecoImages,
  responsiveImage,
  richTextToHtml,
  urlForImage,
} from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export async function getStaticPaths() {
  const products = await getAllProducts();
  const coffrets = products.filter(isCoffret);
  return locales.flatMap((lang) =>
    coffrets.map((product) => ({ params: { lang, handle: product.handle }, props: { product, products } }))
  );
}

interface Props {
  product: ShopifyProduct;
  products: ShopifyProduct[];
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { product, products } = Astro.props;

// Largeurs des tuiles "You may also like" (287px de large dans la maquette,
// jusqu'à 860 pour la densité 2x sur grand écran).
const TILE_WIDTHS = [320, 480, 640, 860];

const content = await getCoffretByHandle(product.handle, lang);
const variant = getPrimaryVariant(product);
const priceLabel = formatPrice(variant.price.amount, variant.price.currencyCode);

const title = content?.titre ?? product.title;
const description = content?.description ?? product.description;

// ---------- Galerie ----------
// Deux carrés empilés dans la maquette : image Sanity du coffret d'abord,
// puis les photos produit Shopify.
// shopifyImage() borne la largeur : sans ça le CDN sert le fichier d'origine,
// plusieurs Mo pour une colonne de 720 px.
const gallery = [
  content?.image
    ? { ...responsiveImage(content.image as any, { widths: [480, 720, 960, 1440], aspect: 1 }), alt: title }
    : null,
  ...[product.featuredImage, ...product.images.nodes]
    .filter((im) => im)
    .map((im) => ({ ...shopifyImage(im!, [480, 720, 960, 1440]), alt: im!.altText ?? title })),
].filter((g): g is NonNullable<typeof g> => g !== null);

// ---------- Panneau d'achat ----------
const descriptionHtml = description ? `<p>${description.replace(/\n/g, "</p><p>")}</p>` : "";

// Avantages sous le CTA — la maquette n'en garde que deux sur la page coffret.
const perks = [
  { icon: "/brand/shipment.svg", label: t("product.perkDelivery") },
  { icon: "/brand/love.svg", label: t("product.perkTreat") },
];

// Note / avis : placeholders (pas encore de système d'avis branché).
const rating = "4,9";
const panelReviewCount = 147;
const reviewCount = 267;
const reviewPlaceholder = {
  fr: "Avis client à venir — contenu de démonstration en attendant un vrai système d'avis.",
  ar: "رأي العميل قادم — محتوى تجريبي بانتظار نظام تقييمات حقيقي.",
  en: "Customer review coming soon — placeholder content pending a real reviews system.",
}[lang];
const reviews = Array.from({ length: 5 }, () => ({ author: "—", date: "", quote: reviewPlaceholder }));

// ---------- Scent Notes à onglets ----------
/*
 * Un onglet par parfum du coffret. Le nom affiché vient de Shopify (source de
 * vérité du catalogue), avec le repère du Studio en repli si le produit n'a pas
 * encore été créé côté Shopify.
 *
 * `keyIndex` est l'index, DANS LA LISTE AFFICHÉE, de la note dont la photo est
 * montrée : c'est elle qui passe en gras. Même règle que sur la fiche parfum —
 * toutes les matières n'ont pas de photo, et mettre la première en gras
 * afficherait du caramel sous un « Jasmin Sambac » en gras.
 */
const scentLevel = (label: string, notes: { nom: string | null; image?: unknown }[] | undefined) => {
  const named = (notes ?? []).filter((n) => n.nom);
  const keyIndex = named.findIndex((n) => n.image);
  const key = keyIndex >= 0 ? named[keyIndex] : null;
  return {
    label,
    notes: named.map((n) => n.nom as string),
    keyIndex,
    img: key ? responsiveImage(key.image as any, { widths: [320, 480, 640, 960, 1200] }) : null,
  };
};

const scentTabs = (content?.parfums ?? []).map((p) => ({
  id: p.shopifyHandle,
  label: products.find((sp) => sp.handle === p.shopifyHandle)?.title ?? p.nom ?? p.shopifyHandle,
  levels: [
    scentLevel(t("product.notes.tete"), p.notes?.tete),
    scentLevel(t("product.notes.coeur"), p.notes?.coeur),
    scentLevel(t("product.notes.fond"), p.notes?.fond),
  ],
}));

// ---------- Sections éditoriales ----------
const perfumerWord = content?.perfumerWord ?? null;
const perfumerPhoto = content?.perfumerPhoto
  ? responsiveImage(content.perfumerPhoto as any, {
      widths: [640, 960, 1280, 1600],
      aspect: 816 / 560,
    })
  : null;

// Bandeau de réassurance : bibliothèque complète, comme sur la home — la
// maquette en affiche les cinq.
const reassurances = (await getReassurances(lang)).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));

// "You may also like" : les parfums de la collection (5 max, maquette).
const [inspiredMap, bestSellerMap, recoImages] = await Promise.all([
  getInspiredByMap(),
  getBestSellerMap(),
  getRecoImages(),
]);
const related = products
  .filter((p) => !isCoffret(p))
  .slice(0, 5)
  .map((p) => {
    const recoImg = recoImages[p.handle];
    const price = getDisplayPrice(p);
    return {
      name: p.title,
      subtitle: inspiredMap[p.handle] ? `${t("product.twistOf")} ${inspiredMap[p.handle]}` : null,
      price: formatPrice(price.amount, price.currencyCode),
      // Sans imageRecommandation dans Sanity on retombe sur la photo produit
      // Shopify — servie brute elle pèse jusqu'à 7,4 Mo pour une tuile de 287px.
      img: recoImg?.main
        ? responsiveImage(recoImg.main as any, { widths: TILE_WIDTHS, aspect: 287 / 352 })
        : p.featuredImage
          ? shopifyImage(p.featuredImage, TILE_WIDTHS)
          : null,
      // Photo du survol : la version curée dans Sanity si elle existe, sinon
      // la deuxième photo produit de Shopify (voir secondaryImage). Même
      // chaîne de repli que les tuiles du catalogue et de l'accueil.
      hoverImg: recoImg?.hover
        ? responsiveImage(recoImg.hover as any, { widths: TILE_WIDTHS, aspect: 287 / 352 })
        : (() => {
            const im = secondaryImage(p);
            return im ? shopifyImage(im, TILE_WIDTHS) : null;
          })(),
      href: localePath(lang, `/parfums/${p.handle}`),
      badge: bestSellerMap[p.handle] ? t("product.bestSeller") : null,
      variantId: getPrimaryVariant(p).id,
    };
  });

const pillars = [
  { title: t("home.pillars.quality.title"), text: t("home.pillars.quality.text"), image: "/home/pillar-quality.jpg" },
  { title: t("home.pillars.performance.title"), text: t("home.pillars.performance.text"), image: "/home/pillar-performance.jpg" },
  { title: t("home.pillars.character.title"), text: t("home.pillars.character.text"), image: "/home/pillar-character.jpg" },
];

// ---------- Tracking ----------
// Événement Klaviyo "Viewed Product" (voir src/lib/klaviyo.ts + script plus bas).
// Voir le commentaire équivalent dans parfums/[handle].astro : ces pages
// sont pré-générées au build, Astro.url.href y est donc faux sans ceci.
const siteOrigin = import.meta.env.PUBLIC_SITE_URL;
const productUrl = siteOrigin ? `${siteOrigin}${Astro.url.pathname}` : Astro.url.href;

const viewedProduct = {
  ProductName: title,
  ProductID: product.id,
  SKU: variant.sku ?? null,
  Categories: ["Coffret"],
  ImageURL: gallery[0]?.src ?? null,
  URL: productUrl,
  Brand: "Maison Reflet",
  Price: Number(variant.price.amount),
};

// Événement Meta "ViewContent" — voir le commentaire équivalent dans
// parfums/[handle].astro (id de variante numérique, cohérence catalogue).
const metaViewContentData = {
  variantGid: variant.id,
  name: title,
  value: Number(variant.price.amount),
  currency: variant.price.currencyCode,
};

// ---------- SEO ----------
/*
 * Image de partage recadrée en 1200x630 (~1,91:1), format attendu par les
 * réseaux sociaux ; servir un visuel carré donnerait un aperçu mal cadré.
 * Le recadrage n'existe que côté Sanity : en repli Shopify on borne au moins
 * la largeur, sinon l'aperçu pèse plusieurs Mo.
 */
const shareImage = content?.image
  ? urlForImage(content.image as any).width(1200).height(630).fit("crop").url()
  : product.featuredImage
    ? shopifyImage(product.featuredImage, [1200]).src
    : null;

/*
 * JSON-LD Product : c'est lui qui donne à Google le prix, la devise et la
 * disponibilité affichés directement dans les résultats de recherche.
 * `offers.url` doit être l'URL canonique de la page produit.
 */
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: title,
  description: description ?? undefined,
  image: gallery.map((g) => g.src).slice(0, 4),
  brand: { "@type": "Brand", name: "Maison Reflet" },
  sku: variant.sku ?? undefined,
  offers: {
    "@type": "Offer",
    url: productUrl,
    price: Number(variant.price.amount),
    priceCurrency: variant.price.currencyCode,
    availability: variant.availableForSale
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
  },
};
---

<Layout
  title={title}
  description={description ?? undefined}
  lang={lang}
  ogImage={shareImage}
  ogType="product"
  jsonLd={[productJsonLd]}
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: title }]}
>
  <div class="coffret">
    <div class="coffret-gallery">
      <ProductGallery images={gallery} ratio="1 / 1" />
    </div>
    <aside class="coffret-panel">
      <ProductInfoPanel
        title={title}
        sizeLabel={null}
        rating={rating}
        reviewCount={panelReviewCount}
        reviewsWord={t("product.reviews")}
        descriptionHtml={descriptionHtml}
        famillesLabel={t("product.olfactiveFamily")}
        familles={null}
        pyramidLabel={t("product.pyramid")}
        pyramidImg={null}
        noteLevels={[]}
        intensityLabel={t("product.intensity")}
        intensity={null}
        intensityValueLabel={null}
        sillageLabel={t("product.sillage")}
        sillage={null}
        sillageValueLabel={null}
        plainRows={content?.contenance ? [content.contenance] : []}
        variantId={variant.id}
        priceLabel={priceLabel}
        lang={lang}
        addLabel={t("product.addToCart")}
        addedLabel={t("product.added")}
        errorLabel={t("product.error")}
        decreaseLabel={t("cart.decrease")}
        increaseLabel={t("cart.increase")}
        perks={perks}
      >
        <LumaAsk slot="after-perks" lang={lang} handle={product.handle} name={title} kind="coffret" />
      </ProductInfoPanel>
    </aside>
  </div>

  <ScentNotes title={t("product.notes")} tabs={scentTabs} />

  {perfumerWord && <PerfumerWord title={t("product.perfumerWord")} quote={perfumerWord} img={perfumerPhoto} />}

  <Reassurance items={reassurances} />

  <Reviews
    title={t("home.reviews.title")}
    ratingLabel={t("home.reviews.rated")}
    customersLabel={t("home.reviews.customers")}
    reviews={reviews}
    totalCount={reviewCount}
    previousLabel={t("reviews.previous")}
    nextLabel={t("reviews.next")}
  />

  <RelatedProducts
    title={t("product.related")}
    items={related}
    addLabel={t("product.addToCart")}
    addedLabel={t("cart.added")}
    errorLabel={t("product.error")}
  />

  <Pillars
    title1={t("home.pillars.title1")}
    title2={t("home.pillars.title2")}
    subtitle={t("home.pillars.subtitle")}
    pillars={pillars}
  />

  <Faq items={content?.faqs ?? []} title={t("product.faqTitle")} />
</Layout>

{/* .replace(/</g, "\\u003c") : JSON.stringify n'échappe pas "<", un titre
    contenant "</script>" sortirait du bloc (XSS) — voir parfums/[handle].astro. */}
<script type="application/json" id="viewed-product" is:inline set:html={JSON.stringify(viewedProduct).replace(/</g, "\\u003c")} />
<script type="application/json" id="meta-view-content" is:inline set:html={JSON.stringify(metaViewContentData).replace(/</g, "\\u003c")} />

<script>
  import { track } from "../../../lib/klaviyo";
  import { metaViewContent, shopifyNumericId } from "../../../lib/meta";
  import { ga4ViewItem } from "../../../lib/ga4";

  const viewedProduct = JSON.parse(document.getElementById("viewed-product")?.textContent ?? "null");
  if (viewedProduct) {
    try {
      track("Viewed Product", viewedProduct);
    } catch {
      // le tracking ne doit jamais faire échouer le rendu de la page
    }
  }

  // "ViewContent" Meta + "view_item" GA4 — même déclenchement, mêmes données.
  const metaProduct = JSON.parse(document.getElementById("meta-view-content")?.textContent ?? "null");
  if (metaProduct) {
    try {
      metaViewContent({
        contentId: shopifyNumericId(metaProduct.variantGid),
        contentName: metaProduct.name,
        value: metaProduct.value,
        currency: metaProduct.currency,
      });
    } catch {
      // idem : jamais bloquant
    }
    try {
      ga4ViewItem({
        item: {
          item_id: shopifyNumericId(metaProduct.variantGid),
          item_name: metaProduct.name,
          price: metaProduct.value,
        },
        value: metaProduct.value,
        currency: metaProduct.currency,
      });
    } catch {
      // idem : jamais bloquant
    }
  }
</script>

<style>
  /* Galerie + panneau sticky, mêmes règles que la fiche parfum.
     minmax(0, 1fr) et non 1fr : 1fr = minmax(auto, 1fr), donc le min-content
     du panneau (rangée quantité + bouton insécable) élargirait la colonne et
     provoquerait un débordement horizontal sur mobile. */
  .coffret {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
  }
  .coffret-panel {
    position: sticky;
    /* Sous la barre de navigation collante, pas dessous. */
    top: var(--header-h);
    padding: 56px var(--gutter-x) 32px;
  }

  @media (max-width: 900px) {
    .coffret { grid-template-columns: minmax(0, 1fr); }
    .coffret-panel { position: static; padding: 32px var(--gutter-x); }
  }
</style>
