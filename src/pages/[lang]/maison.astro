---
import Layout from "../../layouts/Layout.astro";
import { getPageBySlug, richTextToHtml } from "../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const page = await getPageBySlug("maison", lang);

const contentHtml = richTextToHtml(page?.content);
---

<Layout
  title={page?.title ?? "La Maison"}
  description="L'histoire de Maison Reflet, maison de parfums franco-arabe"
  lang={lang}
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: t("nav.maison") }]}
>
  <article class="page-content">
    {
      page?.title ? (
        <>
          <h1>{page.title}</h1>
          <div set:html={contentHtml} />
        </>
      ) : (
        <h1>La Maison</h1>
      )
    }
  </article>
</Layout>

<style>
  .page-content { max-width: 40rem; margin: 0 auto; padding: 2rem 1rem; }
  .page-content :global(img) { max-width: 100%; height: auto; }
</style>
