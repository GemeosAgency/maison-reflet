---
import { avecAvoir } from "../../lib/coffret-avoir";
import Layout from "../../layouts/Layout.astro";
import DiscoverySetBanner from "../../components/DiscoverySetBanner.astro";
import Faq from "../../components/Faq.astro";
import PerfumeGrid from "../../components/PerfumeGrid.astro";
import { type Locale, locales, localePath, useTranslations } from "../../i18n";
import { COFFRET_HANDLE } from "../../lib/coffret";
import { getDiscoveryBanner } from "../../lib/discovery";
import { getPageBySlug, getPrevente } from "../../lib/sanity";
import { getAllProducts } from "../../lib/shopify";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
// Montant de l'avoir du coffret : son prix pratiqué (120 en prévente), voir coffret-avoir.
const tc = await avecAvoir(t);

// Sections texte + image alternées, dans l'ordre du Figma (10612:10942) :
// Inspiration, Notre histoire, le twist. `textFirst` inverse l'ordre (texte à
// gauche, image à droite) ; par défaut image à gauche. Les photos `figma-*`
// sont les cadrages exacts de la maquette (816 x 560, en 2x), texture du twist
// comprise.
const rows = [
  { img: "/maison/figma-inspiration", title: t("maison.inspiration.title"), body: t("maison.inspiration.body"), textFirst: false },
  { img: "/maison/figma-story", title: t("maison.story.title"), body: t("maison.story.body"), textFirst: true },
  { img: "/maison/figma-twist", title: t("maison.twist.title"), body: t("maison.twist.body"), textFirst: false },
];
const srcset = (base: string, w: number) => `${base}-1x.jpg ${w}w, ${base}.jpg ${w * 2}w`;

const prevente = await getPrevente();
const addLabel = prevente.active ? t("prevente.add") : t("product.addToCart");
const products = await getAllProducts();

// Bannière coffret : la photo propre à La Maison (Figma 12018:1011, la boîte
// sur une table, ombres de feuillage). Titre et texte de la maquette, sans
// l'encadré de l'avoir (déjà dit dans le texte) ; prix et lien comme ailleurs.
const discovery = await getDiscoveryBanner(lang);
const discoveryImg = { src: "/maison/figma-coffret.jpg", srcset: srcset("/maison/figma-coffret", 816) };

// FAQ : les questions rattachées à la page « maison » dans le Studio, sinon
// celles de l'accueil, comme le catalogue.
const faqPage = (await getPageBySlug("maison", lang)) ?? (await getPageBySlug("home", lang));

// Dégradé propre à chaque pilier, relevé dans la maquette.
const pillars = [
  { img: "/maison/figma-pillar-quality", title: t("home.pillars.quality.title"), text: t("home.pillars.quality.text"), veil: "linear-gradient(to bottom, rgba(31, 31, 31, 0) 46.8%, rgba(23, 23, 23, 0.96) 86.3%)" },
  { img: "/maison/figma-pillar-performance", title: t("home.pillars.performance.title"), text: t("home.pillars.performance.text"), veil: "linear-gradient(to bottom, rgba(31, 31, 31, 0) 53.2%, rgba(23, 23, 23, 0.96) 86.8%)" },
  { img: "/maison/figma-pillar-character", title: t("home.pillars.character.title"), text: t("home.pillars.character.text"), veil: "linear-gradient(to bottom, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.8) 87.4%)" },
];
---

<Layout
  title={t("nav.maison")}
  description={t("meta.maison")}
  lang={lang}
  ogImage="/maison/hero.jpg"
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: t("nav.maison") }]}
>
  <section class="maison-hero full-bleed">
    <!-- LCP : vraie balise img (fetchpriority) plutôt qu'un background CSS. -->
    <img class="maison-hero-img" src="/maison/figma-hero.jpg" srcset={srcset("/maison/figma-hero", 1440)} sizes="100vw" alt="" fetchpriority="high" decoding="async" />
    <div class="maison-hero-inner">
      <div class="maison-hero-content">
        <h1>
          {t("home.story.title1")}<br />
          {t("home.story.title2")}
        </h1>
        <p>{[t("home.story.p1"), t("home.story.p2"), t("home.story.p3")].join(" ")}</p>
      </div>
    </div>
  </section>

  <section class="maison-rows">
    {
      rows.map((r) => (
        <div class:list={["maison-row", { "text-first": r.textFirst }]}>
          <div class="maison-row-img">
            <img src={`${r.img}.jpg`} srcset={srcset(r.img, 816)} sizes="(max-width: 900px) 100vw, 57vw" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="maison-row-text">
            <h2>{r.title}</h2>
            <p>{r.body}</p>
          </div>
        </div>
      ))
    }
  </section>

  <section class="maison-pillars">
    <div class="maison-pillars-head">
      <h2>
        {t("home.pillars.title1")}<br />
        {t("home.pillars.title2")}
      </h2>
      <p>{t("home.pillars.subtitle")}</p>
    </div>
    <div class="maison-pillars-grid full-bleed">
      {
        pillars.map((p) => (
          <article class="maison-pillar" style={`--veil: ${p.veil}`}>
            <img class="maison-pillar-img" src={`${p.img}.jpg`} srcset={srcset(p.img, 479)} sizes="(max-width: 900px) 100vw, 33vw" alt="" loading="lazy" decoding="async" />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* Tradition : titre et texte côte à côte, puis l'image en pleine largeur du container (Figma 11035:16371). */}
  <section class="maison-wide">
    <div class="maison-wide-text">
      <h2>{t("maison.tradition.title")}</h2>
      <p>{t("maison.tradition.body")}</p>
    </div>
    <div class="maison-wide-img">
      <img src="/maison/figma-tradition.jpg" srcset={srcset("/maison/figma-tradition", 1294)} sizes="(max-width: 900px) 100vw, 90vw" alt="" loading="lazy" decoding="async" />
    </div>
  </section>

  <PerfumeGrid
    products={products}
    lang={lang}
    addLabel={addLabel}
    layout="row"
    title={t("maison.reflections")}
    seeAllHref={localePath(lang, "/parfums")}
    seeAllLabel={t("home.seeAll")}
  />

  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.handle === COFFRET_HANDLE ? t("maison.discoveryTitle") : discovery.titre}
        description={discovery.handle === COFFRET_HANDLE ? tc("maison.discoveryBody") : discovery.description}
        priceLabel={discovery.price}
        compareLabel={discovery.compare}
        href={discovery.href}
        img={discoveryImg}
        ctaLabel={prevente.active ? t("prevente.add") : t("home.hero.cta")}
        creditLabel={null}
        creditNote={null}
        tipLabel={t("product.tipOpen")}
      />
    )
  }

  <Faq items={faqPage?.faqs ?? []} title={t("maison.faqTitle")} />
</Layout>

<style>
  /* Hero plein écran — 2:1 fixe, y compris grand écran (pas de max-height :
     ça écraserait le ratio dès qu'on dépasse une certaine largeur) ; <img
     fetchpriority> pour le LCP.
     .maison-hero = pur canvas full-bleed (juste l'image + le dégradé).
     .maison-hero-inner porte le positionnement (texte bas-gauche) et surtout
     le plafond de largeur (--page-max, comme <main>) : sans lui, le texte
     s'alignait sur le bord RÉEL de la fenêtre au lieu de la même colonne de
     contenu que le reste du site — flagrant sur les écrans très larges. */
  .maison-hero {
    position: relative;
    /* Figma : 1440 x 680. */
    aspect-ratio: 1440 / 680;
    min-height: 560px;
    background-color: var(--ink);
    color: var(--paper);
    overflow: hidden;
  }
  .maison-hero-img {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center;
  }
  .maison-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 20%, rgba(31, 31, 31, 0.64) 72%);
  }
  .maison-hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--page-max);
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    padding: 64px var(--gutter-x);
  }
  .maison-hero-content {
    max-width: 701px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, 0.56));
  }
  .maison-hero-content h1 {
    margin: 0;
    font-size: clamp(30px, 2.78vw, 48px);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .maison-hero-content p {
    margin: 0;
    font-size: 18px;
    line-height: 1.32;
    letter-spacing: 1.08px;
  }

  /* Rangées texte/image alternées */
  .maison-rows {
    display: flex;
    flex-direction: column;
    gap: 72px;
    padding: 72px;
  }
  /* Proportions de la maquette : image 816 x 560, texte 416, 64 px d'écart,
     texte calé en bas de l'image. */
  .maison-row {
    display: grid;
    grid-template-columns: minmax(0, 816fr) minmax(0, 416fr);
    gap: 64px;
    align-items: end;
  }
  .maison-row.text-first {
    grid-template-columns: minmax(0, 416fr) minmax(0, 816fr);
  }
  .maison-row.text-first .maison-row-img {
    order: 2;
  }
  .maison-row-img {
    aspect-ratio: 816 / 560;
    overflow: hidden;
    background: #dec9b8;
  }
  .maison-row-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Texte calé 40 px au-dessus du bas de l'image (56 px pour la première
     rangée), titres coupés comme dans la maquette (\n dans i18n). */
  .maison-row-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 40px;
    color: var(--ink);
  }
  .maison-row:first-child .maison-row-text {
    padding-bottom: 56px;
  }
  .maison-row-text h2 {
    margin: 0;
    font-size: clamp(26px, 2.22vw, 38px);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: pre-line;
  }
  .maison-row-text p {
    margin: 0;
    font-size: 18px;
    line-height: 1.32;
    letter-spacing: 1.08px;
    white-space: pre-line;
  }

  /* Tradition (Figma 11035:16371) : titre à gauche, texte à droite, puis
     l'image pleine largeur du container au ratio 1296 x 560. */
  .maison-wide {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 120px var(--gutter-x) 72px;
  }
  .maison-wide-text {
    display: flex;
    justify-content: space-between;
    gap: 64px;
    min-height: 120px;
  }
  .maison-wide-text h2 {
    margin: 0;
    max-width: 422px;
    font-size: clamp(26px, 2.22vw, 32px);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: pre-line;
  }
  .maison-wide-text p {
    margin: 0;
    max-width: 732px;
    font-size: 18px;
    line-height: 1.32;
    letter-spacing: 1.08px;
    white-space: pre-line;
  }
  .maison-wide-img { aspect-ratio: 1296 / 560; overflow: hidden; border: 1px solid var(--ink); background: #dec9b8; }
  .maison-wide-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Section piliers (Qualité / Tenue / Caractère) */
  .maison-pillars {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .maison-pillars-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    padding: 56px 64px 40px;
  }
  .maison-pillars-head h2 {
    margin: 0;
    font-size: clamp(26px, 2.22vw, 38px);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--ink);
  }
  .maison-pillars-head p {
    margin: 0;
    font-size: 18px;
    line-height: 1.36;
    color: var(--ink);
  }
  /* Ratio Figma 1440×560 ; images en <img loading="lazy"> (sous la ligne de
     flottaison) plutôt qu'en background CSS. */
  .maison-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    width: 100%;
    aspect-ratio: 18 / 7;
    max-height: 760px;
  }
  .maison-pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 32px;
    overflow: hidden;
    background: #e0cdbb;
    color: var(--paper);
  }
  .maison-pillar-img {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center;
  }
  .maison-pillar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--veil, linear-gradient(to bottom, rgba(31, 31, 31, 0) 50%, #171717 87%));
  }
  .maison-pillar h3,
  .maison-pillar p {
    position: relative;
    z-index: 2;
    margin: 0;
  }
  .maison-pillar h3 {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .maison-pillar p {
    max-width: 360px;
    font-size: 18px;
    line-height: 1.28;
    letter-spacing: 1.08px;
  }

  @media (max-width: 900px) {
    .maison-hero {
      min-height: 520px;
    }
    .maison-hero-inner {
      padding: 32px var(--gutter-x);
    }
    .maison-hero-content h1 {
      font-size: 30px;
    }
    .maison-hero-content p {
      font-size: 16px;
    }
    .maison-rows {
      padding: 40px 24px;
      gap: 48px;
    }
    .maison-row,
    .maison-row.text-first {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .maison-wide { padding: 48px var(--gutter-x) 40px; gap: 24px; }
    .maison-wide-text { flex-direction: column; gap: 16px; }
    .maison-wide-text p { font-size: 16px; }
    .maison-wide-img { aspect-ratio: 3 / 2; }
    .maison-row.text-first .maison-row-img {
      order: 0;
    }
    .maison-row-text h2 {
      font-size: 26px;
    }
    .maison-row-text p {
      font-size: 16px;
    }
    .maison-pillars-head {
      padding: 40px 24px 24px;
    }
    .maison-pillars-head h2 {
      font-size: 26px;
    }
    .maison-pillars-grid {
      grid-template-columns: 1fr;
      aspect-ratio: auto;
      max-height: none;
    }
    .maison-pillar {
      min-height: 360px;
    }
  }
</style>
