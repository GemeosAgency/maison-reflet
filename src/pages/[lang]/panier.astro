---
import Layout from "../../layouts/Layout.astro";
import { type Locale, locales, localePath, useTranslations } from "../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<!--
  Le panier est maintenant la modale coulissante globale (CartDrawer.astro,
  incluse dans Layout.astro sur toutes les pages). Cette page ne sert qu'à
  garder un lien /panier direct/partageable : elle ouvre la modale au chargement.
-->
<Layout
  title={t("cart.title")}
  description="Votre panier Maison Reflet"
  lang={lang}
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: t("nav.panier") }]}
>
  <h1 class="visually-hidden">{t("cart.title")}</h1>
</Layout>

<script>
  document.dispatchEvent(new CustomEvent("cart:open"));
</script>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
