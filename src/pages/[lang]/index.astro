---
import Layout from "../../layouts/Layout.astro";
import DiscoverySetBanner from "../../components/DiscoverySetBanner.astro";
import Faq from "../../components/Faq.astro";
import Pillars from "../../components/Pillars.astro";
import ProductCard from "../../components/ProductCard.astro";
import Reassurance from "../../components/Reassurance.astro";
import Reviews from "../../components/Reviews.astro";
import {
  formatPrice,
  getAllProducts,
  getDisplayPrice,
  getPrimaryVariant,
  isCoffret,
  secondaryImage,
  shopifyImage,
} from "../../lib/shopify";
import {
  getSettings,
  getInspiredByMap,
  getRecoImages,
  getCoffrets,
  getReassurances,
  getBestSellerMap,
  getPageBySlug,
  responsiveImage,
  urlForImage,
} from "../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const settings = await getSettings(lang);
const baseline = settings?.baseline ?? "Six parfums, six reflets d'une identité franco-arabe.";

const allProducts = await getAllProducts();
const perfumes = allProducts.filter((p) => !isCoffret(p));
const inspiredMap = await getInspiredByMap();
const recoImages = await getRecoImages();
const bestSellerMap = await getBestSellerMap();

/*
 * Bestsellers — la maquette (node 10573:5817) en montre QUATRE, dont trois
 * portent la pastille « BEST SELLER ». Le classement vient du marquage
 * `bestSeller` de Sanity (le même qui alimente les pastilles du catalogue) :
 * les parfums marqués d'abord, puis les autres pour compléter la rangée. Pas
 * de vrai classement des ventes tant que Shopify Analytics n'est pas branché.
 */
const TILE_RATIO = 358.5 / 528;
const TILE_WIDTH = 900; // ~449 px de large dans le container, x2 pour les écrans denses
const tileImage = (source: unknown) =>
  urlForImage(source as any)
    .width(TILE_WIDTH)
    .height(Math.round(TILE_WIDTH / TILE_RATIO))
    .auto("format")
    .url();

const bestsellers = [...perfumes]
  .sort(
    (a, b) =>
      Number(Boolean(bestSellerMap[b.handle])) - Number(Boolean(bestSellerMap[a.handle]))
  )
  .slice(0, 4)
  .map((p) => {
    const recoImg = recoImages[p.handle];
    const variant = getPrimaryVariant(p);
    const price = getDisplayPrice(p);
    return {
      name: p.title,
      inspired: inspiredMap[p.handle] ?? null,
      price: formatPrice(price.amount, price.currencyCode),
      img: recoImg?.main
        ? tileImage(recoImg.main)
        : p.featuredImage
          ? shopifyImage(p.featuredImage, [480, 720, TILE_WIDTH]).src
          : null,
      // Seconde photo du survol — même chaîne de repli que le catalogue : la
      // version curée dans Sanity, sinon la deuxième photo produit de Shopify
      // (hors visuels de variante échantillon, qui sont des vignettes de 192 px
      // destinées au panier).
      hoverImg: recoImg?.hover
        ? tileImage(recoImg.hover)
        : (() => {
            const im = secondaryImage(p);
            return im ? shopifyImage(im, [480, 720, TILE_WIDTH]).src : null;
          })(),
      variantId: variant.id,
      href: localePath(lang, `/parfums/${p.handle}`),
      badge: bestSellerMap[p.handle] ? t("product.bestSeller") : null,
    };
  });

/*
 * « The Discovery Set » (node 11026:16156) remplace l'ancienne rangée de
 * cartes coffret : même bandeau que le catalogue et la fiche produit, image à
 * gauche, texte et CTA à droite. Même sélection que là-bas — le coffret dont
 * le handle évoque un set d'échantillons, sinon le premier.
 */
const coffretProducts = allProducts.filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const discoveryCandidates = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const variant = getPrimaryVariant(sp);
    return {
      handle: sp.handle,
      titre: c.titre ?? sp.title,
      description: c.description,
      img: c.image
        ? responsiveImage(c.image as any, { widths: [640, 960, 1280, 1600], aspect: 816 / 560 })
        : sp.featuredImage
          ? shopifyImage(sp.featuredImage, [640, 960, 1280, 1600])
          : null,
      price: formatPrice(variant.price.amount, variant.price.currencyCode),
      href: localePath(lang, `/coffrets/${sp.handle}`),
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
const discovery =
  discoveryCandidates.find((c) => /sample|discovery|decouverte|découverte/i.test(c.handle)) ??
  discoveryCandidates[0] ??
  null;

const reassurances = (await getReassurances(lang)).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));

// FAQ de la home : rattachées dans le Studio au document "Page" (slug "home"),
// comme pour "La Maison" — vide tant que rien n'y est attaché.
const homePage = await getPageBySlug("home", lang);

// Avis clients : AUCUN système d'avis n'existe encore (Judge.me, Loox…) — ce
// bloc est un aperçu visuel avec du contenu de démonstration, à remplacer par
// de vrais avis avant le lancement.
const reviewCount = 267;
const reviewPlaceholder = {
  fr: "Avis client à venir — contenu de démonstration en attendant un vrai système d'avis.",
  ar: "رأي العميل قادم — محتوى تجريبي بانتظار نظام تقييمات حقيقي.",
  en: "Customer review coming soon — placeholder content pending a real reviews system.",
}[lang];
const reviews = Array.from({ length: 5 }, () => ({ author: "—", date: "", quote: reviewPlaceholder }));

/*
 * Héros scindé en deux volets (node 11101:6088). Les photos sont statiques
 * (public/home) et non éditoriales : elles fixent le ton de la page d'accueil.
 * Deux fichiers par volet, servis en srcset 1x/2x — c'est le LCP de la page,
 * on ne peut pas se contenter d'un 1800 px pour tout le monde.
 */
const heroPanels = [
  {
    title1: t("home.hero.title1"),
    title2: t("home.hero.title2"),
    text: t("home.hero.text"),
    cta: t("home.hero.cta"),
    href: localePath(lang, "/parfums"),
    img: "hero-left",
  },
  {
    title1: t("home.hero2.title1"),
    title2: t("home.hero2.title2"),
    // La maquette reprend ici, mot pour mot, la première phrase du récit de
    // marque plus bas dans la page — d'où la clé partagée.
    text: t("home.story.p1"),
    cta: t("home.story.cta"),
    href: localePath(lang, "/maison"),
    img: "hero-right",
  },
];
---

<Layout
  title={settings?.brandName ?? "Maison Reflet"}
  description={baseline}
  lang={lang}
  ogImage="/home/hero.jpg"
>
  <section class="hero full-bleed">
    {
      heroPanels.map((panel, i) => (
        <a class="hero-panel" href={panel.href}>
          {/* LCP : vraie balise img (fetchpriority) plutôt qu'un background
              CSS, que le navigateur ne peut ni prioriser ni précharger.
              Aucun `loading="lazy"` : les DEUX volets sont au-dessus de la
              ligne de flottaison sur desktop, différer le second ne ferait
              que le faire apparaître en retard. */}
          <img
            class="hero-img"
            src={`/home/${panel.img}.jpg`}
            srcset={`/home/${panel.img}.jpg 900w, /home/${panel.img}@2x.jpg 1800w`}
            sizes="(max-width: 900px) 100vw, (min-width: 1800px) 900px, 50vw"
            alt=""
            fetchpriority={i === 0 ? "high" : undefined}
            decoding="async"
          />
          <div class="hero-text">
            {i === 0 ? (
              <h1>
                {panel.title1}
                <br />
                {panel.title2}
              </h1>
            ) : (
              <h2>
                {panel.title1}
                <br />
                {panel.title2}
              </h2>
            )}
            <p>{panel.text}</p>
          </div>
          <div class="hero-cta-wrap">
            <span class="btn-square">
              {panel.cta}
              <img src="/brand/arrow-right.svg" alt="" width="12" height="12" />
            </span>
          </div>
        </a>
      ))
    }
  </section>

  {
    bestsellers.length > 0 && (
      <section class="bestsellers">
        <div class="section-head">
          <h2>{t("home.bestsellers")}</h2>
          <a class="btn-square" href={localePath(lang, "/parfums")}>
            {t("home.seeAll")}
            <img src="/brand/arrow-right.svg" alt="" width="12" height="12" />
          </a>
        </div>
        <div class="bestsellers-grid full-bleed">
          {bestsellers.map((p) => (
            <ProductCard
              name={p.name}
              inspired={p.inspired}
              inspiredByLabel={t("product.twistOf")}
              price={p.price}
              img={p.img}
              hoverImg={p.hoverImg}
              href={p.href}
              variantId={p.variantId}
              badge={p.badge}
              addLabel={t("product.addToCart")}
              addedLabel={t("cart.added")}
              errorLabel={t("product.error")}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="story">
    <div class="story-text">
      <h2>
        {t("home.story.title1")}<br />
        {t("home.story.title2")}
      </h2>
      <div class="story-copy">
        <p>{t("home.story.p1")}</p>
        <p>{t("home.story.p2")}</p>
        <p>{t("home.story.p3")}</p>
      </div>
      <a class="btn-square" href={localePath(lang, "/maison")}>
        {t("home.story.cta")}
        <img src="/brand/arrow-right.svg" alt="" width="12" height="12" />
      </a>
    </div>
    <div class="story-img">
      <img src="/home/story.jpg" alt="" loading="lazy" decoding="async" />
    </div>
  </section>

  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.titre}
        description={discovery.description}
        priceLabel={discovery.price}
        href={discovery.href}
        img={discovery.img}
        ctaLabel={t("home.hero.cta")}
      />
    )
  }

  {/* Avis : bloc de démonstration, voir le commentaire en frontmatter. */}
  <Reviews
    title={t("home.reviews.title")}
    ratingLabel={t("home.reviews.rated")}
    customersLabel={t("home.reviews.customers")}
    reviews={reviews}
    totalCount={reviewCount}
    previousLabel={t("reviews.previous")}
    nextLabel={t("reviews.next")}
  />

  <Pillars
    title1={t("home.pillars.title1")}
    title2={t("home.pillars.title2")}
    subtitle={t("home.pillars.subtitle")}
    pillars={[
      { title: t("home.pillars.quality.title"), text: t("home.pillars.quality.text"), image: "/home/pillar-quality.jpg" },
      { title: t("home.pillars.performance.title"), text: t("home.pillars.performance.text"), image: "/home/pillar-performance.jpg" },
      { title: t("home.pillars.character.title"), text: t("home.pillars.character.text"), image: "/home/pillar-character.jpg" },
    ]}
  />

  <Faq items={homePage?.faqs ?? []} title={t("nav.faq")} />

  <Reassurance items={reassurances} />
</Layout>

<style>
  /*
   * BOUTON — la maquette n'utilise QUE des rectangles sable (#e7dfd0, 48 px de
   * haut, 20 px de retrait, flèche à 12 px). Plus aucune pastille arrondie :
   * c'est le même bouton que `.dset-cta` du bandeau coffret.
   */
  .btn-square {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 20px;
    background: var(--sand);
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .btn-square:hover { opacity: 0.85; }

  /*
   * HÉROS — deux volets côte à côte (node 11101:6088), ratio de la bande
   * 1440 x 760 et 2 px de filet entre les deux, comme les autres triptyques
   * du site.
   *
   * `full-bleed` : sur grand écran les bandes d'images vont bord à bord,
   * seul le texte reste dans le container. La couture centrale du héros
   * continue de tomber sur les limites de tuiles des bestsellers, puisque
   * les deux bandes s'étirent de la même façon.
   *
   * La hauteur suit le ratio de la maquette : sur un écran de 2560 px le
   * héros fait donc ~1350 px de haut. C'est voulu — « full screen ». Les
   * photos étant en `object-fit: cover`, un `max-height` les recadrerait
   * sans les déformer si on veut plafonner un jour.
   */
  .hero {
    display: flex;
    gap: 2px;
    aspect-ratio: 1440 / 760;
  }
  .hero-panel {
    flex: 1 0 0;
    min-width: 0;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 24px;
    padding: 40px;
    background-color: #d3b69c;
    color: var(--bg);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Photos recadrées au ratio du volet et ancrées en bas : au-dessus du
       sujet il n'y a que du fond, sous ses pieds il y a le sujet. */
    object-position: bottom;
  }
  .hero-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 46%, rgba(31, 31, 31, 0.72) 87%);
  }
  .hero-text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 504px;
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, 0.56));
  }
  .hero-text h1,
  .hero-text h2 {
    margin: 0;
    font-size: clamp(24px, 2.22vw, 32px);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .hero-text p { margin: 0; font-size: 18px; line-height: 1.32; letter-spacing: -0.36px; }
  /* Le CTA n'apparaît qu'au survol (curseur dessiné dans la maquette sur le
     volet de droite) — même mécanique que la tuile produit. Le volet entier
     étant un lien, le bouton est un <span> : pas de lien imbriqué. */
  .hero-cta-wrap {
    position: relative;
    z-index: 2;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease;
  }
  .hero-panel:hover .hero-cta-wrap,
  .hero-panel:focus-visible .hero-cta-wrap { max-height: 48px; opacity: 1; }

  /* En-têtes de section (node 10573:5818 : 96 px au-dessus, 40 px en dessous) */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 96px var(--gutter-x) 40px;
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(26px, 2.22vw, 32px);
    font-weight: 500;
    text-transform: uppercase;
  }

  /* Bestsellers — la tuile porte le ratio de la maquette (358,5 x 528), donc
     la hauteur suit la largeur du container au lieu d'une valeur figée. */
  .bestsellers-grid { display: flex; gap: 2px; }
  .bestsellers-grid :global(.product-card) { aspect-ratio: 358.5 / 528; }

  /* Récit de marque (node 10582:5942) — texte à gauche, photo à droite.
     Géométrie identique au bandeau coffret juste en dessous et aux blocs
     éditoriaux de la fiche produit : les deux rangées doivent s'aligner. */
  .story {
    display: flex;
    align-items: flex-end;
    gap: 64px;
    padding: 72px var(--gutter-x) 0;
  }
  .story-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    padding-bottom: 56px;
    padding-inline-end: 56px;
    color: var(--ink);
  }
  .story-text h2 {
    margin: 0;
    font-size: clamp(26px, 2.22vw, 32px);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  /* La maquette n'a qu'un seul bloc de texte, avec une ligne vide avant le
     dernier paragraphe — d'où le gap nul et la respiration sur le seul p3. */
  .story-copy { display: flex; flex-direction: column; gap: 0; max-width: 416px; }
  .story-copy p { margin: 0; font-size: 18px; line-height: 1.36; }
  .story-copy p:last-child { margin-top: 1.36em; }
  .story-img {
    flex: 0 0 56%;
    max-width: 816px;
    aspect-ratio: 816 / 560;
    background: var(--sand);
    overflow: hidden;
  }
  .story-img img { width: 100%; height: 100%; object-fit: cover; object-position: bottom; }

  @media (max-width: 900px) {
    /* Volets empilés : le ratio de la maquette (0,95) donnerait deux blocs
       quasi carrés de 100vw, soit tout l'écran avant le premier scroll. */
    .hero { flex-direction: column; aspect-ratio: auto; }
    .hero-panel { flex: none; aspect-ratio: 4 / 5; min-height: 420px; padding: 24px; }
    .hero-text h1, .hero-text h2 { font-size: 26px; }
    .hero-text p { font-size: 16px; }
    /* Pas de survol au doigt : le CTA reste visible. */
    .hero-cta-wrap { max-height: none; opacity: 1; overflow: visible; }
    .section-head { padding: 56px var(--gutter-x) 32px; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
    .bestsellers-grid { flex-wrap: wrap; }
    .bestsellers-grid :global(.product-card) { flex: 1 1 45%; aspect-ratio: 358.5 / 528; }
    .story { flex-direction: column; align-items: stretch; gap: 24px; padding: 40px var(--gutter-x) 0; }
    .story-text { padding: 0; gap: 24px; }
    .story-text h2 { font-size: 26px; }
    .story-copy { max-width: none; }
    .story-copy p { font-size: 16px; }
    /* Pleine largeur mobile, comme le bandeau coffret. */
    .story-img { flex: none; max-width: none; aspect-ratio: 3 / 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cta-wrap { transition: none; }
  }
</style>
