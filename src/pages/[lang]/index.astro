---
import { avecAvoir } from "../../lib/coffret-avoir";
import { intlLocale } from "../../lib/markets";
import { getProductHoverSrc } from "../../lib/product-images";
import Layout from "../../layouts/Layout.astro";
import DiscoverySetBanner from "../../components/DiscoverySetBanner.astro";
import { COFFRET_HANDLE } from "../../lib/coffret";
import Faq from "../../components/Faq.astro";
import Pillars from "../../components/Pillars.astro";
import ProductCard from "../../components/ProductCard.astro";
import Reassurance from "../../components/Reassurance.astro";
import { Picture } from "astro:assets";
import heroLeft from "../../assets/home/hero-left.jpg";
import heroRight from "../../assets/home/hero-right.jpg";
import storyImage from "../../assets/home/story.jpg";
import {
  formatPrice,
  getAllProducts,
  getDisplayPrice,
  getCompareAtLabel,
  getPrimaryVariant,
  isCoffret,
  secondaryImage,
  hoverGalleryImage,
  shopifyImage,
} from "../../lib/shopify";
import {
  getSettings,
  getInspiredByMap,
  getRecoImages,
  getCoffrets,
  getReassurances,
  getBestSellerMap,
  getPageBySlug,
  responsiveImage,
  urlForImage,
  getPrevente,
} from "../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
// Montant de l'avoir du coffret : son prix pratiqué (120 en prévente), voir coffret-avoir.
const tc = await avecAvoir(t);
// Prévente ouverte (réglage Sanity) : « Précommander » partout où l'on achète.
const prevente = await getPrevente();
const addLabel = prevente.active ? t("prevente.add") : t("product.addToCart");

const settings = await getSettings(lang);
const baseline = settings?.baseline ?? "Six parfums, six reflets d'une identité franco-arabe.";

const allProducts = await getAllProducts();
const perfumes = allProducts.filter((p) => !isCoffret(p));
const inspiredMap = await getInspiredByMap();
const recoImages = await getRecoImages();
const bestSellerMap = await getBestSellerMap();

/*
 * Bestsellers — la maquette (node 10573:5817) en montre QUATRE, dont trois
 * portent la pastille « BEST SELLER ». Le classement vient du marquage
 * `bestSeller` de Sanity (le même qui alimente les pastilles du catalogue) :
 * les parfums marqués d'abord, puis les autres pour compléter la rangée. Pas
 * de vrai classement des ventes tant que Shopify Analytics n'est pas branché.
 */
const TILE_RATIO = 358.5 / 528;
const TILE_WIDTH = 900; // ~449 px de large dans le container, x2 pour les écrans denses
// Plusieurs largeurs : en mobile la carte fait une demi-largeur d'écran, le
// palier 900 y était téléchargé pour rien.
const tileImage = (source: unknown) =>
  responsiveImage(source as any, { widths: [480, 720, TILE_WIDTH], aspect: TILE_RATIO });
const TILE_SIZES = "(max-width: 900px) 50vw, 25vw";

const bestsellers = [...perfumes]
  .sort(
    (a, b) =>
      Number(Boolean(bestSellerMap[b.handle])) - Number(Boolean(bestSellerMap[a.handle]))
  )
  .slice(0, 4)
  .map((p) => {
    const recoImg = recoImages[p.handle];
    const variant = getPrimaryVariant(p);
    const price = getDisplayPrice(p);
    return {
      name: p.title,
      inspired: inspiredMap[p.handle] ?? null,
      price: formatPrice(price.amount, price.currencyCode, intlLocale(lang)),
      compare: getCompareAtLabel(p, intlLocale(lang)),
      img: recoImg?.main
        ? tileImage(recoImg.main)
        : p.featuredImage
          ? shopifyImage(p.featuredImage, [480, 720, TILE_WIDTH])
          : null,
      // Seconde photo du survol — même chaîne de repli que le catalogue : la
      // version curée dans Sanity, sinon la deuxième photo produit de Shopify
      // (hors visuels de variante échantillon, qui sont des vignettes de 192 px
      // destinées au panier).
      hoverImg: (() => {
        const local = getProductHoverSrc(p.handle, p.title);
        return local ? { src: local, srcset: "" } : null;
      })() ??
        (() => {
          const im = hoverGalleryImage(p);
          return im ? shopifyImage(im, [480, 720, TILE_WIDTH]) : null;
        })() ??
        (recoImg?.hover
        ? tileImage(recoImg.hover)
        : (() => {
            const im = secondaryImage(p);
            return im ? shopifyImage(im, [480, 720, TILE_WIDTH]) : null;
          })()),
      variantId: variant.id,
      href: localePath(lang, `/parfums/${p.handle}`),
      badge: bestSellerMap[p.handle] ? t("product.bestSeller") : null,
    };
  });

/*
 * « The Discovery Set » (node 11026:16156) remplace l'ancienne rangée de
 * cartes coffret : même bandeau que le catalogue et la fiche produit, image à
 * gauche, texte et CTA à droite. Même sélection que là-bas — le coffret dont
 * le handle évoque un set d'échantillons, sinon le premier.
 */
const coffretProducts = allProducts.filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const discoveryCandidates = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const variant = getPrimaryVariant(sp);
    return {
      handle: sp.handle,
      titre: c.titre ?? sp.title,
      description: c.description,
      img: c.image
        ? responsiveImage(c.image as any, { widths: [640, 960, 1280, 1600], aspect: 816 / 560 })
        : sp.featuredImage
          ? shopifyImage(sp.featuredImage, [640, 960, 1280, 1600])
          : null,
      price: formatPrice(variant.price.amount, variant.price.currencyCode, intlLocale(lang)),
      compare: getCompareAtLabel(sp, intlLocale(lang)),
      href: localePath(lang, `/coffrets/${sp.handle}`),
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
const discovery =
  discoveryCandidates.find((c) => /sample|discovery|decouverte|découverte/i.test(c.handle)) ??
  discoveryCandidates[0] ??
  null;

const reassurances = (await getReassurances(lang)).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));

// FAQ de la home : rattachées dans le Studio au document "Page" (slug "home"),
// comme pour "La Maison" — vide tant que rien n'y est attaché.
const homePage = await getPageBySlug("home", lang);

/*
 * Ligne d'offre du héros (audit du 31 oct. : rien sur le prix au-dessus de la
 * ligne de flottaison). Les chiffres viennent de Shopify, jamais d'ici : prix
 * pratiqué et prix normal barré des Reflets, prix du coffret découverte. Les
 * Reflets n'y figurent que s'ils partagent le même prix (sinon « 320 AED »
 * mentirait pour l'un d'eux) ; le coffret, que s'il existe.
 */
const perfumePrices = perfumes.map((p) => ({
  variantId: getPrimaryVariant(p).id,
  price: getDisplayPrice(p),
  compare: getCompareAtLabel(p, intlLocale(lang)),
}));
const samePrice =
  perfumePrices.length > 0 &&
  perfumePrices.every((p) => p.price.amount === perfumePrices[0].price.amount && p.compare === perfumePrices[0].compare);
const coffretOffer = (() => {
  const sp = coffretProducts.find((p) => p.handle === COFFRET_HANDLE);
  const titre = coffretContent.find((c) => c.shopifyHandle === COFFRET_HANDLE)?.titre;
  if (!sp || !titre) return null;
  const variant = getPrimaryVariant(sp);
  return { titre, variantId: variant.id, price: formatPrice(variant.price.amount, variant.price.currencyCode, intlLocale(lang)) };
})();
const heroOffer = {
  reflets: samePrice
    ? {
        // « Prix de lancement » seulement s'il y a un prix normal à barrer.
        label: prevente.active && perfumePrices[0].compare ? t("prevente.launchPrice") : t("menu.reflets"),
        variantId: perfumePrices[0].variantId,
        price: formatPrice(perfumePrices[0].price.amount, perfumePrices[0].price.currencyCode, intlLocale(lang)),
        compare: prevente.active ? perfumePrices[0].compare : null,
      }
    : null,
  coffret: coffretOffer,
};


/*
 * Héros scindé en deux volets (node 11101:6088). Les photos sont statiques
 * (src/assets/home) et non éditoriales : elles fixent le ton de la page
 * d'accueil. C'est le LCP de la page : Astro les sert en AVIF (WebP en repli)
 * à plusieurs largeurs, sous un nom haché donc gardé un an en cache. Le
 * palier 720 couvre un téléphone en densité 2 ; on servait un JPEG de 900 à
 * 1800 px (77 à 441 Kio).
 */
const HERO_WIDTHS = [480, 720, 960, 1280, 1800];
const heroPanels = [
  {
    title1: t("home.hero.title1"),
    title2: t("home.hero.title2"),
    text: t("home.hero.text"),
    // Pendant la prévente, on précommande : « Acheter maintenant » promettait
    // un flacon livré tout de suite.
    cta: prevente.active ? t("prevente.add") : t("home.hero.cta"),
    href: localePath(lang, "/parfums"),
    img: heroLeft,
  },
  {
    title1: t("home.hero2.title1"),
    title2: t("home.hero2.title2"),
    // La maquette reprend ici, mot pour mot, la première phrase du récit de
    // marque plus bas dans la page — d'où la clé partagée.
    text: t("home.story.p1"),
    cta: t("home.story.cta"),
    href: localePath(lang, "/maison"),
    img: heroRight,
  },
];
---

<Layout
  title={t("meta.homeTitle")}
  description={baseline}
  lang={lang}
  ogImage="/home/hero.jpg"
>
  <section class="hero full-bleed">
    {
      heroPanels.map((panel, i) => (
        <a class="hero-panel" href={panel.href}>
          {/* LCP : vraie balise img (fetchpriority) plutôt qu'un background
              CSS, que le navigateur ne peut ni prioriser ni précharger.
              Aucun `loading="lazy"` : les DEUX volets sont au-dessus de la
              ligne de flottaison sur desktop, différer le second ne ferait
              que le faire apparaître en retard. */}
          <Picture
            class="hero-img"
            src={panel.img}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={HERO_WIDTHS}
            sizes="(max-width: 900px) 100vw, (min-width: 1800px) 900px, 50vw"
            quality={70}
            alt=""
            loading="eager"
            fetchpriority={i === 0 ? "high" : undefined}
            decoding={i === 0 ? "sync" : "async"}
          />
          <div class="hero-text">
            {i === 0 ? (
              <h1>
                {panel.title1}
                <br />
                {panel.title2}
              </h1>
            ) : (
              <h2>
                {panel.title1}
                <br />
                {panel.title2}
              </h2>
            )}
            <p>{panel.text}</p>
            {i === 0 && (heroOffer.reflets || heroOffer.coffret) && (
              <p class="hero-offer">
                {heroOffer.reflets && (
                  <span class="hero-offer-item">
                    {heroOffer.reflets.label}{" "}
                    <span data-money={heroOffer.reflets.variantId}>{heroOffer.reflets.price}</span>
                    {heroOffer.reflets.compare && (
                      <>
                        {" "}
                        <s data-money-compare={heroOffer.reflets.variantId}>{heroOffer.reflets.compare}</s>
                      </>
                    )}
                  </span>
                )}
                {heroOffer.reflets && heroOffer.coffret && <span class="hero-offer-sep" aria-hidden="true">·</span>}
                {heroOffer.coffret && (
                  <span class="hero-offer-item">
                    {heroOffer.coffret.titre}{" "}
                    <span data-money={heroOffer.coffret.variantId}>{heroOffer.coffret.price}</span>
                  </span>
                )}
              </p>
            )}
          </div>
          <div class="hero-cta-wrap">
            <span class="btn-square">
              {panel.cta}
              <img src="/brand/arrow-right.svg" alt="" width="12" height="12" />
            </span>
          </div>
        </a>
      ))
    }
  </section>

  {
    bestsellers.length > 0 && (
      <section class="bestsellers">
        <div class="section-head">
          {/* Pas de « meilleures ventes » avant la première vente. */}
          <h2>{t(prevente.active ? "home.collection" : "home.bestsellers")}</h2>
          <a class="btn-square" href={localePath(lang, "/parfums")}>
            {t("home.seeAll")}
            <img src="/brand/arrow-right.svg" alt="" width="12" height="12" />
          </a>
        </div>
        <div class="bestsellers-grid full-bleed">
          {bestsellers.map((p) => (
            <ProductCard
              name={p.name}
              inspired={p.inspired}
              inspiredByLabel={t("product.twistOf")}
              price={p.price}
              compare={p.compare}
              img={p.img?.src ?? null}
              imgSrcset={p.img?.srcset || undefined}
              hoverImg={p.hoverImg?.src ?? null}
              hoverSrcset={p.hoverImg?.srcset || undefined}
              sizes={TILE_SIZES}
              href={p.href}
              variantId={p.variantId}
              badge={p.badge}
              addLabel={addLabel}
              addedLabel={t("cart.added")}
              errorLabel={t("product.error")}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="story">
    <div class="story-text">
      <h2>
        {t("home.story.title1")}<br />
        {t("home.story.title2")}
      </h2>
      {/* La première phrase du récit (home.story.p1) est déjà le texte du
          volet droit du héros : la répéter ici faisait lire deux fois le même
          paragraphe sur l'accueil (audit du 31 oct.). */}
      <div class="story-copy">
        <p>{t("home.story.p2")}</p>
        <p>{t("home.story.p3")}</p>
      </div>
      <a class="btn-square" href={localePath(lang, "/maison")}>
        {t("home.story.cta")}
        <img src="/brand/arrow-right.svg" alt="" width="12" height="12" />
      </a>
    </div>
    <div class="story-img">
      <Picture
        src={storyImage}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[480, 816, 1200, 1520]}
        sizes="(max-width: 900px) 100vw, 56vw"
        quality={70}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.titre}
        description={discovery.description}
        priceLabel={discovery.price}
        compareLabel={discovery.compare}
        href={discovery.href}
        img={discovery.img}
        ctaLabel={prevente.active ? t("prevente.add") : t("home.hero.cta")}
        creditLabel={discovery.handle === COFFRET_HANDLE ? t("coffret.creditShort") : null}
        creditNote={discovery.handle === COFFRET_HANDLE ? tc("coffret.creditNote") : null}
        tipLabel={t("product.tipOpen")}
      />
    )
  }


  <Pillars
    title1={t("home.pillars.title1")}
    title2={t("home.pillars.title2")}
    subtitle={t("home.pillars.subtitle")}
    pillars={[
      { title: t("home.pillars.quality.title"), text: t("home.pillars.quality.text"), image: "/home/pillar-quality.jpg" },
      { title: t("home.pillars.performance.title"), text: t("home.pillars.performance.text"), image: "/home/pillar-performance.jpg" },
      { title: t("home.pillars.character.title"), text: t("home.pillars.character.text"), image: "/home/pillar-character.jpg" },
    ]}
  />

  <Faq items={homePage?.faqs ?? []} title={t("nav.faq")} />

  <Reassurance items={reassurances} />
</Layout>

<style>
  /*
   * BOUTON — la maquette n'utilise QUE des rectangles sable (#e7dfd0, 48 px de
   * haut, 20 px de retrait, flèche à 12 px). Plus aucune pastille arrondie :
   * c'est le même bouton que `.dset-cta` du bandeau coffret.
   */
  .btn-square {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 20px;
    background: var(--sand);
    color: var(--ink);
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .btn-square:hover { opacity: 0.85; }

  /*
   * HÉROS — deux volets côte à côte (node 11101:6088), ratio de la bande
   * 1440 x 760 et 2 px de filet entre les deux, comme les autres triptyques
   * du site.
   *
   * `full-bleed` : sur grand écran les bandes d'images vont bord à bord,
   * seul le texte reste dans le container. La couture centrale du héros
   * continue de tomber sur les limites de tuiles des bestsellers, puisque
   * les deux bandes s'étirent de la même façon.
   *
   * La hauteur suit le ratio de la maquette : sur un écran de 2560 px le
   * héros fait donc ~1350 px de haut. C'est voulu — « full screen ». Les
   * photos étant en `object-fit: cover`, un `max-height` les recadrerait
   * sans les déformer si on veut plafonner un jour.
   */
  .hero {
    display: flex;
    gap: 2px;
    aspect-ratio: 1440 / 760;
    /* Bord à bord, le ratio de la maquette donne un héros plus haut que
       l'écran dès ~1700px de large, et l'accroche tombait sous la ligne de
       flottaison. On plafonne donc à la place réellement visible : les
       photos étant en `object-fit: cover`, ça les RECADRE au lieu de les
       déformer, et le texte reste juste au-dessus du bord. */
    max-height: var(--hero-max-h);
  }
  .hero-panel {
    flex: 1 0 0;
    min-width: 0;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 24px;
    padding: 40px;
    background-color: #d3b69c;
    color: var(--bg);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Photos recadrées au ratio du volet et ancrées en bas : au-dessus du
       sujet il n'y a que du fond, sous ses pieds il y a le sujet. */
    object-position: bottom;
  }
  .hero-panel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 46%, rgba(31, 31, 31, 0.72) 87%);
  }
  .hero-text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 504px;
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, 0.56));
  }
  .hero-text h1,
  .hero-text h2 {
    margin: 0;
    font-size: clamp(24px, 2.22vw, 32px);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .hero-text p { margin: 0; font-size: 18px; line-height: 1.32; letter-spacing: -0.36px; }
  /* Ligne d'offre : prix de lancement et coffret, sous le texte du volet gauche. */
  .hero-text .hero-offer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 8px;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0;
  }
  .hero-offer s { opacity: 0.72; font-weight: 400; }
  .hero-offer-item { white-space: nowrap; }
  /* Le CTA était réservé au survol (maquette) : en ordinateur, le héros ne
     montrait donc aucun bouton au premier regard (audit du 31 oct.). Il est
     désormais toujours visible. Le volet entier étant un lien, le bouton est
     un <span> : pas de lien imbriqué. */
  .hero-cta-wrap {
    position: relative;
    z-index: 2;
  }

  /* En-têtes de section (node 10573:5818 : 96 px au-dessus, 40 px en dessous) */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 96px var(--gutter-x) 40px;
  }
  .section-head h2 {
    margin: 0;
    font-size: clamp(26px, 2.22vw, 32px);
    font-weight: 500;
    text-transform: uppercase;
  }

  /* Bestsellers — la tuile porte le ratio de la maquette (358,5 x 528), donc
     la hauteur suit la largeur du container au lieu d'une valeur figée. */
  .bestsellers-grid { display: flex; gap: 2px; }
  .bestsellers-grid :global(.product-card) { aspect-ratio: 358.5 / 528; }

  /* Récit de marque (node 10582:5942) — texte à gauche, photo à droite.
     Géométrie identique au bandeau coffret juste en dessous et aux blocs
     éditoriaux de la fiche produit : les deux rangées doivent s'aligner. */
  .story {
    display: flex;
    align-items: flex-end;
    gap: 64px;
    padding: 72px var(--gutter-x) 0;
  }
  .story-text {
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    padding-bottom: 56px;
    padding-inline-end: 56px;
    color: var(--ink);
  }
  .story-text h2 {
    margin: 0;
    font-size: clamp(26px, 2.22vw, 32px);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }
  /* La maquette n'a qu'un seul bloc de texte, avec une ligne vide avant le
     dernier paragraphe — d'où le gap nul et la respiration sur le seul p3. */
  .story-copy { display: flex; flex-direction: column; gap: 0; max-width: 416px; }
  .story-copy p { margin: 0; font-size: 18px; line-height: 1.36; }
  .story-copy p:last-child { margin-top: 1.36em; }
  .story-img {
    flex: 0 0 56%;
    max-width: 816px;
    aspect-ratio: 816 / 560;
    background: var(--sand);
    overflow: hidden;
  }
  .story-img img { width: 100%; height: 100%; object-fit: cover; object-position: bottom; }
  /* Les <picture> d'Astro ne doivent rien changer à la mise en page : l'image
     reste l'enfant direct du volet (absolue) ou du cadre du récit. */
  .hero-panel > :global(picture),
  .story-img > :global(picture) { display: contents; }

  @media (max-width: 900px) {
    /* Volets empilés : le ratio de la maquette (0,95) donnerait deux blocs
       quasi carrés de 100vw, soit tout l'écran avant le premier scroll. */
    /* Empilés, chaque volet porte son propre ratio : un plafond global
       écraserait la colonne entière. */
    .hero { flex-direction: column; aspect-ratio: auto; max-height: none; }
    .hero-panel { flex: none; aspect-ratio: 4 / 5; min-height: 420px; padding: 24px; }
    /*
     * Volet haut (4/5), texte et bouton sur son dernier tiers : le dégradé de
     * l'ordinateur, qui ne fonçait qu'à partir de 46 %, laissait le titre sur
     * la photo claire (1,6 à 3:1 mesurés). Il part plus haut et fonce
     * davantage sous le texte.
     */
    .hero-panel::after { background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 28%, rgba(31, 31, 31, 0.6) 56%, rgba(31, 31, 31, 0.78) 100%); }
    .hero-text h1, .hero-text h2 { font-size: 26px; }
