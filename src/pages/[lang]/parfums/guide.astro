---
/**
 * « Les six Reflets, côte à côte » — la page guide (Sandro, 12 septembre 2026).
 * Éditoriale, pas un tableau à coches (code du mass market) : les six en rang
 * avec la même structure de colonne (pas les trois portes Luma : Sandro les a
 * retirées d'ici, elles restent sur /parfums), « Si vous portez… » (la grille de Luma),
 * le manifeste du twist et les six twists, les accords de layering, puis deux
 * sorties — le Coffret découverte et Luma.
 *
 * Données : Shopify (produits, prix, photos), Sanity (inspiré de, coffret),
 * lib/universes.ts, lib/guide.ts (matières, moments, twists, manifeste),
 * lib/layering.ts (duos). Les portraits audio par LumaListen.
 */
import Layout from "../../../layouts/Layout.astro";
import LumaListen from "../../../components/LumaListen.astro";
import DiscoverySetBanner from "../../../components/DiscoverySetBanner.astro";
import { formatPrice, getAllProducts, getDisplayPrice, getPrimaryVariant, isCoffret, shopifyImage } from "../../../lib/shopify";
import { getCoffrets, getInspiredByMap, responsiveImage } from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";
import { universeLabel } from "../../../lib/universes";
import { GUIDE_MANIFESTO, GUIDE_ORIGINS, GUIDE_REFLETS } from "../../../lib/guide";
import { LAYERING } from "../../../lib/layering";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const [allProducts, inspiredMap, coffretContent] = await Promise.all([getAllProducts(), getInspiredByMap(), getCoffrets(lang)]);

const reflets = allProducts
  .filter((p) => !isCoffret(p))
  .map((p) => {
    const variant = getPrimaryVariant(p);
    const price = getDisplayPrice(p);
    const guide = GUIDE_REFLETS[p.handle];
    return {
      handle: p.handle,
      name: p.title,
      href: localePath(lang, `/parfums/${p.handle}`),
      universe: universeLabel(p.handle, lang),
      inspiredBy: inspiredMap[p.handle] ?? null,
      materials: guide?.materials.map((m) => m[lang]) ?? [],
      moment: guide?.moment[lang] ?? null,
      twistLine: guide?.twistLine[lang] ?? null,
      price: formatPrice(price.amount, price.currencyCode),
      variantId: variant.id,
      img: p.featuredImage ? shopifyImage(p.featuredImage, [320, 480, 640]) : null,
    };
  });
const byHandle = Object.fromEntries(reflets.map((r) => [r.handle, r]));

// Le Coffret découverte, comme sur le catalogue.
const coffretProducts = allProducts.filter(isCoffret);
const discovery = (() => {
  const candidates = coffretContent
    .map((c) => {
      const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
      if (!sp) return null;
      const variant = getPrimaryVariant(sp);
      return {
        handle: sp.handle,
        titre: c.titre ?? sp.title,
        description: c.description,
        img: c.image
          ? responsiveImage(c.image as any, { widths: [640, 960, 1280, 1600], aspect: 816 / 560 })
          : sp.featuredImage
            ? shopifyImage(sp.featuredImage, [640, 960, 1280, 1600])
            : null,
        price: formatPrice(variant.price.amount, variant.price.currencyCode),
        href: localePath(lang, `/coffrets/${sp.handle}`),
      };
    })
    .filter((c): c is NonNullable<typeof c> => c !== null);
  return candidates.find((c) => /sample|discovery|decouverte|découverte/i.test(c.handle)) ?? candidates[0] ?? null;
})();

const duos = LAYERING.map((d) => ({
  duo: d,
  first: byHandle[d.pair[0]],
  second: byHandle[d.pair[1]],
})).filter((d) => d.first && d.second);
---

<Layout
  title={t("guide.title")}
  description={t("guide.lead")}
  lang={lang}
  breadcrumbs={[
    { label: t("nav.home"), href: localePath(lang, "/") },
    { label: t("nav.perfumes"), href: localePath(lang, "/parfums") },
    { label: t("guide.title") },
  ]}
>
  <section class="guide-hero">
    <h1>{t("guide.title")}</h1>
    <p>{t("guide.lead")}</p>
  </section>

  {/* Les six en rang : même structure de colonne, on compare d'un regard. */}
  <section class="guide-six" aria-label={t("guide.title")}>
    <div class="guide-six-row">
      {
        reflets.map((r) => (
          <article class="guide-col">
            <a class="guide-col-media" href={r.href} aria-label={r.name}>
              {r.img && <img src={r.img.src} srcset={r.img.srcset} sizes="(max-width: 900px) 70vw, 16vw" alt="" loading="lazy" decoding="async" />}
            </a>
            {r.universe && <p class="guide-kicker">{r.universe}</p>}
            <h2 class="guide-col-name"><a href={r.href}>{r.name}</a></h2>
            {r.inspiredBy && (
              <p class="guide-col-inspired">
                {t("product.inspiredBy")} {r.inspiredBy}
              </p>
            )}
            <dl class="guide-col-facts">
              <dt>{t("guide.materials")}</dt>
              <dd>{r.materials.join(" · ")}</dd>
              {r.moment && (
                <>
                  <dt>{t("guide.moment")}</dt>
                  <dd>{r.moment}</dd>
                </>
              )}
            </dl>
            <div class="guide-col-listen">
              <LumaListen lang={lang} handle={r.handle} name={r.name} />
            </div>
            <div class="guide-col-foot">
              <span class="guide-col-price" data-money={r.variantId}>{r.price}</span>
              <a class="guide-link" href={r.href}>{t("guide.discover")}</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* Si vous portez… : la grille de correspondance de Luma. */}
  <section class="guide-wearing">
    <div class="guide-section-head">
      <h2>{t("guide.wearingTitle")}</h2>
      <p>{t("guide.wearingLead")}</p>
    </div>
    <ul class="guide-wearing-list">
      {
        GUIDE_ORIGINS.map((o) => {
          const rec = byHandle[o.recommend];
          const alt = byHandle[o.alternative];
          if (!rec) return null;
          return (
            <li class="guide-wearing-row">
              <span class="guide-wearing-origin">{o.origin}</span>
              <span class="guide-wearing-reco">
                <span class="guide-kicker">{t("guide.recommend")}</span>
                <a href={rec.href}>{rec.name}</a>
                {alt && (
                  <span class="guide-wearing-alt">
                    {t("guide.or")} <a href={alt.href}>{alt.name}</a>
                  </span>
                )}
              </span>
              <span class="guide-wearing-why">{o.why[lang]}</span>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* Le twist, notre manière : le manifeste, puis les six twists. */}
  <section class="guide-twist">
    <div class="guide-twist-manifesto">
      <h2>{t("guide.twistTitle")}</h2>
      <div class="guide-twist-text">
        {GUIDE_MANIFESTO.map((par) => <p>{par[lang]}</p>)}
      </div>
    </div>
    <div class="guide-twists">
      <h3 class="guide-kicker">{t("guide.twistsTitle")}</h3>
      <ul class="guide-twists-list">
        {
          reflets.map((r) => (
            <li>
              <a class="guide-twists-name" href={r.href}>{r.name}</a>
              {r.twistLine && <p>{r.twistLine}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Les accords : les duos de layering, en cours de validation. */}
  {
    duos.length > 0 && (
      <section class="guide-layering">
        <div class="guide-section-head">
          <h2>{t("guide.layeringTitle")}</h2>
          <p>{t("guide.layeringLead")}</p>
        </div>
        <ul class="guide-duos">
          {duos.map(({ duo, first, second }) => (
            <li class="guide-duo">
              <div class="guide-duo-pair">
                <a class="guide-duo-media" href={first.href} aria-label={first.name}>
                  {first.img && <img src={first.img.src} srcset={first.img.srcset} sizes="140px" alt="" loading="lazy" decoding="async" />}
                </a>
                <a class="guide-duo-media" href={second.href} aria-label={second.name}>
                  {second.img && <img src={second.img.src} srcset={second.img.srcset} sizes="140px" alt="" loading="lazy" decoding="async" />}
                </a>
              </div>
              <div class="guide-duo-body">
                <p class="guide-kicker">
                  <span>{duo.name[lang]}</span>
                  {duo.status === "candidate" && <span class="guide-candidate">{t("layering.candidate")}</span>}
                </p>
                <h3>
                  <a href={first.href}>{first.name}</a> <span class="guide-duo-plus">+</span> <a href={second.href}>{second.name}</a>
                </h3>
                <p class="guide-duo-story">{duo.story[lang]}</p>
                <p class="guide-duo-gesture"><strong>{t("layering.gesture")}</strong> {duo.gesture[lang]}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Deux sorties : le Coffret découverte, Luma. */}
  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.titre}
        description={discovery.description}
        priceLabel={discovery.price}
        href={discovery.href}
        img={discovery.img}
        ctaLabel={t("home.hero.cta")}
      />
    )
  }

  <section class="guide-luma">
    <h2>{t("guide.lumaTitle")}</h2>
    <p>{t("guide.lumaText")}</p>
    <button type="button" class="guide-luma-cta" data-luma-open data-luma-source="guide">
      <span class="guide-luma-name">{t("luma.name")}</span>
      <span>{t("guide.lumaCta")}</span>
    </button>
  </section>
</Layout>

<style>
  .guide-hero {
    padding: 72px var(--gutter-x) 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 900px;
  }
  .guide-hero h1 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 52px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .guide-hero p { margin: 0; font-size: 18px; line-height: 1.4; letter-spacing: 0.04em; opacity: 0.8; max-width: 640px; }

  .guide-kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rose);
  }
  .guide-link {
    text-decoration: underline;
    text-decoration-color: rgba(21, 14, 10, 0.3);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease;
  }
  .guide-link:hover { text-decoration-color: currentColor; }

  /* ---- Les six en rang ---- */
  .guide-six { padding: 72px var(--gutter-x) 96px; }
  .guide-six-row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 24px;
  }
  .guide-col { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .guide-col-media { display: block; aspect-ratio: 3 / 4; background: var(--sand); overflow: hidden; margin-bottom: 8px; }
  .guide-col-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .guide-col-media:hover img { transform: scale(1.03); }
  .guide-col-name { margin: 0; font-size: 22px; font-weight: 400; line-height: 1.1; }
  .guide-col-inspired { margin: 0; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.55; }
  .guide-col-facts { margin: 6px 0 0; display: flex; flex-direction: column; gap: 4px; font-size: 13px; line-height: 1.4; }
  .guide-col-facts dt { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.5; margin-top: 8px; }
  .guide-col-facts dd { margin: 0; }
  .guide-col-listen { margin-top: 4px; }
  /* Le lecteur de la fiche est pensé pour une colonne large : ici il se resserre. */
  .guide-col-listen :global(.listen) { margin-top: 0; }
  .guide-col-listen :global(.listen-label) { font-size: 13px; }
  .guide-col-listen :global(.listen-text) { display: none; }
  .guide-col-foot { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(21, 14, 10, 0.12); font-size: 14px; }
  .guide-col-price { opacity: 0.7; }

  /* ---- Si vous portez… ---- */
  .guide-section-head { display: flex; flex-direction: column; gap: 12px; max-width: 720px; }
  .guide-section-head h2 { margin: 0; font-size: 32px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .guide-section-head p { margin: 0; font-size: 18px; line-height: 1.4; opacity: 0.8; }
  .guide-wearing { padding: 0 var(--gutter-x) 96px; display: flex; flex-direction: column; gap: 40px; }
  .guide-wearing-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(21, 14, 10, 0.12); }
  .guide-wearing-row {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(220px, 1.2fr) 2fr;
    gap: 32px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid rgba(21, 14, 10, 0.12);
  }
  .guide-wearing-origin { font-size: 22px; line-height: 1.1; }
  .guide-wearing-reco { display: flex; flex-direction: column; gap: 4px; font-size: 18px; }
  .guide-wearing-reco a { text-decoration: underline; text-decoration-color: rgba(21, 14, 10, 0.3); text-underline-offset: 4px; }
  .guide-wearing-reco a:hover { text-decoration-color: currentColor; }
  .guide-wearing-alt { font-size: 14px; opacity: 0.7; }
  .guide-wearing-why { font-size: 15px; line-height: 1.4; opacity: 0.8; }

  /* ---- Le twist ---- */
  .guide-twist {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(320px, 1.4fr);
    gap: 80px;
    padding: 96px var(--gutter-x);
    background: var(--sand);
  }
  .guide-twist-manifesto { display: flex; flex-direction: column; gap: 24px; }
  .guide-twist-manifesto h2 { margin: 0; font-size: 32px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .guide-twist-text { display: flex; flex-direction: column; gap: 16px; }
  .guide-twist-text p { margin: 0; font-size: 18px; line-height: 1.4; letter-spacing: 0.04em; }
  .guide-twists { display: flex; flex-direction: column; gap: 20px; }
  .guide-twists-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .guide-twists-list li { display: flex; flex-direction: column; gap: 6px; padding: 18px 0; border-top: 1px solid rgba(21, 14, 10, 0.14); }
  .guide-twists-list li:last-child { border-bottom: 1px solid rgba(21, 14, 10, 0.14); }
  .guide-twists-name { font-size: 20px; }
  .guide-twists-list p { margin: 0; font-size: 15px; line-height: 1.4; opacity: 0.8; }

  /* ---- Les accords ---- */
  .guide-layering { padding: 96px var(--gutter-x); display: flex; flex-direction: column; gap: 40px; }
  .guide-duos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .guide-duo { display: flex; flex-direction: column; gap: 16px; }
  .guide-duo-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; max-width: 360px; }
  .guide-duo-media { display: block; aspect-ratio: 3 / 4; background: var(--sand); overflow: hidden; }
  .guide-duo-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .guide-duo-body { display: flex; flex-direction: column; gap: 10px; }
  .guide-candidate { padding: 3px 9px 2px; border: 1px solid currentColor; border-radius: 100px; font-size: 10px; letter-spacing: 0.1em; }
  .guide-duo-body h3 { margin: 0; font-size: 22px; font-weight: 400; line-height: 1.15; }
  .guide-duo-plus { opacity: 0.5; margin: 0 4px; }
  .guide-duo-story { margin: 0; font-size: 15px; line-height: 1.4; }
  .guide-duo-gesture { margin: 0; font-size: 14px; line-height: 1.4; opacity: 0.75; }
  .guide-duo-gesture strong { font-weight: 500; }

  /* ---- Luma ---- */
  .guide-luma { padding: 96px var(--gutter-x) 120px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; }
  .guide-luma h2 { margin: 0; font-size: 32px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .guide-luma p { margin: 0; font-size: 18px; opacity: 0.8; }
  .guide-luma-cta {
    margin-top: 16px;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 28px;
    border: 1px solid var(--ink);
    border-radius: 100px;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .guide-luma-cta:hover { background: var(--ink); color: var(--bg); }
  .guide-luma-name { font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }

  @media (max-width: 1100px) {
    .guide-six-row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 24px; }
    .guide-twist { grid-template-columns: 1fr; gap: 48px; }
    .guide-duos { gap: 32px 24px; }
  }
  @media (max-width: 900px) {
    .guide-hero { padding: 40px var(--gutter-x) 24px; }
    .guide-six { padding: 40px 0 64px; }
    .guide-six-row {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter-x);
      gap: 16px;
      padding: 0 var(--gutter-x);
      scrollbar-width: none;
    }
    .guide-six-row::-webkit-scrollbar { display: none; }
    .guide-col { flex: 0 0 70vw; scroll-snap-align: start; }
    .guide-wearing { padding-bottom: 64px; gap: 24px; }
    .guide-section-head h2 { font-size: 26px; }
    .guide-wearing-row { grid-template-columns: 1fr; gap: 8px; padding: 18px 0; }
    .guide-wearing-origin { font-size: 20px; }
    .guide-twist { padding: 64px var(--gutter-x); }
    .guide-twist-manifesto h2 { font-size: 26px; }
    .guide-layering { padding: 64px var(--gutter-x); gap: 24px; }
    .guide-duos { grid-template-columns: 1fr; }
    .guide-luma { padding: 64px var(--gutter-x) 80px; }
    .guide-luma h2 { font-size: 26px; }
  }
</style>
