---
/**
 * « Les six Reflets, côte à côte » — la page guide (Sandro, 12 septembre 2026).
 * Éditoriale, pas un tableau à coches (code du mass market) : les six en rang
 * avec la même structure de colonne (pas les trois portes Luma : Sandro les a
 * retirées d'ici, elles restent sur /parfums), « Si vous portez… » (la grille de Luma),
 * le manifeste du twist et les six twists, les accords de layering, puis deux
 * sorties — le Coffret découverte et Luma.
 *
 * Données : Shopify (produits, prix, photos), Sanity (inspiré de, coffret),
 * lib/universes.ts, lib/guide.ts (matières, moments, twists, manifeste),
 * lib/layering.ts (duos). Les portraits audio par LumaListen.
 */
import Layout from "../../../layouts/Layout.astro";
import LumaListen from "../../../components/LumaListen.astro";
import DiscoverySetBanner from "../../../components/DiscoverySetBanner.astro";
import { formatPrice, getAllProducts, getDisplayPrice, getPrimaryVariant, isCoffret, shopifyImage } from "../../../lib/shopify";
import { getCoffrets, getInspiredByMap, getParfumContent, responsiveImage } from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";
import { REFLET_UNIVERSE, UNIVERSE_LABELS, universeLabel, type UniverseKey } from "../../../lib/universes";
import { GUIDE_MANIFESTO, GUIDE_ORIGINS, GUIDE_REFLETS } from "../../../lib/guide";
import { LAYERING, accordAudioPath, stripVoiceTags } from "../../../lib/layering";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const [allProducts, inspiredMap, coffretContent] = await Promise.all([getAllProducts(), getInspiredByMap(), getCoffrets(lang)]);

/*
 * Les filtres du guide agissent sur les six sans requête : le moment et
 * l'univers viennent de lib/guide.ts et lib/universes.ts ; les matières sont
 * les huit des portes de Luma, retrouvées dans les pyramides Sanity (noms FR,
 * quelle que soit la langue de la page) et dans les matières signature.
 */
const MATERIALS = ["vanilla", "oud", "leather", "mango", "saffron", "musk", "rose", "praline"] as const;
type MaterialKey = (typeof MATERIALS)[number];
const MATERIAL_MATCH: Record<MaterialKey, RegExp> = {
  vanilla: /vanill/i,
  oud: /\boud\b|agar/i,
  leather: /cuir|daim|leather/i,
  mango: /mangue|mango/i,
  saffron: /safran|saffron/i,
  musk: /musc|musk/i,
  rose: /(?<!bois de )rose/i,
  praline: /pralin/i,
};

const perfumeProducts = allProducts.filter((p) => !isCoffret(p));
const pyramids = await Promise.all(perfumeProducts.map((p) => getParfumContent(p.handle, "fr")));

const reflets = perfumeProducts.map((p, i) => {
  const variant = getPrimaryVariant(p);
  const price = getDisplayPrice(p);
  const guide = GUIDE_REFLETS[p.handle];
  const notes = pyramids[i]?.notes;
  const noteNames = [...(notes?.tete ?? []), ...(notes?.coeur ?? []), ...(notes?.fond ?? [])].map((n) => n.nom ?? "");
  const haystack = [...noteNames, ...(guide?.materials.map((m) => m.fr) ?? [])].join(" · ");
  return {
    handle: p.handle,
    name: p.title,
    href: localePath(lang, `/parfums/${p.handle}`),
    universe: universeLabel(p.handle, lang),
    universeKey: REFLET_UNIVERSE[p.handle] ?? null,
    inspiredBy: inspiredMap[p.handle] ?? null,
    materials: guide?.materials.map((m) => m[lang]) ?? [],
    materialKeys: MATERIALS.filter((m) => MATERIAL_MATCH[m].test(haystack)),
    moment: guide?.moment[lang] ?? null,
    when: guide?.when ?? [],
    twistLine: guide?.twistLine[lang] ?? null,
    twistShort: guide?.twistShort[lang] ?? null,
    price: formatPrice(price.amount, price.currencyCode),
    variantId: variant.id,
    img: p.featuredImage ? shopifyImage(p.featuredImage, [320, 480, 640]) : null,
  };
});
const universeChips = (Object.keys(UNIVERSE_LABELS) as UniverseKey[])
  .filter((k) => reflets.some((r) => r.universeKey === k))
  .map((k) => ({ key: k, label: UNIVERSE_LABELS[k][lang] }));
const materialChips = MATERIALS.filter((m) => reflets.some((r) => r.materialKeys.includes(m))).map((m) => ({ key: m, label: t(`luma.doors.m.${m}`) }));
const byHandle = Object.fromEntries(reflets.map((r) => [r.handle, r]));

// Le Coffret découverte, comme sur le catalogue.
const coffretProducts = allProducts.filter(isCoffret);
const discovery = (() => {
  const candidates = coffretContent
    .map((c) => {
      const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
      if (!sp) return null;
      const variant = getPrimaryVariant(sp);
      return {
        handle: sp.handle,
        titre: c.titre ?? sp.title,
        description: c.description,
        img: c.image
          ? responsiveImage(c.image as any, { widths: [640, 960, 1280, 1600], aspect: 816 / 560 })
          : sp.featuredImage
            ? shopifyImage(sp.featuredImage, [640, 960, 1280, 1600])
            : null,
        price: formatPrice(variant.price.amount, variant.price.currencyCode),
        href: localePath(lang, `/coffrets/${sp.handle}`),
      };
    })
    .filter((c): c is NonNullable<typeof c> => c !== null);
  return candidates.find((c) => /sample|discovery|decouverte|découverte/i.test(c.handle)) ?? candidates[0] ?? null;
})();

const duos = LAYERING.map((d) => ({
  duo: d,
  first: byHandle[d.pair[0]],
  second: byHandle[d.pair[1]],
})).filter((d) => d.first && d.second);
---

<Layout
  title={t("guide.title")}
  description={t("guide.lead")}
  lang={lang}
  breadcrumbs={[
    { label: t("nav.home"), href: localePath(lang, "/") },
    { label: t("nav.perfumes"), href: localePath(lang, "/parfums") },
    { label: t("guide.title") },
  ]}
>
  <section class="guide-hero">
    <h1>{t("guide.title")}</h1>
    <p>{t("guide.lead")}</p>
  </section>

  {/*
    Les six en rang (refonte UX du 12 sept., validée par Sandro) : des filtres
    qui estompent les colonnes qui ne correspondent pas, les étiquettes une
    seule fois à gauche (les colonnes partagent leurs rangées : subgrid), le
    twist dans la colonne, et la colonne entière cliquable au survol.
  */}
  <section class="guide-six" aria-label={t("guide.title")} data-guide-six>
    <div class="guide-filters">
      <div class="guide-filter-group">
        <span class="guide-filter-label">{t("guide.filterWhen")}</span>
        <div class="guide-chips">
          <button type="button" class="guide-chip" data-filter="when" data-value="day" aria-pressed="false">{t("guide.day")}</button>
          <button type="button" class="guide-chip" data-filter="when" data-value="evening" aria-pressed="false">{t("guide.evening")}</button>
        </div>
      </div>
      <div class="guide-filter-group">
        <span class="guide-filter-label">{t("guide.filterUniverse")}</span>
        <div class="guide-chips">
          {universeChips.map((c) => <button type="button" class="guide-chip" data-filter="universe" data-value={c.key} aria-pressed="false">{c.label}</button>)}
        </div>
      </div>
      {
        materialChips.length > 0 && (
          <div class="guide-filter-group">
            <span class="guide-filter-label">{t("guide.filterMaterial")}</span>
            <div class="guide-chips">
              {materialChips.map((c) => <button type="button" class="guide-chip" data-filter="materials" data-value={c.key} aria-pressed="false">{c.label}</button>)}
            </div>
          </div>
        )
      }
      <p class="guide-filter-status" data-guide-status data-one={t("guide.countOne")} data-many={t("guide.countMany")} hidden>
        <span data-guide-count></span>
        <button type="button" class="guide-filter-reset" data-guide-reset>{t("guide.all")}</button>
      </p>
    </div>

    <div class="guide-six-row" data-guide-row>
      <div class="guide-labels" aria-hidden="true">
        <span class="guide-label guide-label-materials">{t("guide.materials")}</span>
        <span class="guide-label guide-label-moment">{t("guide.moment")}</span>
        <span class="guide-label guide-label-twist">{t("guide.twistLabel")}</span>
      </div>
      {
        reflets.map((r) => (
          <article
            class="guide-col"
            data-guide-col
            data-href={r.href}
            data-when={r.when.join(" ")}
            data-universe={r.universeKey ?? ""}
            data-materials={r.materialKeys.join(" ")}
          >
            <a class="guide-col-media" href={r.href} aria-label={r.name} tabindex="-1">
              {r.img && <img src={r.img.src} srcset={r.img.srcset} sizes="(max-width: 1100px) 70vw, 15vw" alt="" loading="lazy" decoding="async" />}
            </a>
            <div class="guide-col-head">
              {r.universe && <p class="guide-kicker">{r.universe}</p>}
              <h2 class="guide-col-name"><a href={r.href}>{r.name}</a></h2>
              {r.inspiredBy && (
                <p class="guide-col-inspired">
                  {t("product.inspiredBy")} {r.inspiredBy}
                </p>
              )}
            </div>
            <div class="guide-col-fact">
              <span class="guide-col-dt">{t("guide.materials")}</span>
              <p>{r.materials.join(" · ")}</p>
            </div>
            <div class="guide-col-fact">
              <span class="guide-col-dt">{t("guide.moment")}</span>
              <p>{r.moment}</p>
            </div>
            <div class="guide-col-fact guide-col-twist">
              <span class="guide-col-dt">{t("guide.twistLabel")}</span>
              <p>{r.twistShort}</p>
            </div>
            <div class="guide-col-listen">
              <LumaListen lang={lang} handle={r.handle} name={r.name} />
            </div>
            <div class="guide-col-foot">
              <span class="guide-col-price" data-money={r.variantId}>{r.price}</span>
              <a class="guide-link" href={r.href}>{t("guide.discover")}</a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="guide-none" data-guide-none hidden>
      {t("guide.noMatch")}
      <button type="button" class="guide-none-cta" data-luma-open data-luma-source="guide">{t("guide.noMatchCta")}</button>
    </p>
  </section>

  <script>
    /*
     * Filtres : une valeur active par groupe, les groupes se cumulent. Une
     * colonne qui ne correspond pas s'estompe (et disparaît en cartes, pour
     * raccourcir le défilement). La colonne entière mène à la fiche, sauf
     * quand on clique un bouton ou un lien qu'elle contient.
     */
    const six = document.querySelector<HTMLElement>("[data-guide-six]");
    if (six) {
      const cols = Array.from(six.querySelectorAll<HTMLElement>("[data-guide-col]"));
      const chips = Array.from(six.querySelectorAll<HTMLButtonElement>("[data-filter]"));
      const row = six.querySelector<HTMLElement>("[data-guide-row]");
      const status = six.querySelector<HTMLElement>("[data-guide-status]");
      const count = six.querySelector<HTMLElement>("[data-guide-count]");
      const none = six.querySelector<HTMLElement>("[data-guide-none]");
      const active: Record<string, string | null> = { when: null, universe: null, materials: null };

      const apply = () => {
        let shown = 0;
        for (const col of cols) {
          const ok = Object.entries(active).every(([k, v]) => !v || (col.dataset[k] ?? "").split(" ").includes(v));
          col.classList.toggle("is-dim", !ok);
          if (ok) shown++;
        }
        const any = Object.values(active).some(Boolean);
        for (const chip of chips) chip.setAttribute("aria-pressed", String(active[chip.dataset.filter ?? ""] === chip.dataset.value));
        if (status && count) {
          status.hidden = !any;
          const tpl = (shown === 1 ? status.dataset.one : status.dataset.many) ?? "";
          count.textContent = tpl.replace("{n}", String(shown));
        }
        if (none) none.hidden = !(any && shown === 0);
        if (any) row?.scrollTo({ left: 0, behavior: "smooth" });
      };
      for (const chip of chips) {
        chip.addEventListener("click", () => {
          const k = chip.dataset.filter ?? "";
          const v = chip.dataset.value ?? "";
          active[k] = active[k] === v ? null : v;
          apply();
        });
      }
      six.querySelector<HTMLButtonElement>("[data-guide-reset]")?.addEventListener("click", () => {
        for (const k of Object.keys(active)) active[k] = null;
        apply();
      });
      for (const col of cols) {
        col.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).closest("a, button")) return;
          const href = col.dataset.href;
          if (href) window.location.href = href;
        });
      }
    }
  </script>

  {/* Si vous portez… : la grille de correspondance de Luma. */}
  <section class="guide-wearing">
    <div class="guide-section-head">
      <h2>{t("guide.wearingTitle")}</h2>
      <p>{t("guide.wearingLead")}</p>
    </div>
    <ul class="guide-wearing-list">
      {
        GUIDE_ORIGINS.map((o) => {
          const rec = byHandle[o.recommend];
          const alt = byHandle[o.alternative];
          if (!rec) return null;
          return (
            <li class="guide-wearing-row">
              <span class="guide-wearing-origin">{o.origin}</span>
              <span class="guide-wearing-reco">
                <span class="guide-kicker">{t("guide.recommend")}</span>
                <a href={rec.href}>{rec.name}</a>
                {alt && (
                  <span class="guide-wearing-alt">
                    {t("guide.or")} <a href={alt.href}>{alt.name}</a>
                  </span>
                )}
              </span>
              <span class="guide-wearing-why">{o.why[lang]}</span>
            </li>
          );
        })
      }
    </ul>
  </section>

  {/* Le twist, notre manière : le manifeste, puis les six twists. */}
  <section class="guide-twist">
    <div class="guide-twist-manifesto">
      <h2>{t("guide.twistTitle")}</h2>
      <div class="guide-twist-text">
        {GUIDE_MANIFESTO.map((par) => <p>{par[lang]}</p>)}
      </div>
    </div>
    <div class="guide-twists">
      <h3 class="guide-kicker">{t("guide.twistsTitle")}</h3>
      <ul class="guide-twists-list">
        {
          reflets.map((r) => (
            <li>
              <a class="guide-twists-name" href={r.href}>{r.name}</a>
              {r.twistLine && <p>{r.twistLine}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Les accords : les duos de layering, en cours de validation. */}
  {
    duos.length > 0 && (
      <section class="guide-layering">
        <div class="guide-section-head">
          <h2>{t("guide.layeringTitle")}</h2>
          <p>{t("guide.layeringLead")}</p>
        </div>
        <ul class="guide-duos">
          {duos.map(({ duo, first, second }) => (
            <li class="guide-duo">
              <div class="guide-duo-pair">
                <a class="guide-duo-media" href={first.href} aria-label={first.name}>
                  {first.img && <img src={first.img.src} srcset={first.img.srcset} sizes="140px" alt="" loading="lazy" decoding="async" />}
                </a>
                <a class="guide-duo-media" href={second.href} aria-label={second.name}>
                  {second.img && <img src={second.img.src} srcset={second.img.srcset} sizes="140px" alt="" loading="lazy" decoding="async" />}
                </a>
              </div>
              <div class="guide-duo-body">
                <p class="guide-kicker">
                  <span>{duo.name[lang]}</span>
                  {duo.status === "candidate" && <span class="guide-candidate">{t("layering.candidate")}</span>}
                </p>
                <h3>
                  <a href={first.href}>{first.name}</a> <span class="guide-duo-plus">+</span> <a href={second.href}>{second.name}</a>
                </h3>
                <p class="guide-duo-story">{duo.story[lang]}</p>
                <p class="guide-duo-gesture"><strong>{t("layering.gesture")}</strong> {duo.gesture[lang]}</p>
                <LumaListen
                  lang={lang}
                  src={accordAudioPath(lang, duo.id)}
                  text={stripVoiceTags(duo.recommendation[lang])}
                  label={t("layering.recommendation")}
                  moreLabel={t("layering.readRecommendation")}
                />
                {/* Les six Reflets sont au même prix : « 2 × » sur la variante du premier suffit, data-money le convertit. */}
                <div class="guide-duo-actions">
                  <button
                    type="button"
                    class="guide-duo-add"
                    data-layering-add
                    data-variants={`${first.variantId},${second.variantId}`}
                    data-added-label={t("cart.added")}
                    data-error-label={t("product.error")}
                  >
                    <span data-layering-label>{t("layering.addBoth")}</span>
                  </button>
                  <span class="guide-duo-price">2 × <span data-money={first.variantId}>{first.price}</span></span>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* Deux sorties : le Coffret découverte, Luma. */}
  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.titre}
        description={discovery.description}
        priceLabel={discovery.price}
        href={discovery.href}
        img={discovery.img}
        ctaLabel={t("home.hero.cta")}
      />
    )
  }

  <script>
    import { bindLayeringAdds } from "../../../lib/layering-client";
    bindLayeringAdds();
  </script>

  <section class="guide-luma">
    <h2>{t("guide.lumaTitle")}</h2>
    <p>{t("guide.lumaText")}</p>
    <button type="button" class="guide-luma-cta" data-luma-open data-luma-source="guide">
      <span class="guide-luma-name">{t("luma.name")}</span>
      <span>{t("guide.lumaCta")}</span>
    </button>
  </section>
</Layout>

<style>
  .guide-hero {
    padding: 72px var(--gutter-x) 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 900px;
  }
  .guide-hero h1 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 52px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .guide-hero p { margin: 0; font-size: 18px; line-height: 1.4; letter-spacing: 0.04em; opacity: 0.8; max-width: 640px; }

  .guide-kicker {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rose);
  }
  .guide-link {
    text-decoration: underline;
    text-decoration-color: rgba(21, 14, 10, 0.3);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s ease;
  }
  .guide-link:hover { text-decoration-color: currentColor; }

  /* ---- Les six en rang ---- */
  .guide-six { padding: 72px var(--gutter-x) 96px; display: flex; flex-direction: column; gap: 40px; }

  /* Les filtres : trois groupes, des pastilles ; l'active passe en encre. */
  .guide-filters { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 20px 40px; }
  .guide-filter-group { display: flex; flex-direction: column; gap: 10px; }
  .guide-filter-label { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.5; }
  .guide-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .guide-chip {
    padding: 8px 14px;
    border: 1px solid rgba(21, 14, 10, 0.28);
    border-radius: 100px;
    background: none;
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }
  .guide-chip:hover { border-color: var(--ink); }
  .guide-chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .guide-chip:focus-visible { outline: 1px solid var(--ink); outline-offset: 3px; }
  .guide-filter-status { margin: 0; flex-basis: 100%; display: flex; align-items: baseline; gap: 12px; font-size: 13px; opacity: 0.8; }
  .guide-filter-status[hidden] { display: none; }
  .guide-filter-reset {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(21, 14, 10, 0.3);
    cursor: pointer;
  }
  .guide-filter-reset:hover { text-decoration-color: currentColor; }

  /* La rangée : une colonne d'étiquettes puis les six, qui partagent leurs rangées (subgrid). */
  .guide-six-row {
    display: grid;
    grid-template-columns: 92px repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(7, auto);
    column-gap: 20px;
    row-gap: 12px;
    align-items: start;
    isolation: isolate;
  }
  .guide-labels { display: grid; grid-template-rows: subgrid; grid-row: 1 / span 7; grid-column: 1; }
  .guide-label { font-size: 10px; line-height: 1.4; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.5; padding-top: 2px; }
  .guide-label-materials { grid-row: 3; }
  .guide-label-moment { grid-row: 4; }
  .guide-label-twist { grid-row: 5; }
  .guide-col {
    position: relative;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / span 7;
    min-width: 0;
    cursor: pointer;
    transition: opacity 0.35s ease;
  }
  /* Le survol : le rectangle blanc du menu, derrière toute la colonne. */
  .guide-col::before {
    content: "";
    position: absolute;
    inset: -12px -10px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.55);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }
  .guide-col:hover::before { opacity: 1; }
  .guide-col.is-dim { opacity: 0.28; }
  .guide-col.is-dim::before { display: none; }
  .guide-col-media { display: block; aspect-ratio: 3 / 4; background: var(--sand); overflow: hidden; }
  .guide-col-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .guide-col:hover .guide-col-media img { transform: scale(1.03); }
  .guide-col-head { display: flex; flex-direction: column; gap: 6px; padding-top: 4px; }
  .guide-col-name { margin: 0; font-size: 22px; font-weight: 400; line-height: 1.1; }
  .guide-col-name a { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color 0.25s ease; }
  .guide-col:hover .guide-col-name a { text-decoration-color: rgba(21, 14, 10, 0.4); }
  .guide-col-inspired { margin: 0; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.55; }
  .guide-col-fact p { margin: 0; font-size: 13px; line-height: 1.4; }
  /* twistShort est écrit pour suivre « Notre twist : » ; sous son étiquette, il prend une majuscule. */
  .guide-col-twist p { opacity: 0.85; }
