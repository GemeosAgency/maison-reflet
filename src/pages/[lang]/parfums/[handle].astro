---
/**
 * Fiche produit v2 (refonte design août 2026) — assemblage de sections :
 * galerie + panneau sticky, Scent Notes, Specific Twist, Perfumer's word,
 * réassurance, avis (placeholder), You may also like, piliers, Discovery Set,
 * FAQ. Commerce (prix/variantes/panier) = Shopify ; éditorial = Sanity,
 * chaque section se masque si son contenu n'est pas rempli dans le Studio.
 */
import Layout from "../../../layouts/Layout.astro";
import Faq from "../../../components/Faq.astro";
import Pillars from "../../../components/Pillars.astro";
import Reassurance from "../../../components/Reassurance.astro";
import RelatedProducts from "../../../components/RelatedProducts.astro";
import DiscoverySetBanner from "../../../components/DiscoverySetBanner.astro";
import ProductGallery from "../../../components/product/ProductGallery.astro";
import ProductInfoPanel from "../../../components/product/ProductInfoPanel.astro";
import ScentNotes from "../../../components/product/ScentNotes.astro";
import TwistSection from "../../../components/product/TwistSection.astro";
import PerfumerWord from "../../../components/product/PerfumerWord.astro";
import {
  formatPrice,
  getAllProducts,
  getPrimaryVariant,
  getDisplayPrice,
  isCoffret,
  isSampleVariantTitle,
  shopifyImage,
  type ShopifyProduct,
} from "../../../lib/shopify";
import {
  getParfumContent,
  getInspiredByMap,
  getRecoImages,
  getBestSellerMap,
  getCoffrets,
  richTextToHtml,
  responsiveImage,
  urlForImage,
} from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export async function getStaticPaths() {
  // Un coffret n'est pas un parfum classique : il a sa propre page.
  const products = (await getAllProducts()).filter((p) => !isCoffret(p));
  return locales.flatMap((lang) =>
    products.map((product) => ({ params: { lang, handle: product.handle }, props: { product, products } }))
  );
}

interface Props {
  product: ShopifyProduct;
  products: ShopifyProduct[];
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { product, products } = Astro.props;

const parfum = await getParfumContent(product.handle, lang);
const variant = getPrimaryVariant(product);
const priceLabel = formatPrice(variant.price.amount, variant.price.currencyCode);

const inspiredMap = await getInspiredByMap();
const recoImages = await getRecoImages();
const bestSellerMap = await getBestSellerMap();

// Galerie : la photo produit Shopify d'abord — c'est le rendu du flacon, la
// référence commerciale, celle qu'on remplace quand le packaging change — puis
// les images éditoriales Sanity en complément, puis les visuels de secours.
//
// Les deux sources sont CONCATÉNÉES. Avant, un `editorialImgs.length ? … : …`
// faisait qu'une seule image éditoriale dans Sanity masquait toutes les photos
// Shopify : on a renommé les 6 parfums et poussé de nouveaux rendus sans qu'ils
// apparaissent jamais sur la fiche.
//
// Largeurs de la galerie : la colonne fait 50vw en desktop (720px à 1440,
// jusqu'à ~900px sur un très grand écran) et 100vw en mobile — il faut donc
// monter jusqu'au double pour rester net en densité 2x.
const GALLERY_WIDTHS = [480, 720, 960, 1440, 1800];
// Tuiles « You may also like » et recommandations : 287 px de large dans la
// maquette, donc 640 suffit en densité 2x, 860 pour les très grands écrans.
const TILE_WIDTHS = [320, 480, 640, 860];
const editorialImgs = (parfum?.images ?? []).map((im) => ({
  ...responsiveImage(im as any, { widths: GALLERY_WIDTHS, aspect: 720 / 896 }),
  alt: im.alt ?? product.title,
}));
// Les variantes échantillon ont leur propre visuel (une vignette de 192 px, vue
// dans le panier) : dans la galerie de la fiche il serait étiré et illisible.
const sampleImageUrls = new Set(
  product.variants.nodes
    .filter((v) => isSampleVariantTitle(v.title))
    .map((v) => v.image?.url)
    .filter((u): u is string => Boolean(u))
);
// featuredImage figure aussi dans images.nodes, d'où le dédoublonnage par URL.
// shopifyImage() ajoute le paramètre `width` du CDN : sans lui on servait le
// fichier d'origine, jusqu'à 7,4 Mo pour un rendu de flacon en 2346x2884.
const shopifyImgs = [product.featuredImage, ...product.images.nodes]
  .filter((im) => im && !sampleImageUrls.has(im.url))
  .filter((im, i, arr) => arr.findIndex((x) => x!.url === im!.url) === i)
  .map((im) => ({
    ...shopifyImage(im!, GALLERY_WIDTHS),
    alt: im!.altText ?? product.title,
  }));
const placeholderImgs = ["/brand/gallery1.jpg", "/brand/gallery2.jpg", "/brand/gallery3.jpg"].map((src) => ({
  src,
  srcset: "",
  alt: product.title,
}));
const galleryImgs = [...shopifyImgs, ...editorialImgs];
const gallery = galleryImgs.length ? galleryImgs : placeholderImgs;

// ---------- Tracking ----------
// "Viewed Product" Klaviyo : propriétés au format standard (flows browse
// abandonment, blocs "vus récemment"). Pages pré-générées au build (SSG) :
// Astro.url.href y vaudrait localhost, d'où PUBLIC_SITE_URL par environnement.
const siteOrigin = import.meta.env.PUBLIC_SITE_URL;
const productUrl = siteOrigin ? `${siteOrigin}${Astro.url.pathname}` : Astro.url.href;

const familles = parfum?.familles ?? parfum?.familleOlfactive ?? null;

const viewedProduct = {
  ProductName: product.title,
  ProductID: product.id,
  SKU: variant.sku ?? null,
  Categories: familles ? [familles] : [],
  ImageURL: gallery[0]?.src ?? null,
  URL: productUrl,
  Brand: "Maison Reflet",
  Price: Number(variant.price.amount),
};

// "ViewContent" Meta + "view_item" GA4 — id de variante numérique, cohérent
// avec AddToCart/InitiateCheckout/Purchase pour le matching catalogue.
const metaViewContentData = {
  variantGid: variant.id,
  name: product.title,
  value: Number(variant.price.amount),
  currency: variant.price.currencyCode,
};

// ---------- Contenu du panneau ----------
const descriptionHtml =
  richTextToHtml(parfum?.description) ||
  (parfum?.accroche ? `<p>${parfum.accroche}</p>` : (product.descriptionHtml ?? ""));

const pyramidImg = parfum?.imagePyramide ? urlForImage(parfum.imagePyramide as any).width(700).url() : null;

// Jauges 1–5 → libellé (léger / modéré / fort), différencié par jauge pour
// accorder le français (intensité au féminin, sillage au masculin).
const gaugeLabel = (value: number | null, low: string, mid: string, high: string): string | null => {
  if (value == null) return null;
  return value <= 2 ? low : value === 3 ? mid : high;
};
const intensite = parfum?.intensite ?? null;
const sillage = parfum?.sillage ?? null;

// Contenance affichée à côté du titre (variante principale Shopify).
const sizeLabel = variant.title !== "Default Title" ? variant.title : null;

// Avantages sous le CTA (fixes, i18n — icônes locales).
const perks = [
  { icon: "/brand/gift.svg", label: t("product.perkSample") },
  { icon: "/brand/shipment.svg", label: t("product.perkDelivery") },
  { icon: "/brand/love.svg", label: t("product.perkTreat") },
];

// Note / avis : placeholders (pas encore de système d'avis branché).
const rating = "4,9";
const panelReviewCount = 147;
const reviewCount = 267;
const reviewPlaceholder = {
  fr: "Avis client à venir — contenu de démonstration en attendant un vrai système d'avis.",
  ar: "رأي العميل قادم — محتوى تجريبي بانتظار نظام تقييمات حقيقي.",
  en: "Customer review coming soon — placeholder content pending a real reviews system.",
}[lang];
const reviews = Array.from({ length: 5 }, () => ({ author: "—", date: "", quote: reviewPlaceholder }));

// ---------- Sections éditoriales ----------
const specificTwist = parfum?.specificTwist ?? null;
// Image panoramique quasi pleine largeur : jusqu'à 2x sur un écran large.
const twistImg = parfum?.imageTwist
  ? responsiveImage(parfum.imageTwist as any, {
      widths: [768, 1280, 1800, 2400, 3000],
      aspect: 1296 / 560,
    })
  : (editorialImgs[1] ?? editorialImgs[0] ?? null);

const perfumerWord = parfum?.perfumerWord ?? null;
const perfumerPhoto = parfum?.perfumerPhoto
  ? responsiveImage(parfum.perfumerPhoto as any, {
      widths: [640, 960, 1280, 1600],
      aspect: 816 / 560,
    })
  : null;

/*
 * Une colonne de la section « Scent Notes ».
 *
 * La photo vient de la BIBLIOTHÈQUE de matières (champ Image du document
 * "note"), pas de la fiche parfum — une matière est photographiée une fois et
 * réutilisée partout.
 *
 * `keyIndex` est l'index, DANS LA LISTE AFFICHÉE, de la note dont la photo est
 * montrée : c'est elle qui passe en gras. Toutes les matières n'ont pas encore
 * de photo, et mettre en gras la première note de la liste affichait du
 * caramel sous un « Jasmin Sambac » en gras. L'index est calculé après le
 * filtrage des notes sans nom, sinon il ne correspondrait plus à l'affichage.
 *
 * Largeurs : la colonne fait un tiers du container (--page-max, 1800px), donc
 * 600px au maximum, soit 1200 en densité 2x. responsiveImage() plafonne à la
 * largeur native de chaque photo et l'ajoute comme dernier palier, donc rien
 * à ajuster ici quand une matière est réexportée plus grande.
 */
const scentLevel = (label: string, notes: { nom: string | null; image?: unknown }[] | undefined) => {
  const named = (notes ?? []).filter((n) => n.nom);
  const keyIndex = named.findIndex((n) => n.image);
  const key = keyIndex >= 0 ? named[keyIndex] : null;
  return {
    label,
    notes: named.map((n) => n.nom as string),
    keyIndex,
    img: key ? responsiveImage(key.image as any, { widths: [320, 480, 640, 960, 1200] }) : null,
  };
};

const scentLevels = [
  scentLevel(t("product.notes.tete"), parfum?.notes.tete),
  scentLevel(t("product.notes.coeur"), parfum?.notes.coeur),
  scentLevel(t("product.notes.fond"), parfum?.notes.fond),
];

// Bandeau de réassurance : sélection/ordre gérés dans Sanity.
const reassurances = (parfum?.reassurances ?? []).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));

// "You may also like" : les autres parfums de la collection (5 max, design).
const related = products
  .filter((p) => p.handle !== product.handle)
  .slice(0, 5)
  .map((p) => {
    const recoImg = recoImages[p.handle];
    const price = getDisplayPrice(p);
    return {
      name: p.title,
      subtitle: inspiredMap[p.handle] ? `${t("product.twistOf")} ${inspiredMap[p.handle]}` : null,
      price: formatPrice(price.amount, price.currencyCode),
      // Sans imageRecommandation dans Sanity on retombe sur la photo produit
      // Shopify — c'est le bon rendu du flacon, avec la bonne étiquette. Il
      // faut la passer par shopifyImage() : servie brute, elle pèse jusqu'à
      // 7,4 Mo pour une tuile de 287 px.
      img: recoImg?.main
        ? responsiveImage(recoImg.main as any, { widths: TILE_WIDTHS, aspect: 287 / 352 })
        : p.featuredImage
          ? shopifyImage(p.featuredImage, TILE_WIDTHS)
          : null,
      href: localePath(lang, `/parfums/${p.handle}`),
      badge: bestSellerMap[p.handle] ? t("product.bestSeller") : null,
    };
  });

// "The Discovery Set" : coffret découverte (Sanity + Shopify). On cible le
// coffret dont le handle évoque un set d'échantillons, sinon le premier.
const coffretProducts = (await getAllProducts()).filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const discoveryCandidates = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const v = getPrimaryVariant(sp);
    return {
      handle: sp.handle,
      titre: c.titre ?? sp.title,
      description: c.description,
      img: c.image
        ? responsiveImage(c.image as any, { widths: [640, 960, 1280, 1600], aspect: 816 / 560 })
        : sp.featuredImage
          ? shopifyImage(sp.featuredImage, [640, 960, 1280, 1600])
          : null,
      price: formatPrice(v.price.amount, v.price.currencyCode),
      href: localePath(lang, `/coffrets/${sp.handle}`),
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
const discovery =
  discoveryCandidates.find((c) => /sample|discovery|decouverte|découverte/i.test(c.handle)) ??
  discoveryCandidates[0] ??
  null;

// ---------- SEO ----------
// Le bloc `seo` de Sanity (rempli au cas par cas dans le Studio) surcharge le
// titre, la description et l'image de partage ; sinon on retombe sur le
// contenu de la fiche.
const seo = parfum?.seo ?? null;
const seoTitle = seo?.metaTitle ?? product.title;
const seoDescription = seo?.metaDescription ?? parfum?.accroche ?? product.description;
/*
 * Image de partage : réglage SEO > 1re image éditoriale > photo Shopify.
 * Recadrée en 1200x630 (~1,91:1) car c'est le format attendu par les réseaux
 * sociaux ; servir une image portrait comme nos visuels produit donnerait un
 * aperçu mal cadré. Le recadrage respecte le hotspot défini dans le Studio.
 */
const ogSource = seo?.ogImage ?? parfum?.images?.[0] ?? null;
// Le recadrage 1200x630 n'existe que côté Sanity ; en repli Shopify on borne
// au moins la largeur, sinon l'aperçu de partage pèse plusieurs Mo.
const shareImage = ogSource
  ? urlForImage(ogSource as any).width(1200).height(630).fit("crop").url()
  : product.featuredImage
    ? shopifyImage(product.featuredImage, [1200]).src
    : null;

/*
 * JSON-LD Product : c'est lui qui donne à Google le prix, la devise et la
 * disponibilité affichés directement dans les résultats de recherche.
 * `offers.url` doit être l'URL canonique de la page produit.
 */
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.title,
  description: seoDescription ?? undefined,
  image: gallery.map((g) => g.src).slice(0, 4),
  brand: { "@type": "Brand", name: "Maison Reflet" },
  sku: variant.sku ?? undefined,
  ...(familles ? { category: familles } : {}),
  offers: {
    "@type": "Offer",
    url: productUrl,
    price: Number(variant.price.amount),
    priceCurrency: variant.price.currencyCode,
    availability: variant.availableForSale
      ? "https://schema.org/InStock"
      : "https://schema.org/OutOfStock",
  },
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  lang={lang}
  ogImage={shareImage}
  ogType="product"
  jsonLd={[productJsonLd]}
  breadcrumbs={[
    { label: t("nav.home"), href: localePath(lang, "/") },
    { label: t("nav.perfumes"), href: localePath(lang, "/parfums") },
    { label: product.title },
  ]}
>
  <div class="produit">
    <div class="produit-gallery">
      <ProductGallery images={gallery} />
    </div>
    <aside class="produit-panel">
      <ProductInfoPanel
        title={product.title}
        sizeLabel={sizeLabel}
        rating={rating}
        reviewCount={panelReviewCount}
        reviewsWord={t("product.reviews")}
        descriptionHtml={descriptionHtml}
        famillesLabel={t("product.olfactiveFamily")}
        familles={familles}
        pyramidLabel={t("product.pyramid")}
        pyramidImg={pyramidImg}
        noteLevels={scentLevels.map((l) => ({ label: l.label, notes: l.notes }))}
        intensityLabel={t("product.intensity")}
        intensity={intensite}
        intensityValueLabel={gaugeLabel(intensite, t("product.intensityLow"), t("product.intensityMid"), t("product.intensityHigh"))}
        sillageLabel={t("product.sillage")}
        sillage={sillage}
        sillageValueLabel={gaugeLabel(sillage, t("product.sillageLow"), t("product.sillageMid"), t("product.sillageHigh"))}
        variantId={variant.id}
        priceLabel={priceLabel}
        addLabel={t("product.addToCart")}
        addedLabel={t("product.added")}
        errorLabel={t("product.error")}
        decreaseLabel={t("cart.decrease")}
        increaseLabel={t("cart.increase")}
        perks={perks}
      />
    </aside>
  </div>

  <ScentNotes title={t("product.notes")} levels={scentLevels} />

  {specificTwist && <TwistSection title={t("product.specificTwist")} text={specificTwist} img={twistImg} />}

  {perfumerWord && <PerfumerWord title={t("product.perfumerWord")} quote={perfumerWord} img={perfumerPhoto} />}

  <Reassurance items={reassurances} />

  <!--
    Avis clients : aucun système d'avis branché — bloc de démonstration,
    à remplacer par de vrais avis (Judge.me / Loox…) avant le lancement.
  -->
  <section class="reviews">
    <div class="reviews-head">
      <h2>{t("home.reviews.title").replace("{count}", String(reviewCount))}</h2>
      <div class="reviews-rating">
        <span class="stars">
          {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="14" height="14" />)}
        </span>
        <span class="reviews-rated">
          <strong>{t("home.reviews.rated")}</strong>
          <span>{t("home.reviews.customers")}</span>
        </span>
      </div>
    </div>
    <div class="reviews-list">
      {
        reviews.map((r) => (
          <div class="review">
            <div class="review-head">
              <span class="stars">
                {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="14" height="14" />)}
              </span>
              <p class="review-author">{r.author}</p>
              {r.date && <p class="review-date">{r.date}</p>}
            </div>
            <p class="review-quote">“{r.quote}”</p>
          </div>
        ))
      }
    </div>
  </section>

  <RelatedProducts title={t("product.related")} items={related} />

  <Pillars
    title1={t("home.pillars.title1")}
    title2={t("home.pillars.title2")}
    subtitle={t("home.pillars.subtitle")}
    pillars={[
      { title: t("home.pillars.quality.title"), text: t("home.pillars.quality.text"), image: "/home/pillar-quality.jpg" },
      { title: t("home.pillars.performance.title"), text: t("home.pillars.performance.text"), image: "/home/pillar-performance.jpg" },
      { title: t("home.pillars.character.title"), text: t("home.pillars.character.text"), image: "/home/pillar-character.jpg" },
    ]}
  />

  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.titre}
        description={discovery.description}
        priceLabel={discovery.price}
        href={discovery.href}
        img={discovery.img}
        ctaLabel={t("home.hero.cta")}
      />
    )
  }

  <Faq items={parfum?.faqs ?? []} title={t("product.faqTitle")} />
</Layout>

{/* .replace(/</g, "\\u003c") : JSON.stringify n'échappe pas "<" ; un titre
    contenant "</script>" sortirait du bloc (XSS) — l'échappement unicode est
    du JSON valide et neutralise toute balise. */}
<script type="application/json" id="viewed-product" is:inline set:html={JSON.stringify(viewedProduct).replace(/</g, "\\u003c")} />
<script type="application/json" id="meta-view-content" is:inline set:html={JSON.stringify(metaViewContentData).replace(/</g, "\\u003c")} />

<script>
  import { track } from "../../../lib/klaviyo";
  import { metaViewContent, shopifyNumericId } from "../../../lib/meta";
  import { ga4ViewItem } from "../../../lib/ga4";

  // "Viewed Product" : un envoi par chargement de page produit (best effort).
  const viewedProduct = JSON.parse(document.getElementById("viewed-product")?.textContent ?? "null");
  if (viewedProduct) {
    try {
      track("Viewed Product", viewedProduct);
    } catch {
      // le tracking ne doit jamais faire échouer le rendu de la page
    }
  }

  // "ViewContent" Meta + "view_item" GA4 — même déclenchement, mêmes données.
  const metaProduct = JSON.parse(document.getElementById("meta-view-content")?.textContent ?? "null");
  if (metaProduct) {
    try {
      metaViewContent({
        contentId: shopifyNumericId(metaProduct.variantGid),
        contentName: metaProduct.name,
        value: metaProduct.value,
        currency: metaProduct.currency,
      });
    } catch {
      // idem : jamais bloquant
    }
    try {
      ga4ViewItem({
        item: {
          item_id: shopifyNumericId(metaProduct.variantGid),
          item_name: metaProduct.name,
          price: metaProduct.value,
        },
        value: metaProduct.value,
        currency: metaProduct.currency,
      });
    } catch {
      // idem : jamais bloquant
    }
  }
</script>

<style>
  /* Galerie + panneau sticky.
     minmax(0, 1fr) et non 1fr : 1fr = minmax(auto, 1fr), donc le min-content
     du panneau (rangée quantité + bouton insécable) élargirait la colonne et
     provoquerait un débordement horizontal sur mobile. */
  .produit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
  }
  .produit-panel {
    position: sticky;
    top: 0;
    padding: 56px var(--gutter-x) 32px;
  }

  /* Avis (placeholder) */
  .reviews {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 96px var(--gutter-x) 80px;
  }
  .reviews-head { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .reviews-head h2 { margin: 0; font-size: 32px; font-weight: 500; text-transform: uppercase; }
  .reviews-rating { display: flex; align-items: center; gap: 8px; }
  .stars { display: inline-flex; gap: 2px; }
  .reviews-rated { display: flex; align-items: baseline; gap: 4px; }
  .reviews-rated strong { font-size: 16px; font-weight: 500; }
  .reviews-rated span { font-size: 14px; }
  .reviews-list { display: flex; flex-direction: column; }
  .review {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 0;
    border-top: 1px solid rgba(21, 14, 10, 0.12);
  }
  .reviews-list .review:last-child { border-bottom: 1px solid rgba(21, 14, 10, 0.12); }
  .review-head { display: flex; flex-direction: column; gap: 8px; }
  .review-author { margin: 0; font-size: 16px; font-weight: 500; text-transform: uppercase; }
  .review-date { margin: 0; font-size: 16px; opacity: 0.7; }
  .review-quote { margin: 0; max-width: 60rem; font-size: 18px; line-height: 1.28; letter-spacing: 1.08px; }

  @media (max-width: 900px) {
    .produit { grid-template-columns: minmax(0, 1fr); }
    .produit-panel { position: static; padding: 32px var(--gutter-x); }
    .reviews { padding: 56px var(--gutter-x) 40px; }
    .reviews-head h2 { font-size: 26px; }
    /* `flex: none` est indispensable : en flex-direction column, le
       `flex: 1 0 0` du desktop s'applique à la HAUTEUR et écrase
       l'aspect-ratio — les piliers s'effondraient à 48px de haut.
       Et empilés en pleine largeur, le ratio de maquette donnerait des blocs
       de 117vw de haut, d'où le 4/3 paysage. */
  }</style>
