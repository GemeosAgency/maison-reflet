---
import Layout from "../../../layouts/Layout.astro";
import { formatPrice, getAllProducts, isCoffret, type ShopifyProduct } from "../../../lib/shopify";
import {
  getParfumContent,
  getInspiredByMap,
  getRecoImages,
  getCoffrets,
  urlForImage,
} from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export async function getStaticPaths() {
  // Un coffret n'est pas un parfum classique : sa propre section plus bas s'en occupe.
  const products = (await getAllProducts()).filter((p) => !isCoffret(p));
  return locales.flatMap((lang) =>
    products.map((product) => ({ params: { lang, handle: product.handle }, props: { product, products } }))
  );
}

interface Props {
  product: ShopifyProduct;
  products: ShopifyProduct[];
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { product, products } = Astro.props;

const parfum = await getParfumContent(product.handle, lang);
const variant = product.variants.nodes.find((v) => v.availableForSale) ?? product.variants.nodes[0];
const priceLabel = formatPrice(variant.price.amount, variant.price.currencyCode);

// Galerie spécifique au parfum :
// 1) images éditoriales Sanity (curées par parfum) → 2) images produit Shopify
// (propres à chaque produit) → 3) visuels du design (placeholder de secours).
const editorialImgs = (parfum?.images ?? []).map((im) =>
  urlForImage(im as any).width(1000).url()
);
const shopifyImgs = [
  product.featuredImage?.url,
  ...product.images.nodes.map((n) => n.url),
].filter((u): u is string => Boolean(u));
const placeholderImgs = [
  "/brand/gallery1.jpg",
  "/brand/gallery2.jpg",
  "/brand/gallery3.jpg",
  "/brand/gallery4.jpg",
];
const gallery = editorialImgs.length
  ? editorialImgs
  : shopifyImgs.length
    ? shopifyImgs
    : placeholderImgs;

const names = (arr: { nom: string | null }[] | undefined) =>
  (arr ?? []).map((n) => n.nom).filter(Boolean) as string[];
const tete = names(parfum?.notes.tete);
const coeur = names(parfum?.notes.coeur);
const fond = names(parfum?.notes.fond);
const ingredients = (parfum?.ingredients ?? []).filter(Boolean) as string[];

const inspiredBy = parfum?.inspiredBy ?? null;
const blocs = parfum?.blocs ?? [];
// Bandeau de réassurance (livraison, paiement…) : sélectionné et ordonné dans Sanity.
const reassurances = (parfum?.reassurances ?? []).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));
const inspiredMap = await getInspiredByMap();
const recoImages = await getRecoImages();
// Note / avis : placeholders (pas encore de système d'avis).
const rating = "4,9";
const reviewCount = 147;

// "Vous aimerez aussi" : tous les autres parfums réels de la collection (image dédiée si définie
// dans Sanity, sinon photo produit Shopify).
const reco = products
  .filter((p) => p.handle !== product.handle)
  .map((p) => ({
    name: p.title,
    inspired: inspiredMap[p.handle] ?? null,
    price: formatPrice(p.priceRange.minVariantPrice.amount, p.priceRange.minVariantPrice.currencyCode),
    img: recoImages[p.handle]
      ? urlForImage(recoImages[p.handle] as any).width(800).height(1200).url()
      : (p.featuredImage?.url ?? null),
    href: localePath(lang, `/parfums/${p.handle}`),
  }));

// Coffrets : contenu Sanity (titre/description/image) croisé avec le produit Shopify
// correspondant (prix + variante) via shopifyHandle. Repli sur les 2 cartes statiques
// tant qu'aucun coffret n'est configuré des deux côtés.
const coffretProducts = (await getAllProducts()).filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const coffrets = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const variant = sp.variants.nodes.find((v) => v.availableForSale) ?? sp.variants.nodes[0];
    return {
      titre: c.titre ?? sp.title,
      description: c.description,
      img: c.image ? urlForImage(c.image as any).width(1000).url() : (sp.featuredImage?.url ?? null),
      price: formatPrice(variant.price.amount, variant.price.currencyCode),
      variantId: variant.id,
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
---

<Layout title={product.title} description={parfum?.accroche ?? product.description} lang={lang}>
  <div class="produit">
    <!-- Galerie -->
    <div class="gallery">
      {
        gallery.map((src) => (
          <div class="shot">
            <img src={src} alt={product.title} loading="lazy" />
          </div>
        ))
      }
    </div>

    <!-- Colonne d'achat (sticky) -->
    <aside class="info">
      <div class="info-top">
        <div class="head">
          <div class="title-row">
            <h1>{product.title}</h1>
            <span class="ml">75 ml</span>
          </div>
          {inspiredBy && <p class="inspired">{t("product.inspiredBy")} {inspiredBy}</p>}
          {parfum?.accroche && <p class="desc">{parfum.accroche}</p>}
        </div>

        <div class="rating">
          <span class="stars">
            {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="18" height="18" />)}
          </span>
          <span class="score">{rating}</span>
          <span class="reviews">· {reviewCount} {t("product.reviews")}</span>
        </div>
      </div>

      <button type="button" class="add-to-bag" data-add-to-cart data-variant-id={variant.id}>
        ADD TO BAG · {priceLabel}
      </button>
      <p class="feedback" data-feedback role="status" aria-live="polite"></p>

      <div class="accordions">
        <details open>
          <summary>{t("product.pyramid")}<img src="/brand/chevron.svg" alt="" width="8" height="8" /></summary>
          <div class="acc-body">
            {tete.length > 0 && <p><strong>{t("product.notes.tete")}</strong> — {tete.join(", ")}</p>}
            {coeur.length > 0 && <p><strong>{t("product.notes.coeur")}</strong> — {coeur.join(", ")}</p>}
            {fond.length > 0 && <p><strong>{t("product.notes.fond")}</strong> — {fond.join(", ")}</p>}
          </div>
        </details>
        {
          ingredients.length > 0 && (
            <details>
              <summary>
                {t("product.ingredients")}
                <img src="/brand/chevron.svg" alt="" width="8" height="8" />
              </summary>
              <div class="acc-body">
                <p>{ingredients.join(" · ")}</p>
              </div>
            </details>
          )
        }
      </div>
    </aside>
  </div>

  <!-- Réassurance (icône + texte, sélectionnés par parfum dans Sanity) -->
  {
    reassurances.length > 0 && (
      <section class="reassurance">
        {reassurances.map((r) => (
          <div class="reassurance-item">
            {r.icone && <img src={r.icone} alt="" width="40" height="40" />}
            <p>
              {r.lignes.map((ligne) => (
                <>
                  {ligne}
                  <br />
                </>
              ))}
            </p>
          </div>
        ))}
      </section>
    )
  }

  <!-- Blocs éditoriaux (administrables dans Sanity, en alterné) -->
  {
    blocs.length > 0 && (
      <section class="story-blocks">
        {blocs.map((b, i) => {
          const imgSrc = b.image
            ? urlForImage(b.image as any).width(1000).url()
            : (gallery[i] ?? gallery[0]);
          const text = (
            <div class="story-text">
              {b.titre && <h2>{b.titre}</h2>}
              {b.texte && <p>{b.texte}</p>}
            </div>
          );
          const img = (
            <div class="story-img">
              <img src={imgSrc} alt={b.titre ?? product.title} loading="lazy" />
            </div>
          );
          return (
            <div class={`story-row${b.imageAGauche ? " reverse" : ""}`}>
              {b.imageAGauche ? (
                <>
                  {img}
                  {text}
                </>
              ) : (
                <>
                  {text}
                  {img}
                </>
              )}
            </div>
          );
        })}
      </section>
    )
  }

  <!-- Vous aimerez aussi -->
  {
    reco.length > 0 && (
      <section class="reco">
        <h2>{t("product.related")}</h2>
        <div class="reco-grid">
          {reco.map((p) => (
            <a class="reco-card" href={p.href}>
              {p.img && <img src={p.img} alt={p.name} loading="lazy" />}
              <div class="reco-meta">
                <h3>{p.name}</h3>
                {p.inspired && <p class="reco-inspired">{t("product.inspiredBy")} {p.inspired}</p>}
                <p class="reco-price">{p.price}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Coffrets -->
  <section class="boxes">
    <h2>{t("product.boxes")}</h2>
    <div class="boxes-grid">
      {
        coffrets.length > 0 ? (
          coffrets.map((c) => (
            <div class="box-card">
              {c.img && <img src={c.img} alt={c.titre ?? ""} loading="lazy" />}
              <div class="box-meta light">
                <h3>{c.titre}</h3>
                {c.description && <p class="box-desc">{c.description}</p>}
                <button type="button" class="box-add" data-add-to-cart data-variant-id={c.variantId}>
                  ADD TO BAG · {c.price}
                </button>
                <p class="feedback" data-feedback role="status" aria-live="polite" />
              </div>
            </div>
          ))
        ) : (
          <>
            <div class="box-card">
              <img src="/brand/box-sample.jpg" alt="Coffret découverte" loading="lazy" />
              <div class="box-meta light">
                <h3>Coffret découverte</h3>
                <p>Dhs. 160</p>
              </div>
            </div>
            <div class="box-card">
              <img src="/brand/box-all6.jpg" alt="Les 6 parfums" loading="lazy" />
              <div class="box-meta light">
                <h3>Les 6 parfums</h3>
                <p>Dhs. 2 200</p>
              </div>
            </div>
          </>
        )
      }
    </div>
  </section>
</Layout>

<script>
  import { addToCart } from "../../../lib/cart";
  document.querySelectorAll<HTMLButtonElement>("[data-add-to-cart]").forEach((btn) => {
    const feedback = btn.parentElement?.querySelector<HTMLElement>("[data-feedback]") ?? null;
    btn.addEventListener("click", async () => {
      const id = btn.dataset.variantId;
      if (!id) return;
      btn.disabled = true;
      try {
        await addToCart(id, 1);
        if (feedback) feedback.textContent = "✓";
      } catch (e) {
        console.error(e);
        if (feedback) feedback.textContent = "×";
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .produit { display: flex; align-items: flex-start; }
  .gallery { display: flex; flex-direction: column; gap: 2px; width: 800px; max-width: 55%; }
  .shot { background: #e5d3be; aspect-ratio: 800 / 960; overflow: hidden; }
  .shot img { width: 100%; height: 100%; object-fit: cover; }

  .info {
    position: sticky;
    top: 0;
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 56px 64px;
  }
  .info-top { display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-direction: column; gap: 16px; }
  .title-row { display: flex; gap: 8px; align-items: flex-start; }
  .title-row h1 { margin: 0; font-size: 40px; font-weight: 500; line-height: 1.2; text-transform: uppercase; }
  .ml { font-size: 16px; }
  .inspired { margin: 0; font-size: 16px; font-weight: 500; }
  .desc { margin: 0; font-size: 16px; line-height: 1.36; }
  .rating { display: flex; gap: 8px; align-items: center; }
  .stars { display: inline-flex; gap: 2px; }
  .score { font-size: 16px; font-weight: 500; }
  .reviews { font-size: 14px; }

  .add-to-bag {
    height: 56px;
    border: 0;
    border-radius: 999px;
    background: var(--rose);
    color: #fff;
    font: inherit;
    font-weight: 500;
    font-size: 16px;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .add-to-bag:hover { opacity: 0.9; }
  .add-to-bag:disabled { opacity: 0.6; }
  .feedback { margin: -20px 0 0; min-height: 1em; color: var(--rose); }

  /* Réassurance (bandeau pleine largeur, d'après le Figma) */
  .reassurance {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 24px; padding: 64px; background: #e9dac9;
  }
  .reassurance-item {
    display: flex; flex-direction: column; align-items: center; gap: 16px;
    width: 200px; flex-shrink: 0;
  }
  .reassurance-item img { width: 40px; height: 40px; }
  .reassurance-item p {
    margin: 0; font-size: 14px; font-weight: 500; text-transform: uppercase;
    text-align: center; line-height: 1.28; color: #0a1215;
  }

  .accordions { display: flex; flex-direction: column; border-top: 1px solid rgba(0,0,0,0.15); }
  .accordions details { border-bottom: 1px solid rgba(0,0,0,0.15); }
  .accordions summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 24px 0; font-size: 18px; font-weight: 500; cursor: pointer; list-style: none;
  }
  .accordions summary::-webkit-details-marker { display: none; }
  .accordions summary img { transition: transform 0.2s; }
  .accordions details[open] summary img { transform: rotate(180deg); }
  .acc-body { padding-bottom: 24px; font-size: 15px; line-height: 1.5; }
  .acc-body p { margin: 0 0 8px; }

  /* Blocs éditoriaux alternés (d'après le Figma) */
  .story-blocks { display: flex; flex-direction: column; gap: 72px; padding: 72px; }
  .story-row { display: flex; gap: 64px; align-items: flex-end; }
  .story-text { flex: 1 0 0; min-width: 0; padding-bottom: 40px; color: #0a1215; }
  .story-row:not(.reverse) .story-text { padding-right: 56px; }
  .story-text h2 { margin: 0 0 24px; font-size: 40px; font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .story-text p { margin: 0; font-size: 18px; line-height: 1.36; }
  .story-img { width: 816px; max-width: 60%; height: 560px; background: #dec9b8; overflow: hidden; flex-shrink: 0; }
  .story-img img { width: 100%; height: 100%; object-fit: cover; }

  /* Sections recommandées */
  .reco, .boxes { display: flex; flex-direction: column; align-items: center; }
  .reco h2, .boxes h2 {
    margin: 0; padding: 96px 64px 40px; font-size: 40px; font-weight: 500;
    text-transform: uppercase; text-align: center;
  }
  .reco-grid { display: flex; gap: 2px; width: 100%; height: 560px; }
  .reco-card {
    flex: 1 0 0; min-width: 0; height: 100%; position: relative;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 24px; overflow: hidden;
  }
  .reco-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: bottom; }
  .reco-meta { position: relative; }
  .reco-meta h3 { margin: 0; font-size: 24px; font-weight: 500; text-transform: uppercase; }
  .reco-inspired, .reco-price { margin: 4px 0 0; font-size: 14px; font-weight: 500; }

  .boxes-grid { display: flex; gap: 2px; width: 100%; height: 728px; }
  .box-card { flex: 1 0 0; min-width: 0; position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding: 24px; overflow: hidden; background: #e0cdbb; }
  .box-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .box-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.45), transparent 45%); }
  .box-meta { position: relative; z-index: 1; }
  .box-meta h3 { margin: 0; font-size: 24px; font-weight: 500; text-transform: uppercase; }
  .box-meta p { margin: 4px 0 0; font-size: 14px; font-weight: 500; }
  .box-meta.light { color: #fff; }
  .box-desc { font-weight: 400; opacity: 0.9; max-width: 32ch; }
  .box-add {
    margin-top: 12px; height: 44px; padding: 0 24px; border: 0; border-radius: 999px;
    background: var(--rose); color: #fff; font: inherit; font-weight: 500; font-size: 14px;
    text-transform: uppercase; cursor: pointer; transition: opacity 0.15s;
  }
  .box-add:hover { opacity: 0.9; }
  .box-add:disabled { opacity: 0.6; }
  .box-meta .feedback { margin: 4px 0 0; min-height: 1em; }

  @media (max-width: 900px) {
    .produit { flex-direction: column; }
    .gallery { width: 100%; max-width: 100%; }
    .info { position: static; padding: 32px 20px; width: 100%; }
    .reassurance { flex-wrap: wrap; justify-content: center; padding: 32px 20px; gap: 32px; }
    .reco-grid, .boxes-grid { flex-wrap: wrap; height: auto; }
    .reco-card, .box-card { flex: 1 1 45%; min-height: 320px; }
    .reco h2, .boxes h2 { padding: 56px 20px 32px; font-size: 28px; }
    .story-blocks { padding: 40px 20px; gap: 48px; }
    .story-row, .story-row.reverse { flex-direction: column; align-items: stretch; gap: 20px; }
    .story-row.reverse { flex-direction: column-reverse; }
    .story-text { padding: 0 !important; }
    .story-text h2 { font-size: 28px; }
    .story-img { width: 100%; max-width: 100%; height: auto; aspect-ratio: 816 / 560; }
  }
</style>
