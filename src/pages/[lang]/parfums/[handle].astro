---
import Layout from "../../../layouts/Layout.astro";
import { formatPrice, getAllProducts, type ShopifyProduct } from "../../../lib/shopify";
import { getParfumContent, urlForImage } from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export async function getStaticPaths() {
  const products = await getAllProducts();
  return locales.flatMap((lang) =>
    products.map((product) => ({ params: { lang, handle: product.handle }, props: { product, products } }))
  );
}

interface Props {
  product: ShopifyProduct;
  products: ShopifyProduct[];
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { product, products } = Astro.props;

const parfum = await getParfumContent(product.handle, lang);
const variant = product.variants.nodes.find((v) => v.availableForSale) ?? product.variants.nodes[0];
const priceLabel = formatPrice(variant.price.amount, variant.price.currencyCode);

// Galerie : image Shopify + images éditoriales Sanity, empilées.
const gallery: string[] = [];
if (product.featuredImage) gallery.push(product.featuredImage.url);
for (const im of product.images.nodes) if (!gallery.includes(im.url)) gallery.push(im.url);
for (const im of parfum?.images ?? []) gallery.push(urlForImage(im as any).width(1000).url());

const names = (arr: { nom: string | null }[] | undefined) =>
  (arr ?? []).map((n) => n.nom).filter(Boolean) as string[];
const tete = names(parfum?.notes.tete);
const coeur = names(parfum?.notes.coeur);
const fond = names(parfum?.notes.fond);
const allNotes = [...tete, ...coeur, ...fond];

// PLACEHOLDERS (à câbler à Sanity ensuite)
const inspiredBy = "Bois Impérial";
const rating = "4,9";
const reviewCount = 147;

const others = products.filter((p) => p.handle !== product.handle).slice(0, 4);
const cardBg = ["#dfcbb8", "#e0cdba", "#dec8b5", "#dec9b8"];
---

<Layout title={product.title} description={parfum?.accroche ?? product.description} lang={lang}>
  <div class="produit">
    <!-- Galerie -->
    <div class="gallery">
      {
        gallery.map((src) => (
          <div class="shot">
            <img src={src} alt={product.title} loading="lazy" />
          </div>
        ))
      }
    </div>

    <!-- Colonne d'achat (sticky) -->
    <aside class="info">
      <div class="info-top">
        <div class="head">
          <div class="title-row">
            <h1>{product.title}</h1>
            <span class="ml">75 ml</span>
          </div>
          <p class="inspired">{t("product.inspiredBy")} {inspiredBy}</p>
          {parfum?.accroche && <p class="desc">{parfum.accroche}</p>}
        </div>

        <div class="rating">
          <span class="stars">
            {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="18" height="18" />)}
          </span>
          <span class="score">{rating}</span>
          <span class="reviews">· {reviewCount} {t("product.reviews")}</span>
        </div>
      </div>

      <button type="button" class="add-to-bag" data-add-to-cart data-variant-id={variant.id}>
        ADD TO BAG · {priceLabel}
      </button>
      <p class="feedback" data-feedback role="status" aria-live="polite"></p>

      <ul class="perks">
        <li><img src="/brand/gift.svg" alt="" width="20" height="20" />{t("product.perk1")}</li>
        <li><img src="/brand/shipment.svg" alt="" width="20" height="20" />{t("product.perk2")}</li>
        <li><img src="/brand/love.svg" alt="" width="20" height="20" />{t("product.perk3")}</li>
      </ul>

      <div class="accordions">
        <details open>
          <summary>{t("product.pyramid")}<img src="/brand/chevron.svg" alt="" width="8" height="8" /></summary>
          <div class="acc-body">
            {tete.length > 0 && <p><strong>{t("product.notes.tete")}</strong> — {tete.join(", ")}</p>}
            {coeur.length > 0 && <p><strong>{t("product.notes.coeur")}</strong> — {coeur.join(", ")}</p>}
            {fond.length > 0 && <p><strong>{t("product.notes.fond")}</strong> — {fond.join(", ")}</p>}
          </div>
        </details>
        <details>
          <summary>{t("product.notes")}<img src="/brand/chevron.svg" alt="" width="8" height="8" /></summary>
          <div class="acc-body">
            {parfum?.histoire && <p>{parfum.histoire}</p>}
          </div>
        </details>
        <details>
          <summary>{t("product.ingredients")}<img src="/brand/chevron.svg" alt="" width="8" height="8" /></summary>
          <div class="acc-body">
            <p>{allNotes.join(" · ")}</p>
          </div>
        </details>
      </div>
    </aside>
  </div>

  <!-- Vous aimerez aussi -->
  {
    others.length > 0 && (
      <section class="reco">
        <h2>{t("product.related")}</h2>
        <div class="reco-grid">
          {others.map((p, i) => (
            <a class="reco-card" href={localePath(lang, `/parfums/${p.handle}`)} style={`background:${cardBg[i % cardBg.length]}`}>
              {p.featuredImage && <img src={p.featuredImage.url} alt={p.title} loading="lazy" />}
              <div class="reco-meta">
                <h3>{p.title}</h3>
                <p class="reco-inspired">{t("product.inspiredBy")} {inspiredBy}</p>
                <p class="reco-price">{formatPrice(p.priceRange.minVariantPrice.amount, p.priceRange.minVariantPrice.currencyCode)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Coffrets -->
  <section class="boxes">
    <h2>{t("product.boxes")}</h2>
    <div class="boxes-grid">
      <div class="box-card box-a">
        <div class="box-meta">
          <h3>Coffret découverte</h3>
          <p>Dhs. 160</p>
        </div>
      </div>
      <div class="box-card box-b">
        <div class="box-meta light">
          <h3>Les 6 parfums</h3>
          <p>Dhs. 2 200</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { addToCart } from "../../../lib/cart";
  const btn = document.querySelector<HTMLButtonElement>("[data-add-to-cart]");
  const feedback = document.querySelector<HTMLElement>("[data-feedback]");
  btn?.addEventListener("click", async () => {
    const id = btn.dataset.variantId;
    if (!id) return;
    btn.disabled = true;
    try {
      await addToCart(id, 1);
      if (feedback) feedback.textContent = "✓";
    } catch (e) {
      console.error(e);
      if (feedback) feedback.textContent = "×";
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .produit { display: flex; align-items: flex-start; }
  .gallery { display: flex; flex-direction: column; gap: 2px; width: 800px; max-width: 55%; }
  .shot { background: #e5d3be; aspect-ratio: 800 / 960; overflow: hidden; }
  .shot img { width: 100%; height: 100%; object-fit: cover; }

  .info {
    position: sticky;
    top: 0;
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 56px 64px;
  }
  .info-top { display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-direction: column; gap: 16px; }
  .title-row { display: flex; gap: 8px; align-items: flex-start; }
  .title-row h1 { margin: 0; font-size: 40px; font-weight: 500; line-height: 1.2; text-transform: uppercase; }
  .ml { font-size: 16px; }
  .inspired { margin: 0; font-size: 16px; font-weight: 500; }
  .desc { margin: 0; font-size: 16px; line-height: 1.36; }
  .rating { display: flex; gap: 8px; align-items: center; }
  .stars { display: inline-flex; gap: 2px; }
  .score { font-size: 16px; font-weight: 500; }
  .reviews { font-size: 14px; }

  .add-to-bag {
    height: 56px;
    border: 0;
    border-radius: 999px;
    background: var(--rose);
    color: #fff;
    font: inherit;
    font-weight: 500;
    font-size: 16px;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .add-to-bag:hover { opacity: 0.9; }
  .add-to-bag:disabled { opacity: 0.6; }
  .feedback { margin: -20px 0 0; min-height: 1em; color: var(--rose); }

  .perks { list-style: none; margin: 0; padding: 0 8px; display: flex; flex-direction: column; gap: 10px; }
  .perks li { display: flex; gap: 8px; align-items: center; font-size: 16px; }

  .accordions { display: flex; flex-direction: column; border-top: 1px solid rgba(0,0,0,0.15); }
  .accordions details { border-bottom: 1px solid rgba(0,0,0,0.15); }
  .accordions summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: 24px 0; font-size: 18px; font-weight: 500; cursor: pointer; list-style: none;
  }
  .accordions summary::-webkit-details-marker { display: none; }
  .accordions summary img { transition: transform 0.2s; }
  .accordions details[open] summary img { transform: rotate(180deg); }
  .acc-body { padding-bottom: 24px; font-size: 15px; line-height: 1.5; }
  .acc-body p { margin: 0 0 8px; }

  /* Sections recommandées */
  .reco, .boxes { display: flex; flex-direction: column; align-items: center; }
  .reco h2, .boxes h2 {
    margin: 0; padding: 96px 64px 40px; font-size: 40px; font-weight: 500;
    text-transform: uppercase; text-align: center;
  }
  .reco-grid { display: flex; gap: 2px; width: 100%; height: 560px; }
  .reco-card {
    flex: 1 0 0; min-width: 0; height: 100%; position: relative;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 24px; overflow: hidden;
  }
  .reco-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: bottom; }
  .reco-meta { position: relative; }
  .reco-meta h3 { margin: 0; font-size: 24px; font-weight: 500; text-transform: uppercase; }
  .reco-inspired, .reco-price { margin: 4px 0 0; font-size: 14px; font-weight: 500; }

  .boxes-grid { display: flex; gap: 2px; width: 100%; height: 728px; }
  .box-card { flex: 1 0 0; min-width: 0; position: relative; display: flex; flex-direction: column; justify-content: flex-end; padding: 24px; }
  .box-a { background: #e0cdbb; }
  .box-b { background: #2a2622; }
  .box-meta h3 { margin: 0; font-size: 24px; font-weight: 500; text-transform: uppercase; }
  .box-meta p { margin: 4px 0 0; font-size: 14px; font-weight: 500; }
  .box-meta.light { color: #fff; }

  @media (max-width: 900px) {
    .produit { flex-direction: column; }
    .gallery { width: 100%; max-width: 100%; }
    .info { position: static; padding: 32px 20px; width: 100%; }
    .reco-grid, .boxes-grid { flex-wrap: wrap; height: auto; }
    .reco-card, .box-card { flex: 1 1 45%; min-height: 320px; }
    .reco h2, .boxes h2 { padding: 56px 20px 32px; font-size: 28px; }
  }
</style>
