---
import { toHTML, type PortableTextComponents } from "@portabletext/to-html";
import Layout from "../../../layouts/Layout.astro";
import { formatPrice, getAllProducts, isCoffret, type ShopifyProduct } from "../../../lib/shopify";
import {
  getParfumContent,
  getInspiredByMap,
  getRecoImages,
  getCoffrets,
  urlForImage,
} from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export async function getStaticPaths() {
  // Un coffret n'est pas un parfum classique : sa propre section plus bas s'en occupe.
  const products = (await getAllProducts()).filter((p) => !isCoffret(p));
  return locales.flatMap((lang) =>
    products.map((product) => ({ params: { lang, handle: product.handle }, props: { product, products } }))
  );
}

interface Props {
  product: ShopifyProduct;
  products: ShopifyProduct[];
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { product, products } = Astro.props;

const parfum = await getParfumContent(product.handle, lang);
const variant = product.variants.nodes.find((v) => v.availableForSale) ?? product.variants.nodes[0];
const priceLabel = formatPrice(variant.price.amount, variant.price.currencyCode);

const inspiredMap = await getInspiredByMap();

// Lot "Buy 2 Get 1 Free" : catalogue complet des parfums (autres produits déjà
// filtrés des coffrets par getStaticPaths) pour les 3 sélecteurs. La vraie remise
// (article le moins cher offert) est appliquée par Shopify au checkout — voir
// la remise automatique "Buy X Get Y" configurée sur la collection Eaux de Parfum.
const bundleCatalog = products.map((p) => {
  const v = p.variants.nodes.find((x) => x.availableForSale) ?? p.variants.nodes[0];
  return {
    handle: p.handle,
    title: p.title,
    inspiredBy: inspiredMap[p.handle] ?? null,
    img: p.featuredImage?.url ?? null,
    variantId: v.id,
    price: Number(v.price.amount),
  };
});
const currentIndex = Math.max(
  0,
  products.findIndex((p) => p.handle === product.handle)
);
const defaultBundle = [0, 1, 2].map(
  (i) => products[(currentIndex + i) % products.length].handle
);

// Galerie spécifique au parfum :
// 1) images éditoriales Sanity (curées par parfum) → 2) images produit Shopify
// (propres à chaque produit) → 3) visuels du design (placeholder de secours).
const editorialImgs = (parfum?.images ?? []).map((im) =>
  urlForImage(im as any).width(1000).url()
);
const shopifyImgs = [
  product.featuredImage?.url,
  ...product.images.nodes.map((n) => n.url),
].filter((u): u is string => Boolean(u));
const placeholderImgs = [
  "/brand/gallery1.jpg",
  "/brand/gallery2.jpg",
  "/brand/gallery3.jpg",
  "/brand/gallery4.jpg",
];
const gallery = editorialImgs.length
  ? editorialImgs
  : shopifyImgs.length
    ? shopifyImgs
    : placeholderImgs;

const names = (arr: { nom: string | null }[] | undefined) =>
  (arr ?? []).map((n) => n.nom).filter(Boolean) as string[];
const tete = names(parfum?.notes.tete);
const coeur = names(parfum?.notes.coeur);
const fond = names(parfum?.notes.fond);
const ingredients = (parfum?.ingredients ?? []).filter(Boolean) as string[];

const portableTextComponents: Partial<PortableTextComponents> = {
  types: {
    image: ({ value }) => `<img src="${urlForImage(value as any).width(1000).url()}" alt="" loading="lazy" />`,
  },
};
const descriptionHtml =
  parfum?.description && Array.isArray(parfum.description)
    ? toHTML(parfum.description as any, { components: portableTextComponents })
    : "";

const inspiredBy = parfum?.inspiredBy ?? null;
const blocs = parfum?.blocs ?? [];
// Bandeau de réassurance (livraison, paiement…) : sélectionné et ordonné dans Sanity.
const reassurances = (parfum?.reassurances ?? []).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));
const recoImages = await getRecoImages();
// Note / avis : placeholders (pas encore de système d'avis).
const rating = "4,9";
const reviewCount = 147;

// "Vous aimerez aussi" : tous les autres parfums réels de la collection (image dédiée si définie
// dans Sanity, sinon photo produit Shopify).
const reco = products
  .filter((p) => p.handle !== product.handle)
  .map((p) => ({
    name: p.title,
    inspired: inspiredMap[p.handle] ?? null,
    price: formatPrice(p.priceRange.minVariantPrice.amount, p.priceRange.minVariantPrice.currencyCode),
    img: recoImages[p.handle]
      ? urlForImage(recoImages[p.handle] as any).width(800).height(1200).url()
      : (p.featuredImage?.url ?? null),
    href: localePath(lang, `/parfums/${p.handle}`),
  }));

// Coffrets : contenu Sanity (titre/description/image) croisé avec le produit Shopify
// correspondant (prix + variante) via shopifyHandle. Repli sur les 2 cartes statiques
// tant qu'aucun coffret n'est configuré des deux côtés.
const coffretProducts = (await getAllProducts()).filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const coffrets = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const variant = sp.variants.nodes.find((v) => v.availableForSale) ?? sp.variants.nodes[0];
    return {
      titre: c.titre ?? sp.title,
      description: c.description,
      img: c.image ? urlForImage(c.image as any).width(1000).url() : (sp.featuredImage?.url ?? null),
      price: formatPrice(variant.price.amount, variant.price.currencyCode),
      variantId: variant.id,
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
---

<Layout title={product.title} description={parfum?.accroche ?? product.description} lang={lang}>
  <div class="produit">
    <!-- Galerie -->
    <div class="gallery">
      {
        gallery.map((src) => (
          <div class="shot">
            <img src={src} alt={product.title} loading="lazy" />
          </div>
        ))
      }
    </div>

    <!-- Colonne d'achat (sticky) -->
    <aside class="info">
      <div class="info-top">
        <div class="head">
          <div class="title-row">
            <h1>{product.title}</h1>
            <span class="ml">75 ml</span>
          </div>
          {inspiredBy && <p class="inspired">{t("product.inspiredBy")} {inspiredBy}</p>}
          {parfum?.accroche && <p class="desc">{parfum.accroche}</p>}
        </div>

        <div class="rating">
          <span class="stars">
            {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="18" height="18" />)}
          </span>
          <span class="score">{rating}</span>
          <span class="reviews">· {reviewCount} {t("product.reviews")}</span>
        </div>
      </div>

      <div class="qty-select">
        <h3 class="qty-title">{t("product.selectQuantity")}</h3>

        <button type="button" class="qty-single is-active" data-qty-single>
          {product.featuredImage && <img src={product.featuredImage.url} alt="" />}
          <span class="qty-single-label">{t("product.oneUnit")}</span>
          <span class="promo-price">
            <strong>{priceLabel}</strong>
            <small>{t("product.perUnit")}</small>
          </span>
        </button>

        <div class="promo-bundle" data-promo-bundle>
          <button type="button" class="promo-header" data-promo-toggle aria-expanded="false">
            <span class="promo-left">
              <span class="promo-thumbs">
                {[0, 1, 2].map((i) => (
                  <img
                    data-bundle-img={i}
                    src={bundleCatalog.find((p) => p.handle === defaultBundle[i])?.img ?? ""}
                    alt=""
                  />
                ))}
              </span>
              <span class="promo-title">{t("product.buy2get1")}</span>
              <span class="promo-badge" data-promo-badge>{t("product.save")} 33%</span>
            </span>
            <span class="promo-price">
              <strong data-bundle-unit-price>—</strong>
              <small>{t("product.perUnit")}</small>
            </span>
          </button>

          <div class="bundle-slots" data-bundle-slots hidden>
            {[0, 1, 2].map((i) => (
              <div class="bundle-slot">
                <img data-bundle-slot-img={i} src={bundleCatalog.find((p) => p.handle === defaultBundle[i])?.img ?? ""} alt="" />
                <select data-bundle-slot-select={i}>
                  {bundleCatalog.map((p) => (
                    <option value={p.handle} selected={p.handle === defaultBundle[i]}>
                      {p.title.toUpperCase()}
                      {p.inspiredBy ? ` ${t("product.inspiredBy")} ${p.inspiredBy}` : ""} · 70 ML
                    </option>
                  ))}
                </select>
                <img src="/brand/chevron.svg" alt="" class="chev" width="8" height="8" />
              </div>
            ))}
          </div>
        </div>
      </div>

      <button
        type="button"
        class="add-to-bag"
        data-main-add-to-cart
        data-variant-id={variant.id}
        data-single-price={variant.price.amount}
        data-currency={variant.price.currencyCode}
      >
        ADD TO BAG · {priceLabel}
      </button>
      <p class="feedback" data-main-feedback role="status" aria-live="polite"></p>

      <div class="accordions">
        {
          descriptionHtml && (
            <details open>
              <summary>
                {t("product.description")}
                <img src="/brand/chevron.svg" alt="" width="8" height="8" />
              </summary>
              <div class="acc-body" set:html={descriptionHtml} />
            </details>
          )
        }
        <details open={!descriptionHtml}>
          <summary>{t("product.pyramid")}<img src="/brand/chevron.svg" alt="" width="8" height="8" /></summary>
          <div class="acc-body">
            {tete.length > 0 && <p><strong>{t("product.notes.tete")}</strong> — {tete.join(", ")}</p>}
            {coeur.length > 0 && <p><strong>{t("product.notes.coeur")}</strong> — {coeur.join(", ")}</p>}
            {fond.length > 0 && <p><strong>{t("product.notes.fond")}</strong> — {fond.join(", ")}</p>}
          </div>
        </details>
        {
          ingredients.length > 0 && (
            <details>
              <summary>
                {t("product.ingredients")}
                <img src="/brand/chevron.svg" alt="" width="8" height="8" />
              </summary>
              <div class="acc-body">
                <p>{ingredients.join(" · ")}</p>
              </div>
            </details>
          )
        }
      </div>
    </aside>
  </div>

  <!-- Réassurance (icône + texte, sélectionnés par parfum dans Sanity) -->
  {
    reassurances.length > 0 && (
      <section class="reassurance">
        {reassurances.map((r) => (
          <div class="reassurance-item">
            {r.icone && <img src={r.icone} alt="" width="40" height="40" />}
            <p>
              {r.lignes.map((ligne) => (
                <>
                  {ligne}
                  <br />
                </>
              ))}
            </p>
          </div>
        ))}
      </section>
    )
  }

  <!-- Blocs éditoriaux (administrables dans Sanity, en alterné) -->
  {
    blocs.length > 0 && (
      <section class="story-blocks">
        {blocs.map((b, i) => {
          const imgSrc = b.image
            ? urlForImage(b.image as any).width(1000).url()
            : (gallery[i] ?? gallery[0]);
          const text = (
            <div class="story-text">
              {b.titre && <h2>{b.titre}</h2>}
              {b.texte && <p>{b.texte}</p>}
            </div>
          );
          const img = (
            <div class="story-img">
              <img src={imgSrc} alt={b.titre ?? product.title} loading="lazy" />
            </div>
          );
          return (
            <div class={`story-row${b.imageAGauche ? " reverse" : ""}`}>
              {b.imageAGauche ? (
                <>
                  {img}
                  {text}
                </>
              ) : (
                <>
                  {text}
                  {img}
                </>
              )}
            </div>
          );
        })}
      </section>
    )
  }

  <!-- Vous aimerez aussi -->
  {
    reco.length > 0 && (
      <section class="reco">
        <h2>{t("product.related")}</h2>
        <div class="reco-grid">
          {reco.map((p) => (
            <a class="reco-card" href={p.href}>
              {p.img && <img src={p.img} alt={p.name} loading="lazy" />}
              <div class="reco-meta">
                <h3>{p.name}</h3>
                {p.inspired && <p class="reco-inspired">{t("product.inspiredBy")} {p.inspired}</p>}
                <p class="reco-price">{p.price}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- Coffrets -->
  <section class="boxes">
    <h2>{t("product.boxes")}</h2>
    <div class="boxes-grid">
      {
        coffrets.length > 0 ? (
          coffrets.map((c) => (
            <div class="box-card">
              {c.img && <img src={c.img} alt={c.titre ?? ""} loading="lazy" />}
              <div class="box-meta light">
                <h3>{c.titre}</h3>
                {c.description && <p class="box-desc">{c.description}</p>}
                <button type="button" class="box-add" data-add-to-cart data-variant-id={c.variantId}>
                  ADD TO BAG · {c.price}
                </button>
                <p class="feedback" data-feedback role="status" aria-live="polite" />
              </div>
            </div>
          ))
        ) : (
          <>
            <div class="box-card">
              <img src="/brand/box-sample.jpg" alt="Coffret découverte" loading="lazy" />
              <div class="box-meta light">
                <h3>Coffret découverte</h3>
                <p>Dhs. 160</p>
              </div>
            </div>
            <div class="box-card">
              <img src="/brand/box-all6.jpg" alt="Les 6 parfums" loading="lazy" />
              <div class="box-meta light">
                <h3>Les 6 parfums</h3>
                <p>Dhs. 2 200</p>
              </div>
            </div>
          </>
        )
      }
    </div>
  </section>
</Layout>

<script type="application/json" id="bundle-catalog" is:inline set:html={JSON.stringify(bundleCatalog)} />

<script>
  import { addToCart, addManyToCart } from "../../../lib/cart";

  type BundleCatalogEntry = { handle: string; title: string; img: string | null; variantId: string; price: number };
  const bundleCatalog: BundleCatalogEntry[] = JSON.parse(
    document.getElementById("bundle-catalog")?.textContent ?? "[]"
  );

  // Boutons génériques (coffrets) : ajoutent leur unique variante.
  document.querySelectorAll<HTMLButtonElement>("[data-add-to-cart]").forEach((btn) => {
    const feedback = btn.parentElement?.querySelector<HTMLElement>("[data-feedback]") ?? null;
    btn.addEventListener("click", async () => {
      const id = btn.dataset.variantId;
      if (!id) return;
      btn.disabled = true;
      try {
        await addToCart(id, 1);
        if (feedback) feedback.textContent = "✓";
      } catch (e) {
        console.error(e);
        if (feedback) feedback.textContent = "×";
      } finally {
        btn.disabled = false;
      }
    });
  });

  // Carte "Buy 2 Get 1 Free" repliable de la fiche produit. Repliée = achat à
  // l'unité (comportement par défaut) ; dépliée = lot de 3 sélectionné.
  const promoEl = document.querySelector<HTMLElement>("[data-promo-bundle]");
  const mainAddBtn = document.querySelector<HTMLButtonElement>("[data-main-add-to-cart]");
  if (promoEl && mainAddBtn) {
    // Constantes fraîches, non-nullables : le narrowing du if ne traverse pas
    // les fermetures des fonctions imbriquées ci-dessous.
    const promo = promoEl;
    const mainBtn = mainAddBtn;
    const mainFeedback = document.querySelector<HTMLElement>("[data-main-feedback]");
    const qtySingle = document.querySelector<HTMLButtonElement>("[data-qty-single]");
    const toggleBtn = promo.querySelector<HTMLButtonElement>("[data-promo-toggle]");
    const bundleSlotsEl = promo.querySelector<HTMLElement>("[data-bundle-slots]");
    const selects = Array.from(promo.querySelectorAll<HTMLSelectElement>("[data-bundle-slot-select]"));
    const unitPriceEl = promo.querySelector<HTMLElement>("[data-bundle-unit-price]");
    const badgeEl = promo.querySelector<HTMLElement>("[data-promo-badge]");

    const currentPrice = Number(mainBtn.dataset.singlePrice);
    const currency = mainBtn.dataset.currency;
    const fmt = (amount: number) => new Intl.NumberFormat("fr-FR", { style: "currency", currency }).format(amount);
    const saveLabel = badgeEl?.textContent?.replace(/\d.*/, "").trim() ?? "";
    const catalogByHandle = Object.fromEntries(bundleCatalog.map((p) => [p.handle, p]));

    function isExpanded(): boolean {
      return toggleBtn?.getAttribute("aria-expanded") === "true";
    }

    function updateBundlePricing() {
      const chosen = selects.map((s) => catalogByHandle[s.value]).filter(Boolean);
      // Chaque slot a 2 vignettes à synchroniser : la miniature de la ligne et
      // celle du récapitulatif dans l'en-tête "2 achetés, le 3e offert".
      selects.forEach((s, i) => {
        const p = catalogByHandle[s.value];
        if (!p) return;
        promo
          .querySelectorAll<HTMLImageElement>(`[data-bundle-img="${i}"], [data-bundle-slot-img="${i}"]`)
          .forEach((img) => {
            img.src = p.img ?? "";
          });
      });
      if (chosen.length < 3) return;
      const prices = chosen.map((p) => p.price);
      const cheapest = Math.min(...prices);
      const sum = prices.reduce((a, b) => a + b, 0);
      const total = sum - cheapest;
      if (unitPriceEl) unitPriceEl.textContent = fmt(total / 3);
      if (badgeEl) badgeEl.textContent = `${saveLabel} ${Math.round((cheapest / sum) * 100)}%`;
      mainBtn.dataset.bundlePrice = String(total);
      mainBtn.dataset.bundleVariants = JSON.stringify(chosen.map((p) => p.variantId));
      updateButtonLabel();
    }

    function updateButtonLabel() {
      const total = isExpanded() ? Number(mainBtn.dataset.bundlePrice ?? currentPrice * 3) : currentPrice;
      mainBtn.textContent = `ADD TO BAG · ${fmt(total)}`;
    }

    function setExpanded(next: boolean) {
      toggleBtn?.setAttribute("aria-expanded", String(next));
      promo.classList.toggle("is-expanded", next);
      qtySingle?.classList.toggle("is-active", !next);
      if (bundleSlotsEl) bundleSlotsEl.hidden = !next;
      updateButtonLabel();
    }

    toggleBtn?.addEventListener("click", () => setExpanded(!isExpanded()));
    qtySingle?.addEventListener("click", () => setExpanded(false));

    selects.forEach((s) => s.addEventListener("change", updateBundlePricing));

    updateBundlePricing();
    updateButtonLabel();

    mainBtn.addEventListener("click", async () => {
      mainBtn.disabled = true;
      try {
        if (isExpanded()) {
          const variantIds: string[] = JSON.parse(mainBtn.dataset.bundleVariants ?? "[]");
          await addManyToCart(variantIds.map((id) => ({ variantId: id, quantity: 1 })));
        } else if (mainBtn.dataset.variantId) {
          await addToCart(mainBtn.dataset.variantId, 1);
        }
        if (mainFeedback) mainFeedback.textContent = "✓";
      } catch (e) {
        console.error(e);
        if (mainFeedback) mainFeedback.textContent = "×";
      } finally {
        mainBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .produit { display: flex; align-items: flex-start; }
  .gallery { display: flex; flex-direction: column; gap: 2px; width: 800px; max-width: 55%; }
  .shot { background: #e5d3be; aspect-ratio: 800 / 960; overflow: hidden; }
  .shot img { width: 100%; height: 100%; object-fit: cover; }

  .info {
    position: sticky;
    top: 0;
    flex: 1 0 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 56px 64px;
  }
  .info-top { display: flex; flex-direction: column; gap: 24px; }
  .head { display: flex; flex-direction: column; gap: 16px; }
  .title-row { display: flex; gap: 8px; align-items: flex-start; }
  .title-row h1 { margin: 0; font-size: 40px; font-weight: 500; line-height: 1.2; text-transform: uppercase; }
  .ml { font-size: 16px; }
  .inspired { margin: 0; font-size: 16px; font-weight: 500; }
  .desc { margin: 0; font-size: 16px; line-height: 1.36; }
  .rating { display: flex; gap: 8px; align-items: center; }
  .stars { display: inline-flex; gap: 2px; }
  .score { font-size: 16px; font-weight: 500; }
  .reviews { font-size: 14px; }

  /* Choix de quantité : ligne "1 parfum" + carte "Buy 2 Get 1 Free" */
  .qty-select {
    display: flex; flex-direction: column; gap: 8px;
    border-top: 1px solid rgba(0,0,0,0.15); padding-top: 24px;
  }
  .qty-title { margin: 0 0 4px; font-size: 14px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.02em; }
  .qty-single {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%;
    padding: 16px; background: #e9dac9; border-radius: 8px; border: 1.5px solid transparent;
    font: inherit; text-align: left; cursor: pointer; transition: border-color 0.15s;
  }
  .qty-single.is-active { border-color: var(--rose); background: #f5eee6; }
  .qty-single img { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; background: #d8c3ab; flex-shrink: 0; }
  .qty-single-label { flex: 1 0 0; min-width: 0; font-size: 18px; font-weight: 500; color: #0a1215; }

  /* Carte "Buy 2 Get 1 Free" repliable (d'après le Figma) */
  .promo-bundle {
    display: flex; flex-direction: column; gap: 16px; padding: 16px;
    background: #e9dac9; border-radius: 8px; border: 1.5px solid transparent;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .promo-bundle.is-expanded { background: #f5eee6; border-color: var(--rose); }
  .promo-header {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    width: 100%; border: 0; background: transparent; padding: 0; margin: 0;
    font: inherit; text-align: left; cursor: pointer;
  }
  .promo-left { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .promo-thumbs { display: flex; flex-shrink: 0; }
  .promo-thumbs img { width: 48px; height: 48px; object-fit: cover; border-radius: 6px; margin-left: -16px; border: 2px solid #e9dac9; background: #d8c3ab; }
  .promo-thumbs img:first-child { margin-left: 0; }
  .promo-bundle.is-expanded .promo-thumbs img { border-color: #f5eee6; }
  .promo-title { font-size: 18px; font-weight: 500; white-space: nowrap; }
  .promo-badge {
    background: #efc5a9; color: var(--rose); padding: 4.5px 6px; border-radius: 8px;
    font-size: 14px; font-weight: 500; text-transform: uppercase; white-space: nowrap; flex-shrink: 0;
  }
  .promo-price { display: flex; flex-direction: column; align-items: flex-end; text-align: right; flex-shrink: 0; color: var(--ink); }
  .promo-price strong { font-size: 16px; font-weight: 500; }
  .promo-price small { font-size: 12px; opacity: 0.64; }

  .bundle-slots { display: flex; flex-direction: column; gap: 4px; }
