---
import Layout from "../../../layouts/Layout.astro";
import { formatPrice, getAllProducts, type ShopifyProduct } from "../../../lib/shopify";
import { getParfumContent, urlForImage, type NoteCard } from "../../../lib/sanity";
import { type Locale, locales, useTranslations } from "../../../i18n";

export async function getStaticPaths() {
  const products = await getAllProducts();
  return locales.flatMap((lang) =>
    products.map((product) => ({ params: { lang, handle: product.handle }, props: { product } }))
  );
}

interface Props {
  product: ShopifyProduct;
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { product } = Astro.props;

const parfum = await getParfumContent(product.handle, lang);
const accent = parfum?.couleurSignature ?? "#8a7a5c";

const variants = product.variants.nodes;
const hasSizes = variants.length > 1 || (variants.length === 1 && variants[0].title !== "Default Title");
const defaultVariant = variants.find((v) => v.availableForSale) ?? variants[0];
const anyAvailable = variants.some((v) => v.availableForSale);

const gallery = product.images.nodes.length ? product.images.nodes : product.featuredImage ? [product.featuredImage] : [];
const mainImage = product.featuredImage ?? gallery[0] ?? null;

const noteTabs = [
  { key: "tete", label: t("product.notes.tete"), items: parfum?.notes.tete ?? [] },
  { key: "coeur", label: t("product.notes.coeur"), items: parfum?.notes.coeur ?? [] },
  { key: "fond", label: t("product.notes.fond"), items: parfum?.notes.fond ?? [] },
].filter((tab) => tab.items.length > 0);
const firstTab = noteTabs[0]?.key;

function noteImg(note: NoteCard) {
  return note.image ? urlForImage(note.image as any).width(560).height(680).fit("crop").url() : null;
}
---

<Layout title={product.title} description={parfum?.accroche ?? product.description} lang={lang}>
  <article class="pdp" style={`--accent: ${accent}`}>
    <!-- Galerie -->
    <div class="pdp-gallery">
      <div class="main-image">
        {
          mainImage && (
            <img
              id="pdp-main"
              src={mainImage.url}
              alt={mainImage.altText ?? product.title}
              width={mainImage.width}
              height={mainImage.height}
            />
          )
        }
      </div>
      {
        gallery.length > 1 && (
          <div class="thumbs">
            {gallery.map((img) => (
              <button class="thumb" type="button" data-src={img.url} aria-label={img.altText ?? product.title}>
                <img src={img.url} alt={img.altText ?? product.title} loading="lazy" />
              </button>
            ))}
          </div>
        )
      }
    </div>

    <!-- Colonne d'achat -->
    <div class="pdp-info">
      {parfum?.familleOlfactive && <span class="tag">{parfum.familleOlfactive}</span>}
      <h1>{product.title}</h1>
      {parfum?.accroche && <p class="subtitle">{parfum.accroche}</p>}

      <p class="price" data-price>
        {formatPrice(defaultVariant.price.amount, defaultVariant.price.currencyCode)}
      </p>

      <div class="description" set:html={product.descriptionHtml} />

      {
        hasSizes && (
          <div class="field">
            <span class="label">{t("product.size")}</span>
            <div class="pills" role="radiogroup">
              {variants.map((v, i) => (
                <button
                  type="button"
                  class="pill"
                  role="radio"
                  aria-checked={v.id === defaultVariant.id ? "true" : "false"}
                  data-variant-id={v.id}
                  data-price={formatPrice(v.price.amount, v.price.currencyCode)}
                  disabled={!v.availableForSale}
                >
                  {v.title}
                </button>
              ))}
            </div>
          </div>
        )
      }

      <div class="field">
        <span class="label">{t("product.quantity")}</span>
        <div class="qty" data-qty>
          <button type="button" data-qty-minus aria-label="−">−</button>
          <input type="text" inputmode="numeric" value="1" data-qty-input aria-label="Quantité" readonly />
          <button type="button" data-qty-plus aria-label="+">+</button>
        </div>
      </div>

      <div
        class="actions"
        data-purchase
        data-default-variant={defaultVariant?.id}
        data-checkout-label={t("cart.checkout")}
        data-adding={t("product.adding")}
        data-error={t("product.error")}
      >
        <button type="button" class="btn btn-outline" data-add-to-cart disabled={!anyAvailable}>
          {anyAvailable ? t("product.addToCart") : t("product.soldOut")}
        </button>
        <button type="button" class="btn btn-solid" data-buy-now disabled={!anyAvailable}>
          {t("cart.checkout")}
        </button>
      </div>
      <p class="feedback" data-feedback role="status" aria-live="polite"></p>
    </div>
  </article>

  {
    parfum?.histoire && (
      <section class="story" style={`--accent: ${accent}`}>
        <h2>{t("product.story")}</h2>
        <p>{parfum.histoire}</p>
        {parfum.inspiration && <p class="inspiration">{parfum.inspiration}</p>}
      </section>
    )
  }

  {
    noteTabs.length > 0 && (
      <section class="notes-section" data-notes style={`--accent: ${accent}`}>
        <div class="notes-head">
          <h2>{t("product.notes")}</h2>
          <div class="tabs" role="tablist">
            {noteTabs.map((tab) => (
              <button
                type="button"
                class="tab"
                role="tab"
                data-tab={tab.key}
                aria-selected={tab.key === firstTab ? "true" : "false"}
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>
        {noteTabs.map((tab) => (
          <div class="note-cards" data-panel={tab.key} hidden={tab.key !== firstTab}>
            {tab.items.map((note) => {
              const src = noteImg(note);
              return (
                <article class="note-card">
                  {src ? (
                    <img src={src} alt={note.nom ?? ""} loading="lazy" />
                  ) : (
                    <div class="note-fallback" />
                  )}
                  <div class="note-overlay">
                    <h3>{note.nom}</h3>
                    {note.histoire && <p>{note.histoire}</p>}
                  </div>
                </article>
              );
            })}
          </div>
        ))}
      </section>
    )
  }
</Layout>

<script>
  import { addToCart } from "../../../lib/cart";

  // Galerie : swap de l'image principale au clic sur une miniature
  const main = document.getElementById("pdp-main") as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>(".thumb").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      if (main && thumb.dataset.src) main.src = thumb.dataset.src;
    });
  });

  // Sélection de contenance (variante)
  let currentVariant = document.querySelector<HTMLElement>("[data-purchase]")?.dataset.defaultVariant ?? "";
  const priceEl = document.querySelector<HTMLElement>("[data-price]");
  document.querySelectorAll<HTMLButtonElement>(".pill").forEach((pill) => {
    pill.addEventListener("click", () => {
      document.querySelectorAll(".pill").forEach((p) => p.setAttribute("aria-checked", "false"));
      pill.setAttribute("aria-checked", "true");
      currentVariant = pill.dataset.variantId ?? currentVariant;
      if (priceEl && pill.dataset.price) priceEl.textContent = pill.dataset.price;
    });
  });

  // Quantité
  let qty = 1;
  const qtyInput = document.querySelector<HTMLInputElement>("[data-qty-input]");
  const syncQty = () => {
    if (qtyInput) qtyInput.value = String(qty);
  };
  document.querySelector("[data-qty-minus]")?.addEventListener("click", () => {
    qty = Math.max(1, qty - 1);
    syncQty();
  });
  document.querySelector("[data-qty-plus]")?.addEventListener("click", () => {
    qty = Math.min(20, qty + 1);
    syncQty();
  });

  // Achat
  const purchase = document.querySelector<HTMLElement>("[data-purchase]");
  const feedback = document.querySelector<HTMLElement>("[data-feedback]");
  const addBtn = document.querySelector<HTMLButtonElement>("[data-add-to-cart]");
  const buyBtn = document.querySelector<HTMLButtonElement>("[data-buy-now]");

  async function purchaseAction(redirect: boolean) {
    if (!currentVariant || !feedback || !purchase) return;
    if (addBtn) addBtn.disabled = true;
    if (buyBtn) buyBtn.disabled = true;
    feedback.textContent = purchase.dataset.adding ?? "";
    try {
      const cart = await addToCart(currentVariant, qty);
      if (redirect && cart?.checkoutUrl) {
        window.location.href = cart.checkoutUrl;
        return;
      }
      feedback.textContent = "✓";
    } catch (error) {
      console.error(error);
      feedback.textContent = purchase.dataset.error ?? "";
    } finally {
      if (addBtn) addBtn.disabled = false;
      if (buyBtn) buyBtn.disabled = false;
    }
  }
  addBtn?.addEventListener("click", () => purchaseAction(false));
  buyBtn?.addEventListener("click", () => purchaseAction(true));

  // Onglets Notes
  const notes = document.querySelector<HTMLElement>("[data-notes]");
  notes?.querySelectorAll<HTMLButtonElement>(".tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      const key = tab.dataset.tab;
      notes.querySelectorAll(".tab").forEach((t) => t.setAttribute("aria-selected", "false"));
      tab.setAttribute("aria-selected", "true");
      notes.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.panel !== key;
      });
    });
  });
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap");

  .pdp,
  .story,
  .notes-section {
    font-family: "Jost", system-ui, sans-serif;
    color: #1c1714;
  }
  .pdp {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    align-items: start;
  }
  @media (max-width: 820px) {
    .pdp { grid-template-columns: 1fr; gap: 2rem; }
  }
  .main-image {
    background: #f2f1ee;
    border-radius: 6px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .main-image img { width: 100%; height: 100%; object-fit: cover; }
  .thumbs { display: flex; gap: 0.75rem; margin-top: 0.75rem; }
  .thumb {
    flex: 1; max-width: 6rem; aspect-ratio: 1 / 1; padding: 0;
    background: #f2f1ee; border: 1px solid transparent; border-radius: 6px;
    cursor: pointer; overflow: hidden;
  }
  .thumb:hover { border-color: var(--accent); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }

  .pdp-info { padding-top: 0.5rem; }
  .tag {
    display: inline-block; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    background: #eef1f6; color: #3a4256; padding: 0.3rem 0.6rem; border-radius: 4px; margin-bottom: 1rem;
  }
  .pdp-info h1 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 500; line-height: 1.1; margin: 0 0 0.4rem; }
  .subtitle { color: #6b6b6b; font-style: italic; margin: 0 0 1.2rem; }
  .price { font-size: 1.4rem; margin: 0 0 1.5rem; }
  .description { color: #444; line-height: 1.65; margin-bottom: 2rem; }

  .field { margin-bottom: 1.5rem; }
  .label { display: block; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: #8a8a8a; margin-bottom: 0.6rem; }
  .pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pill {
    padding: 0.6rem 1rem; border: 1px solid #d8d6d0; background: #fff; border-radius: 4px;
    cursor: pointer; font: inherit; transition: border-color 0.15s, color 0.15s;
  }
  .pill[aria-checked="true"] { border-color: var(--accent); color: var(--accent); }
  .pill:disabled { opacity: 0.4; text-decoration: line-through; cursor: not-allowed; }

  .qty { display: inline-flex; align-items: center; border: 1px solid #d8d6d0; border-radius: 4px; overflow: hidden; }
  .qty button { width: 2.6rem; height: 2.6rem; border: 0; background: #fff; font-size: 1.1rem; cursor: pointer; }
  .qty button:hover { background: #f2f1ee; }
  .qty input { width: 3rem; height: 2.6rem; text-align: center; border: 0; border-inline: 1px solid #eee; font: inherit; }

  .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 0.5rem; }
  @media (max-width: 480px) { .actions { grid-template-columns: 1fr; } }
  .btn {
    padding: 0.95rem 1rem; border-radius: 4px; font: inherit; letter-spacing: 0.04em;
    text-transform: uppercase; font-size: 0.85rem; cursor: pointer; transition: opacity 0.15s;
  }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-outline { background: #fff; border: 1px solid #1c1714; color: #1c1714; }
  .btn-outline:hover:not(:disabled) { background: #faf9f6; }
  .btn-solid { background: #1c1714; border: 1px solid #1c1714; color: #fff; }
  .btn-solid:hover:not(:disabled) { opacity: 0.88; }
  .feedback { min-height: 1.2em; margin-top: 0.75rem; color: var(--accent); font-size: 0.9rem; }

  .story { max-width: 42rem; margin: 1rem auto 3rem; padding: 0 1.5rem; line-height: 1.7; }
  .story h2 { font-weight: 500; }
  .inspiration { color: #6b6b6b; }

  .notes-section { max-width: 72rem; margin: 0 auto 4rem; padding: 0 1.5rem; }
  .notes-head { display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px solid #eee; padding-bottom: 0.75rem; margin-bottom: 1.5rem; }
  .notes-head h2 { font-weight: 500; margin: 0; }
  .tabs { display: flex; gap: 1.2rem; }
  .tab { border: 0; background: none; font: inherit; color: #9a9a9a; cursor: pointer; padding: 0 0 0.4rem; border-bottom: 2px solid transparent; }
  .tab[aria-selected="true"] { color: #1c1714; border-color: var(--accent); }
  .note-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  @media (max-width: 820px) { .note-cards { grid-template-columns: repeat(2, 1fr); } }
  .note-card { position: relative; aspect-ratio: 3 / 4; border-radius: 6px; overflow: hidden; background: #f2f1ee; }
  .note-card img { width: 100%; height: 100%; object-fit: cover; }
  .note-fallback { width: 100%; height: 100%; background: linear-gradient(160deg, var(--accent, #8a7a5c), #1c1714); }
  .note-overlay {
    position: absolute; inset: auto 0 0 0; padding: 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0));
    color: #fff;
  }
  .note-overlay h3 { margin: 0 0 0.25rem; font-size: 1rem; font-weight: 500; }
  .note-overlay p { margin: 0; font-size: 0.8rem; line-height: 1.4; opacity: 0.9; }
</style>
