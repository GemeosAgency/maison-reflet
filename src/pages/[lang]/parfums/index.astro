---
import { avecAvoir } from "../../../lib/coffret-avoir";
import { intlLocale } from "../../../lib/markets";
import Layout from "../../../layouts/Layout.astro";
import PerfumeGrid from "../../../components/PerfumeGrid.astro";
import DiscoverySetBanner from "../../../components/DiscoverySetBanner.astro";
import { COFFRET_HANDLE } from "../../../lib/coffret";
import Faq from "../../../components/Faq.astro";
import Pillars from "../../../components/Pillars.astro";
import LumaDoors from "../../../components/LumaDoors.astro";
import Reassurance from "../../../components/Reassurance.astro";
import { getImage } from "astro:assets";
import heroWide from "../../../assets/catalog/hero.jpg";
import heroNarrow from "../../../assets/catalog/hero-narrow.jpg";
import {
  formatPrice,
  getCompareAtLabel,
  getAllProducts,
  getPrimaryVariant,
  isCoffret,
  shopifyImage,
} from "../../../lib/shopify";
import {
  getCoffrets,
  getReassurances,
  getPageBySlug,
  responsiveImage,
  urlForImage,
  getPrevente,
} from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
// Montant de l'avoir du coffret : son prix pratiqué (120 en prévente), voir coffret-avoir.
const tc = await avecAvoir(t);
// Prévente ouverte (réglage Sanity) : « Précommander » partout où l'on achète.
const prevente = await getPrevente();
const addLabel = prevente.active ? t("prevente.add") : t("product.addToCart");

const allProducts = await getAllProducts();

/*
 * « The Discovery Set » : la maquette du catalogue (node 11003:9970) remplace
 * la rangée de cartes coffret par le même bandeau que la fiche produit —
 * grande image à gauche, texte et CTA à droite. Même sélection que là-bas :
 * le coffret dont le handle évoque un set d'échantillons, sinon le premier.
 */
const coffretProducts = allProducts.filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const discoveryCandidates = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const variant = getPrimaryVariant(sp);
    return {
      handle: sp.handle,
      titre: c.titre ?? sp.title,
      description: c.description,
      img: c.image
        ? responsiveImage(c.image as any, { widths: [640, 960, 1280, 1600], aspect: 816 / 560 })
        : sp.featuredImage
          ? shopifyImage(sp.featuredImage, [640, 960, 1280, 1600])
          : null,
      price: formatPrice(variant.price.amount, variant.price.currencyCode, intlLocale(lang)),
      compare: getCompareAtLabel(sp, intlLocale(lang)),
      href: localePath(lang, `/coffrets/${sp.handle}`),
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
const discovery =
  discoveryCandidates.find((c) => /sample|discovery|decouverte|découverte/i.test(c.handle)) ??
  discoveryCandidates[0] ??
  null;

/*
 * FAQ : la maquette reprend les mêmes questions de marque que la fiche
 * produit. On lit d'abord un document `page` de slug "parfums" s'il existe,
 * sinon celui de l'accueil — le composant se masque de lui-même si les deux
 * sont vides.
 */
const catalogPage = (await getPageBySlug("parfums", lang)) ?? (await getPageBySlug("home", lang));

const reassurances = (await getReassurances(lang)).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));


/*
 * Héros : deux cadrages (voir plus bas), chacun en AVIF puis WebP à plusieurs
 * largeurs, le JPEG en dernier recours. Noms hachés sous /_astro : gardés un
 * an en cache. Le cadrage étroit, LCP du mobile, pesait 178 Kio en JPEG.
 */
const heroSet = async (src: ImageMetadata, widths: number[]) => {
  const at = (format: "avif" | "webp" | "jpg") =>
    getImage({ src, format, widths, quality: format === "jpg" ? 75 : 65 });
  const [avif, webp, jpg] = await Promise.all([at("avif"), at("webp"), at("jpg")]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, jpg: jpg.srcSet.attribute, src: jpg.src };
};
const [heroNarrowSet, heroWideSet] = await Promise.all([
  heroSet(heroNarrow, [480, 720, 960, 1440, 1800]),
  heroSet(heroWide, [1024, 1440, 2048, 2810]),
]);
// Image de partage : le cadrage large en JPEG 1200 px (les réseaux n'aiment pas l'AVIF).
const heroShare = await getImage({ src: heroWide, format: "jpg", width: 1200, quality: 80 });
---

<Layout
  title={t("meta.catalogTitle")}
  description={t("meta.catalog")}
  lang={lang}
  ogImage={heroShare.src}
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: t("nav.perfumes") }]}
>
  <section class="catalog-hero full-bleed">
    <!-- LCP : vraie balise img (fetchpriority) plutôt qu'un background CSS.
         Deux cadrages de la maquette (Banner 12184:2474 et 12184:3061) : les
         flacons sont à droite dans le large, au centre dans l'étroit. Un écran
         de téléphone recadre le large en son milieu et couperait les flacons. -->
    <picture>
      <source media="(max-width: 900px)" type="image/avif" srcset={heroNarrowSet.avif} sizes="100vw" />
      <source media="(max-width: 900px)" type="image/webp" srcset={heroNarrowSet.webp} sizes="100vw" />
      <source media="(max-width: 900px)" srcset={heroNarrowSet.jpg} sizes="100vw" />
      <source type="image/avif" srcset={heroWideSet.avif} sizes="100vw" />
      <source type="image/webp" srcset={heroWideSet.webp} sizes="100vw" />
      <img
        class="catalog-hero-img"
        src={heroWideSet.src}
        srcset={heroWideSet.jpg}
        sizes="100vw"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <div class="catalog-hero-inner">
      <div class="catalog-hero-content">
        <h1>{t("home.hero.title1")} {t("home.hero.title2")}</h1>
        <p>{t("catalog.subtitle")}</p>
      </div>
    </div>
  </section>

  {/* Grille catalogue : les six Reflets (hors coffrets). */}
  <PerfumeGrid products={allProducts} lang={lang} addLabel={addLabel} />

  <LumaDoors lang={lang} />

  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.titre}
        description={discovery.description}
        priceLabel={discovery.price}
        compareLabel={discovery.compare}
        href={discovery.href}
        img={discovery.img}
        ctaLabel={prevente.active ? t("prevente.add") : t("home.hero.cta")}
        creditLabel={discovery.handle === COFFRET_HANDLE ? t("coffret.creditShort") : null}
        creditNote={discovery.handle === COFFRET_HANDLE ? tc("coffret.creditNote") : null}
        tipLabel={t("product.tipOpen")}
      />
    )
  }


  <Pillars
    title1={t("home.pillars.title1")}
    title2={t("home.pillars.title2")}
    subtitle={t("home.pillars.subtitle")}
    pillars={[
      { title: t("home.pillars.quality.title"), text: t("home.pillars.quality.text"), image: "/home/pillar-quality.jpg" },
      { title: t("home.pillars.performance.title"), text: t("home.pillars.performance.text"), image: "/home/pillar-performance.jpg" },
      { title: t("home.pillars.character.title"), text: t("home.pillars.character.text"), image: "/home/pillar-character.jpg" },
    ]}
  />

  <Faq items={catalogPage?.faqs ?? []} title={t("nav.faq")} />

  <Reassurance items={reassurances} />
</Layout>

<style>
  /* Hero catalogue — ratio de la maquette (1440x560), y compris grand écran
     (pas de max-height : ça écraserait le ratio) ; image
     en <img fetchpriority> pour le LCP.
     .catalog-hero = pur canvas full-bleed. .catalog-hero-inner plafonne la
     largeur du contenu à --page-max (comme <main>) : c'est ici que le padding
     valait 24px au lieu des 64/72px utilisés partout ailleurs sur cette
     page — le texte n'était pas aligné avec les titres de section en dessous. */
  .catalog-hero {
    position: relative;
    aspect-ratio: 1440 / 560;
    min-height: 480px;
    /* Même plafond que le héros de l'accueil : bord à bord, le ratio finit
       par dépasser la hauteur visible. Photo en `cover`, donc recadrage. */
    max-height: var(--hero-max-h);
    background-color: #dec9b8;
    overflow: hidden;
  }
  .catalog-hero-img {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center;
  }
  /* Voile de la maquette (12184:2596) : en diagonale, il assombrit le coin
     bas gauche où se pose le texte et laisse les flacons en pleine lumière. */
  .catalog-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(238.6deg, rgba(12, 13, 14, 0) 45.3%, rgba(12, 13, 14, 0.72) 85.9%);
  }
  .catalog-hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--page-max);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 56px var(--gutter-x);
  }
  /* En arabe, `flex-start` enverrait le texte à droite, sur les flacons : il
     reste dans le coin sombre de la photo, qui ne se retourne pas. */
  :global([dir="rtl"]) .catalog-hero-inner { align-items: flex-end; }
  .catalog-hero-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--cream);
  }
  .catalog-hero-content h1 { max-width: 528px; margin: 0; font-size: clamp(30px, 2.78vw, 48px); font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .catalog-hero-content p { margin: 0; font-size: 18px; line-height: 1.32; letter-spacing: -0.36px; }


  @media (max-width: 900px) {
    .catalog-hero { min-height: 440px; }
    /* Pas de mobile dans la maquette. Sur un écran étroit, les flacons
       descendent jusque sous le titre : le voile diagonal ne suffit plus, on
       assombrit tout le bas. */
    .catalog-hero::before {
      background: linear-gradient(to bottom, rgba(12, 13, 14, 0) 30%, rgba(12, 13, 14, 0.85) 92%);
    }
    .catalog-hero-inner { padding: 40px var(--gutter-x); }
    .catalog-hero-content p { font-size: 16px; }
  }
</style>
