---
import Layout from "../../../layouts/Layout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import DiscoverySetBanner from "../../../components/DiscoverySetBanner.astro";
import Faq from "../../../components/Faq.astro";
import Pillars from "../../../components/Pillars.astro";
import Reassurance from "../../../components/Reassurance.astro";
import Reviews from "../../../components/Reviews.astro";
import {
  formatPrice,
  getAllProducts,
  getPrimaryVariant,
  getDisplayPrice,
  isCoffret,
  isSampleVariantTitle,
  shopifyImage,
} from "../../../lib/shopify";
import {
  getInspiredByMap,
  getRecoImages,
  getCoffrets,
  getReassurances,
  getBestSellerMap,
  getPageBySlug,
  responsiveImage,
  urlForImage,
} from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const allProducts = await getAllProducts();
const inspiredMap = await getInspiredByMap();
const recoImages = await getRecoImages();
const bestSellerMap = await getBestSellerMap();

// Grille catalogue : tous les parfums (hors coffrets).
const perfumes = allProducts
  .filter((p) => !isCoffret(p))
  .map((p) => {
    const recoImg = recoImages[p.handle];
    const variant = getPrimaryVariant(p);
    const price = getDisplayPrice(p);
    return {
      name: p.title,
      inspired: inspiredMap[p.handle] ?? null,
      price: formatPrice(price.amount, price.currencyCode),
      img: recoImg?.main
        ? urlForImage(recoImg.main as any).width(800).height(1000).url()
        : p.featuredImage
          ? shopifyImage(p.featuredImage, [400, 800]).src
          : null,
      // Seconde photo du survol : la version curée dans Sanity si elle existe,
      // sinon la deuxième photo produit de Shopify. Les visuels de variante
      // échantillon sont écartés — ce sont des vignettes de 192px destinées au
      // panier, pas des angles de flacon.
      hoverImg: recoImg?.hover
        ? urlForImage(recoImg.hover as any).width(800).height(1000).url()
        : (() => {
            const sampleUrls = new Set(
              p.variants.nodes
                .filter((v) => isSampleVariantTitle(v.title))
                .map((v) => v.image?.url)
                .filter((u): u is string => Boolean(u))
            );
            const autres = [p.featuredImage, ...p.images.nodes]
              .filter((im) => im && !sampleUrls.has(im.url))
              .filter((im, i, arr) => arr.findIndex((x) => x!.url === im!.url) === i);
            return autres[1] ? shopifyImage(autres[1]!, [400, 800]).src : null;
          })(),
      variantId: variant.id,
      href: localePath(lang, `/parfums/${p.handle}`),
      badge: bestSellerMap[p.handle] ? t("product.bestSeller") : null,
    };
  });

/*
 * « The Discovery Set » : la maquette du catalogue (node 11003:9970) remplace
 * la rangée de cartes coffret par le même bandeau que la fiche produit —
 * grande image à gauche, texte et CTA à droite. Même sélection que là-bas :
 * le coffret dont le handle évoque un set d'échantillons, sinon le premier.
 */
const coffretProducts = allProducts.filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const discoveryCandidates = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const variant = getPrimaryVariant(sp);
    return {
      handle: sp.handle,
      titre: c.titre ?? sp.title,
      description: c.description,
      img: c.image
        ? responsiveImage(c.image as any, { widths: [640, 960, 1280, 1600], aspect: 816 / 560 })
        : sp.featuredImage
          ? shopifyImage(sp.featuredImage, [640, 960, 1280, 1600])
          : null,
      price: formatPrice(variant.price.amount, variant.price.currencyCode),
      href: localePath(lang, `/coffrets/${sp.handle}`),
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);
const discovery =
  discoveryCandidates.find((c) => /sample|discovery|decouverte|découverte/i.test(c.handle)) ??
  discoveryCandidates[0] ??
  null;

/*
 * FAQ : la maquette reprend les mêmes questions de marque que la fiche
 * produit. On lit d'abord un document `page` de slug "parfums" s'il existe,
 * sinon celui de l'accueil — le composant se masque de lui-même si les deux
 * sont vides.
 */
const catalogPage = (await getPageBySlug("parfums", lang)) ?? (await getPageBySlug("home", lang));

const reassurances = (await getReassurances(lang)).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));

// Avis clients : aucun système d'avis en place (Judge.me, Loox…) — bloc de
// démonstration à remplacer avant le lancement (voir même logique sur la home).
const reviewCount = 267;
const reviewPlaceholder = {
  fr: "Avis client à venir — contenu de démonstration en attendant un vrai système d'avis.",
  ar: "رأي العميل قادم — محتوى تجريبي بانتظار نظام تقييمات حقيقي.",
  en: "Customer review coming soon — placeholder content pending a real reviews system.",
}[lang];
const reviews = Array.from({ length: 5 }, () => ({ author: "—", date: "", quote: reviewPlaceholder }));
---

<Layout
  title={t("nav.parfums")}
  description="La collection de parfums Maison Reflet"
  lang={lang}
  ogImage="/catalog/hero.jpg"
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: t("nav.perfumes") }]}
>
  <section class="catalog-hero full-bleed">
    <!-- LCP : vraie balise img (fetchpriority) plutôt qu'un background CSS. -->
    <img class="catalog-hero-img" src="/catalog/hero.jpg" alt="" fetchpriority="high" decoding="async" />
    <div class="catalog-hero-inner">
      <div class="catalog-hero-content">
        <h1>{t("home.hero.title1")} {t("home.hero.title2")}</h1>
        <p>{t("catalog.subtitle")}</p>
      </div>
    </div>
  </section>

  <section class="catalog-grid">
    {
      perfumes.map((p) => (
        <ProductCard
          name={p.name}
          inspired={p.inspired}
          inspiredByLabel={t("product.twistOf")}
          price={p.price}
          img={p.img}
          hoverImg={p.hoverImg}
          href={p.href}
          variantId={p.variantId}
          badge={p.badge}
        />
      ))
    }
  </section>

  {
    discovery && (
      <DiscoverySetBanner
        title={discovery.titre}
        description={discovery.description}
        priceLabel={discovery.price}
        href={discovery.href}
        img={discovery.img}
        ctaLabel={t("home.hero.cta")}
      />
    )
  }

  <Reviews
    title={t("home.reviews.title")}
    ratingLabel={t("home.reviews.rated")}
    customersLabel={t("home.reviews.customers")}
    reviews={reviews}
    totalCount={reviewCount}
    previousLabel={t("reviews.previous")}
    nextLabel={t("reviews.next")}
  />

  <Pillars
    title1={t("home.pillars.title1")}
    title2={t("home.pillars.title2")}
    subtitle={t("home.pillars.subtitle")}
    pillars={[
      { title: t("home.pillars.quality.title"), text: t("home.pillars.quality.text"), image: "/home/pillar-quality.jpg" },
      { title: t("home.pillars.performance.title"), text: t("home.pillars.performance.text"), image: "/home/pillar-performance.jpg" },
      { title: t("home.pillars.character.title"), text: t("home.pillars.character.text"), image: "/home/pillar-character.jpg" },
    ]}
  />

  <Faq items={catalogPage?.faqs ?? []} title={t("nav.faq")} />

  <Reassurance items={reassurances} />
</Layout>

<style>
  /* Hero catalogue — ratio de la maquette (1440x560), y compris grand écran
     (pas de max-height : ça écraserait le ratio) ; image
     en <img fetchpriority> pour le LCP.
     .catalog-hero = pur canvas full-bleed. .catalog-hero-inner plafonne la
     largeur du contenu à --page-max (comme <main>) : c'est ici que le padding
     valait 24px au lieu des 64/72px utilisés partout ailleurs sur cette
     page — le texte n'était pas aligné avec les titres de section en dessous. */
  .catalog-hero {
    position: relative;
    aspect-ratio: 1440 / 560;
    min-height: 480px;
    background-color: #dec9b8;
    overflow: hidden;
  }
  .catalog-hero-img {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center;
  }
  .catalog-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 26%, rgba(31, 31, 31, 0.88) 102%);
  }
  .catalog-hero-inner {
    position: relative;
    z-index: 2;
    max-width: var(--page-max);
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 56px var(--gutter-x);
    text-align: center;
  }
  .catalog-hero-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 40rem;
    color: var(--cream);
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, 0.56));
  }
  .catalog-hero-content h1 { margin: 0; font-size: clamp(30px, 2.78vw, 48px); font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .catalog-hero-content p { margin: 0; font-size: 18px; line-height: 1.32; letter-spacing: -0.36px; }

  /* Grille produits : 3 colonnes sur toute la largeur du container, gap 2px,
     deux rangées de trois. La hauteur découle du ratio de la maquette
     (478,67 x 640) et non d'une valeur fixe, donc les tuiles gardent leurs
     proportions sur écran large. */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    width: 100%;
    margin-top: 2px;
  }
  .catalog-grid :global(.product-card) { aspect-ratio: 478.6667 / 640; height: auto; }

  @media (max-width: 900px) {
    .catalog-hero { min-height: 440px; }
    .catalog-hero-inner { padding: 40px var(--gutter-x); }
    .catalog-hero-content p { font-size: 16px; }
    .catalog-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .catalog-grid { grid-template-columns: 1fr; }
    .catalog-grid :global(.product-card) { aspect-ratio: 4 / 5; }
  }
</style>
