---
import Layout from "../../../layouts/Layout.astro";
import ProductCard from "../../../components/ProductCard.astro";
import BoxCard from "../../../components/BoxCard.astro";
import Reassurance from "../../../components/Reassurance.astro";
import { formatPrice, getAllProducts, getPrimaryVariant, getDisplayPrice, isCoffret } from "../../../lib/shopify";
import { getInspiredByMap, getRecoImages, getCoffrets, getReassurances, urlForImage } from "../../../lib/sanity";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const allProducts = await getAllProducts();
const inspiredMap = await getInspiredByMap();
const recoImages = await getRecoImages();

// Grille catalogue : tous les parfums (hors coffrets).
const perfumes = allProducts
  .filter((p) => !isCoffret(p))
  .map((p) => {
    const recoImg = recoImages[p.handle];
    const variant = getPrimaryVariant(p);
    const price = getDisplayPrice(p);
    return {
      name: p.title,
      inspired: inspiredMap[p.handle] ?? null,
      price: formatPrice(price.amount, price.currencyCode),
      img: recoImg?.main
        ? urlForImage(recoImg.main as any).width(800).height(1000).url()
        : (p.featuredImage?.url ?? null),
      hoverImg: recoImg?.hover ? urlForImage(recoImg.hover as any).width(800).height(1000).url() : null,
      variantId: variant.id,
      href: localePath(lang, `/parfums/${p.handle}`),
    };
  });

// "The Perfumer's Set" : coffrets (contenu Sanity croisé avec le produit Shopify).
const coffretProducts = allProducts.filter(isCoffret);
const coffretContent = await getCoffrets(lang);
const coffrets = coffretContent
  .map((c) => {
    const sp = coffretProducts.find((p) => p.handle === c.shopifyHandle);
    if (!sp) return null;
    const variant = getPrimaryVariant(sp);
    return {
      titre: c.titre ?? sp.title,
      img: c.image ? urlForImage(c.image as any).width(1000).url() : (sp.featuredImage?.url ?? null),
      price: formatPrice(variant.price.amount, variant.price.currencyCode),
      variantId: variant.id,
      href: localePath(lang, `/coffrets/${sp.handle}`),
    };
  })
  .filter((c): c is NonNullable<typeof c> => c !== null);

const reassurances = (await getReassurances(lang)).map((r) => ({
  icone: r.icone ? urlForImage(r.icone as any).width(80).url() : null,
  lignes: (r.texte ?? "").split("\n").filter(Boolean),
}));

// Avis clients : aucun système d'avis en place (Judge.me, Loox…) — bloc de
// démonstration à remplacer avant le lancement (voir même logique sur la home).
const reviewCount = 267;
const reviewPlaceholder = {
  fr: "Avis client à venir — contenu de démonstration en attendant un vrai système d'avis.",
  ar: "رأي العميل قادم — محتوى تجريبي بانتظار نظام تقييمات حقيقي.",
  en: "Customer review coming soon — placeholder content pending a real reviews system.",
}[lang];
const reviews = Array.from({ length: 5 }, () => ({ author: "—", date: "", quote: reviewPlaceholder }));
---

<Layout
  title={t("nav.parfums")}
  description="La collection de parfums Maison Reflet"
  lang={lang}
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: t("nav.perfumes") }]}
>
  <section class="catalog-hero full-bleed">
    <!-- LCP : vraie balise img (fetchpriority) plutôt qu'un background CSS. -->
    <img class="catalog-hero-img" src="/catalog/hero.jpg" alt="" fetchpriority="high" decoding="async" />
    <div class="catalog-hero-inner">
      <div class="catalog-hero-content">
        <h1>{t("home.hero.title1")} {t("home.hero.title2")}</h1>
        <p>{t("catalog.subtitle")}</p>
      </div>
    </div>
  </section>

  <section class="catalog-grid">
    {
      perfumes.map((p) => (
        <ProductCard
          name={p.name}
          inspired={p.inspired}
          inspiredByLabel={t("product.twistOf")}
          price={p.price}
          img={p.img}
          hoverImg={p.hoverImg}
          href={p.href}
          variantId={p.variantId}
        />
      ))
    }
  </section>

  {
    coffrets.length > 0 && (
      <section class="perfumers-set">
        <h2>{t("home.perfumersSet")}</h2>
        <div class="perfumers-set-grid">
          {coffrets.map((c) => (
            <BoxCard title={c.titre} price={c.price} img={c.img} href={c.href} variantId={c.variantId} />
          ))}
        </div>
      </section>
    )
  }

  <!--
    Avis clients : aucun système d'avis en place — bloc de démonstration.
    À remplacer par de vrais avis (Judge.me / Loox…) avant le lancement.
  -->
  <section class="reviews">
    <div class="reviews-head">
      <h2>{t("home.reviews.title").replace("{count}", String(reviewCount))}</h2>
      <div class="reviews-rating">
        <span class="stars">
          {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="18" height="18" />)}
        </span>
        <span class="reviews-rated">
          <strong>{t("home.reviews.rated")}</strong>
          <span>{t("home.reviews.customers")}</span>
        </span>
      </div>
    </div>
    <div class="reviews-list">
      {
        reviews.map((r) => (
          <div class="review">
            <div class="review-head">
              <span class="stars">
                {[0, 1, 2, 3, 4].map(() => <img src="/brand/star.svg" alt="" width="18" height="18" />)}
              </span>
              <p class="review-author">{r.author}</p>
              {r.date && <p class="review-date">{r.date}</p>}
            </div>
            <p class="review-quote">“{r.quote}”</p>
          </div>
        ))
      }
    </div>
  </section>

  <Reassurance items={reassurances} />
</Layout>

<style>
  /* Hero catalogue — 2:1 fixe, y compris grand écran (pas de max-height :
     ça écraserait le ratio dès qu'on dépasse une certaine largeur) ; image
     en <img fetchpriority> pour le LCP.
     .catalog-hero = pur canvas full-bleed. .catalog-hero-inner plafonne la
     largeur du contenu à 1800px (comme <main>) : c'est ici que le padding
     valait 24px au lieu des 64/72px utilisés partout ailleurs sur cette
     page — le texte n'était pas aligné avec les titres de section en dessous. */
  .catalog-hero {
    position: relative;
    aspect-ratio: 2 / 1;
    min-height: 480px;
    background-color: #dec9b8;
    overflow: hidden;
  }
  .catalog-hero-img {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: center;
  }
  .catalog-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, rgba(31, 31, 31, 0) 26%, rgba(31, 31, 31, 0.88) 102%);
  }
  .catalog-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1800px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 56px var(--gutter-x);
    text-align: center;
  }
  .catalog-hero-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 40rem;
    color: var(--cream);
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, 0.56));
  }
  .catalog-hero-content h1 { margin: 0; font-size: clamp(30px, 2.78vw, 48px); font-weight: 500; text-transform: uppercase; line-height: 1.2; }
  .catalog-hero-content p { margin: 0; font-size: 18px; line-height: 1.32; letter-spacing: -0.36px; }

  /* Grille produits : 3 colonnes pleine largeur, gap 2px. La hauteur des
     cellules découle du ratio Figma (480×640 = 3:4) et plus d'une valeur
     fixe — les cartes gardent leurs proportions sur écran large. */
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    width: 100%;
    margin-top: 2px;
  }
  .catalog-grid :global(.product-card) { aspect-ratio: 3 / 4; height: auto; }

  /* The Perfumer's Set — ratio Figma 1440×728 (≈ carré par carte) */
  .perfumers-set { display: flex; flex-direction: column; align-items: center; }
  .perfumers-set > h2 {
    margin: 0; font-size: clamp(26px, 2.22vw, 38px); font-weight: 500; text-transform: uppercase; text-align: center;
    padding: 96px 64px 40px;
  }
  .perfumers-set-grid { display: flex; gap: 2px; width: 100%; aspect-ratio: 180 / 91; max-height: 980px; }
  .perfumers-set-grid :global(.box-card) { aspect-ratio: auto; }

  /* Avis (placeholder) */
  .reviews { display: flex; flex-direction: column; gap: 32px; padding: 96px 72px; }
  .reviews-head { display: flex; align-items: center; gap: 32px; flex-wrap: wrap; }
  .reviews-head h2 { margin: 0; font-size: 32px; font-weight: 500; text-transform: uppercase; }
  .reviews-rating { display: flex; align-items: center; gap: 8px; }
  .stars { display: inline-flex; gap: 2px; }
  .reviews-rated { display: flex; align-items: baseline; gap: 4px; color: var(--ink); }
  .reviews-rated strong { font-size: 16px; font-weight: 500; }
  .reviews-rated span { font-size: 14px; }
  .reviews-list { display: flex; flex-direction: column; }
  .review {
    display: flex; flex-direction: column; gap: 12px;
    padding: 24px 0; border-top: 1px solid rgba(31, 31, 31, 0.12);
  }
  .reviews-list .review:last-child { border-bottom: 1px solid rgba(31, 31, 31, 0.12); }
  .review-head { display: flex; flex-direction: column; gap: 8px; }
  .review-author { margin: 0; font-size: 18px; font-weight: 500; }
  .review-date { margin: 0; font-size: 16px; opacity: 0.7; }
  .review-quote { margin: 0; font-size: 20px; line-height: 1.2; max-width: 60rem; }

  @media (max-width: 900px) {
    .catalog-hero { min-height: 440px; }
    .catalog-hero-inner { padding: 40px var(--gutter-x); }
    .catalog-hero-content p { font-size: 16px; }
    .catalog-grid { grid-template-columns: repeat(2, 1fr); }
    .perfumers-set > h2 { padding: 56px 24px 24px; }
    .perfumers-set-grid { aspect-ratio: auto; max-height: none; flex-direction: column; }
    .perfumers-set-grid :global(.box-card) { min-height: 420px; }
    .reviews { padding: 56px 24px; }
  }

  @media (max-width: 560px) {
    .catalog-grid { grid-template-columns: 1fr; }
    .catalog-grid :global(.product-card) { aspect-ratio: 4 / 5; }
  }
</style>
