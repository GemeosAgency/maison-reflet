---
import Layout from "../../../layouts/Layout.astro";
import { formatPrice, getAllProducts, getDisplayPrice, isCoffret } from "../../../lib/shopify";
import { type Locale, locales, localePath, useTranslations } from "../../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const products = (await getAllProducts()).filter((p) => !isCoffret(p));
---

<Layout
  title={t("nav.parfums")}
  description="La collection de parfums Maison Reflet"
  lang={lang}
  breadcrumbs={[{ label: t("nav.home"), href: localePath(lang, "/") }, { label: t("nav.perfumes") }]}
>
  <h1>{t("nav.parfums")}</h1>

  <div class="grid">
    {
      products.map((product) => (
        <a href={localePath(lang, `/parfums/${product.handle}`)} class="card">
          {product.featuredImage && (
            <img
              src={product.featuredImage.url}
              alt={product.featuredImage.altText ?? product.title}
              width={product.featuredImage.width}
              height={product.featuredImage.height}
              loading="lazy"
            />
          )}
          <h2>{product.title}</h2>
          <p>
            {formatPrice(getDisplayPrice(product).amount, getDisplayPrice(product).currencyCode)}
          </p>
        </a>
      ))
    }
  </div>
</Layout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 2rem; }
  .card { display: block; text-decoration: none; color: inherit; }
  .card img { width: 100%; height: auto; display: block; }
</style>
