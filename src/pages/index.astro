---
import Layout from "../layouts/Layout.astro";
import { formatPrice, getAllProducts } from "../lib/shopify";

// Parfums phares : les 3 premiers du catalogue Shopify.
// Pour une vraie curation éditoriale, créer plus tard une collection Shopify
// dédiée (ex: "selection-accueil") et filtrer dessus dans getAllProducts.
const featured = (await getAllProducts(3)).slice(0, 3);
---

<Layout
  title="Accueil"
  description="Maison Reflet — Parfums franco-arabes, collection Les 10 Reflets"
>
  <section class="hero">
    <h1>Maison Reflet</h1>
    <p class="tagline">Dix parfums, dix reflets d'une identité franco-arabe.</p>
    <p>
      Entre les jardins de Grasse et les souks d'Orient, chaque création de la Maison
      raconte une double appartenance : la précision de la parfumerie française,
      l'intensité des matières arabes — oud, ambre, rose de Taïf.
    </p>
    <a href="/parfums" class="cta">Découvrir la collection</a>
  </section>

  {
    featured.length > 0 && (
      <section class="featured" aria-labelledby="featured-title">
        <h2 id="featured-title">Les reflets phares</h2>
        <div class="featured-grid">
          {featured.map((product) => (
            <a href={`/parfums/${product.handle}`} class="featured-card">
              {product.featuredImage && (
                <img
                  src={product.featuredImage.url}
                  alt={product.featuredImage.altText ?? product.title}
                  width={product.featuredImage.width}
                  height={product.featuredImage.height}
                  loading="lazy"
                />
              )}
              <h3>{product.title}</h3>
              <p>
                {formatPrice(
                  product.priceRange.minVariantPrice.amount,
                  product.priceRange.minVariantPrice.currencyCode
                )}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="identity" aria-labelledby="identity-title">
    <h2 id="identity-title">Une maison, deux rives</h2>
    <p>
      Maison Reflet est née d'une conviction : le parfum est un miroir. Il reflète
      celles et ceux qui le portent, leurs héritages, leurs traversées. Nos dix
      créations composent un pont olfactif entre la France et le monde arabe —
      ni tout à fait l'une, ni tout à fait l'autre, profondément les deux.
    </p>
    <a href="/maison">Découvrir La Maison</a>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 1rem;
    max-width: 40rem;
    margin: 0 auto;
  }
  .tagline {
    font-size: 1.25rem;
  }
  .featured,
  .identity {
    padding: 2rem 1rem;
    max-width: 60rem;
    margin: 0 auto;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
  }
  .featured-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .featured-card img {
    width: 100%;
    height: auto;
    display: block;
  }
  .identity {
    text-align: center;
    max-width: 40rem;
  }
</style>
