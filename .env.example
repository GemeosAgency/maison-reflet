# ---- Shopify Storefront API ----
# Préfixe PUBLIC_ (convention Astro/Vite) : ces valeurs sont embarquées dans le
# JavaScript envoyé au navigateur, ce qui permet au panier d'appeler la Cart API
# directement côté client. C'est voulu et sans risque : le token Storefront est
# un token PUBLIC par conception chez Shopify (lecture + panier, rate-limité).
# Ne JAMAIS mettre ici un token Admin API.

# Domaine de ta boutique Shopify (pas de https://)
PUBLIC_SHOPIFY_STORE_DOMAIN=maison-reflet.myshopify.com

# Token public de la Storefront API (PAS le token Admin API)
# À générer dans Shopify Admin > Réglages > Apps et canaux de vente > Développer des apps
# > créer une app > Storefront API > activer les scopes nécessaires
# (lecture produits + unauthenticated_write_checkouts pour le panier)
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Version de l'API Storefront (à mettre à jour tous les ~3 mois)
PUBLIC_SHOPIFY_API_VERSION=2025-10

# ---- Sanity ----
# Lues uniquement au build (côté serveur), donc pas de préfixe PUBLIC_.
# Visible sur sanity.io/manage une fois le projet créé
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-01-01

# Token de lecture Sanity — nécessaire uniquement si le dataset est privé
# ou si tu veux prévisualiser du contenu en brouillon (draft)
SANITY_READ_TOKEN=

# ---- Klaviyo ----
# Clé publique (company ID à 6 caractères) — charge klaviyo.js si définie.
# Préfixe PUBLIC_ voulu : c'est une clé publique par conception.
PUBLIC_KLAVIYO_COMPANY_ID=

# Clé PRIVÉE restreinte (scope minimal : Events → Write) — utilisée uniquement
# côté serveur par le relais first-party /api/events (tracking insensible aux
# bloqueurs de contenu). JAMAIS de préfixe PUBLIC_ ici.
# À créer dans Klaviyo → Settings → Account → API keys → Create Private API Key.
KLAVIYO_PRIVATE_API_KEY=

# Clé PRIVÉE distincte (scope minimal : Subscriptions → Write) — utilisée
# uniquement par /api/subscribe pour abonner (consentement réel) le profil à
# la liste "Newsletter" lors de l'inscription depuis le footer. Volontairement
# séparée de KLAVIYO_PRIVATE_API_KEY ci-dessus (une capacité par clé).
KLAVIYO_SUBSCRIBE_API_KEY=

# ---- Meta (Facebook) Pixel + Conversions API ----
# Tout le tracking Meta est inerte tant que ces variables sont absentes — le
# code est en place, il s'active en les renseignant PUIS en redéployant
# (PUBLIC_META_PIXEL_ID est inliné dans le bundle client au build ; sur Vercel,
# un changement d'env ne s'applique qu'aux déploiements suivants).
# Architecture : chaque événement part en double (Pixel navigateur + relais
# first-party /api/meta-events → CAPI) avec le même event_id, Meta dédoublonne ;
# le Purchase vient du webhook Shopify orders/paid (checkout hors domaine).
# Voir src/lib/meta.ts.

# ID du Pixel (public par conception, comme le company ID Klaviyo).
# À créer dans Meta Events Manager → Data Sources → Web (Business Manager requis,
# pas besoin de compte publicitaire actif).
PUBLIC_META_PIXEL_ID=

# Token d'accès Conversions API (SECRET — jamais de préfixe PUBLIC_).
# Events Manager → ton Pixel → Settings → Conversions API → Generate access token.
META_CAPI_ACCESS_TOKEN=

# Optionnel : code "Test events" (Events Manager → Test events) pour valider le
# flux en pré-lancement sans polluer les données réelles. RETIRER en production.
META_TEST_EVENT_CODE=

# ---- Shopify webhooks ----
# Clé de signature HMAC des webhooks (SECRET). Shopify Admin → Settings →
# Notifications → Webhooks : créer un webhook "Order payment" (orders/paid)
# pointant vers https://<domaine>/api/webhooks/shopify-orders, puis copier la
# clé de signature affichée en bas de cette page.
SHOPIFY_WEBHOOK_SECRET=
